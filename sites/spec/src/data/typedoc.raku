      'category' => 'metamodel',
      'subtitle' => 'Metaobject that supports storing and introspecting methods',
      'declkind' => 'role',
      'consumers' => ['Metamodel::ClassHOW', 'Metamodel::ConcreteRoleHOW', 'Metamodel::EnumHOW', 'Metamodel::ParametricRoleHOW'],
      'routines' => [
        { 'name' => 'add_method', 'kind' => 'method', 'summary' => 'Adds a method to the metaclass, to be called with name C<$name>. This should only be done before a type is composed.', 'sigs' => ['method add_method($obj, $name, $code)'], 'returns' => [] },
        { 'name' => 'methods', 'kind' => 'method', 'summary' => 'Returns a list of public methods available on the class (which includes methods from superclasses and roles). By default this stops at the classes L<C<Cool>|/type/Cool>, L<C<Any>|/type/Any> or L<C<Mu>|/type/Mu>; to really get all methods, use the C<:all> adverb. If C<:local> is set, only methods declared directly in the class are returned. The returned list contains objects of type L<C<Method>|/type/Method>, which you can', 'sigs' => ['method methods($obj, :$all, :$local)'], 'returns' => [] },
        { 'name' => 'method_table', 'kind' => 'method', 'summary' => 'Returns a hash where the keys are method names, and the values are L<C<Method>|/type/Method>s. Note that the keys are the names by which the methods can be called, not necessarily the names by which the methods know themselves.', 'sigs' => ['method method_table($obj --> Hash:D)'], 'returns' => ['Hash:D'] },
        { 'name' => 'lookup', 'kind' => 'method', 'summary' => 'Returns the first matching L<C<Method>|/type/Method> object of the provided C<$name> or C<(Mu)> if no method object was found. The search for a matching method object is done by following the L<mro|/type/Metamodel::C3MRO> of C<$obj>. Note that C<lookup> is supposed to be used for introspection, if you\'re after something which can be invoked you probably want to use L<find_method|/routine/find_method>', 'sigs' => ['method lookup($obj, $name --> Method)'], 'returns' => ['Method'] },
      ],
