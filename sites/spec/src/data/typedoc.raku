      'children' => ['Match'],
      'routines' => [
        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Returns the positional part of the C<Capture>.', 'sigs' => ['method list(Capture:D:)'], 'returns' => [] },
        { 'name' => 'hash', 'kind' => 'method', 'summary' => 'Returns the named/hash part of the C<Capture>.', 'sigs' => ['method hash(Capture:D:)'], 'returns' => [] },
        { 'name' => 'elems', 'kind' => 'method', 'summary' => 'Returns the number of positional elements in the C<Capture>.', 'sigs' => ['method elems(Capture:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'keys', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> containing all positional keys followed by all named keys. For positional arguments the keys are the respective arguments\' ordinal positions starting from zero.', 'sigs' => ['multi method keys(Capture:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'values', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> containing all positional values followed by all named argument values.', 'sigs' => ['multi method values(Capture:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'kv', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of alternating L<keys|#method_keys> and L<values|#method_values>. The positional keys and values, if any, come first followed by the named keys and values.', 'sigs' => ['multi method kv(Capture:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'pairs', 'kind' => 'method', 'summary' => 'Returns all arguments, the positional followed by the named, as a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s. Positional arguments have their respective ordinal value, starting at zero, as key while the named arguments have their names as key.', 'sigs' => ['multi method pairs(Capture:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'antipairs', 'kind' => 'method', 'summary' => 'Returns all arguments, the positional followed by the named, as a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s where the keys and values have been swapped, i.e. the value becomes the key and the key becomes the value. This behavior is the opposite of the L<pairs|#method_pairs> method.', 'sigs' => ['multi method antipairs(Capture:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<True> if the C<Capture> contains at least one named or one positional argument.', 'sigs' => ['method Bool(Capture:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'Capture', 'kind' => 'method', 'summary' => 'Returns itself, i.e. the invocant.', 'sigs' => ['method Capture(Capture:D: --> Capture:D)'], 'returns' => ['Capture:D'] },
        { 'name' => 'Numeric', 'kind' => 'method', 'summary' => 'Returns the number of positional elements in the C<Capture>.', 'sigs' => ['method Numeric(Capture:D: --> Int:D)'], 'returns' => ['Int:D'] },
      ],
      'examples' => [
        { 'code' => 'class Capture { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $a = \\(42);                      # Capture with one positional arg
my $b = \\(1, 2, verbose => True);   # Capture with two positional args and one named arg
my $c = \\(1, 2, :verbose(True));    # same as before
my $c = \\(1, 2, \'verbose\' => True); # Capture with three positional args', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'sub greet(:$name, :$age) {
    "$name, $age"
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $d = \\(name => \'Mugen\', age => 19);   # OK
my $e = \\(:name(\'Jin\'), :age(20));       # OK
