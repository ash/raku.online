say ⅔.atan2(⅓);             # OUTPUT: «1.1071487177940904␤»', 'expect' => '1.24904577239825
1.1071487177940904
', 'routine' => 'atan2', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say 45.sec;                 # OUTPUT: «1.90359440740442␤»
