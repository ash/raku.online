', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %next-prime{Int} = 2 => 3, 3 => 5, 5 => 7, 7 => 11, 11 => 13;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Array %lists;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Array %next-primes{Int} = 2 => [3, 5], 11 => [13, 17];', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say % .classify-list: { $_ %% 2 ?? \'even\' !! \'odd\' }, ^10;
# OUTPUT: «{even => [0 2 4 6 8], odd => [1 3 5 7 9]}␤»

