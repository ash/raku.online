);', 'expect' => '', 'routine' => 'from-paragraphs', 'opts' => ':lang<raku> :preamble<use experimental :rakuast>', 'preamble' => 'use experimental :rakuast' },
        { 'code' => '$block.set-margin("    ");', 'expect' => '', 'routine' => 'set-margin', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => '$block.set-type("foo");', 'expect' => '', 'routine' => 'set-type', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => '$block.set-level(1);', 'expect' => '', 'routine' => 'set-level', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => '$block.set-config({
  numbered => RakuAST::Term::True.new;
});', 'expect' => '', 'routine' => 'set-config', 'opts' => ':preamble<my $block;use experimental :rakuast>', 'preamble' => 'my $block;use experimental :rakuast' },
        { 'code' => '$block.add-config(
  \'allow\',
