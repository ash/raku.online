    {
      'name' => 'Dateish',
      'file' => 'Dateish',
      'subkind' => 'role',
      'category' => 'basic',
      'subtitle' => 'Object that can be treated as a date',
      'declkind' => 'role',
      'consumers' => ['DateTime', 'Date'],
      'routines' => [
        { 'name' => 'year', 'kind' => 'method', 'summary' => 'Returns the year of the date.', 'sigs' => ['method year(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'month', 'kind' => 'method', 'summary' => 'Returns the month of the date (1..12).', 'sigs' => ['method month(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'day', 'kind' => 'method', 'summary' => 'Returns the day of the month of the date (1..31).', 'sigs' => ['method day(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'formatter', 'kind' => 'method', 'summary' => 'Returns the formatting function which is used for conversion to L<C<Str>|/type/Str>. If none was provided at object construction, a default formatter is used.  In that case the method will return a Callable type object. The formatting function is called by L<DateTime method Str|/type/DateTime#method_Str> with the invocant as its only argument.', 'sigs' => ['method formatter(Dateish:D:)'], 'returns' => [] },
        { 'name' => 'is-leap-year', 'kind' => 'method', 'summary' => 'Returns C<True> if the year of the Dateish object is a leap year.', 'sigs' => ['method is-leap-year(Dateish:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'day-of-month', 'kind' => 'method', 'summary' => 'Returns the day of the month of the date (1..31). Synonymous to the C<day> method.', 'sigs' => ['method day-of-month(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'day-of-week', 'kind' => 'method', 'summary' => 'Returns the day of the week, where 1 is Monday, 2 is Tuesday and Sunday is 7.', 'sigs' => ['method day-of-week(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'day-of-year', 'kind' => 'method', 'summary' => 'Returns the day of the year (1..366).', 'sigs' => ['method day-of-year(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'days-in-year', 'kind' => 'method', 'summary' => 'Returns the number of days in the year represented by the Dateish object: Available as of the 2022.12 release of the Rakudo compiler.', 'sigs' => ['method days-in-year(Dateish:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'days-in-month', 'kind' => 'method', 'summary' => 'Returns the number of days in the month represented by the Dateish object:', 'sigs' => ['method days-in-month(Dateish:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'week', 'kind' => 'method', 'summary' => 'Returns a list of two integers: the year, and the week number. This is because at the start or end of a year, the week may actually belong to the other year.', 'sigs' => ['method week()'], 'returns' => [] },
        { 'name' => 'week-number', 'kind' => 'method', 'summary' => 'Returns the week number (1..53) of the date specified by the invocant. The first week of the year is defined by ISO as the one which contains the fourth day of January. Thus, dates early in January often end up in the last week of the prior year, and similarly, the final few days of December may be placed in the first week of the next year.', 'sigs' => ['method week-number(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'week-year', 'kind' => 'method', 'summary' => 'Returns the week year of the date specified by the invocant. Normally C<week-year> is equal to C<Date.year>. Note however that dates early in January often end up in the last week of the prior year, and similarly, the final few days of December may be placed in the first week of the next year.', 'sigs' => ['method week-year(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'weekday-of-month', 'kind' => 'method', 'summary' => 'Returns a number (1..5) indicating the number of times a particular day-of-week has occurred so far during that month, the day itself included.', 'sigs' => ['method weekday-of-month(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'yyyy-mm-dd', 'kind' => 'method', 'summary' => 'Returns the date in C<YYYY-MM-DD> format (L<ISO 8601|https://en.wikipedia.org/wiki/ISO_8601>). The optional positional argument C<$sep>, which defaults to C«-», is a one-character separator placed between the different parts of the date.', 'sigs' => ['method yyyy-mm-dd(str $sep = "-" --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'mm-dd-yyyy', 'kind' => 'method', 'summary' => 'Returns the date in C<MM-DD-YYYY> format (L<Gregorian, month-day-year (MDY)|https://en.wikipedia.org/wiki/Calendar_date>). The optional positional argument C<$sep>, which defaults to C«-», is a one-character separator placed between the different parts of the date.', 'sigs' => ['method mm-dd-yyyy(str $sep = "-" --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'dd-mm-yyyy', 'kind' => 'method', 'summary' => 'Returns the date in C<DD-MM-YYYY> format (L<Gregorian, day-month-year (DMY)|https://en.wikipedia.org/wiki/Calendar_date>). The optional positional argument C<$sep>, which defaults to C«-», is a one-character separator placed between the different parts of the date.', 'sigs' => ['method dd-mm-yyyy(str $sep = "-" --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'daycount', 'kind' => 'method', 'summary' => 'Returns the number of days from the epoch Nov. 17, 1858, to the day of the invocant. The daycount returned by this method is the integral part of the L<Modified Julian Day|https://en.wikipedia.org/wiki/Julian_day> (MJD) which is used routinely by astronomers, geodesists, scientists, and others. The MJD convention is designed to facilitate simplified chronological calculations. The fractional part of the MJD', 'sigs' => ['method daycount(Dateish:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'IO', 'kind' => 'method', 'summary' => 'Returns an L<C<IO::Path>|/type/IO::Path> object representing the stringified value of the Dateish object: B<PORTABILITY NOTE:> some operating systems (e.g. Windows) do not permit colons (C<:>) in filenames, which would be present in L<C<IO::Path>|/type/IO::Path> created from a L<C<DateTime>|/type/DateTime> object.', 'sigs' => ['method IO(Dateish:D: --> IO::Path:D)'], 'returns' => ['IO::Path:D'] },
        { 'name' => 'earlier', 'kind' => 'method', 'summary' => 'Returns an object based on the current one, but with a date delta towards the past applied. Unless the given unit is C<second> or C<seconds>, the given value will be converted to an L<C<Int>|/type/Int>. See L<C<.later>|/type/Dateish#method_later> for usage. It will generally be used through classes that implement this role, L<C<Date>|/type/Date> or L<C<DateTime>|/type/DateTime> If the resultant time has value C<60> for seconds, yet no leap second', 'sigs' => ['multi method earlier(Dateish:D: *%unit)', 'multi method earlier(Dateish:D: @pairs)'], 'returns' => [] },
        { 'name' => 'later', 'kind' => 'method', 'summary' => 'Returns an object based on the current one (belonging to any class that mixes this role in), but with a time delta applied. The time delta can be passed as a named argument where the argument name is the unit. Unless the given unit is C<second> or C<seconds>, the given value will be converted to an L<C<Int>|/type/Int>. Allowed units are C<second>, C<seconds>, C<minute>, C<minutes>, C<hour>, C<hours>, C<day>, C<days>, C<week>, C<weeks>, C<month>, C<months>, C<year>,', 'sigs' => ['multi method later(DateTime:D: *%unit)'], 'returns' => [] },
      ],
      'examples' => [
