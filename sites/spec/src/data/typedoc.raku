(eggs bacon)
', 'routine' => 'pick', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say $breakfast.total;                             # OUTPUT: «4␤»
say $breakfast.pick(*);                           # OUTPUT: «(bacon bacon bacon eggs)␤»', 'expect' => '4
(bacon bacon bacon eggs)
', 'routine' => 'pick', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = bag <eggs bacon bacon bacon>;
say $breakfast.pickpairs;                         # OUTPUT: «eggs => 1␤»
say $breakfast.pickpairs(1);                      # OUTPUT: «(bacon => 3)␤»
