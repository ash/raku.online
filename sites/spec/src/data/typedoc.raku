        { 'name' => 'workaround', 'kind' => 'method', 'summary' => 'It helpfully shows a possible workaround for the missing feature, if it\'s been declared.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'message', 'kind' => 'method', 'summary' => 'Returns the message including the above properties.', 'sigs' => [], 'returns' => [] },
      ],
      'examples' => [
