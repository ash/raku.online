        { 'code' => '$declarator.add-leading("additional");', 'expect' => '', 'routine' => 'add-leading', 'opts' => ':preamble<my $declarator>', 'preamble' => 'my $declarator' },
        { 'code' => '$declarator.set-trailing;  # reset
