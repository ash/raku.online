        { 'name' => 'connect-path', 'kind' => 'method', 'summary' => 'Attempts to connect to a unix domain stream socket specified by C<$path>, returning a L<C<Promise>|/type/Promise> that will either be kept with a connected C<IO::Socket::Async> or broken if the connection cannot be made.', 'sigs' => ['method connect-path(Str $path --> Promise)'], 'returns' => ['Promise'] },
        { 'name' => 'listen', 'kind' => 'method', 'summary' => 'Creates a listening socket on the specified C<$host> and C<$port>, returning a L<C<Supply>|/type/Supply> to which the accepted client C<IO::Socket::Async>s will be emitted. This L<C<Supply>|/type/Supply> should be tapped start listening for client connections.  You can set C<$port> to C<0> if you want the operating system to find one for you. The L<C<IO::Socket::Async::ListenSocket>|/type/IO::Socket::Async::ListenSocket>', 'sigs' => ['method listen(Str $host, Int $port --> Supply)'], 'returns' => ['Supply'] },
        { 'name' => 'listen-path', 'kind' => 'method', 'summary' => 'Creates a unix domain stream listening socket on the specified C<$path>, returning a L<C<Supply>|/type/Supply> to which the accepted client C<IO::Socket::Async>s will be emitted. This L<C<Supply>|/type/Supply> should be tapped start listening for client connections. The L<C<IO::Socket::Async::ListenSocket>|/type/IO::Socket::Async::ListenSocket> returned by calling the L<tap|/type/Supply#method_tap> method on the supply', 'sigs' => ['method listen-path(Str $path)'], 'returns' => [] },
        { 'name' => 'udp', 'kind' => 'method', 'summary' => 'Returns an initialized C<IO::Socket::Async> client object that is configured to send UDP messages using C<print-to> or C<write-to>.  The C<:broadcast> adverb will set the C<SO_BROADCAST> option which will allow the socket to send packets to a broadcast address.', 'sigs' => ['method udp(IO::Socket::Async:U: :$broadcast --> IO::Socket::Async)'], 'returns' => ['IO::Socket::Async'] },
        { 'name' => 'bind-udp', 'kind' => 'method', 'summary' => 'This returns an initialized C<IO::Socket::Async> server object that is configured to receive UDP messages sent to the specified C<$host> and C<$port> and is equivalent to C<listen> for a TCP socket.  The C<:broadcast> adverb can be specified to allow the receipt of messages sent to the broadcast address.', 'sigs' => ['method bind-udp(IO::Socket::Async:U: Str() $host, Int() $port, :$broadcast --> IO::Socket::Async)'], 'returns' => ['IO::Socket::Async'] },
        { 'name' => 'print', 'kind' => 'method', 'summary' => 'Attempt to send C<$str> on the C<IO::Socket::Async> that will have been obtained indirectly via C<connect> or C<listen>, returning a L<C<Promise>|/type/Promise> that will be kept with the number of bytes sent or broken if there was an error sending.', 'sigs' => ['method print(IO::Socket::Async:D: Str $str --> Promise)'], 'returns' => ['Promise'] },
        { 'name' => 'print-to', 'kind' => 'method', 'summary' => 'This is the equivalent of C<print> for UDP sockets that have been created with the C<udp> method, it will try send a UDP message of C<$str> to the specified C<$host> and C<$port> returning a L<C<Promise>|/type/Promise> that will be kept when the data is successfully sent or broken if it was unable to send the data. In order to send to a broadcast address the C<:broadcast> flag must have been specified when', 'sigs' => ['method print-to(IO::Socket::Async:D: Str() $host, Int() $port, Str() $str --> Promise)'], 'returns' => ['Promise'] },
        { 'name' => 'write', 'kind' => 'method', 'summary' => 'This method will attempt to send the bytes in C<$b> on the C<IO::Socket::Async> that will have been obtained indirectly via C<connect> or C<listen>, returning a L<C<Promise>|/type/Promise> that will be kept with the number of bytes sent or broken if there was an error sending.', 'sigs' => ['method write(IO::Socket::Async:D: Blob $b --> Promise)'], 'returns' => ['Promise'] },
        { 'name' => 'write-to', 'kind' => 'method', 'summary' => 'This is the equivalent of C<write> for UDP sockets that have been created with the C<udp> method. It will try send a UDP message comprised of the bytes in the L<C<Blob>|/type/Blob>  C<$b> to the specified C<$host> and C<$port> returning a L<C<Promise>|/type/Promise> that will be kept when the data is successfully sent or broken if it was unable to send the data. In order to send to a broadcast address the C<:broadcast> flag', 'sigs' => ['method write-to(IO::Socket::Async:D: Str() $host, Int() $port, Blob $b --> Promise)'], 'returns' => ['Promise'] },
        { 'name' => 'Supply', 'kind' => 'method', 'summary' => 'Returns a L<C<Supply>|/type/Supply> which can be tapped to obtain the data read from the connected C<IO::Socket::Async> as it arrives.  By default the data will be emitted as characters, but if the C<:bin> adverb is provided a L<C<Buf>|/type/Buf> of bytes will be emitted instead, optionally in this case you can provide your own L<C<Buf>|/type/Buf> with the C<:buf> named parameter. A UDP socket in character mode will treat each packet as a complete', 'sigs' => ['method Supply(:$bin, :$buf = buf8.new --> Supply)'], 'returns' => ['Supply'] },
        { 'name' => 'close', 'kind' => 'method', 'summary' => 'Close the connected client C<IO::Socket::Async> which will have been obtained from the C<listen> L<C<Supply>|/type/Supply> or the C<connect> L<C<Promise>|/type/Promise>. In order to close the underlying listening socket created by C<listen> you can C<close> the L<C<IO::Socket::Async::ListenSocket>|/type/IO::Socket::Async::ListenSocket>. See L<listen|#method_listen> for examples.', 'sigs' => ['method close(IO::Socket::Async:D: )'], 'returns' => [] },
        { 'name' => 'socket-host', 'kind' => 'method', 'summary' => 'Returns the IP address of the local end of this socket.', 'sigs' => ['method socket-host(--> Str)'], 'returns' => ['Str'] },
        { 'name' => 'peer-host', 'kind' => 'method', 'summary' => 'Returns the IP address of the remote end of this socket.', 'sigs' => ['method peer-host(--> Str)'], 'returns' => ['Str'] },
