        { 'name' => 'get', 'kind' => 'method', 'summary' => 'Reads a line from the socket and returns it as of type L<C<Str>|/type/Str>. Return L<C<Nil>|/type/Nil> on end-of-file (EOF).', 'sigs' => ['method get()'], 'returns' => [] },
