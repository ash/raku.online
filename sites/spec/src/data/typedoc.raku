    {
      'name' => 'Proc::Async',
      'file' => 'Async',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'Running process (asynchronous interface)',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Creates a new C<Proc::Async> object with external program name or path C<$path> and the command line arguments C<@args>. If C<:w> is passed to C<new>, then a pipe to the external program\'s standard input stream (C<stdin>) is opened, to which you can write with C<write> and C<say>. The C<:enc> specifies L<the encoding|/type/IO::Handle#method_encoding> for streams (can still be overridden in individual methods) and defaults', 'sigs' => ['multi method new(*@ ($path, *@args), :$w, :$enc, :$translate-nl, :$arg0,', 'multi method new(   :$path, :@args,  :$w, :$enc, :$translate-nl, :$arg0,'], 'returns' => [] },
        { 'name' => 'stdout', 'kind' => 'method', 'summary' => 'Returns the L<C<Supply>|/type/Supply> for the external program\'s standard output stream. If C<:bin> is passed, the standard output is passed along in binary as L<C<Blob>|/type/Blob>, otherwise it is interpreted as UTF-8, decoded, and passed along as L<C<Str>|/type/Str>. You must call C<stdout> before you call L<C<.start>|/type/Proc::Async#method_start>. Otherwise an exception of class L<C<X::Proc::Async::TapBeforeSpawn>|/type/X::Proc::Async::TapBeforeSpawn> is', 'sigs' => ['method stdout(Proc::Async:D: :$bin --> Supply:D)'], 'returns' => ['Supply:D'] },
        { 'name' => 'stderr', 'kind' => 'method', 'summary' => 'Returns the L<C<Supply>|/type/Supply> for the external program\'s standard error stream. If C<:bin> is passed, the standard error is passed along in binary as L<C<Blob>|/type/Blob>, otherwise it is interpreted as UTF-8, decoded, and passed along as L<C<Str>|/type/Str>. You must call C<stderr> before you call L<C<.start>|/type/Proc::Async#method_start>. Otherwise an exception of class L<C<X::Proc::Async::TapBeforeSpawn>|/type/X::Proc::Async::TapBeforeSpawn>', 'sigs' => ['method stderr(Proc::Async:D: :$bin --> Supply:D)'], 'returns' => ['Supply:D'] },
        { 'name' => 'bind-stdin', 'kind' => 'method', 'summary' => 'Sets a handle (which must be opened) or a C<Pipe> as a source of C<STDIN>. The C<STDIN> of the target process must be writable or L<C<X::Proc::Async::BindOrUse>|/type/X::Proc::Async::BindOrUse> will be thrown. This is equivalent to and will print the content of C</etc/profile> to standard output.', 'sigs' => ['multi method bind-stdin(IO::Handle:D $handle)', 'multi method bind-stdin(Proc::Async::Pipe:D $pipe)'], 'returns' => [] },
        { 'name' => 'bind-stdout', 'kind' => 'method', 'summary' => 'Redirects STDOUT of the target process to a handle (which must be opened). If STDOUT is closed L<C<X::Proc::Async::BindOrUse>|/type/X::Proc::Async::BindOrUse> will be thrown. This program will pipe the output of the C<ls> shell command to a file called C<ls.out>, which we are opened for reading.', 'sigs' => ['method bind-stdout(IO::Handle:D $handle)'], 'returns' => [] },
        { 'name' => 'bind-stderr', 'kind' => 'method', 'summary' => 'Redirects C<STDERR> of the target process to a handle (which must be opened). If C<STDERR> is closed L<C<X::Proc::Async::BindOrUse>|/type/X::Proc::Async::BindOrUse> will be thrown.', 'sigs' => ['method bind-stderr(IO::Handle:D $handle)'], 'returns' => [] },
        { 'name' => 'w', 'kind' => 'method', 'summary' => 'Returns a true value if C<:w> was passed to the constructor, that is, if the external program is started with its input stream made available to output to the program through the C<.print>, C<.say> and C<.write> methods.', 'sigs' => ['method w(Proc::Async:D:)'], 'returns' => [] },
        { 'name' => 'start', 'kind' => 'method', 'summary' => 'Initiates spawning of the external program. Returns a L<C<Promise>|/type/Promise> that will be kept with a L<C<Proc>|/type/Proc> object once the external program exits or broken if the program cannot be started. Optionally, you can use a scheduler instead of the default C<$*SCHEDULER>, or change the environment the process is going to run in via the named argument C<:$ENV> or the directory via the named argument C<:$cwd>.', 'sigs' => ['method start(Proc::Async:D: :$scheduler = $*SCHEDULER, :$ENV, :$cwd = $*CWD --> Promise)'], 'returns' => ['Promise'] },
        { 'name' => 'started', 'kind' => 'method', 'summary' => 'Returns C<False> before C<.start> has been called, and C<True> afterwards.', 'sigs' => ['method started(Proc::Async:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'ready', 'kind' => 'method', 'summary' => 'Returns a L<C<Promise>|/type/Promise> that will be kept once the process has successfully started. L<C<Promise>|/type/Promise> will be broken if the program fails to start. B<Implementation-specific note:> Starting from Rakudo 2018.04, the returned promise will hold the process id (PID).', 'sigs' => ['method ready(Proc::Async:D: --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'pid', 'kind' => 'method', 'summary' => 'Equivalent to L<ready|/routine/ready>. Returns a L<C<Promise>|/type/Promise> that will be kept once the process has successfully started. L<C<Promise>|/type/Promise> will be broken if the program fails to start. Returned promise will hold the process id (PID). B<Implementation-specific note:> Available starting from Rakudo 2018.04.', 'sigs' => ['method pid(Proc::Async:D: --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'path', 'kind' => 'method', 'summary' => 'B<Deprecated as of v6.d>. Use L<command|/routine/command> instead. Returns the name and/or path of the external program that was passed to the C<new> method as first argument.', 'sigs' => ['method path(Proc::Async:D:)'], 'returns' => [] },
        { 'name' => 'args', 'kind' => 'method', 'summary' => 'B<Deprecated as of v6.d>. Use L<command|/routine/command> instead. Returns the command line arguments for the external programs, as passed to the C<new> method.', 'sigs' => ['method args(Proc::Async:D: --> Positional:D)'], 'returns' => ['Positional:D'] },
        { 'name' => 'command', 'kind' => 'method', 'summary' => 'I<Available as of v6.d.> Returns the command and arguments used for this C<Proc::Async> object:', 'sigs' => ['method command(Proc::Async:D: --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'write', 'kind' => 'method', 'summary' => 'Write the binary data in C<$b> to the standard input stream of the external program. Returns a L<C<Promise>|/type/Promise> that will be kept once the data has fully landed in the input buffer of the external program. The C<Proc::Async> object must be created for writing (with C<Proc::Async.new(:w, $path, @args)>). Otherwise an L<C<X::Proc::Async::OpenForWriting>|/type/X::Proc::Async::OpenForWriting> exception will the thrown.', 'sigs' => ['method write(Proc::Async:D: Blob:D $b, :$scheduler = $*SCHEDULER --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'print', 'kind' => 'method', 'summary' => 'Write the text data in C<$str> to the standard input stream of the external program, encoding it as UTF-8. Returns a L<C<Promise>|/type/Promise> that will be kept once the data has fully landed in the input buffer of the external program. The C<Proc::Async> object must be created for writing (with C<Proc::Async.new(:w, $path, @args)>). Otherwise an L<C<X::Proc::Async::OpenForWriting>|/type/X::Proc::Async::OpenForWriting> exception', 'sigs' => ['method print(Proc::Async:D: Str() $str, :$scheduler = $*SCHEDULER)'], 'returns' => [] },
        { 'name' => 'put', 'kind' => 'method', 'summary' => 'Does a C<.join> on the output, adds a newline, and calls C<.print> on it. Will throw if it\'s not started, or not open for writing.', 'sigs' => ['method put(Proc::Async:D: \\x, |c)'], 'returns' => [] },
        { 'name' => 'say', 'kind' => 'method', 'summary' => 'Calls method C<gist> on the C<$output>, adds a newline, encodes it as UTF-8, and sends it to the standard input stream of the external program, encoding it as UTF-8. Returns a L<C<Promise>|/type/Promise> that will be kept once the data has fully landed in the input buffer of the external program. The C<Proc::Async> object must be created for writing (with C<Proc::Async.new(:w, $path, @args)>). Otherwise an', 'sigs' => ['method say(Proc::Async:D: $output, :$scheduler = $*SCHEDULER)'], 'returns' => [] },
        { 'name' => 'pty', 'kind' => 'method', 'summary' => 'Returns whether the child process was created with a PTY.', 'sigs' => ['method pty(--> Bool)'], 'returns' => ['Bool'] },
        { 'name' => 'resize-pty', 'kind' => 'method', 'summary' => 'Changes the size of the PTY the child is attached to.', 'sigs' => ['method resize-pty(Int :$cols, Int :$rows)'], 'returns' => [] },
        { 'name' => 'Supply', 'kind' => 'method', 'summary' => 'Returns a L<C<Supply>|/type/Supply> of merged L<stdout|/routine/stdout> and L<stderr|/routine/stderr> streams. If C<:$bin> named argument is provided, the L<C<Supply>|/type/Supply> will be binary, producing L<C<Buf>|/type/Buf> objects, otherwise, it will be in character mode, producing L<C<Str>|/type/Str> objects and C<:$enc> named argument can specify L<encoding|/routine/encoding> to use. The C<:$translate-nl> option specifies whether new line endings should be', 'sigs' => ['multi method Supply(Proc::Async:D: :$bin!)', 'multi method Supply(Proc::Async:D: :$enc, :$translate-nl)'], 'returns' => [] },
        { 'name' => 'close-stdin', 'kind' => 'method', 'summary' => 'Closes the standard input stream of the external program. Programs that read from STDIN often only terminate when their input stream is closed. So if waiting for the promise from L<C<.start>|/type/Proc::Async#method_start> hangs (for a program opened for writing), it might be a forgotten C<close-stdin>. The C<Proc::Async> object must be created for writing (with C<Proc::Async.new(:w, $path, @args)>). Otherwise an', 'sigs' => ['method close-stdin(Proc::Async:D: --> True)'], 'returns' => ['True'] },
        { 'name' => 'kill', 'kind' => 'method', 'summary' => 'Sends a signal to the running program. The signal can be a signal name ("KILL" or "SIGKILL"), an integer (9) or an element of the L<C<Signal>|/type/Signal> enum (Signal::SIGKILL); by default and with no argument, the C<SIGHUP> signal will be used.', 'sigs' => ['multi method kill(Proc::Async:D: Signal:D \\signal = SIGHUP)', 'multi method kill(Proc::Async:D: Int:D \\signal)', 'multi method kill(Proc::Async:D: Str:D \\signal)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Proc::Async {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $file = ‘foo’.IO;
spurt $file, “and\\nCamelia\\n♡\\nme\\n”;

my $proc = Proc::Async.new: :w, ‘tac’, ‘--’, $file, ‘-’;
# my $proc = Proc::Async.new: :w, ‘sleep’, 15; # uncomment to try timeouts

react {
whenever $proc.stdout.lines { # split input on \\r\\n, \\n, and \\r
    say ‘line: ’, $_
}
whenever $proc.stderr { # chunks
    say ‘stderr: ’, $_
}
whenever $proc.ready {
    say ‘PID: ’, $_ # Only in Rakudo 2018.04 and newer, otherwise Nil
}
whenever $proc.start {
    say ‘Proc finished: exitcode=’, .exitcode, ‘ signal=’, .signal;
    done # gracefully jump from the react block
}
whenever $proc.print: “I\\n♥\\nCamelia\\n” {
    $proc.close-stdin
}
whenever signal(SIGTERM).merge: signal(SIGINT) {
    once {
        say ‘Signal received, asking the process to stop’;
        $proc.kill; # sends SIGHUP, change appropriately
        whenever signal($_).zip: Promise.in(2).Supply {
            say ‘Kill it!’;
            $proc.kill: SIGKILL
        }
    }
}
whenever Promise.in(5) {
    say ‘Timeout. Asking the process to stop’;
    $proc.kill; # sends SIGHUP, change appropriately
    whenever Promise.in(2) {
        say ‘Timeout. Forcing the process to stop’;
        $proc.kill: SIGKILL
    }
}
}

say ‘Program finished’;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'line: me
line: ♡
line: Camelia
line: and
line: Camelia
line: ♥
line: I
Proc finished: exitcode=0 signal=0
Program finished', 'expect' => '', 'routine' => '', 'opts' => ':lang<text>', 'preamble' => '' },
        { 'code' => '# command with arguments
my $proc = Proc::Async.new(\'echo\', \'foo\', \'bar\');', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# subscribe to new output from out and err handles:
$proc.stdout.tap(-> $v { print "Output: $v" }, quit => { say \'caught exception \' ~ .^name });
$proc.stderr.tap(-> $v { print "Error:  $v" });', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "Starting...";
my $promise = $proc.start;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# wait for the external program to terminate
await $promise;
say "Done.";', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'Starting...
Output: foo bar
Done.', 'expect' => '', 'routine' => '', 'opts' => ':lang<text>', 'preamble' => '' },
        { 'code' => 'my $prog = Proc::Async.new(:w, \'hexdump\', \'-C\');
my $promise = $prog.start;
await $prog.write(Buf.new(12, 42));
$prog.close-stdin;
await $promise;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $proc-echo = Proc::Async.new: \'echo\', \'Hello, world\';
my $proc-cat = Proc::Async.new: \'cat\', \'-n\';
$proc-cat.bind-stdin: $proc-echo.stdout;
await $proc-echo.start, $proc-cat.start;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '                 :$win-verbatim-args = False, :$pty,
                 :$started = False --> Proc::Async:D)
                 :$win-verbatim-args = False, :$pty,
                 :$started = False --> Proc::Async:D)', 'expect' => '', 'routine' => 'new', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $proc = Proc::Async.new(:r, \'echo\', \'Raku\');
$proc.stdout.tap( -> $str {
    say "Got output \'$str\' from the external program";
});
my $promise = $proc.start;
await $promise;', 'expect' => '', 'routine' => 'stdout', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $proc = Proc::Async.new(:r, \'echo\', \'Raku\');
$proc.stderr.tap( -> $str {
    say "Got error \'$str\' from the external program";
});
my $promise = $proc.start;
await $promise;', 'expect' => '', 'routine' => 'stderr', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $p = Proc::Async.new("cat", :in);
my $h = "/etc/profile".IO.open;
$p.bind-stdin($h);
$p.start;', 'expect' => '', 'routine' => 'bind-stdin', 'opts' => '', 'preamble' => '' },
        { 'code' => 'cat < /etc/profile', 'expect' => '', 'routine' => 'bind-stdin', 'opts' => ':lang<shell>', 'preamble' => '' },
        { 'code' => 'my $p = Proc::Async.new("ls", :out);
my $h = "ls.out".IO.open(:w);
$p.bind-stdout($h);
$p.start;', 'expect' => '', 'routine' => 'bind-stdout', 'opts' => '', 'preamble' => '' },
