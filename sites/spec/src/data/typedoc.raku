}', 'expect' => '', 'routine' => 'next', 'opts' => '', 'preamble' => '' },
        { 'code' => '# OUTPUT: «5 6 7 8 9 10 »', 'expect' => '5 6 7 8 9 10 ', 'routine' => 'next', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $has-repeated = False;', 'expect' => '', 'routine' => 'redo', 'opts' => '', 'preamble' => '' },
