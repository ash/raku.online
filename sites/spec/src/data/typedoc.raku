    {
      'name' => 'RakuAST::Doc::DeclaratorTarget',
      'file' => 'DeclaratorTarget',
      'subkind' => 'role',
      'category' => 'basic',
      'subtitle' => 'Provide leading/trailing doc functionality',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'set-WHY', 'kind' => 'method', 'summary' => 'Set the L<C<RakuAST::Doc::Declarator>|/type/RakuAST::Doc::Declarator> object to be associated.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'cut-WHY', 'kind' => 'method', 'summary' => 'Removes the L<C<RakuAST::Doc::Declarator>|/type/RakuAST::Doc::Declarator> object, if any.  Intended to be used when deparsing / stringification to prevent an infinite loop because the L<C<RakuAST::Doc::Declarator>|/type/RakuAST::Doc::Declarator> object points to its target, and the other way around.  Usually called on a clone of the original target.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-leading', 'kind' => 'method', 'summary' => 'Set the leading documentation.  If no arguments are specified, reset to not having any leading documentation.  Creates a L<C<RakuAST::Doc::Declarator>|/type/RakuAST::Doc::Declarator> object and sets it in the C<.WHY> if there wasn\'t one already.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'add-leading', 'kind' => 'method', 'summary' => 'Add a line to the leading documentation. Creates a L<C<RakuAST::Doc::Declarator>|/type/RakuAST::Doc::Declarator> object and sets it in the C<.WHY> if there wasn\'t one already.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-trailing', 'kind' => 'method', 'summary' => 'Set the trailing documentation.  If no arguments are specified, reset to not having any trailing documentation.  Creates a L<C<RakuAST::Doc::Declarator>|/type/RakuAST::Doc::Declarator> object and sets it in the C<.WHY> if there wasn\'t one already.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'add-trailing', 'kind' => 'method', 'summary' => 'Add a line to the trailing documentation. Creates a L<C<RakuAST::Doc::Declarator>|/type/RakuAST::Doc::Declarator> object and sets it in the C<.WHY> if there wasn\'t one already.', 'sigs' => [], 'returns' => [] },
      ],
      'examples' => [
