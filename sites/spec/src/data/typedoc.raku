        { 'code' => 'say greet |$d;                # OUTPUT: «Mugen, 19␤»
say greet |$e;                # OUTPUT: «Jin, 20␤»', 'expect' => 'Mugen, 19
Jin, 20
', 'routine' => '', 'opts' => ':preamble<my $d;my $e; sub greet {...}>', 'preamble' => 'my $d;my $e; sub greet {...}' },
        { 'code' => 'my $x = \\(4, 2, 3, -2);
