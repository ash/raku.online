ä
o
ö
', 'routine' => 'collate', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $supply = Supply.from-list(1..5).reduce({$^a + $^b});
$supply.tap(-> $v { say "$v" }); # OUTPUT: «15␤»', 'expect' => '15
', 'routine' => 'reduce', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $s = Supply.from-list(1, 2, 3);
$s.tap(&say);           # OUTPUT: «1␤2␤3␤»', 'expect' => '1
