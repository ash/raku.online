        { 'code' => 'my $WHY := $target.cut-WHY;', 'expect' => '', 'routine' => 'cut-WHY', 'opts' => ':preamble<my $target>', 'preamble' => 'my $target' },
        { 'code' => '$target.set-leading;  # reset
