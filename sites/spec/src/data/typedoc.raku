      'name' => 'IO::Special',
      'file' => 'Special',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'Path to special I/O device',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Takes a single required attribute L<what|/routine/what>. It is unlikely that you will ever need to construct one of these objects yourself.', 'sigs' => ['method new(:$!what!)'], 'returns' => [] },
        { 'name' => 'what', 'kind' => 'method', 'summary' => 'Returns one of the strings C«\'<STDIN>\'», C«\'<STDOUT>\'», or C«\'<STDERR>\'», specifying the type of the special IO device.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'WHICH', 'kind' => 'method', 'summary' => 'This returns a string that identifies the object. The string is composed by the type of the instance (C<IO::Special>) and the C<what> attribute:', 'sigs' => ['method WHICH(IO::Special:D: --> Str)'], 'returns' => ['Str'] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'This returns C«\'<STDIN>\'», C«\'<STDOUT>\'», or C«\'<STDERR>\'» as appropriate.', 'sigs' => ['method Str(IO::Special:D:)'], 'returns' => [] },
        { 'name' => 'IO', 'kind' => 'method', 'summary' => 'Returns the invocant.', 'sigs' => ['method IO(IO::Special:D: --> IO::Special)'], 'returns' => ['IO::Special'] },
        { 'name' => 'e', 'kind' => 'method', 'summary' => 'The \'exists\' file test operator, always returns C<True>.', 'sigs' => ['method e(IO::Special:D: --> True)'], 'returns' => ['True'] },
        { 'name' => 'd', 'kind' => 'method', 'summary' => 'The \'directory\' file test operator, always returns C<False>.', 'sigs' => ['method d(IO::Special:D: --> False)'], 'returns' => ['False'] },
        { 'name' => 'f', 'kind' => 'method', 'summary' => 'The \'file\' file test operator, always returns C<False>.', 'sigs' => ['method f(IO::Special:D: --> False)'], 'returns' => ['False'] },
        { 'name' => 's', 'kind' => 'method', 'summary' => 'The \'size\' file test operator, always returns C<0>.', 'sigs' => ['method s(IO::Special:D: --> 0)'], 'returns' => ['0'] },
        { 'name' => 'l', 'kind' => 'method', 'summary' => 'The \'symbolic links\' file test operator, always returns C<False>.', 'sigs' => ['method l(IO::Special:D: --> False)'], 'returns' => ['False'] },
        { 'name' => 'r', 'kind' => 'method', 'summary' => 'The \'read access\' file test operator, returns C<True> if and only if this instance represents the standard input handle(C«<STDIN>»).', 'sigs' => ['method r(IO::Special:D: --> Bool)'], 'returns' => ['Bool'] },
        { 'name' => 'w', 'kind' => 'method', 'summary' => 'The \'write access\' file test operator, returns C<True> only if this instance represents either the standard output (C«<STOUT>») or the standard error (C«<STDERR>») handle.', 'sigs' => ['method w(IO::Special:D: --> Bool)'], 'returns' => ['Bool'] },
        { 'name' => 'x', 'kind' => 'method', 'summary' => 'The \'execute access\' file test operator, always returns C<False>.', 'sigs' => ['method x(IO::Special:D: --> False)'], 'returns' => ['False'] },
        { 'name' => 'modified', 'kind' => 'method', 'summary' => 'The last modified time for the filehandle. It always returns an L«C<Instant>|/type/Instant» type object.', 'sigs' => ['method modified(IO::Special:D: --> Instant)'], 'returns' => ['Instant'] },
        { 'name' => 'accessed', 'kind' => 'method', 'summary' => 'The last accessed time for the filehandle. It always returns an L«C<Instant>|/type/Instant» type object.', 'sigs' => ['method accessed(IO::Special:D: --> Instant)'], 'returns' => ['Instant'] },
        { 'name' => 'changed', 'kind' => 'method', 'summary' => 'The last changed time for the filehandle. It always returns an L«C<Instant>|/type/Instant» type object.', 'sigs' => ['method changed(IO::Special:D: --> Instant)'], 'returns' => ['Instant'] },
        { 'name' => 'mode', 'kind' => 'method', 'summary' => 'The mode for the filehandle, it always returns L<C<Nil>|/type/Nil>', 'sigs' => ['method mode(IO::Special:D: --> Nil)'], 'returns' => ['Nil'] },
      ],
