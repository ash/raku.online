    {
      'name' => 'IO::Spec::Unix',
      'file' => 'Unix',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'Platform specific operations on file and directory paths for POSIX',
      'declkind' => 'class',
      'children' => ['IO::Spec::Win32', 'IO::Spec::Cygwin', 'IO::Spec::QNX'],
      'routines' => [
        { 'name' => 'abs2rel', 'kind' => 'method', 'summary' => 'Returns a string that represents C<$path>, but relative to C<$base> path. Both C<$path> and C<$base> may be relative paths. C<$base> defaults to C<$*CWD>.', 'sigs' => ['method abs2rel(IO::Path:D $path, IO::Path:D $base = $*CWD --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'basename', 'kind' => 'method', 'summary' => 'Takes a path as a string and returns a possibly-empty portion after the last slash:', 'sigs' => ['method basename(Str:D $path --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'canonpath', 'kind' => 'method', 'summary' => 'Returns a string that is a canonical representation of C<$path>. If C<:$parent> is set to true, will also clean up references to parent directories. B<NOTE:> the routine does not access the filesystem, so no symlinks are followed.', 'sigs' => ['method canonpath(Str() $path, :$parent --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'catdir', 'kind' => 'method', 'summary' => 'Concatenates multiple path fragments and returns the canonical representation of the resultant path as a string. The C<@parts> are L«C<Str>|/type/Str» objects and are allowed to contain path separators.', 'sigs' => ['method catdir (*@parts --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'catfile', 'kind' => 'method', 'summary' => 'Alias for L«C<catdir>|/routine/catdir».', 'sigs' => [], 'returns' => [] },
        { 'name' => 'catpath', 'kind' => 'method', 'summary' => 'Takes two path fragments and concatenates them, adding or removing a path separator, if necessary. The first argument is ignored (it exists to maintain consistent interface with other L«C<IO::Spec>|/type/IO::Spec» types for systems that have volumes).', 'sigs' => ['method catpath ($, Str:D $part1, Str:D $part2 --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'curdir', 'kind' => 'method', 'summary' => 'Returns a string representing the current directory:', 'sigs' => ['method curdir()'], 'returns' => [] },
        { 'name' => 'curupdir', 'kind' => 'method', 'summary' => 'Returns a L«C<Block>|/type/Block» taking an argument. This block returns C<True> if its argument is neither the string representing the current directory nor the string representing the directory one up from the current one.  It returns C<False> otherwise. This block is intended to be used with L<smartmatching|/language/operators#infix_~~>. Neither C<foo> nor C<bar> are equal to the representation of the current', 'sigs' => ['method curupdir()'], 'returns' => [] },
        { 'name' => 'devnull', 'kind' => 'method', 'summary' => 'Returns the string C<"/dev/null"> representing the L<"Null device"|https://en.wikipedia.org/wiki/Null_device>:', 'sigs' => ['method devnull(--> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'dir-sep', 'kind' => 'method', 'summary' => 'Returns the string C<"/"> representing canonical directory separator character.', 'sigs' => ['method dir-sep(--> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'extension', 'kind' => 'method', 'summary' => 'B<NOTE:> Most users would want to use the higher-level routine L«C<IO::Path.extension>|/type/IO::Path#method_extension» instead of this lower-level version. Takes a string representing a base name and returns the characters after the last dot (C<".">), or empty string if no dots are present. The routine makes no attempt to detect path separators and will return everything after the last dot.', 'sigs' => ['method extension(Str:D $path --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'is-absolute', 'kind' => 'method', 'summary' => 'Returns C<True> if the C<$path> starts with a slash (C<"/">), even if it has combining character on it:', 'sigs' => ['method is-absolute(Str:D $path --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'join', 'kind' => 'method', 'summary' => 'Similar to L«C<catpath>|/routine/catpath», takes two path fragments and concatenates them, adding or removing a path separator, if necessary, except it will return just C<$file> if both C<$dir> and C<$file> are string C<\'/\'> or if C<$dir> is the string C<\'.\'>. The first argument is ignored (it exists to maintain consistent interface with other L<C<IO::Spec>|/type/IO::Spec> types for systems that have volumes).', 'sigs' => ['method join ($, Str:D $dir, Str:D $file --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'path', 'kind' => 'method', 'summary' => 'Splits the value of C«%*ENV<PATH>» on colons (C<":">), replaces empty parts with C<".">, and returns a L<C<Seq>|/type/Seq> with each of the resultant parts. Returns an empty L<C<Seq>|/type/Seq> if C«%*ENV<PATH>» is not set or is an empty string.', 'sigs' => ['method path(--> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'rel2abs', 'kind' => 'method', 'summary' => 'Returns a string representing C<$path> converted to absolute path, based at C<$base>, which defaults to C<$*CWD>. If C<$base> is not an absolute path, it will be made absolute relative to C<$*CWD>, unless C<$*CWD> and C<$base> are the same.', 'sigs' => ['method rel2abs(Str() $path, $base = $*CWD --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'rootdir', 'kind' => 'method', 'summary' => 'Returns string C<\'/\'>, representing root directory.', 'sigs' => ['method rootdir(--> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'split', 'kind' => 'method', 'summary' => 'Creates an L«C<IO::Path::Parts>|/type/IO::Path::Parts» for C<$path>, with an empty string as its C<volume> attribute\'s value. B<Note>: Before Rakudo release 2020.06 this method split the given C<$path> into "volume", "dirname", and "basename" and returned the result as a L<C<List>|/type/List> of three L<C<Pair>|/type/Pair>s, in that order.', 'sigs' => ['method split(IO::Spec::Unix: Cool:D $path)'], 'returns' => [] },
        { 'name' => 'splitdir', 'kind' => 'method', 'summary' => 'Splits the given C<$path> on slashes.', 'sigs' => ['method splitdir(Cool:D $path --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'splitpath', 'kind' => 'method', 'summary' => 'Splits the given C<$path> into a list of 3 strings: volume, dirname, and file. The volume is always an empty string, returned for API compatibility with other L<C<IO::Spec>|/type/IO::Spec> types. If C<:$nofile> named argument is set to C<True>, the content of the file string is undefined and should be ignored; this is a means to get a performance boost, as implementations may use faster code path when file is not needed.', 'sigs' => ['method splitpath(Cool:D $path, :$nofile --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'tmpdir', 'kind' => 'method', 'summary' => 'Attempts to locate a system\'s temporary directory by checking several typical directories and environment variables. Uses current directory if no suitable directories are found.', 'sigs' => ['method tmpdir(--> IO::Path:D)'], 'returns' => ['IO::Path:D'] },
        { 'name' => 'updir', 'kind' => 'method', 'summary' => 'Returns a string representing the directory one up from current:', 'sigs' => ['method updir()'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class IO::Spec::Unix is IO::Spec  { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.basename("foo/bar/") .raku.say; # OUTPUT: «""␤»
IO::Spec::Unix.basename("foo/bar/.").raku.say; # OUTPUT: «"."␤»
IO::Spec::Unix.basename("foo/bar")  .raku.say; # OUTPUT: «"bar"␤»', 'expect' => '""
"."
"bar"
', 'routine' => 'basename', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.canonpath("foo//../bar/../ber").say;
# OUTPUT: «foo/../bar/../ber␤»', 'expect' => 'foo/../bar/../ber
', 'routine' => 'canonpath', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.canonpath("foo///./../bar/../ber").say;
# OUTPUT: «foo/../bar/../ber␤»', 'expect' => 'foo/../bar/../ber
', 'routine' => 'canonpath', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.canonpath("foo///./../bar/../ber", :parent).say;
# OUTPUT: «ber␤»', 'expect' => 'ber
', 'routine' => 'canonpath', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.catdir(<foo/bar ber raku>).say; # OUTPUT: «foo/bar/ber/raku␤»', 'expect' => 'foo/bar/ber/raku
', 'routine' => 'catdir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.catpath($, \'some/dir\', \'and/more\').say;
# OUTPUT: «some/dir/and/more␤»', 'expect' => 'some/dir/and/more
', 'routine' => 'catpath', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say \'.\' eq $*SPEC.curdir; # OUTPUT: «True␤»', 'expect' => 'True
', 'routine' => 'curdir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say $*SPEC.curupdir;
# OUTPUT: «-> str $dir { #`(Block|65335808) ... }␤»

my @dirs = <. foo .. bar>;
say @dirs.grep: { $_ ~~ $*SPEC.curupdir };
# OUTPUT: «(foo bar)␤»', 'expect' => '-> str $dir { #`(Block|65335808) ... }
(foo bar)
', 'routine' => 'curupdir', 'opts' => '', 'preamble' => '' },
        { 'code' => '$*SPEC.devnull.IO.spurt: "foo bar baz";', 'expect' => '', 'routine' => 'devnull', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.dir-sep.say; # OUTPUT: «/␤»', 'expect' => '/
', 'routine' => 'dir-sep', 'opts' => '', 'preamble' => '' },
        { 'code' => '$*SPEC.extension(\'foo.\'      ).raku.say;  # OUTPUT: «""␤»
$*SPEC.extension(\'foo.txt\'   ).raku.say;  # OUTPUT: «"txt"␤»
$*SPEC.extension(\'foo.tar.gz\').raku.say;  # OUTPUT: «"gz"␤»
$*SPEC.extension(\'foo\'       ).raku.say;  # OUTPUT: «""␤»
$*SPEC.extension(\'bar.foo/foo\').raku.say; # OUTPUT: «"foo/foo"␤»', 'expect' => '""
"txt"
"gz"
""
"foo/foo"
', 'routine' => 'extension', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say IO::Spec::Unix.is-absolute: "/foo";        # OUTPUT: «True␤»
say IO::Spec::Unix.is-absolute: "/\\x[308]foo"; # OUTPUT: «True␤»
say IO::Spec::Unix.is-absolute: "bar";         # OUTPUT: «False␤»', 'expect' => 'True
True
False
', 'routine' => 'is-absolute', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.join($, \'foo\', \'bar\').say; # OUTPUT: «foo/bar␤»
IO::Spec::Unix.join($, \'/\', \'/\').say;     # OUTPUT: «/␤»
IO::Spec::Unix.join($, \'.\', \'foo\').say;   # OUTPUT: «foo␤»
say $*SPEC.join(True,".","/foo");         # OUTPUT: «/foo␤»', 'expect' => 'foo/bar
/
foo
/foo
', 'routine' => 'join', 'opts' => '', 'preamble' => '' },
        { 'code' => '%*ENV<PATH> = \'foo:bar/ber::foo:\';
IO::Spec::Unix.path.raku.say;
# OUTPUT: «("foo", "bar/ber", ".", "foo", ".").Seq␤»', 'expect' => '("foo", "bar/ber", ".", "foo", ".").Seq
', 'routine' => 'path', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say $*CWD;                                  # OUTPUT: «"/home/camelia".IO␤»

say IO::Spec::Unix.rel2abs: \'foo\';          # OUTPUT: «/home/camelia/foo␤»
say IO::Spec::Unix.rel2abs: \'./\';           # OUTPUT: «/home/camelia␤»
say IO::Spec::Unix.rel2abs: \'foo/../../\';   # OUTPUT: «/home/camelia/foo/../..␤»
say IO::Spec::Unix.rel2abs: \'/foo/\';        # OUTPUT: «/foo␤»

say IO::Spec::Unix.rel2abs: \'foo\', \'bar\';   # OUTPUT: «/home/camelia/bar/foo␤»
say IO::Spec::Unix.rel2abs: \'./\', \'/bar\';   # OUTPUT: «/bar␤»
say IO::Spec::Unix.rel2abs: \'/foo/\', \'bar\'; # OUTPUT: «/foo␤»

say IO::Spec::Unix.rel2abs: \'foo/../../\', \'bar\';
# OUTPUT: «/home/camelia/bar/foo/../..␤»', 'expect' => '"/home/camelia".IO
/home/camelia/foo
/home/camelia
/home/camelia/foo/../..
/foo
/home/camelia/bar/foo
/bar
/foo
/home/camelia/bar/foo/../..
', 'routine' => 'rel2abs', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.split(\'C:/foo/bar.txt\').raku.say;
# OUTPUT: «IO::Path::Parts.new("","C:/foo","bar.txt")␤»

IO::Spec::Unix.split(\'/foo/\').raku.say;
# OUTPUT: «IO::Path::Parts.new("","/","foo")␤»

IO::Spec::Unix.split(\'///\').raku.say;
# OUTPUT: «IO::Path::Parts.new("","/","/")␤»

IO::Spec::Unix.split(\'./\').raku.say;
# OUTPUT: «IO::Path::Parts.new("",".",".")␤»

IO::Spec::Unix.split(\'.\').raku.say;
# OUTPUT: «IO::Path::Parts.new("",".",".")␤»

IO::Spec::Unix.split(\'\').raku.say;
# OUTPUT: «IO::Path::Parts.new("","","")␤»', 'expect' => 'IO::Path::Parts.new("","C:/foo","bar.txt")
IO::Path::Parts.new("","/","foo")
IO::Path::Parts.new("","/","/")
IO::Path::Parts.new("",".",".")
IO::Path::Parts.new("",".",".")
IO::Path::Parts.new("","","")
', 'routine' => 'split', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.splitdir(\'C:\\foo/bar.txt\').raku.say;
# OUTPUT: «("C:\\\\foo", "bar.txt")␤»

IO::Spec::Unix.splitdir(\'/foo/\').raku.say;
# OUTPUT: «("", "foo", "")␤»

IO::Spec::Unix.splitdir(\'///\').raku.say;
# OUTPUT: «("", "", "", "")␤»

IO::Spec::Unix.splitdir(\'./\').raku.say;
# OUTPUT: «(".", "")␤»

IO::Spec::Unix.splitdir(\'.\').raku.say;
# OUTPUT: «(".",)␤»

IO::Spec::Unix.splitdir(\'\').raku.say;
# OUTPUT: «("",)␤»', 'expect' => '("C:\\\\foo", "bar.txt")
("", "foo", "")
("", "", "", "")
(".", "")
(".",)
("",)
', 'routine' => 'splitdir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Unix.splitpath(\'C:\\foo/bar.txt\').raku.say;
# OUTPUT: «("", "C:\\\\foo/", "bar.txt")␤»

IO::Spec::Unix.splitpath(\'C:\\foo/bar.txt\', :nofile).raku.say;
# OUTPUT: «("", "C:\\\\foo/bar.txt", "")␤»

IO::Spec::Unix.splitpath(\'/foo/\').raku.say;
# OUTPUT: «("", "/foo/", "")␤»

IO::Spec::Unix.splitpath(\'/foo/\', :nofile).raku.say;
# OUTPUT: «("", "/foo/", "")␤»

IO::Spec::Unix.splitpath(\'///\').raku.say;
# OUTPUT: «("", "///", "")␤»

IO::Spec::Unix.splitpath(\'./\').raku.say;
# OUTPUT: «("", "./", "")␤»

IO::Spec::Unix.splitpath(\'.\').raku.say;
# OUTPUT: «("", "", ".")␤»

IO::Spec::Unix.splitpath(\'\').raku.say;
# OUTPUT: «("", "", "")␤»', 'expect' => '("", "C:\\\\foo/", "bar.txt")
("", "C:\\\\foo/bar.txt", "")
("", "/foo/", "")
("", "/foo/", "")
("", "///", "")
("", "./", "")
("", "", ".")
("", "", "")
', 'routine' => 'splitpath', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say \'..\' eq $*SPEC.updir; # OUTPUT: «True␤»', 'expect' => 'True
', 'routine' => 'updir', 'opts' => '', 'preamble' => '' },
      ],
