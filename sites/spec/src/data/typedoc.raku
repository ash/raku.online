$first-prime.tap: &say;', 'expect' => '', 'routine' => 'first', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $words = Supply.from-list(<Hello World From Raku!>);
my $s = $words.split(/ <?upper> /, 2, :skip-empty);
