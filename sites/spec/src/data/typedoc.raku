    {
      'name' => 'Metamodel::AttributeContainer',
      'file' => 'AttributeContainer',
      'subkind' => 'role',
      'category' => 'metamodel',
      'subtitle' => 'Metaobject that can hold attributes',
      'declkind' => 'role',
      'consumers' => ['Metamodel::ClassHOW', 'Metamodel::ConcreteRoleHOW', 'Metamodel::EnumHOW', 'Metamodel::ParametricRoleHOW'],
      'routines' => [
        { 'name' => 'add_attribute', 'kind' => 'method', 'summary' => 'Adds an attribute. C<$attribute> must be an object that supports the methods C<name>,  C<type> and C<package>, which are called without arguments. It can for example be of L<type Attribute|/type/Attribute>.', 'sigs' => ['method add_attribute($obj, $attribute)'], 'returns' => [] },
        { 'name' => 'attributes', 'kind' => 'method', 'summary' => 'Returns a list of attributes. For most Raku types, these will be objects of L<type Attribute|/type/Attribute>.', 'sigs' => ['method attributes($obj)'], 'returns' => [] },
        { 'name' => 'set_rw', 'kind' => 'method', 'summary' => 'Marks a type whose attributes default to having a write accessor. For example in The C<is rw> trait on the class calls the C<set_rw> method on the metaclass, making all the attributes implicitly writable, so that you can write;', 'sigs' => ['method set_rw($obj)'], 'returns' => [] },
        { 'name' => 'rw', 'kind' => 'method', 'summary' => 'Returns a true value if L<method set_rw|#method set_rw> has been called on this object, that is, if new public attributes are writable by default. TODO: compose_attributes, get_attribute_for_usage Also TODO: describe :local, :excl, :all options of method attributes', 'sigs' => ['method rw($obj)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'role Metamodel::AttributeContainer {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'class Point is rw {
    has $.x;
    has $.y;
}', 'expect' => '', 'routine' => 'set_rw', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $p = Point.new(x => 1, y => 2);
$p.x = 42;', 'expect' => '', 'routine' => 'set_rw', 'opts' => ':preamble<class Point {}>', 'preamble' => 'class Point {}' },
      ],
    },
