', 'routine' => 'grab', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $s = Supply.from-list(1, 2, 3);
my $t = $s.reverse;
$t.tap(&say);           # OUTPUT: «3␤2␤1␤»', 'expect' => '3
2
1
', 'routine' => 'reverse', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $s = Supply.from-list(4, 10, 3, 2);
my $t = $s.sort();
$t.tap(&say);           # OUTPUT: «2␤3␤4␤10␤»', 'expect' => '2
3
4
10
', 'routine' => 'sort', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $s = Supply.from-list(<ä a o ö>);
my $t = $s.collate();
