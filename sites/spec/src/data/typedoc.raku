    {
      'name' => 'QuantHash',
      'file' => 'QuantHash',
      'subkind' => 'role',
      'category' => 'composite',
      'subtitle' => 'Object hashes with a limitation on the type of values',
      'declkind' => 'role',
      'consumers' => ['Setty', 'Baggy'],
      'routines' => [
        { 'name' => 'hash', 'kind' => 'method', 'summary' => 'Coerces the C<QuantHash> object to a L<C<Hash>|/type/Hash> (by stringifying the objects for the keys) with the values of the hash limited to the same limitation as C<QuantHash>, and returns that.', 'sigs' => ['method hash()'], 'returns' => [] },
        { 'name' => 'Hash', 'kind' => 'method', 'summary' => 'Coerces the C<QuantHash> object to a L<C<Hash>|/type/Hash> (by stringifying the objects for the keys) without any limitations on the values, and returns that.', 'sigs' => ['method Hash()'], 'returns' => [] },
        { 'name' => 'Map', 'kind' => 'method', 'summary' => 'Available as of the 2021.02 release of the Rakudo compiler. Coerces the C<QuantHash> object to a L<C<Map>|/type/Map> (by stringifying the objects for the keys) without any limitations on the values, and returns that.', 'sigs' => ['method Map()'], 'returns' => [] },
        { 'name' => 'of', 'kind' => 'method', 'summary' => 'Returns the type of value a value of this C<QuantHash> may have.  This is typically L<C<Bool>|/type/Bool> for L<C<Setty>|/type/Setty>, L<C<UInt>|/type/UInt> for L<C<Baggy>|/type/Baggy> or L<C<Real>|/type/Real> for L<C<Mixy>|/type/Mixy> roles.', 'sigs' => ['method of()'], 'returns' => [] },
        { 'name' => 'keyof', 'kind' => 'method', 'summary' => 'Returns the type of value a key of this subclass of C<QuantHash> may have. This is typically L<C<Mu>|/type/Mu>, which is also the default for punned QuantHashes.', 'sigs' => ['method keyof()'], 'returns' => [] },
        { 'name' => 'Capture', 'kind' => 'method', 'summary' => 'Returns the object as a L<C<Capture>|/type/Capture> by previously coercing it to a L<C<Hash>|/type/Hash>.', 'sigs' => ['method Capture()'], 'returns' => [] },
        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Returns a list of L<C<Pair>|/type/Pair> objects of all keys and values in the QuantHash.', 'sigs' => ['multi method list(QuantHash:D:)'], 'returns' => [] },
        { 'name' => 'Setty', 'kind' => 'method', 'summary' => 'Coerce the C<QuantHash> object to the equivalent object that uses the L<C<Setty>|/type/Setty> role. Note that for L<C<Mixy>|/type/Mixy> type coercion items with negative values will be skipped.', 'sigs' => ['method Setty(--> Setty:D)'], 'returns' => ['Setty:D'] },
        { 'name' => 'Baggy', 'kind' => 'method', 'summary' => 'Coerce the C<QuantHash> object to the equivalent object that uses the L<C<Baggy>|/type/Baggy> role. Note that for L<C<Mixy>|/type/Mixy> type coercion items with negative values will be skipped.', 'sigs' => ['method Baggy(--> Baggy:D)'], 'returns' => ['Baggy:D'] },
        { 'name' => 'Mixy', 'kind' => 'method', 'summary' => 'Coerce the C<QuantHash> object to the equivalent object that uses the L<C<Mixy>|/type/Mixy> role.', 'sigs' => ['method Mixy(--> Mixy:D)'], 'returns' => ['Mixy:D'] },
      ],
      'examples' => [
