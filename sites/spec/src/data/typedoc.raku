say "foo.tar.gz".IO.extension: \'ZIP\', :0parts;    # OUTPUT: «"foo.tar.gz.ZIP".IO␤»
say "foo.tar.gz".IO.extension: \'ZIP\', :2parts;    # OUTPUT: «"foo.ZIP".IO␤»
say "foo.tar.gz".IO.extension: \'ZIP\', :parts(^5); # OUTPUT: «"foo.ZIP".IO␤»', 'expect' => '"foo.tar".IO
"foo.tar.ZIP".IO
"foo.tar.gz.ZIP".IO
"foo.ZIP".IO
"foo.ZIP".IO
', 'routine' => 'extension', 'opts' => '', 'preamble' => '' },
        { 'code' => '# Replacing an extension using non-standard joiner:
