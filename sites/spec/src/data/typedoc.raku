      'consumers' => ['Metamodel::ClassHOW', 'Metamodel::DefiniteHOW', 'Metamodel::ModuleHOW', 'Metamodel::NativeHOW', 'Metamodel::PackageHOW', 'Metamodel::ParametricRoleHOW', 'Metamodel::SubsetHOW'],
      'routines' => [
