    {
      'name' => 'Str',
      'file' => 'Str',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'String of characters',
      'declkind' => 'class',
      'children' => ['Allomorph'],
      'routines' => [
        { 'name' => 'chop', 'kind' => 'routine', 'summary' => 'Returns the string with C<$n> characters removed from the end. The original string is left unchanged. The C<$n> positional is converted to L<C<Int>|/type/Int> beforehand. Calls without an argument remove just one character. If the string contains fewer characters than are to be chopped, the result is the empty string.', 'sigs' => ['multi method chop(Str:D:)', 'multi method chop(Str:D: Int() $n)'], 'returns' => [] },
        { 'name' => 'chomp', 'kind' => 'routine', 'summary' => 'Returns the string with a logical newline (any codepoint that has the C<NEWLINE> property) removed from the end. Examples:', 'sigs' => ['multi        chomp(Str:D  --> Str:D)', 'multi method chomp(Str:D: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'contains', 'kind' => 'method', 'summary' => 'Given a C<Str> invocant (known as the I<haystack>) and a first argument (known as the C<$needle>), it searches for the C<$needle> in the I<haystack> from the beginning of the string and returns C<True> if C<$needle> is found. If the optional parameter C<$pos> is provided, then C<contains> will search the I<haystack> starting from C<$pos> characters into the string. In the first case, C<contains> searches for the C<\'Hello\'> string on the', 'sigs' => ['multi method contains(Str:D: Str:D $needle --> Bool)', 'multi method contains(Str:D: Str:D $needle, Int:D $pos --> Bool)', 'multi method contains(Str:D: Str:D $needle, :m(:$ignoremark)! --> Bool)', 'multi method contains(Str:D: Str:D $needle, :i(:$ignorecase)!, :m(:$ignoremark) --> Bool)', 'multi method contains(Str:D: Str:D $needle, Int:D $pos, :m(:$ignoremark)! --> Bool)', 'multi method contains(Str:D: Str:D $needle, Int:D $pos, :i(:$ignorecase)!, :m(:$ignoremark) --> Bool)', 'multi method contains(Str:D: Regex:D $needle --> Bool)', 'multi method contains(Str:D: Regex:D $needle, Int:D $pos --> Bool)'], 'returns' => ['Bool', 'Bool', 'Bool', 'Bool', 'Bool', 'Bool', 'Bool', 'Bool'] },
        { 'name' => 'lc', 'kind' => 'routine', 'summary' => 'Returns a lowercase version of the string. Examples:', 'sigs' => ['multi        lc(Str:D  --> Str:D)', 'multi method lc(Str:D: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'uc', 'kind' => 'routine', 'summary' => 'Returns an uppercase version of the string.', 'sigs' => ['multi        uc(Str:D  --> Str:D)', 'multi method uc(Str:D: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'fc', 'kind' => 'routine', 'summary' => 'Does a Unicode "fold case" operation suitable for doing caseless string comparisons.  (In general, the returned string is unlikely to be useful for any purpose other than comparison.)', 'sigs' => ['multi        fc(Str:D  --> Str:D)', 'multi method fc(Str:D: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'tc', 'kind' => 'routine', 'summary' => 'Does a Unicode "titlecase" operation, that is changes the first character in the string to titlecase, or to uppercase if the character has no titlecase mapping.', 'sigs' => ['multi        tc(Str:D  --> Str:D)', 'multi method tc(Str:D: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'tclc', 'kind' => 'routine', 'summary' => 'Turns the first character to titlecase, and all other characters to lowercase.', 'sigs' => ['multi        tclc(Str:D  --> Str:D)', 'multi method tclc(Str:D: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'wordcase', 'kind' => 'routine', 'summary' => 'Returns a string in which C<&filter> has been applied to all the words that match C<$where>. By default, this means that the first letter of every word is capitalized, and all the other letters lowercased.', 'sigs' => ['multi        wordcase(Cool $x  --> Str)', 'multi        wordcase(Str:D $x --> Str)', 'multi method wordcase(Str:D: :&filter = &tclc, Mu :$where = True --> Str)'], 'returns' => ['Str', 'Str', 'Str'] },
        { 'name' => 'unival', 'kind' => 'method', 'summary' => 'Returns the numeric value that the first codepoint in the invocant represents, or C<NaN> if it\'s not numeric.', 'sigs' => ['multi method unival(Str:D: --> Numeric)'], 'returns' => ['Numeric'] },
        { 'name' => 'univals', 'kind' => 'method', 'summary' => 'Returns a list of numeric values represented by each codepoint in the invocant string, and C<NaN> for non-numeric characters.', 'sigs' => ['multi method univals(Str:D: --> List)'], 'returns' => ['List'] },
        { 'name' => 'chars', 'kind' => 'routine', 'summary' => 'Returns the number of characters in the string in graphemes. On the JVM, this currently erroneously returns the number of codepoints instead.', 'sigs' => ['multi        chars(Cool  $x --> Int:D)', 'multi        chars(Str:D $x --> Int:D)', 'multi        chars(str   $x --> int)', 'multi method chars(Str:D:   --> Int:D)'], 'returns' => ['Int:D', 'Int:D', 'int', 'Int:D'] },
        { 'name' => 'encode', 'kind' => 'method', 'summary' => 'Returns a L<C<Blob>|/type/Blob> which represents the original string in the given encoding and normal form. The actual return type is as specific as possible, so C<$str.encode(\'UTF-8\')> returns a L<C<utf8>|/type/utf8> object, C<$str.encode(\'ISO-8859-1\')> a C<buf8>. If C<:translate-nl> is set to C<True>, it will translate newlines from C<\\n> to C<\\r\\n>, but only in Windows. C<$replacement> indicates how characters are going to be', 'sigs' => ['multi method encode(Str:D $encoding = \'utf8\', :$replacement, Bool() :$translate-nl = False, :$strict)'], 'returns' => [] },
        { 'name' => 'index', 'kind' => 'method', 'summary' => 'Searches for C<$needle> in the string starting from C<$pos> (if present). It returns the offset into the string where C<$needle> was found, and L<C<Nil>|/type/Nil> if it was not found. Since Rakudo release 2020.02, if the optional named parameter C<:ignorecase>, or C<:i>, is specified, the search for C<$needle> ignores the distinction between uppercase, lowercase and titlecase letters. In addition, if the optional named parameter C<:ignoremark>, or C<:m>, is', 'sigs' => ['multi method index(Str:D: Cool:D $needle, :i(:$ignorecase), :m(:$ignoremark) --> Int:D)', 'multi method index(Str:D: Str:D $needle, :i(:$ignorecase), :m(:$ignoremark) --> Int:D)', 'multi method index(Str:D: Cool:D $needle, Cool:D $pos, :i(:$ignorecase), :m(:$ignoremark) --> Int:D)', 'multi method index(Str:D: Str:D $needle, Int:D $pos, :i(:$ignorecase), :m(:$ignoremark) --> Int:D)', 'multi method index(Str:D: @needles --> Int:D)', 'multi method index(Str:D: @needles, :m(:$ignoremark)! --> Int:D)', 'multi method index(Str:D: @needles, :i(:$ignorecase)!, :m(:$ignoremark) --> Int:D)'], 'returns' => ['Int:D', 'Int:D', 'Int:D', 'Int:D', 'Int:D', 'Int:D', 'Int:D'] },
        { 'name' => 'rindex', 'kind' => 'routine', 'summary' => 'Returns the last position of C<$needle> in the string not after C<$pos>. Returns L<C<Nil>|/type/Nil> if C<$needle> wasn\'t found. Since Rakudo release 2020.05, C<rindex> accepts a list of needles to search the string with, and return the highest index found or L<C<Nil>|/type/Nil>. Examples: Other forms of C<rindex>, including subs, are L<inherited from C<Cool>|/type/Cool#routine_rindex>.', 'sigs' => ['multi method rindex(Str:D: Str:D $needle --> Int:D)', 'multi method rindex(Str:D: Str:D $needle, Int:D $pos --> Int:D)', 'multi method rindex(Str:D: @needles --> Int:D)'], 'returns' => ['Int:D', 'Int:D', 'Int:D'] },
        { 'name' => 'indices', 'kind' => 'method', 'summary' => 'Searches for all occurrences of C<$needle> in the string starting from position C<$start>, or zero if it is not specified, and returns a L<C<List>|/type/List> with all offsets in the string where C<$needle> was found, or an empty list if it was not found. If the optional parameter C<:overlap> is specified the search continues from the index directly following the previous match, otherwise the search will continue', 'sigs' => ['multi method indices(Str:D: Str:D $needle, :i(:$ignorecase), :m(:$ignoremark), :$overlap --> List:D)', 'multi method indices(Str:D: Str:D $needle, Int:D $start, :i(:$ignorecase), :m(:$ignoremark), :$overlap --> List:D)'], 'returns' => ['List:D', 'List:D'] },
        { 'name' => 'match', 'kind' => 'method', 'summary' => 'Performs a match of the string against C<$pat> and returns a L<C<Match>|/type/Match> object if there is a successful match; it returns L<C<Nil>|/type/Nil> otherwise. Matches are stored in the L<default match variable C<$/>|/language/variables#index-entry-match_variable>. If C<$pat> is not a L<C<Regex>|/type/Regex> object, match will coerce the argument to a Str and then perform a literal match against C<$pat>.', 'sigs' => ['method match($pat, :continue(:$c), :pos(:$p), :global(:$g), :overlap(:$ov), :exhaustive(:$ex), :st(:$nd), :rd(:$th), :$nth, :$x --> Match)'], 'returns' => ['Match'] },
        { 'name' => 'Numeric', 'kind' => 'method', 'summary' => 'Coerces the string to L<C<Numeric>|/type/Numeric> using semantics equivalent to L<val|/routine/val> routine. L<Fails|/routine/fail> with L<C<X::Str::Numeric>|/type/X::Str::Numeric> if the coercion to a number cannot be done. Only Unicode characters with property C<Nd>, as well as leading and trailing whitespace are allowed, with the special case of the empty string being coerced to C<0>. Synthetic codepoints (e.g. C<"7\\x[308]">) are forbidden.', 'sigs' => ['method Numeric(Str:D: --> Numeric:D)'], 'returns' => ['Numeric:D'] },
        { 'name' => 'Num', 'kind' => 'method', 'summary' => 'Coerces the string to L«C<Num>|/type/Num», using the same rules as L«C<Str.Numeric>|/type/Str#method_Numeric» and handling negative zero, C<-0e0>, and positive zero, C<0e0>.', 'sigs' => ['method Num(Str:D: --> Num:D)'], 'returns' => ['Num:D'] },
        { 'name' => 'Int', 'kind' => 'method', 'summary' => 'Coerces the string to L<C<Int>|/type/Int>, using the same rules as L«C<Str.Numeric>|/type/Str#method_Numeric».', 'sigs' => ['method Int(Str:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'Rat', 'kind' => 'method', 'summary' => 'Coerces the string to a L<C<Rat>|/type/Rat> object, using the same rules as L«C<Str.Numeric>|/type/Str#method_Numeric». If the denominator is larger than 64-bits is it still kept and no degradation to L<C<Num>|/type/Num> occurs.', 'sigs' => ['method Rat(Str:D: --> Rational:D)'], 'returns' => ['Rational:D'] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<False> if the string is empty, C<True> otherwise.', 'sigs' => ['method Bool(Str:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'parse-base', 'kind' => 'routine', 'summary' => 'Performs the reverse of L«C<base>|/routine/base» by converting a string with a base-C<$radix> number to its L«C<Numeric>|/type/Numeric» equivalent. Will L«C<fail>|/routine/fail» if radix is not in range C<2..36> or if the string being parsed contains characters that are not valid for the specified base. See also: L«syntax for number literals|/syntax/Number%20literals»', 'sigs' => ['multi        parse-base(Str:D $num, Int:D $radix --> Numeric)', 'multi method parse-base(Str:D $num: Int:D $radix --> Numeric)'], 'returns' => ['Numeric', 'Numeric'] },
        { 'name' => 'parse-names', 'kind' => 'routine', 'summary' => 'B<DEPRECATED>. Use L<uniparse|/routine/uniparse> instead. Existed in Rakudo implementation as a proof of viability implementation before being renamed and will be removed when 6.e language is released.', 'sigs' => ['sub    parse-names(Str:D $names  --> Str:D)', 'method parse-names(Str:D $names: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'uniparse', 'kind' => 'routine', 'summary' => 'Takes string with comma-separated Unicode names of characters and returns a string composed of those characters. Will L«C<fail>|/routine/fail» if any of the characters\' names are empty or not recognized. Whitespace around character names is ignored. See L<uniname|/routine/uniname> and L<uninames|/routine/uninames> for routines that work in the opposite direction with a single codepoint and multiple', 'sigs' => ['sub    uniparse(Str:D $names  --> Str:D)', 'method uniparse(Str:D $names: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'samecase', 'kind' => 'method', 'summary' => 'multi method samecase(Str:D: Str:D $pattern --> Str:D) Returns a copy of the invocant with case information for each individual character changed according to C<$pattern>. B<Note>: The pattern string can contain three types of characters, i.e. uppercase, lowercase and caseless. For a given character in C<$pattern> its case information determines the case of the corresponding character in the result.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'split', 'kind' => 'routine', 'summary' => 'Splits a string up into pieces based on delimiters found in the string. If C<$delimiter> is a string, it is used literally. An empty string effectively returns all characters of the string separately (plus an empty string at the begin and at the end). C<$delimiter> also can be passed as a L<C<Regex>|/type/Regex>. If a list is used, then each of its elements will be considered a delimiter based on its type as mentioned above.', 'sigs' => ['multi        split(  Str:D $delimiter, Str:D $input, $limit = Inf,', 'multi        split(Regex:D $delimiter, Str:D $input, $limit = Inf,', 'multi        split(List:D $delimiters, Str:D $input, $limit = Inf,', 'multi method split(Str:D:   Str:D $delimiter, $limit = Inf,', 'multi method split(Str:D: Regex:D $delimiter, $limit = Inf,', 'multi method split(Str:D: List:D $delimiters, $limit = Inf,'], 'returns' => [] },
        { 'name' => 'comb', 'kind' => 'routine', 'summary' => 'Searches for C<$matcher> in C<$input> and returns a L<C<Seq>|/type/Seq> of non-overlapping matches limited to at most C<$limit> matches. If C<$matcher> is a Regex, each L<C<Match>|/type/Match> object is converted to a C<Str>, unless C<$match> is set (available as of the 2020.01 release of the Rakudo compiler). If no matcher is supplied, a Seq of characters in the string is returned, as if the matcher was C<rx/./>.', 'sigs' => ['multi        comb(Str:D   $matcher, Str:D $input, $limit = Inf)', 'multi        comb(Regex:D $matcher, Str:D $input, $limit = Inf, Bool :$match)', 'multi        comb(Int:D $size, Str:D $input, $limit = Inf)', 'multi method comb(Str:D $input:)', 'multi method comb(Str:D $input: Str:D   $matcher, $limit = Inf)', 'multi method comb(Str:D $input: Regex:D $matcher, $limit = Inf, Bool :$match)', 'multi method comb(Str:D $input: Int:D $size, $limit = Inf)'], 'returns' => [] },
        { 'name' => 'lines', 'kind' => 'routine', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of lines. By default, it chomps line endings the same as a call to C<$input.comb( / ^^ \\N* /, $limit )> would. To keep line endings, set the optional named parameter C<$chomp> to C<False>. Examples: You can limit the number of lines returned by setting the C<$limit> variable to a non-zero, non-C<Infinity> value: B«DEPRECATED as of C<6.d> language», the C<:count> argument was used', 'sigs' => ['multi method lines(Str:D: $limit, :$chomp = True)', 'multi method lines(Str:D: :$chomp = True)'], 'returns' => [] },
        { 'name' => 'words', 'kind' => 'routine', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of non-whitespace bits, i.e. the same as a call to C<$input.comb( / \\S+ /, $limit )> would. Examples: It can also be used as a subroutine, turning the first argument into the invocant. C<$limit> is optional, but if it is provided (and not equal to C<Inf>), it will return only the first C<$limit> words.', 'sigs' => ['multi method words(Str:D: $limit)', 'multi method words(Str:D:)'], 'returns' => [] },
        { 'name' => 'flip', 'kind' => 'routine', 'summary' => 'Returns the string reversed character by character. Examples:', 'sigs' => ['multi        flip(Str:D  --> Str:D)', 'multi method flip(Str:D: --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'starts-with', 'kind' => 'method', 'summary' => 'Returns C<True> if the invocant is identical to or starts with C<$needle>. Since Rakudo release 2020.02, if the optional named parameter C<:ignorecase>, or C<:i>, is specified, the comparison of the invocant and C<$needle> ignores the distinction between uppercase, lowercase and titlecase letters. Since Rakudo 2020.02, if the optional named parameter C<:ignoremark>, or C<:m>, is specified, the comparison of the invocant and C<$needle>', 'sigs' => ['multi method starts-with(Str:D: Str(Cool) $needle, :i(:$ignorecase), :m(:$ignoremark) --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'ends-with', 'kind' => 'method', 'summary' => 'Returns C<True> if the invocant is identical to or ends with C<$needle>. Since Rakudo release 2020.02, if the optional named parameter C<:ignorecase>, or C<:i>, is specified, the comparison of the invocant and C<$needle> ignores the distinction between uppercase, lowercase and titlecase letters. Since Rakudo 2020.02, if the optional named parameter C<:ignoremark>, or C<:m>, is specified, the comparison of the invocant and C<$needle>', 'sigs' => ['multi method ends-with(Str:D: Str(Cool) $needle, :i(:$ignorecase), :m(:$ignoremark) --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'subst', 'kind' => 'method', 'summary' => 'Returns the invocant string where C<$matcher> is replaced by C<$replacement> (or the original string, if no match was found). If no C<$replacement> is provided, the empty string is used (i.e., matched string(s) are removed). There is an in-place syntactic variant of C<subst> spelled C<s/matcher/replacement/> and with adverb following the C<s> or inside the matcher. C<$matcher> can be a L<C<Regex>|/type/Regex>, or a literal C<Str>. Non-Str matcher arguments of', 'sigs' => ['multi method subst(Str:D: $matcher, $replacement = "", *%options)'], 'returns' => [] },
        { 'name' => 'subst-mutate', 'kind' => 'method', 'summary' => 'B<NOTE:> I<<< C<.subst-mutate> is deprecated in the 6.d version, and will be removed in future ones. You can use L<subst|/routine/subst> with L«C<.=> method call assignment operator|/routine/.=» or L«C<s///> substitution operator|/language/operators#s///_in-place_substitution» instead. >>> Where L<subst|/routine/subst> returns the modified string and leaves the original unchanged, it is possible to mutate the original string by using', 'sigs' => [], 'returns' => [] },
        { 'name' => 'substr', 'kind' => 'routine', 'summary' => 'Returns a substring of the original string, between the indices specified by C<$from-to>\'s endpoints (coerced to L<C<Int>|/type/Int>) or from index C<$from> and of length C<$chars>. Both C<$from> and C<$chars> can be specified as L<C<Callable>|/type/Callable> and the returned value will be used as the value for the argument. C<$from> is invoked with the L<length|/routine/chars> of the original string, while C<$chars> is invoked with remaining character count after C<$from>. If C<$from> or', 'sigs' => ['multi        substr(Str:D $s, $from, $chars?  --> Str:D)', 'multi        substr(Str:D $s, Range  $from-to --> Str:D)', 'multi method substr(Str:D $s: $from, $chars?  --> Str:D)', 'multi method substr(Str:D $s: Range $from-to  --> Str:D)'], 'returns' => ['Str:D', 'Str:D', 'Str:D', 'Str:D'] },
        { 'name' => 'substr-eq', 'kind' => 'method', 'summary' => 'Returns C<True> if the C<$test-string> exactly matches the C<String> object, starting from the given initial index C<$from>.  For example, beginning with the string C<"foobar">, the substring C<"bar"> will match from index 3: However, the substring C<"barz"> starting from index 3 won\'t match even though the first three letters of the substring do match: Naturally, to match the entire string, one merely matches from index 0:', 'sigs' => ['multi method substr-eq(Str:D:  Str(Cool) $test-string, Int(Cool) $from, :i(:$ignorecase), :m(:$ignoremark) --> Bool)', 'multi method substr-eq(Cool:D: Str(Cool) $test-string, Int(Cool) $from, :i(:$ignorecase), :m(:$ignoremark) --> Bool)'], 'returns' => ['Bool', 'Bool'] },
        { 'name' => 'substr-rw', 'kind' => 'method', 'summary' => 'A version of C<substr> that returns a L<C<Proxy>|/type/Proxy> functioning as a writable reference to a part of a string variable. Its first argument, C<$from> specifies the index in the string from which a substitution should occur, and its last argument, C<$length> specifies how many characters are to be replaced. If not specified, C<$length> defaults to the length of the string. For example, in its method form, if one wants to take the string C<"abc">', 'sigs' => ['method substr-rw($from, $length = *)'], 'returns' => [] },
        { 'name' => 'samemark', 'kind' => 'routine', 'summary' => 'Returns a copy of C<$string> with the mark/accent information for each character changed such that it matches the mark/accent of the corresponding character in C<$pattern>. If C<$string> is longer than C<$pattern>, the remaining characters in C<$string> receive the same mark/accent as the last character in C<$pattern>. If C<$pattern> is empty no changes will be made. Examples:', 'sigs' => ['multi  samemark(Str:D $string, Str:D $pattern --> Str:D)', 'method samemark(Str:D: Str:D $pattern --> Str:D)'], 'returns' => ['Str:D', 'Str:D'] },
        { 'name' => 'succ', 'kind' => 'method', 'summary' => 'Returns the string incremented by one. String increment is "magical". It searches for the last alphanumeric sequence that is not preceded by a dot, and increments it. The actual increment step works by mapping the last alphanumeric character to a character range it belongs to, and choosing the next character in that range, carrying to the previous letter on overflow. String increment is Unicode-aware, and generally works for scripts where a', 'sigs' => ['method succ(Str:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'pred', 'kind' => 'method', 'summary' => 'Returns the string decremented by one. String decrementing is "magical" just like string increment (see L<succ|/routine/succ>). It fails on underflow', 'sigs' => ['method pred(Str:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'ord', 'kind' => 'routine', 'summary' => 'Returns the codepoint number of the base characters of the first grapheme in the string. Example:', 'sigs' => ['multi        ord(Str:D  --> Int:D)', 'multi method ord(Str:D: --> Int:D)'], 'returns' => ['Int:D', 'Int:D'] },
        { 'name' => 'ords', 'kind' => 'method', 'summary' => 'Returns a list of Unicode codepoint numbers that describe the codepoints making up the string. Example: Strings are represented as graphemes. If a character in the string is represented by multiple codepoints, then all of those codepoints will appear in the result of C<ords>. Therefore, the number of elements in the result may not always be equal to L<chars|/routine/chars>, but will be equal to L<codes|/routine/codes>; L<codes|/routine/codes> computes the codepoints in a different way, so the result might be faster.', 'sigs' => ['multi method ords(Str:D: --> Seq)'], 'returns' => ['Seq'] },
        { 'name' => 'trans', 'kind' => 'method', 'summary' => 'Replaces one or many characters with one or many characters. Ranges are supported, both for keys and values. Regexes work as keys. In case a list of keys and values is used, substrings can be replaced as well. When called with C<:complement> anything but the matched value or range is replaced with a single value; with C<:delete> the matched characters without corresponding replacement are removed. Combining C<:complement> and C<:delete> will remove', 'sigs' => ['multi method trans(Str:D: Pair:D \\what, *%n --> Str)', 'multi method trans(Str:D: *@changes, :complement(:$c), :squash(:$s), :delete(:$d) --> Str)'], 'returns' => ['Str', 'Str'] },
        { 'name' => 'indent', 'kind' => 'method', 'summary' => 'Indents each line of the string by C<$steps>. If C<$steps> is negative, it outdents instead. If C<$steps> is L<C<*>|/routine/*>, then the string is outdented to the margin:', 'sigs' => ['multi method indent(Int $steps where { $_ == 0 } )', 'multi method indent(Int $steps where { $_ > 0  } )', 'multi method indent($steps where { .isa(Whatever) || .isa(Int) && $_ < 0 } )'], 'returns' => [] },
        { 'name' => 'trim', 'kind' => 'method', 'summary' => 'Remove leading and trailing whitespace. It can be used both as a method on strings and as a function. When used as a method it will return the trimmed string. In order to do in-place trimming, one needs to write C<.=trim> See also L<trim-trailing|/routine/trim-trailing> and L<trim-leading|/routine/trim-leading>.', 'sigs' => ['method trim(Str:D: --> Str)'], 'returns' => ['Str'] },
        { 'name' => 'trim-trailing', 'kind' => 'method', 'summary' => 'Removes the whitespace characters from the end of a string. See also L<trim|/routine/trim>.', 'sigs' => ['method trim-trailing(Str:D: --> Str)'], 'returns' => ['Str'] },
        { 'name' => 'trim-leading', 'kind' => 'method', 'summary' => 'Removes the whitespace characters from the beginning of a string. See also L<trim|/routine/trim>.', 'sigs' => ['method trim-leading(Str:D: --> Str)'], 'returns' => ['Str'] },
        { 'name' => 'NFC', 'kind' => 'method', 'summary' => 'Returns a codepoint string in L<C<NFC>|/type/NFC> format (Unicode Normalization Form C / Composed).', 'sigs' => ['method NFC(Str:D: --> NFC:D)'], 'returns' => ['NFC:D'] },
        { 'name' => 'NFD', 'kind' => 'method', 'summary' => 'Returns a codepoint string in L<C<NFD>|/type/NFD> format (Unicode Normalization Form D / Decomposed).', 'sigs' => ['method NFD(Str:D: --> NFD:D)'], 'returns' => ['NFD:D'] },
        { 'name' => 'NFKC', 'kind' => 'method', 'summary' => 'Returns a codepoint string in L<C<NFKC>|/type/NFKC> format (Unicode Normalization Form KC / Compatibility Composed).', 'sigs' => ['method NFKC(Str:D: --> NFKC:D)'], 'returns' => ['NFKC:D'] },
        { 'name' => 'NFKD', 'kind' => 'method', 'summary' => 'Returns a codepoint string in L<C<NFKD>|/type/NFKD> format (Unicode Normalization Form KD / Compatibility Decomposed).', 'sigs' => ['method NFKD(Str:D: --> NFKD:D)'], 'returns' => ['NFKD:D'] },
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'Returns C<True> if the string is L<the same as|/routine/eq> C<$other>.', 'sigs' => ['multi method ACCEPTS(Str:D: $other)'], 'returns' => [] },
        { 'name' => 'Capture', 'kind' => 'method', 'summary' => 'Throws C<X::Cannot::Capture>.', 'sigs' => ['method Capture()'], 'returns' => [] },
        { 'name' => 'val', 'kind' => 'routine', 'summary' => 'Given a C<Str> that may be parsable as a numeric value, it will attempt to construct the appropriate L<allomorph|/language/glossary#Allomorph>, returning one of L<C<IntStr>|/type/IntStr>, L<C<NumStr>|/type/NumStr>, L<C<RatStr>|/type/RatStr> or L<C<ComplexStr>|/type/ComplexStr> or a plain C<Str> if a numeric value cannot be parsed. You can use the plus and minus sign, as well as the Unicode "Minus Sign" as', 'sigs' => ['multi val(*@maybevals)', 'multi val(Slip:D \\maybevals)', 'multi val(List:D \\maybevals)', 'multi val(Pair:D \\ww-thing)', 'multi val(\\one-thing)', 'multi val(Str:D $MAYBEVAL, :$val-or-fail)'], 'returns' => [] },
        { 'name' => 'Version', 'kind' => 'method', 'summary' => 'Available as of the 2020.01 release of the Rakudo compiler. Coerces the string to L<C<Version>|/type/Version>. This could be used for L<type coercion in signature|/language/signatures#Coercion_type>, as for example:', 'sigs' => ['method Version(Str:D: --> Version:D)'], 'returns' => ['Version:D'] },
        { 'name' => 'Date', 'kind' => 'method', 'summary' => 'Available as of the 2020.05 release of the Rakudo compiler. Coerces a C<Str> to a L«C«Date»|/type/Date» object, provided the string is properly formatted. C«Date(Str)» also works. Examples:', 'sigs' => ['method Date(Str:D:)'], 'returns' => [] },
        { 'name' => 'DateTime', 'kind' => 'method', 'summary' => 'Available as of the 2020.05 release of the Rakudo compiler. Coerces a C<Str> to a L«C«DateTime»|/type/DateTime» object, provided the string is properly formatted. C«DateTime(Str)» also works. Examples: Since Rakudo release 2022.07, it is also possible to just specify a "YYYY-MM-DD" string to indicate midnight on the given date.', 'sigs' => ['method DateTime(Str:D:)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Str is Cool does Stringy { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "Whateverable".chop(3.6);  # OUTPUT: «Whatevera␤»
my $string= "Whateverable";
say $string.chop("3");         # OUTPUT: «Whatevera␤»', 'expect' => 'Whatevera
Whatevera
', 'routine' => 'chop', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say chomp("abc\\n");       # OUTPUT: «abc␤»
say "def\\r\\n".chomp;      # OUTPUT: «def␤» NOTE: \\r\\n is a single grapheme!
say "foo\\r".chomp;        # OUTPUT: «foo␤»', 'expect' => 'abc
def
foo
', 'routine' => 'chomp', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "Hello, World".contains(\'Hello\');      # OUTPUT: «True␤»
say "Hello, World".contains(\'hello\');      # OUTPUT: «False␤»
say "Hello, World".contains(\'Hello\', 1);   # OUTPUT: «False␤»
say "Hello, World".contains(\',\');          # OUTPUT: «True␤»
say "Hello, World".contains(\',\', 3);       # OUTPUT: «True␤»
say "Hello, World".contains(\',\', 10);      # OUTPUT: «False␤»', 'expect' => 'True
False
False
True
True
False
', 'routine' => 'contains', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "Hello, 12345".contains(5, "10.0");    # OUTPUT: «True␤»', 'expect' => 'True
', 'routine' => 'contains', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say \'Hello, World\'.contains(/\\w <?before \',\'>/);    # OUTPUT: «True␤»
say \'Hello, World\'.contains(/\\w <?before \',\'>/, 5); # OUTPUT: «False␤»', 'expect' => 'True
False
', 'routine' => 'contains', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "Hello, World".contains("world");              # OUTPUT: «False␤»
say "Hello, World".contains("world", :ignorecase); # OUTPUT: «True␤»', 'expect' => 'False
True
', 'routine' => 'contains', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "abc".contains("ä");               # OUTPUT: «False␤»
say "abc".contains("ä", :ignoremark);  # OUTPUT: «True␤»', 'expect' => 'False
True
', 'routine' => 'contains', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say <Hello, World>.contains(\'Hello\');    # OUTPUT: «True␤»
say <Hello, World>.contains(\'Hello\', 0); # OUTPUT: «True␤»
say <Hello, World>.contains(\'Hello\', 1); # OUTPUT: «False␤»', 'expect' => 'True
True
False
', 'routine' => 'contains', 'opts' => '', 'preamble' => '' },
        { 'code' => 'lc("A"); # OUTPUT: «"a"»
"A".lc;  # OUTPUT: «"a"»', 'expect' => '"a""a"', 'routine' => 'lc', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say \'4\'.unival;     # OUTPUT: «4␤»
say \'¾\'.unival;     # OUTPUT: «0.75␤»
say \'a\'.unival;     # OUTPUT: «NaN␤»', 'expect' => '4
0.75
NaN
', 'routine' => 'unival', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "4a¾".univals;  # OUTPUT: «(4 NaN 0.75)␤»', 'expect' => '(4 NaN 0.75)
', 'routine' => 'univals', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $str = "Þor is mighty";
say $str.encode("ascii", :replacement( \'Th\') ).decode("ascii");
# OUTPUT: «Thor is mighty␤»', 'expect' => 'Thor is mighty
', 'routine' => 'encode', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say $str.encode("ascii", :replacement).decode("ascii"); # OUTPUT: «?or is mighty␤»', 'expect' => '?or is mighty
', 'routine' => 'encode', 'opts' => ':preamble<my $str = "Þor is mighty";>', 'preamble' => 'my $str = "Þor is mighty";' },
        { 'code' => 'say "þor".encode.bytes; # OUTPUT: «4␤»
say "þor".encode.elems; # OUTPUT: «4␤»', 'expect' => '4
4
', 'routine' => 'encode', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "Camelia is a butterfly".index("a");         # OUTPUT: «1␤»
say "Camelia is a butterfly".index("a", 2);      # OUTPUT: «6␤»
say "Camelia is a butterfly".index("er");        # OUTPUT: «17␤»
say "Camelia is a butterfly".index("Camel");     # OUTPUT: «0␤»
say "Camelia is a butterfly".index("Onion");     # OUTPUT: «Nil␤»
say "Camelia is a butterfly".index(<a e i u>);   # OUTPUT: «1␤»
say "Camelia is a butterfly".index(<a c>, :i);   # OUTPUT: «0␤»
say "Camelia is a butterfly".index((\'w\', \'x\'));  # OUTPUT: «Nil␤»', 'expect' => '1
6
17
0
Nil
1
0
Nil
', 'routine' => 'index', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "Hello, World".index("world");               # OUTPUT: «Nil␤»
say "Hello, World".index("world", :ignorecase);  # OUTPUT: «7␤»', 'expect' => 'Nil
7
', 'routine' => 'index', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "abc".index("ä");                            # OUTPUT: «Nil␤»
say "abc".index("ä", :ignoremark);               # OUTPUT: «0␤»
say "abc".index("x").defined ?? \'OK\' !! \'NOT\';   # OUTPUT: «NOT␤»', 'expect' => 'Nil
0
NOT
', 'routine' => 'index', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "aardvark".rindex: "a";       # OUTPUT: «5␤»
say "aardvark".rindex: "a", 0;    # OUTPUT: «0␤
say "aardvark".rindex: "t";       # OUTPUT: «Nil␤»
say "aardvark".rindex: <d v k>;   # OUTPUT: «7␤»', 'expect' => '5
Nil
7
', 'routine' => 'rindex', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "banana".indices("a");              # OUTPUT: «(1 3 5)␤»
say "banana".indices("ana");            # OUTPUT: «(1)␤»
say "banana".indices("ana", :overlap);  # OUTPUT: «(1 3)␤»
say "banana".indices("ana", 2);         # OUTPUT: «(3)␤»', 'expect' => '(1 3 5)
(1)
(1 3)
(3)
', 'routine' => 'indices', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "banAna".indices("a");              # OUTPUT:«(1 5)␤»
say "banAna".indices("a", :ignorecase); # OUTPUT:«(1 3 5)␤»', 'expect' => '(1 5)
(1 3 5)
', 'routine' => 'indices', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "tête-à-tête".indices("te");              # OUTPUT:«(2 9)␤»
say "tête-à-tête".indices("te", :ignoremark); # OUTPUT:«(0 2 7 9)␤»', 'expect' => '(2 9)
(0 2 7 9)
', 'routine' => 'indices', 'opts' => '', 'preamble' => '' },
        { 'code' => '
say "properly".match(\'perl\');                     # OUTPUT: «｢perl｣␤»
say "properly".match(/p.../);                     # OUTPUT: «｢prop｣␤»
say "1 2 3".match([1,2,3]);                       # OUTPUT: «｢1 2 3｣␤»
say "a1xa2".match(/a./, :continue(2));            # OUTPUT: «｢a2｣␤»
say "abracadabra".match(/ a .* a /, :exhaustive);
# OUTPUT: «(｢abracadabra｣ ｢abracada｣ ｢abraca｣ ｢abra｣ ｢acadabra｣ ｢acada｣ ｢aca｣ ｢adabra｣ ｢ada｣ ｢abra｣)␤»
say \'several words here\'.match(/\\w+/,:global);    # OUTPUT: «(｢several｣ ｢words｣ ｢here｣)␤»
say \'abcdef\'.match(/.*/, :pos(2));                # OUTPUT: «｢cdef｣␤»
say "foo[bar][baz]".match(/../, :1st);            # OUTPUT: «｢fo｣␤»
say "foo[bar][baz]".match(/../, :2nd);            # OUTPUT: «｢o[｣␤»
say "foo[bar][baz]".match(/../, :3rd);            # OUTPUT: «｢ba｣␤»
say "foo[bar][baz]".match(/../, :4th);            # OUTPUT: «｢r]｣␤»
say "foo[bar][baz]bada".match(\'ba\', :x(2));       # OUTPUT: «(｢ba｣ ｢ba｣)␤»', 'expect' => '｢perl｣
｢prop｣
｢1 2 3｣
｢a2｣
(｢abracadabra｣ ｢abracada｣ ｢abraca｣ ｢abra｣ ｢acadabra｣ ｢acada｣ ｢aca｣ ｢adabra｣ ｢ada｣ ｢abra｣)
(｢several｣ ｢words｣ ｢here｣)
｢cdef｣
｢fo｣
｢o[｣
｢ba｣
｢r]｣
(｢ba｣ ｢ba｣)
', 'routine' => 'match', 'opts' => '', 'preamble' => '' },
        { 'code' => '" −33".Numeric;       # OUTPUT: «-33␤»', 'expect' => '-33
', 'routine' => 'Numeric', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Str $s = "-0/5";
say (.self, .^name) given $s.Numeric;  # OUTPUT: «(0 Rat)␤»
say (.self, .^name) given $s.Num;      # OUTPUT: «(-0 Num)␤»', 'expect' => '(0 Rat)
(-0 Num)
