    {
      'name' => 'Routine',
      'file' => 'Routine',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Code object with its own lexical scope and C<return> handling',
      'declkind' => 'class',
      'children' => ['Sub', 'Method', 'Submethod', 'Macro'],
      'routines' => [
        { 'name' => 'name', 'kind' => 'method', 'summary' => 'Returns the name of the sub or method.', 'sigs' => ['method name(Routine:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'package', 'kind' => 'method', 'summary' => 'Returns the package in which the routine is defined.', 'sigs' => ['method package(Routine:D:)'], 'returns' => [] },
        { 'name' => 'multi', 'kind' => 'method', 'summary' => 'Returns C<True> if the routine is a multi sub or method. Note that the name of a multi sub refers to its L<C<proto>|/syntax/proto> and this method would return false if called on it. It needs to be called on the candidates themselves:', 'sigs' => ['method multi(Routine:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'candidates', 'kind' => 'method', 'summary' => 'Returns a list of multi candidates, or a one-element list with itself if it\'s not a multi', 'sigs' => ['method candidates(Routine:D: --> Positional:D)'], 'returns' => ['Positional:D'] },
        { 'name' => 'cando', 'kind' => 'method', 'summary' => 'Returns a possibly-empty list of candidates that can be called with the given L<C<Capture>|/type/Capture>, ordered by narrowest candidate first. For methods, the first element of the Capture needs to be the invocant:', 'sigs' => ['method cando(Capture $c)'], 'returns' => [] },
        { 'name' => 'wrap', 'kind' => 'method', 'summary' => 'Wraps (i.e. in-place modifies) the routine. That means a call to this routine first calls C<&wrapper>, which then can (but doesn\'t have to) call the original routine with the C<callsame>, C<callwith>, C<nextsame> and C<nextwith> L<dispatchers|/language/functions#Re-dispatching>. The return value from the routine is also the return value from the wrapper. C<wrap> returns an instance of a private class called', 'sigs' => ['method wrap(Routine:D: &wrapper)'], 'returns' => [] },
        { 'name' => 'unwrap', 'kind' => 'method', 'summary' => 'Restores the original routine after it has been wrapped with L<wrap|/routine/wrap>. While the signature allows any type to be passed, only the L<C<Routine::WrapHandle>|/type/Routine::WrapHandle> type returned from C<wrap> can usefully be.', 'sigs' => ['method unwrap($wraphandle)'], 'returns' => [] },
        { 'name' => 'is-wrapped', 'kind' => 'method', 'summary' => 'Returns C<True> or C<False>, depending on the whether or not the C<Routine> is wrapped.', 'sigs' => ['method is-wrapped()'], 'returns' => [] },
        { 'name' => 'yada', 'kind' => 'method', 'summary' => 'Returns C<True> if the routine is a stub', 'sigs' => ['method yada(Routine:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'Causes the return value of a routine to be stored, so that when subsequent calls with the same list of arguments are made, the stored value can be returned immediately instead of re-running the routine.N<This is still in experimental stage. Please check L<the corresponding section in the experimental features document|/language/experimental#cached>> Useful when storing and returning the computed value is much faster than', 'sigs' => ['multi trait_mod:<is>(Routine $r, :$cached!)'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'Marks a subroutine as I<pure>, that is, it asserts that for the same input, it will always produce the same output without any additional side effects. The C<is pure> trait is a promise by the programmer to the compiler that it can constant-fold calls to such functions when the arguments are known at compile time. You can mark function as pure even if they throw exceptions in edge cases or if they modify temporary objects; hence the C<is pure> trait can cover', 'sigs' => ['multi trait_mod:<is>(Routine $r, :$pure!)'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'When a routine is modified with this trait, its return value will be writable. This is useful when returning variables or writable elements of hashes or arrays, for example: produces Note that C<return> marks return values as read only; if you need an early exit from an C<is rw> routine, you have to use X<C<return-rw>|Reference,return-rw> instead.', 'sigs' => ['multi trait_mod:<is>(Routine $r, :$rw!)'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'Marks a routine as exported to the rest of the world From inside another file you\'d say C<use Foo;> to load a module and import the exported functions. See L<Exporting and Selective Importing Modules|/language/using-modules/code#Exporting_and_selective_importing> for more details.', 'sigs' => ['multi trait_mod:<is>(Routine $r, :$export!)'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'Marks a C<Routine> as deprecated; that is, it should no longer be used going forward, and will eventually be removed. An optional message specifying the replacement functionality can be specified By having both the original (deprecated) and new C<Routine> available simultaneously, you can avoid a breaking change in a single release, by allowing users time and instructions on how to update their code. Remove the deprecated version only after at least', 'sigs' => ['multi trait_mod:<is>(Routine:D $r, :$DEPRECATED!)'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'Hides a routine from showing up in a default backtrace. For example produces the error message and backtrace but if C<inner> is marked with C<hidden-from-backtrace> the error backtrace does not show it: TODO: explain export tags X<|Traits,is default>', 'sigs' => ['multi trait_mod:<is>(Routine:D, :$hidden-from-backtrace!)'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'There is a special trait for C<Routine>s called C<is default>. This trait is designed as a way to disambiguate C<multi> calls that would normally throw an error because the compiler would not know which one to use. This means that given the following two C<Routine>s, the one with the C<is default> trait will be called. The C<is default> trait can become very useful for debugging and other uses but keep in mind that it will only resolve an ambiguous dispatch between two', 'sigs' => ['multi trait_mod:<is>(Routine:D $r, :$default!)'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'Gives total access to the data structure returned by the routine.', 'sigs' => ['multi trait_mod:<is>(Routine:D $r, :$raw!)'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'Declares that a routine generates test output (aka TAP). When failures are reported, the calling routine\'s location is used instead of this routine. For example:', 'sigs' => ['multi trait_mod:<is>(Routine:D, :$test-assertion!)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Routine is Block { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'class Foo {
submethod bar { &?ROUTINE.^name }
};
