', 'routine' => 'from-list', 'opts' => '', 'preamble' => '' },
        { 'code' => '# this says in turn: "first 1" "first 2" "second 2" "first 3" "second 3"
my $s = Supply.interval(1).share;
$s.tap: { "first $_".say };
sleep 1.1;
$s.tap: { "second $_".say };
sleep 2', 'expect' => '', 'routine' => 'share', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $s = Supplier.new;
my $tap = $s.Supply.on-close({ say "Tap closed" }).tap(
    -> $v { say "the value is $v" },
    done    => { say "Supply is done" },
    quit    => -> $ex { say "Supply finished with error $ex" },
);', 'expect' => '', 'routine' => 'on-close', 'opts' => '', 'preamble' => '' },
        { 'code' => '$s.emit(\'Raku\');
