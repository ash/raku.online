      'routines' => [
        { 'name' => 'abs', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in the sub form, the argument) to L<C<Numeric>|/type/Numeric> and returns the absolute value (that is, a non-negative number).', 'sigs' => ['sub abs(Numeric() $x)', 'method abs()'], 'returns' => [] },
        { 'name' => 'conj', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Numeric>|/type/Numeric> and returns the L<C<Complex>|/type/Complex> conjugate (that is, the number with the sign of the imaginary part negated).', 'sigs' => ['method conj()'], 'returns' => [] },
        { 'name' => 'EVAL', 'kind' => 'method', 'summary' => 'It calls the L<subroutine form|/type/independent-routines#routine_EVAL> with the invocant as the first argument, C<$code>, passing along named args, if any.', 'sigs' => ['method EVAL(*%_)'], 'returns' => [] },
        { 'name' => 'sqrt', 'kind' => 'routine', 'summary' => 'Coerces the invocant to L<C<Numeric>|/type/Numeric> (or in the sub form, the argument) and returns the square root, that is, a number that, when multiplied with itself, produces the original number. Returns C<NaN> for negative arguments.  As of 6.e language version (early implementation exists in Rakudo compiler 2023.02+), will return a L<C<Complex>|/type/Complex> value for negative arguments.', 'sigs' => ['sub sqrt(Numeric(Cool) $x)', 'method sqrt()'], 'returns' => [] },
        { 'name' => 'sign', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Real>|/type/Real> and returns its sign, that is, 0 if the number is 0, 1 for positive and -1 for negative values.', 'sigs' => ['method sign()'], 'returns' => [] },
        { 'name' => 'rand', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Num>|/type/Num> and returns a pseudo-random value between zero and the number.', 'sigs' => ['method rand()'], 'returns' => [] },
        { 'name' => 'sin', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in the sub form, the argument) to L<C<Numeric>|/type/Numeric>, interprets it as radians, returns its L<sine|https://en.wikipedia.org/wiki/Sine>. Note that Raku is no computer algebra system, so C<sin(pi)> typically does not produce an exact 0, but rather a very small L<C<Num>|/type/Num>.', 'sigs' => ['sub sin(Numeric(Cool))', 'method sin()'], 'returns' => [] },
        { 'name' => 'asin', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in the sub form, the argument) to L<C<Numeric>|/type/Numeric>, and returns its L<arc-sine|https://en.wikipedia.org/wiki/Inverse_trigonometric_functions> in radians.', 'sigs' => ['sub asin(Numeric(Cool))', 'method asin()'], 'returns' => [] },
        { 'name' => 'cos', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, the argument) to L<C<Numeric>|/type/Numeric>, interprets it as radians, returns its L<cosine|https://en.wikipedia.org/wiki/Cosine>.', 'sigs' => ['sub cos(Numeric(Cool))', 'method cos()'], 'returns' => [] },
        { 'name' => 'acos', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, the argument) to L<C<Numeric>|/type/Numeric>, and returns its L<arc-cosine|https://en.wikipedia.org/wiki/Inverse_trigonometric_functions> in radians.', 'sigs' => ['sub acos(Numeric(Cool))', 'method acos()'], 'returns' => [] },
        { 'name' => 'tan', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, the argument) to L<C<Numeric>|/type/Numeric>, interprets it as radians, returns its L<tangent|https://en.wikipedia.org/wiki/Tangent>.', 'sigs' => ['sub tan(Numeric(Cool))', 'method tan()'], 'returns' => [] },
        { 'name' => 'atan', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, the argument) to L<C<Numeric>|/type/Numeric>, and returns its L<arc-tangent|https://en.wikipedia.org/wiki/Inverse_trigonometric_functions> in radians.', 'sigs' => ['sub atan(Numeric(Cool))', 'method atan()'], 'returns' => [] },
        { 'name' => 'atan2', 'kind' => 'routine', 'summary' => 'The sub should usually be written with two arguments for clarity as it is seen in other languages and in mathematical texts, but the single-argument form is available; its result will always match that of L<atan|/routine/atan>. The method coerces self and its single argument to L<C<Numeric>|/type/Numeric>, using them to compute the two-argument L<arc-tangent|https://en.wikipedia.org/wiki/Atan2> in radians.', 'sigs' => ['sub atan2($y, $x = 1e0)', 'method atan2($x = 1e0)'], 'returns' => [] },
        { 'name' => 'sec', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, interprets it as radians, returns its L<secant|https://en.wikipedia.org/wiki/Trigonometric_functions#Reciprocal_functions>, that is, the reciprocal of its cosine.', 'sigs' => ['sub sec(Numeric(Cool))', 'method sec()'], 'returns' => [] },
        { 'name' => 'asec', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<arc-secant|https://en.wikipedia.org/wiki/Inverse_trigonometric_functions> in radians.', 'sigs' => ['sub asec(Numeric(Cool))', 'method asec()'], 'returns' => [] },
        { 'name' => 'cosec', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, interprets it as radians, returns its L<cosecant|https://en.wikipedia.org/wiki/Trigonometric_functions#Reciprocal_functions>, that is, the reciprocal of its sine.', 'sigs' => ['sub cosec(Numeric(Cool))', 'method cosec()'], 'returns' => [] },
        { 'name' => 'acosec', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<arc-cosecant|https://en.wikipedia.org/wiki/Inverse_trigonometric_functions> in radians.', 'sigs' => ['sub acosec(Numeric(Cool))', 'method acosec()'], 'returns' => [] },
        { 'name' => 'cotan', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, interprets it as radians, returns its L<cotangent|https://en.wikipedia.org/wiki/Trigonometric_functions#Reciprocal_functions>, that is, the reciprocal of its tangent.', 'sigs' => ['sub cotan(Numeric(Cool))', 'method cotan()'], 'returns' => [] },
        { 'name' => 'acotan', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<arc-cotangent|https://en.wikipedia.org/wiki/Inverse_trigonometric_functions> in radians.', 'sigs' => ['sub acotan(Numeric(Cool))', 'method acotan()'], 'returns' => [] },
        { 'name' => 'sinh', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in method form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Sine hyperbolicus|https://en.wikipedia.org/wiki/Hyperbolic_function>.', 'sigs' => ['sub sinh(Numeric(Cool))', 'method sinh()'], 'returns' => [] },
        { 'name' => 'asinh', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Inverse Sine hyperbolicus|https://en.wikipedia.org/wiki/Inverse_hyperbolic_function>.', 'sigs' => ['sub asinh(Numeric(Cool))', 'method asinh()'], 'returns' => [] },
        { 'name' => 'cosh', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Cosine hyperbolicus|https://en.wikipedia.org/wiki/Hyperbolic_function>.', 'sigs' => ['sub cosh(Numeric(Cool))', 'method cosh()'], 'returns' => [] },
        { 'name' => 'acosh', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Inverse Cosine hyperbolicus|https://en.wikipedia.org/wiki/Inverse_hyperbolic_function>.', 'sigs' => ['sub acosh(Numeric(Cool))', 'method acosh()'], 'returns' => [] },
        { 'name' => 'tanh', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, interprets it as radians and returns its L<Tangent hyperbolicus|https://en.wikipedia.org/wiki/Hyperbolic_function>.', 'sigs' => ['sub tanh(Numeric(Cool))', 'method tanh()'], 'returns' => [] },
        { 'name' => 'atanh', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Inverse tangent hyperbolicus|https://en.wikipedia.org/wiki/Inverse_hyperbolic_function>.', 'sigs' => ['sub atanh(Numeric(Cool))', 'method atanh()'], 'returns' => [] },
        { 'name' => 'sech', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Secant hyperbolicus|https://en.wikipedia.org/wiki/Hyperbolic_function>.', 'sigs' => ['sub sech(Numeric(Cool))', 'method sech()'], 'returns' => [] },
        { 'name' => 'asech', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Inverse hyperbolic secant|https://en.wikipedia.org/wiki/Hyperbolic_function>.', 'sigs' => ['sub asech(Numeric(Cool))', 'method asech()'], 'returns' => [] },
        { 'name' => 'cosech', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Hyperbolic cosecant|https://en.wikipedia.org/wiki/Hyperbolic_function>.', 'sigs' => ['sub cosech(Numeric(Cool))', 'method cosech()'], 'returns' => [] },
        { 'name' => 'acosech', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Inverse hyperbolic cosecant|https://en.wikipedia.org/wiki/Inverse_hyperbolic_function>.', 'sigs' => ['sub acosech(Numeric(Cool))', 'method acosech()'], 'returns' => [] },
        { 'name' => 'cotanh', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Hyperbolic cotangent|https://en.wikipedia.org/wiki/Hyperbolic_function>.', 'sigs' => ['sub cotanh(Numeric(Cool))', 'method cotanh()'], 'returns' => [] },
        { 'name' => 'acotanh', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns its L<Inverse hyperbolic cotangent|https://en.wikipedia.org/wiki/Inverse_hyperbolic_function>.', 'sigs' => ['sub acotanh(Numeric(Cool))', 'method acotanh()'], 'returns' => [] },
        { 'name' => 'cis', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and returns L<cos(argument) + i*sin(argument)|https://en.wikipedia.org/wiki/Cis_%28mathematics%29>.', 'sigs' => ['sub cis(Numeric(Cool))', 'method cis()'], 'returns' => [] },
        { 'name' => 'log', 'kind' => 'routine', 'summary' => 'Coerces the arguments (including the invocant in the method form) to L<C<Numeric>|/type/Numeric>, and returns its L<Logarithm|https://en.wikipedia.org/wiki/Logarithm> to base C<$base>, or to base C<e> (Euler\'s Number) if no base was supplied (L<Natural logarithm|https://en.wikipedia.org/wiki/Natural_logarithm>). Throws an exception if C<$base> is C<1>. Returns C<NaN> for negative arguments.  As of 6.e language version (early', 'sigs' => ['multi        log(Numeric(Cool) $number, Numeric(Cool) $base?)', 'multi method log(Cool:D: Cool:D $base?)'], 'returns' => [] },
        { 'name' => 'log10', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in the sub form, the argument) to L<C<Numeric>|/type/Numeric> (or uses it directly if it\'s already in that form), and returns its L<Logarithm|https://en.wikipedia.org/wiki/Logarithm> in base 10, that is, a number that approximately produces the original number when 10 is raised to its power. Returns C<-Inf> for C<0>. Returns C<NaN> for negative arguments.  As of 6.e language version (early', 'sigs' => ['multi method log10()', 'multi        log10(Numeric $x)', 'multi        log10(Cool    $x)'], 'returns' => [] },
        { 'name' => 'log2', 'kind' => 'routine', 'summary' => 'Coerces the invocant to L<C<Numeric>|/type/Numeric>, and returns its L<Logarithm|https://en.wikipedia.org/wiki/Logarithm> in base 2, that is, a number that approximately (due to computer precision limitations) produces the original number when 2 is raised to its power. Returns C<-Inf> for C<0>. Returns C<NaN> for negative arguments.  As of 6.e language version (early implementation exists in Rakudo compiler 2023.02+), will return a', 'sigs' => ['multi method log2()', 'multi        log2(Numeric $x)', 'multi        log2(Cool    $x)'], 'returns' => [] },
        { 'name' => 'exp', 'kind' => 'routine', 'summary' => 'Coerces the arguments (including the invocant in the method from) to L<C<Numeric>|/type/Numeric>, and returns C<$base> raised to the power of the first number. If no C<$base> is supplied, C<e> (Euler\'s Number) is used.', 'sigs' => ['multi        exp(Cool:D $pow, Cool:D $base?)', 'multi method exp(Cool:D: Cool:D $base?)'], 'returns' => [] },
        { 'name' => 'unpolar', 'kind' => 'method', 'summary' => 'Coerces the arguments (including the invocant in the method form) to L<C<Numeric>|/type/Numeric>, and returns a complex number from the given polar coordinates. The invocant (or the first argument in sub form) is the magnitude while the argument (i.e. the second argument in sub form) is the angle. The angle is assumed to be in radians.', 'sigs' => ['method unpolar(Numeric(Cool))'], 'returns' => [] },
        { 'name' => 'round', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and rounds it to the unit of C<$scale>. If C<$scale> is 1, rounds to the nearest integer; an arbitrary scale will result in the closest multiple of that number. Always rounds B<up> if the number is at mid-point: B<Pay attention> to types when using this method, as ending up with the wrong type may affect the precision you seek to achieve. For L<C<Real>|/type/Real> types, the type of the result', 'sigs' => ['multi        round(Numeric(Cool), $scale = 1)', 'multi method round(Cool:D: $scale = 1)'], 'returns' => [] },
        { 'name' => 'floor', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and rounds it downwards to the nearest integer.', 'sigs' => ['multi        floor(Numeric(Cool))', 'multi method floor'], 'returns' => [] },
        { 'name' => 'fmt', 'kind' => 'method', 'summary' => 'Uses C<$format> to return a formatted representation of the invocant; equivalent to calling L<sprintf|/routine/sprintf> with C<$format> as format and the invocant as the second argument. The C<$format> will be coerced to L<C<Stringy>|/type/Stringy> and defaults to C<\'%s\'>. For more information about formats strings, see L<sprintf|/routine/sprintf>.', 'sigs' => ['method fmt($format = \'%s\')'], 'returns' => [] },
        { 'name' => 'ceiling', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and rounds it upwards to the nearest integer.', 'sigs' => ['multi        ceiling(Numeric(Cool))', 'multi method ceiling'], 'returns' => [] },
        { 'name' => 'truncate', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Numeric>|/type/Numeric>, and rounds it towards zero.', 'sigs' => ['multi        truncate(Numeric(Cool))', 'multi method truncate()'], 'returns' => [] },
        { 'name' => 'ord', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns the L<Unicode code point|https://en.wikipedia.org/wiki/Code_point> number of the first code point. The inverse operation is L<chr|/routine/chr>. Mnemonic: returns an ordinal number', 'sigs' => ['sub ord(Str(Cool))', 'method ord()'], 'returns' => [] },
        { 'name' => 'path', 'kind' => 'method', 'summary' => 'B<DEPRECATED>. I<It\'s been deprecated as of the 6.d version. Will be removed in the next ones.> Stringifies the invocant and converts it to L<C<IO::Path>|/type/IO::Path> object. Use the L«C<.IO method>|/routine/IO» instead.', 'sigs' => ['method path(Cool:D: --> IO::Path:D)'], 'returns' => ['IO::Path:D'] },
        { 'name' => 'chr', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Int>|/type/Int>, interprets it as a L<Unicode code points|https://en.wikipedia.org/wiki/Code_point>, and returns a L<C<Str>|/type/Str> made of that code point. The inverse operation is L<ord|/routine/ord>. Mnemonic: turns an integer into a I<char>acter.', 'sigs' => ['sub chr(Int(Cool))', 'method chr()'], 'returns' => [] },
        { 'name' => 'chars', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns the number of characters in the string. Please note that on the JVM, you currently get codepoints instead of graphemes. If the string is native, the number of chars will be also returned as a native C<int>. X<|Syntax,Grapheme> Graphemes are user visible characters. That is, this is what the user thinks of as a “character”.', 'sigs' => ['multi  chars(Cool $x)', 'multi  chars(Str:D $x)', 'multi  chars(str $x --> int)', 'method chars(--> Int:D)'], 'returns' => ['int', 'Int:D'] },
        { 'name' => 'codes', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns the number of L<Unicode code points|https://en.wikipedia.org/wiki/Code_point>. The same result will be obtained with L<ords|/routine/ords> first obtains the actual codepoints, so there might be a difference in speed.', 'sigs' => ['sub codes(Str(Cool))', 'method codes()'], 'returns' => [] },
        { 'name' => 'flip', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns a reversed version.', 'sigs' => ['sub flip(Cool $s --> Str:D)', 'method flip()'], 'returns' => ['Str:D'] },
        { 'name' => 'trim', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns the string with both leading and trailing whitespace stripped.', 'sigs' => ['sub trim(Str(Cool))', 'method trim()'], 'returns' => [] },
        { 'name' => 'trim-leading', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns the string with leading whitespace stripped.', 'sigs' => ['sub trim-leading(Str(Cool))', 'method trim-leading()'], 'returns' => [] },
        { 'name' => 'trim-trailing', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns the string with trailing whitespace stripped.', 'sigs' => ['sub trim-trailing(Str(Cool))', 'method trim-trailing()'], 'returns' => [] },
        { 'name' => 'lc', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns it case-folded to lowercase.', 'sigs' => ['sub lc(Str(Cool))', 'method lc()'], 'returns' => [] },
        { 'name' => 'uc', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns it case-folded to uppercase (capital letters).', 'sigs' => ['sub uc(Str(Cool))', 'method uc()'], 'returns' => [] },
        { 'name' => 'fc', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns the result a Unicode "case fold" operation suitable for doing caseless string comparisons. (In general, the returned string is unlikely to be useful for any purpose other than comparison.)', 'sigs' => ['sub fc(Str(Cool))', 'method fc()'], 'returns' => [] },
        { 'name' => 'tc', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns it with the first letter case-folded to titlecase (or where not available, uppercase).', 'sigs' => ['sub tc(Str(Cool))', 'method tc()'], 'returns' => [] },
        { 'name' => 'tclc', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns it with the first letter case-folded to titlecase (or where not available, uppercase), and the rest of the string case-folded to lowercase.', 'sigs' => ['sub tclc(Str(Cool))', 'method tclc()'], 'returns' => [] },
        { 'name' => 'wordcase', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, the first argument) to L<C<Str>|/type/Str>, and filters each word that smartmatches against C<$where> through the C<&filter>. With the default filter (first character to uppercase, rest to lowercase) and matcher (which accepts everything), this titlecases each word: With a matcher: With a customer filter too:', 'sigs' => ['sub wordcase(Str(Cool) $input, :&filter = &tclc, Mu :$where = True)', 'method wordcase(:&filter = &tclc, Mu :$where = True)'], 'returns' => [] },
        { 'name' => 'samecase', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, the first argument) to L<C<Str>|/type/Str>, and calls L«C<Str.samecase>|/type/Str#method_samecase» on it.', 'sigs' => ['sub samecase(Cool $string, Cool $pattern)', 'method samecase(Cool:D: Cool $pattern)'], 'returns' => [] },
        { 'name' => 'uniprop', 'kind' => 'routine', 'summary' => 'Returns the L<unicode property|https://en.wikipedia.org/wiki/Unicode_character_property> of the first character. If no property is specified returns the L<General Category|https://en.wikipedia.org/wiki/Unicode_character_property#General_Category>. Returns a Bool for Boolean properties. A L<uniprops|/routine/uniprops> routine can be used to get the property for every character in a string.', 'sigs' => ['multi        uniprop(Str:D, |c)', 'multi        uniprop(Int:D $code)', 'multi        uniprop(Int:D $code, Stringy:D $propname)', 'multi method uniprop(|c)'], 'returns' => [] },
        { 'name' => 'uniprops', 'kind' => 'sub', 'summary' => 'Interprets the invocant as a L<C<Str>|/type/Str>, and returns the L<unicode property|http://userguide.icu-project.org/strings/properties> for each character as a Seq. If no property is specified returns the L<General Category|https://en.wikipedia.org/wiki/Unicode_character_property#General_Category>. Returns a Bool for Boolean properties. Similar to L<uniprop|/routine/uniprop>, but for each character in the passed', 'sigs' => ['sub uniprops(Str:D $str, Stringy:D $propname = "General_Category")'], 'returns' => [] },
        { 'name' => 'uniname', 'kind' => 'routine', 'summary' => 'Interprets the invocant or first argument as a L<C<Str>|/type/Str>, and returns the Unicode codepoint name of the first codepoint of the first character. See L<uninames|/routine/uninames> for a routine that works with multiple codepoints, and L<uniparse|/routine/uniparse> for the opposite direction. Available as of the 2021.04 Rakudo compiler release.', 'sigs' => ['sub uniname(Str(Cool) --> Str)', 'method uniname(--> Str)'], 'returns' => ['Str', 'Str'] },
        { 'name' => 'uninames', 'kind' => 'routine', 'summary' => 'Returns of a L<C<Seq>|/type/Seq> of Unicode names for the all the codepoints in the L<C<Str>|/type/Str> provided. Note this example, which gets a L<C<Seq>|/type/Seq> where each element is a L<C<Seq>|/type/Seq> of all the codepoints in that character. See L<uniname|/routine/uniname> for the name of the first codepoint of the first character in the provided L<C<Str>|/type/Str> and L<uniparse|/routine/uniparse> for the', 'sigs' => ['sub uninames(Str:D)', 'method uninames()'], 'returns' => [] },
        { 'name' => 'unimatch', 'kind' => 'routine', 'summary' => 'Checks if the given integer codepoint or the first letter of the given string has a unicode property equal to the value you give. If you supply the Unicode property to be checked it will only return True if that property matches the given value. The last property corresponds to "lowercase letter", which explains why it returns false.', 'sigs' => ['multi unimatch(Str:D $str, |c)', 'multi unimatch(Int:D $code, Stringy:D $pvalname, Stringy:D $propname = $pvalname)'], 'returns' => [] },
        { 'name' => 'chop', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns it with the last character removed.', 'sigs' => ['sub chop(Str(Cool))', 'method chop()'], 'returns' => [] },
        { 'name' => 'chomp', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in sub form, its argument) to L<C<Str>|/type/Str>, and returns it with the last character removed, if it is a logical newline.', 'sigs' => ['sub chomp(Str(Cool))', 'method chomp()'], 'returns' => [] },
        { 'name' => 'substr', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in the sub form, the first argument) to L<C<Str>|/type/Str>, and calls L<Str.substr|/type/Str#routine_substr> with the arguments.', 'sigs' => ['sub substr(Str(Cool) $str, |c)', 'method substr(|c)'], 'returns' => [] },
        { 'name' => 'substr-rw', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in the sub form, the first argument) to L<C<Str>|/type/Str>, and calls L<Str.substr-rw|/type/Str#method_substr-rw> with the arguments.', 'sigs' => ['multi method substr-rw(|) is rw', 'multi        substr-rw(|) is rw'], 'returns' => [] },
        { 'name' => 'ords', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in the sub form, the first argument) to L<C<Str>|/type/Str>, and returns a list of Unicode codepoints for each character. This is the list-returning version of L<ord|/routine/ord>. The inverse operation in L<chrs|/routine/chrs>. If you are only interested in the number of codepoints, L<codes|/routine/codes> is a possibly faster option.', 'sigs' => ['sub ords(Str(Cool) $str)', 'method ords()'], 'returns' => [] },
        { 'name' => 'chrs', 'kind' => 'routine', 'summary' => 'Coerces the invocant (or in the sub form, the argument list) to a list of integers, and returns the string created by interpreting each integer as a Unicode codepoint, and joining the characters. This is the list-input version of L<chr|/routine/chr>. The inverse operation is L<ords|/routine/ords>.', 'sigs' => ['sub chrs(*@codepoints --> Str:D)', 'method chrs()'], 'returns' => ['Str:D'] },
        { 'name' => 'split', 'kind' => 'routine', 'summary' => 'N<I«the L<comb|/routine/comb> routine is a much better choice for many tasks that in other languages are handled by the C<split>.»> Coerces the invocant (or in the sub form, the second argument) to L<C<Str>|/type/Str>, splits it into pieces based on delimiters found in the string and returns the result as a L«C<Seq>|/type/Seq». If C<$delimiter> is a string, it is searched for literally and not treated', 'sigs' => ['multi        split(  Str:D $delimiter, Str(Cool) $input, $limit = Inf, :$k, :$v, :$kv, :$p, :$skip-empty)', 'multi        split(Regex:D $delimiter, Str(Cool) $input, $limit = Inf, :$k, :$v, :$kv, :$p, :$skip-empty)', 'multi        split(@delimiters, Str(Cool) $input, $limit = Inf, :$k, :$v, :$kv, :$p, :$skip-empty)', 'multi method split(  Str:D $delimiter, $limit = Inf, :$k, :$v, :$kv, :$p, :$skip-empty)', 'multi method split(Regex:D $delimiter, $limit = Inf, :$k, :$v, :$kv, :$p, :$skip-empty)', 'multi method split(@delimiters, $limit = Inf, :$k, :$v, :$kv, :$p, :$skip-empty)'], 'returns' => [] },
        { 'name' => 'lines', 'kind' => 'routine', 'summary' => 'Coerces the invocant (and in sub form, the argument) to L<C<Str>|/type/Str>, decomposes it into lines (with the newline characters stripped), and returns the list of lines. This method can be used as part of an L«C<IO::Path>|/type/IO::Path» to process a file line-by-line, since L<C<IO::Path>|/type/IO::Path> objects inherit from C<Cool>, e.g.: Without any arguments, sub C<lines> operates on L«C<$*ARGFILES>|/language/variables#$*ARGFILES».', 'sigs' => ['sub lines(Str(Cool))', 'method lines()'], 'returns' => [] },
        { 'name' => 'words', 'kind' => 'method', 'summary' => 'Coerces the invocant (or first argument, if it is called as a subroutine) to L<C<Str>|/type/Str>, and returns a list of words that make up the string. Check L<C<Str.words>|/type/Str#routine_words> for additional arguments and its meaning. C<Cool> is the base class for many other classes, and some of them, like L<C<Match>|/type/Match>, can be converted to a string. This is what happens in this case:', 'sigs' => ['method words(Cool:D: |c)'], 'returns' => [] },
        { 'name' => 'comb', 'kind' => 'routine', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of all (or if supplied, at most C<$limit>) matches of the invocant (method form) or the second argument (sub form) against the L<C<Regex>|/type/Regex>, string or defined number. The second statement exemplifies the first form of C<comb>, with a L<C<Regex>|/type/Regex> that excludes multiples of ten, and a L<C<Range>|/type/Range> (which is C<Cool>) as C<$input>. C<comb> stringifies the L<C<Range>|/type/Range> before applying C<.comb> on the resulting', 'sigs' => ['multi        comb(Regex $matcher, Cool $input, $limit = *)', 'multi        comb(Str $matcher, Cool $input, $limit = *)', 'multi        comb(Int:D $size, Cool $input, $limit = *)', 'multi method comb(|c)'], 'returns' => [] },
        { 'name' => 'contains', 'kind' => 'method', 'summary' => 'Coerces the invocant to a L<C<Str>|/type/Str>, and calls L<C<Str.contains>|/type/Str#method_contains> on it. Please refer to that version of the method for arguments and general syntax. Since L<C<Int>|/type/Int> is a subclass of C<Cool>, C<123> is coerced to a L<C<Str>|/type/Str> and then C<contains> is called on it. L<C<Seq>|/type/Seq>s are also subclasses of C<Cool>, and they are stringified to a', 'sigs' => ['method contains(Cool:D: |c)'], 'returns' => [] },
        { 'name' => 'index', 'kind' => 'routine', 'summary' => 'Coerces the first two arguments (in method form, also counting the invocant) to a L<C<Str>|/type/Str>, and searches for C<$needle> in the string C<$s> starting from C<$pos>. It returns the offset into the string where C<$needle> was found, and L<C<Nil>|/type/Nil> if it was not found. See L<the documentation in type Str|/type/Str#method_index> for examples.', 'sigs' => ['multi        index(Cool:D $s, Cool:D $needle, :i(:$ignorecase), :m(:$ignoremark) --> Int:D)', 'multi        index(Cool:D $s, Cool:D $needle, Cool:D $pos, :i(:$ignorecase), :m(:$ignoremark) --> Int:D)', 'multi method index(Cool:D: Cool:D $needle --> Int:D)', 'multi method index(Cool:D: Cool:D $needle, :m(:$ignoremark)! --> Int:D)', 'multi method index(Cool:D: Cool:D $needle, :i(:$ignorecase)!, :m(:$ignoremark) --> Int:D)', 'multi method index(Cool:D: Cool:D $needle, Cool:D $pos --> Int:D)', 'multi method index(Cool:D: Cool:D $needle, Cool:D $pos, :m(:$ignoremark)!  --> Int:D)', 'multi method index(Cool:D: Cool:D $needle, Cool:D $pos, :i(:$ignorecase)!, :m(:$ignoremark) --> Int:D)'], 'returns' => ['Int:D', 'Int:D', 'Int:D', 'Int:D', 'Int:D', 'Int:D', 'Int:D', 'Int:D'] },
        { 'name' => 'rindex', 'kind' => 'routine', 'summary' => 'Coerces the first two arguments (including the invocant in method form) to L<C<Str>|/type/Str> and C<$pos> to L<C<Int>|/type/Int>, and returns the last position of C<$needle> in the string not after C<$pos>. Returns L<C<Nil>|/type/Nil> if C<$needle> wasn\'t found. See L<the documentation in type Str|/type/Str#routine_rindex> for examples.', 'sigs' => ['multi        rindex(Cool:D $s, Cool:D $needle --> Int:D)', 'multi        rindex(Cool:D $s, Cool:D $needle, Cool:D $pos --> Int:D)', 'multi method rindex(Cool:D: Cool:D $needle --> Int:D)', 'multi method rindex(Cool:D: Cool:D $needle, Cool:D $pos --> Int:D)'], 'returns' => ['Int:D', 'Int:D', 'Int:D', 'Int:D'] },
        { 'name' => 'match', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Stringy>|/type/Stringy> and calls the method L<match|/type/Str#method_match> on it.', 'sigs' => ['method match(Cool:D: $target, *%adverbs)'], 'returns' => [] },
        { 'name' => 'roots', 'kind' => 'routine', 'summary' => 'Coerces the first argument (and in method form, the invocant) to L<C<Numeric>|/type/Numeric> and the second (C<$n>) to L<C<Int>|/type/Int>, and produces a list of C<$n> L<C<Complex>|/type/Complex> C<$n>-roots, which means numbers that, raised to the C<$n>th power, approximately produce the original number. For example', 'sigs' => ['multi        roots(Numeric(Cool) $x, Int(Cool) $n)', 'multi method roots(Int(Cool) $n)'], 'returns' => [] },
        { 'name' => 'subst', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Stringy>|/type/Stringy> and calls L<Str.subst|/type/Str#method_subst>.', 'sigs' => ['method subst(|)'], 'returns' => [] },
        { 'name' => 'trans', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Str>|/type/Str> and calls L<Str.trans|/type/Str#method_trans>', 'sigs' => ['method trans(|)'], 'returns' => [] },
        { 'name' => 'IO', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<IO::Path>|/type/IO::Path>.', 'sigs' => ['method IO(--> IO::Path:D)'], 'returns' => ['IO::Path:D'] },
        { 'name' => 'sprintf', 'kind' => 'method', 'summary' => 'Returns a string according to a series of L<format directives|/type/independent-routines#Directives> that are common in many languages; the object will be the format string, while the supplied arguments will be what\'s going to be formatted according to it.', 'sigs' => ['method sprintf(*@args)'], 'returns' => [] },
        { 'name' => 'printf', 'kind' => 'method', 'summary' => 'Uses the object, as long as it is a L<format string|/type/independent-routines#Directives>, to format and print the arguments', 'sigs' => ['method printf(*@args)'], 'returns' => [] },
        { 'name' => 'Complex', 'kind' => 'method', 'summary' => 'Coerces the invocant to a L«C<Numeric>|/type/Numeric» and calls its L«C<.Complex>|/routine/Complex» method. L<Fails|/routine/fail> if the coercion to a L<C<Numeric>|/type/Numeric> cannot be done.', 'sigs' => ['multi method Complex()'], 'returns' => [] },
        { 'name' => 'FatRat', 'kind' => 'method', 'summary' => 'Coerces the invocant to a L«C<Numeric>|/type/Numeric» and calls its L«C<.FatRat>|/routine/FatRat» method. L<Fails|/routine/fail> if the coercion to a L<C<Numeric>|/type/Numeric> cannot be done.', 'sigs' => ['multi method FatRat()'], 'returns' => [] },
        { 'name' => 'Int', 'kind' => 'method', 'summary' => 'Coerces the invocant to a L«C<Numeric>|/type/Numeric» and calls its L«C<.Int>|/routine/Int» method. L<Fails|/routine/fail> if the coercion to a L<C<Numeric>|/type/Numeric> cannot be done.', 'sigs' => ['multi method Int()'], 'returns' => [] },
        { 'name' => 'Num', 'kind' => 'method', 'summary' => 'Coerces the invocant to a L«C<Numeric>|/type/Numeric» and calls its L«C<.Num>|/routine/Num» method. L<Fails|/routine/fail> if the coercion to a L<C<Numeric>|/type/Numeric> cannot be done.', 'sigs' => ['multi method Num()'], 'returns' => [] },
        { 'name' => 'Rat', 'kind' => 'method', 'summary' => 'Coerces the invocant to a L«C<Numeric>|/type/Numeric» and calls its L«C<.Rat>|/routine/Rat» method. L<Fails|/routine/fail> if the coercion to a L<C<Numeric>|/type/Numeric> cannot be done.', 'sigs' => ['multi method Rat()'], 'returns' => [] },
        { 'name' => 'Real', 'kind' => 'method', 'summary' => 'Coerces the invocant to a L«C<Numeric>|/type/Numeric» and calls its L«C<.Real>|/routine/Real» method. L<Fails|/routine/fail> if the coercion to a L<C<Numeric>|/type/Numeric> cannot be done.', 'sigs' => ['multi method Real()'], 'returns' => [] },
        { 'name' => 'UInt', 'kind' => 'method', 'summary' => 'Coerces the invocant to an L«C<Int>|/type/Int».  L<Fails|/routine/fail> if the coercion to an L<C<Int>|/type/Int> cannot be done or if the L<C<Int>|/type/Int> the invocant had been coerced to is negative.', 'sigs' => ['multi method UInt()'], 'returns' => [] },
        { 'name' => 'uniparse', 'kind' => 'method', 'summary' => 'Available as of the 2021.04 release of the Rakudo compiler. Coerces the invocant to a L<C<Str>|/type/Str> and then calls the L<uniparse|/type/Str#routine_uniparse> on that.  This mostly only makes sense for L<C<Match>|/type/Match> objects.', 'sigs' => ['method uniparse(Cool:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'Order', 'kind' => 'method', 'summary' => 'Available as of the 2022.02 release of the Rakudo compiler. Coerces the invocant to an L<C<Int>|/type/Int>, and then returns one of the L<C<Order>|/type/Order> enums: C<Less> if negative, C<Same> if B<0>, C<More> if positive.', 'sigs' => ['method Order(Cool:D: --> Order:D)'], 'returns' => ['Order:D'] },
        { 'name' => 'Failure', 'kind' => 'method', 'summary' => 'Available as of the 2022.06 release of the Rakudo compiler. Creates an L<C<X::AdHoc>|/type/X::AdHoc> exception with the stringification of the invocant, and coerces that into a L<C<Failure>|/type/Failure> object. Mainly intended to reduce the bytecode for error branches in code, to increase the chances of hot code getting inlined.', 'sigs' => ['method Failure(Cool:D: --> Failure:D)'], 'returns' => ['Failure:D'] },
      ],
      'examples' => [
        { 'code' => 'class Cool is Any { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '123.substr(1, 1);   # \'2\', same as 123.Str.substr(1, 1)', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
