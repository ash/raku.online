      'routines' => [
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'Usage: Returns C<True> if C<$other === self> (i.e. it checks object identity). Many built-in types override this for more specific comparisons.', 'sigs' => ['multi method ACCEPTS(Any:D: Mu $other)'], 'returns' => [] },
        { 'name' => 'any', 'kind' => 'routine', 'summary' => 'Interprets the invocant or arguments as a list and creates an L<any|/routine/any>-L<C<Junction>|/type/Junction> from it.', 'sigs' => ['method any(        --> Junction:D)', 'multi  any(+values --> Junction:D)', 'multi  any(@values --> Junction:D)'], 'returns' => ['Junction:D', 'Junction:D', 'Junction:D'] },
