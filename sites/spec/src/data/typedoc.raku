$supplier.done();              # got cha', 'expect' => '', 'routine' => 'Promise', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Supplier.new.Supply.live;    # OUTPUT: «True␤»', 'expect' => 'True
', 'routine' => 'live', 'opts' => '', 'preamble' => '' },
        { 'code' => ' sleep 1;
 say "One second: running.";
 sleep 1;
 $s.emit(42);
 $s.done;', 'expect' => '', 'routine' => 'wait', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $s = Supply.from-list(4, 10, 3, 2);
my $t = $s.grab(&sum);
