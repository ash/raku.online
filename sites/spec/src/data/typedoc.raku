(bacon eggs bacon)
', 'routine' => 'roll', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $random_dishes := $breakfast.roll(*);
say $random_dishes[^5];                               # OUTPUT: «(bacon eggs bacon bacon bacon)␤»', 'expect' => '(bacon eggs bacon bacon bacon)
', 'routine' => 'roll', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = bag <bacon eggs bacon>;
