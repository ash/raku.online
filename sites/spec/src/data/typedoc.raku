}
say Boring::.^name;             # OUTPUT: «Stash␤»
say Boring.WHO === Boring::;    # OUTPUT: «True␤»', 'expect' => 'Stash
True
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Boring::.keys.sort;         # OUTPUT: «(&package_sub Nested)␤»
say Boring::<Nested>;           # OUTPUT: «(Nested)␤»', 'expect' => '(&package_sub Nested)
(Nested)
', 'routine' => '', 'opts' => ':skip-test<compile time error>', 'preamble' => '' },
