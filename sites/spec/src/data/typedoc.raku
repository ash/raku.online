say $breakfast.grabpairs(1);                      # OUTPUT: «(eggs => 2)␤»
say $breakfast.grabpairs(*);                      # OUTPUT: «()␤»', 'expect' => 'bacon => 3
BagHash.new(eggs(2))
(eggs => 2)
()
', 'routine' => 'grabpairs', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $diet = (\'eggs\' => 2, \'bacon\' => 3).Bag;
say $diet.grabpairs;
CATCH { default { put .^name, \': \', .Str } };
# OUTPUT: «X::Immutable: Cannot call \'grabpairs\' on an immutable \'Bag\'␤»', 'expect' => 'X::Immutable: Cannot call \'grabpairs\' on an immutable \'Bag\'
', 'routine' => 'grabpairs', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = bag <eggs bacon bacon bacon>;
say $breakfast.pick;                              # OUTPUT: «eggs␤»
