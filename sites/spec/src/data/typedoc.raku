', 'routine' => 'antipairs', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = bag <bacon eggs bacon>;
my $seq = $breakfast.invert;
say $seq.sort;                                    # OUTPUT: «(1 => eggs 2 => bacon)␤»', 'expect' => '(1 => eggs 2 => bacon)
', 'routine' => 'invert', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say BagHash.new.classify-list: { $_ %% 2 ?? \'even\' !! \'odd\' }, ^10;
# OUTPUT: BagHash(even(5) odd(5))', 'expect' => '', 'routine' => 'classify-list', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my @mapper = <zero one two three four five>;
say MixHash.new.classify-list: @mapper, 1, 2, 3, 4, 4, 6;
# OUTPUT: MixHash((Any) two three four(2) one)', 'expect' => '', 'routine' => 'classify-list', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say BagHash.new.categorize-list: {
    gather {
        take \'largish\' if $_ > 5;
        take .is-prime ?? \'prime\' !! \'non-prime\';
        take $_ %% 2   ?? \'even\'  !! \'odd\';
    }
}, ^10;
# OUTPUT: BagHash(largish(4) even(5) non-prime(6) prime(4) odd(5))', 'expect' => '', 'routine' => 'categorize-list', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %mapper = :sugar<sweet white>, :lemon<sour>, :cake(\'sweet\', \'is-a-lie\');
say MixHash.new.categorize-list: %mapper, <sugar lemon cake>;
# OUTPUT: MixHash(is-a-lie sour white sweet(2))', 'expect' => '', 'routine' => 'categorize-list', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = bag <eggs spam spam spam>;
say $breakfast.keys.sort;                        # OUTPUT: «(eggs spam)␤»', 'expect' => '(eggs spam)
', 'routine' => 'keys', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $n = ("a" => 5, "b" => 2).BagHash;
say $n.keys.sort;                                # OUTPUT: «(a b)␤»', 'expect' => '(a b)
