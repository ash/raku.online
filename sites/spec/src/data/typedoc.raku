(bacon => 3)
(eggs => 1 bacon => 3)
', 'routine' => 'pickpairs', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = bag <eggs bacon bacon bacon>;
say $breakfast.roll;                                  # OUTPUT: «bacon␤»
