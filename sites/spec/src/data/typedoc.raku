processors => <words val>,
segments   => (
  RakuAST::StrLiteral.new("B C"),
)
  )
);', 'expect' => '', 'routine' => 'add-config', 'opts' => ':preamble<my $block;use experimental :rakuast>', 'preamble' => 'my $block;use experimental :rakuast' },
        { 'code' => '$block.set-paragraphs( ("foo\\n\\n","bar\\n") );', 'expect' => '', 'routine' => 'set-paragraphs', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => '$block.add-paragraph("baz\\n\\n");', 'expect' => '', 'routine' => 'add-paragraph', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => '$block.literalize-config;
say "allowed are: $block.resolved-config<allowed>";', 'expect' => '', 'routine' => 'literalize-config', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
      ],
