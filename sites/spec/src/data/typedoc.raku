      'name' => 'Lock::Async',
      'file' => 'Async',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'A non-blocking, non-re-entrant, mutual exclusion lock',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'lock', 'kind' => 'method', 'summary' => 'Returns a L<C<Promise>|/type/Promise> that will be kept when the lock is available. In the case that the lock is already available, an already kept L<C<Promise>|/type/Promise> will be returned. Use C<await> to wait for the lock to be available in a non-blocking manner. Prefer to use L<protect|/type/Lock/Async#method_protect> instead of explicit calls to C<lock> and C<unlock>.', 'sigs' => ['method lock(Lock::Async:D: --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'unlock', 'kind' => 'method', 'summary' => 'Releases the lock. If there are any outstanding C<lock> L<C<Promise>|/type/Promise>s, the one at the head of the queue will then be kept, and potentially code scheduled on the thread pool (so the cost of calling C<unlock> is limited to the work needed to schedule another piece of code that wants to obtain the lock, but not to execute that code). Prefer to use L<protect|/type/Lock/Async#method_protect> instead of', 'sigs' => ['method unlock(Lock::Async:D: --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'protect', 'kind' => 'method', 'summary' => 'This method reliably wraps code passed to C<&code> parameter with a lock it is called on.  It calls C<lock>, does an C<await> to wait for the lock to be available, and reliably calls C<unlock> afterwards, even if the code throws an exception. Note that the C<Lock::Async> itself needs to be created outside the portion of the code that gets threaded and it needs to protect. In the first example below,', 'sigs' => ['method protect(Lock::Async:D: &code)'], 'returns' => [] },
        { 'name' => 'protect-or-queue-on-recursion', 'kind' => 'method', 'summary' => 'When calling L<protect|/type/Lock/Async#method_protect> on a C<Lock::Async> instance that is already locked, the method is forced to block until the lock gets unlocked. C<protect-or-queue-on-recursion> avoids this issue by either behaving the same as L<protect|/type/Lock/Async#method_protect> if the lock is unlocked or the lock was locked by something outside the caller chain, returning L<C<Nil>|/type/Nil>, or queueing the call to C<&code> and returning a L<C<Promise>|/type/Promise>', 'sigs' => ['method protect-or-queue-on-recursion(Lock::Async:D: &code)'], 'returns' => [] },
        { 'name' => 'with-lock-hidden-from-recursion-check', 'kind' => 'method', 'summary' => 'Temporarily resets the Lock::Async recursion list so that it no longer includes the lock this method is called on and runs the given C<&code> immediately if the call to the method occurred in a caller chain where L<protect-or-queue-on-recursion|/type/Lock/Async#method_protect-or-queue-on-recursion> has already been called and the lock has been placed on the recursion list.', 'sigs' => ['method with-lock-hidden-from-recursion-check(&code)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Lock::Async {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $l = Lock::Async.new;
await $l.lock;', 'expect' => '', 'routine' => 'lock', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $l = Lock::Async.new;
await $l.lock;
$l.unlock;', 'expect' => '', 'routine' => 'unlock', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $l = Lock::Async.new;
{
    await $l.lock;
    LEAVE $l.unlock;
}', 'expect' => '', 'routine' => 'unlock', 'opts' => '', 'preamble' => '' },
        { 'code' => '# Compute how many prime numbers there are in first 10 000 of them
# using 50 threads
my @primes = 0 .. 10_000;
my @results;
my @threads;

# Right: $lock is instantiated outside the portion of the
# code that will get threaded and be in need of protection,
# so all threads share the lock
my $lock = Lock::Async.new;
for ^50 -> $thread {
@threads.push: start {
    $lock.protect: {
        my $from = $thread * 200;
        my $to = ($thread + 1) * 200;
        @results.append: @primes[$from..$to].map(*.is-prime);
    }
}
}

# await for all threads to finish calculation
await Promise.allof(@writers);
# say how many prime numbers we found
say "We found " ~ @results.grep(*.value).elems ~ " prime numbers";', 'expect' => '', 'routine' => 'protect', 'opts' => ':preamble<my @writers>', 'preamble' => 'my @writers' },
        { 'code' => '# !!! WRONG !!! Lock::Async is instantiated inside threaded area,
# so all the 20 threads use 20 different locks, not syncing with
# each other
for ^50 -> $thread {
@threads.push: start {
    my $lock = Lock::Async.new;
    $lock.protect: {
        my $from = $thread * 200;
        my $to = ($thread + 1) * 200;
        @results.append: @primes[$from..$to].map(*.is-prime);
    }
}
}', 'expect' => '', 'routine' => 'protect', 'opts' => ':preamble<my @threads;my @results; my @primes>', 'preamble' => 'my @threads;my @results; my @primes' },
        { 'code' => 'my Lock::Async $lock .= new;
my Int         $count = 0;', 'expect' => '', 'routine' => 'protect-or-queue-on-recursion', 'opts' => '', 'preamble' => '' },
        { 'code' => '# The lock is unlocked, so the code runs instantly.
$lock.protect-or-queue-on-recursion({
    $count++
});', 'expect' => '', 'routine' => 'protect-or-queue-on-recursion', 'opts' => '', 'preamble' => '' },
        { 'code' => '# Here, we have caller recursion. The outer call only returns a Promise
# because the inner one does. If we try to await the inner call\'s Promise
# from the outer call, the two calls will block forever since the inner
# caller\'s Promise return value is just the outer\'s with a then block.
$lock.protect-or-queue-on-recursion({
    $lock.protect-or-queue-on-recursion({
        $count++
    }).then({
        $count++
    })
});', 'expect' => '', 'routine' => 'protect-or-queue-on-recursion', 'opts' => '', 'preamble' => '' },
