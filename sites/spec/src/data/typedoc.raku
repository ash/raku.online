    {
      'name' => 'RakuAST::Doc::Markup',
      'file' => 'Markup',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Contains the information about RakuDoc markup',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'The C<new> method can be called to create a new C<RakuAST::Doc::Markup> object.  It only takes named arguments, with the C<:letter> argument being mandatory. Note that all arguments except C<:letter> are optional.  So it is possible to create "empty" markup as well. The "type" of markup object.  Generally expected to be an uppercase letter, but this is not enforced.  The C<RakuDoc> standard assigns', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-atoms', 'kind' => 'method', 'summary' => 'Set the atoms to the given L<C<Positional>|/type/Positional>.  Values are expected to be either a string, or a C<RakuAST::Doc::Markup> object. If no values are specified, then the object will have no atoms.', 'sigs' => [], 'returns' => [] },
