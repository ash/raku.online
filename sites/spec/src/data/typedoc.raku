      'name' => 'Associative',
      'file' => 'Associative',
      'subkind' => 'role',
      'category' => 'composite',
      'subtitle' => 'Object that supports looking up values by key',
      'declkind' => 'role',
      'consumers' => ['Telemetry::Period', 'IO::Path::Parts', 'Pair', 'Map', 'QuantHash'],
      'routines' => [
        { 'name' => 'of', 'kind' => 'method', 'summary' => 'C<Associative>, as the definition above shows, is actually a L<parameterized role|/language/objects#Parameterized_roles> which can use different classes for keys and values. As seen at the top of the document, by default it coerces the key to L<C<Str>|/type/Str> and uses a very generic L<C<Mu>|/type/Mu> for value. The value is the first parameter you use when instantiating C<Associative> with particular classes:', 'sigs' => ['method of()'], 'returns' => [] },
        { 'name' => 'keyof', 'kind' => 'method', 'summary' => 'Returns the parameterized key used for the Associative role, which is L<C<Any>|/type/Any> coerced to L<C<Str>|/type/Str> by default. This is the class used as second parameter when you use the parameterized version of Associative. You need to provide these methods if you want your class to implement the Associative role properly and, thus, use the C<{}> operator for accessing the value given a key. They are not mandatory, however; on the other hand, if you', 'sigs' => ['method keyof()'], 'returns' => [] },
        { 'name' => 'AT-KEY', 'kind' => 'method', 'summary' => 'Should return the value / container at the given key.', 'sigs' => ['method AT-KEY(\\key)'], 'returns' => [] },
        { 'name' => 'EXISTS-KEY', 'kind' => 'method', 'summary' => 'Should return a L<C<Bool>|/type/Bool> indicating whether the given key actually has a value.', 'sigs' => ['method EXISTS-KEY(\\key)'], 'returns' => [] },
        { 'name' => 'STORE', 'kind' => 'method', 'summary' => 'This method should only be supplied if you want to support the: syntax for binding your implementation of the C<Associative> role. Should accept the values to (re-)initialize the object with, which either could consist of L<C<Pair>|/type/Pair>s, or separate key/value pairs.  The optional named parameter will contain a C<True> value when the method is called on the object for the first time.  Should return the invocant.', 'sigs' => ['method STORE(\\values, :$INITIALIZE)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'role Associative[::TValue = Mu, ::TKey = Str(Any)] { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'class Whatever {};
my %whatever := Whatever.new;
# OUTPUT: «Type check failed in binding; expected Associative but got Whatever', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'class Whatever is Associative {};
my %whatever := Whatever.new;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
