    {
      'name' => 'X::Undeclared',
      'file' => 'Undeclared',
      'subkind' => 'class',
      'category' => 'exception',
      'subtitle' => 'Compilation error due to an undeclared symbol',
      'declkind' => 'class',
      'children' => ['X::Attribute::Undeclared'],
      'routines' => [
        { 'name' => 'symbol', 'kind' => 'method', 'summary' => 'Returns the name of the undeclared symbol', 'sigs' => [], 'returns' => [] },
        { 'name' => 'what', 'kind' => 'method', 'summary' => 'Returns the kind of symbol that was not declared (for example variable, type, routine). Since The symbol wasn\'t declared, the compiler sometimes has to guess (or rather disambiguate) what kind of symbol it encounter that wasn\'t declared. For example if you write Then the disambiguation defaults to reporting a missing subroutine, even though declaring a C<constant a = \'a\'> would also make the error go away.', 'sigs' => [], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class X::Undeclared does X::Comp {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
