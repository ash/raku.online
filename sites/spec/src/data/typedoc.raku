      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Creates and returns a new C<Thread>, without starting it yet. C<&code> is the code that will be run in a separate thread. C<$name> is a user-specified string that identifies the thread. If C<$app_lifetime> is set to C<True>, then the thread is killed when the main thread of the process terminates. If set to C<False>, the process will only terminate when the thread has finished.', 'sigs' => ['method new(:&code!, Bool :$app_lifetime = False, Str :$name = \'<anon>\' --> Thread:D)'], 'returns' => ['Thread:D'] },
        { 'name' => 'start', 'kind' => 'method', 'summary' => 'Creates, runs and returns a new C<Thread>. Note that it can (and often does) return before the thread\'s code has finished running.', 'sigs' => ['method start(Thread:U: &code, Bool :$app_lifetime = False, Str :$name = \'<anon>\' --> Thread:D)'], 'returns' => ['Thread:D'] },
        { 'name' => 'run', 'kind' => 'method', 'summary' => 'Runs the thread, and returns the invocant. It is an error to run a thread that has already been started.', 'sigs' => ['method run(Thread:D:)'], 'returns' => [] },
        { 'name' => 'id', 'kind' => 'method', 'summary' => 'Returns a numeric, unique thread identifier.', 'sigs' => ['method id(Thread:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'finish', 'kind' => 'method', 'summary' => 'Waits for the thread to finish. This is called L<join|#method_join> in other programming systems.', 'sigs' => ['method finish(Thread:D:)'], 'returns' => [] },
        { 'name' => 'join', 'kind' => 'method', 'summary' => 'Waits for the thread to finish.', 'sigs' => ['method join(Thread:D:)'], 'returns' => [] },
        { 'name' => 'yield', 'kind' => 'method', 'summary' => 'Tells the scheduler to prefer another thread for now.', 'sigs' => ['method yield(Thread:U:)'], 'returns' => [] },
        { 'name' => 'app_lifetime', 'kind' => 'method', 'summary' => 'Returns C<False> unless the named parameter C<:app_lifetime> is specifically set to C<True> during object creation. If the method returns C<False> it means that the process will only terminate when the thread has finished while C<True> means that the thread will be killed when the main thread of the process terminates.', 'sigs' => ['method app_lifetime(Thread:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'name', 'kind' => 'method', 'summary' => 'Returns the user defined string, which can optionally be set during object creation in order to identify the C<Thread>, or C<\'<anon>\'> if no such string was specified.', 'sigs' => ['method name(Thread:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'Numeric', 'kind' => 'method', 'summary' => 'Returns a numeric, unique thread identifier, i.e. the same as L<id|#method_id>.', 'sigs' => ['method Numeric(Thread:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Returns a string which contains the invocants L<thread id|#method_id> and L<name|#method_name>.', 'sigs' => ['method Str(Thread:D: --> Str:D)'], 'returns' => ['Str:D'] },
