say Any:U.^name; # OUTPUT: «Any:U␤»
say Any:_.^name; # OUTPUT: «Any␤»', 'expect' => 'Any:D
Any:U
Any
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Any ~~ Any:D;     # OUTPUT: «False␤»
