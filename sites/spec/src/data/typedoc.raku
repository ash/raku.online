      'routines' => [
        { 'name' => 'recv', 'kind' => 'method', 'summary' => 'Receive a packet and return it, either as a L<C<Blob>|/type/Blob> if C<:bin> was passed, or a L<C<Str>|/type/Str> if not. Receives up to C<$elems> or C<65535> (whichever is smaller) bytes or characters. If the socket has previously been read from in non-C<:bin> mode, it\'s not always safe to read from it in C<:bin> mode again. Depending on the decoder it\'s possible for the C<:bin> read to skip over bytes that the decoder has read', 'sigs' => ['method recv(IO::Socket:D: Cool $elems = Inf, :$bin)'], 'returns' => [] },
        { 'name' => 'read', 'kind' => 'method', 'summary' => 'Reads C<$bytes> bytes from the socket and returns them in a L<C<Blob>|/type/Blob>. The same caveat of mixed binary and non-binary reads described in L<method recv|#method recv> applies. Fails if the socket is not connected.', 'sigs' => ['method read(IO::Socket:D: Int(Cool) $bytes)'], 'returns' => [] },
        { 'name' => 'get', 'kind' => 'routine', 'summary' => 'Reads a single line of input from the socket, removing the trailing newline characters (as set by L«C<.nl-in>|/routine/nl-in»). Returns L<C<Nil>|/type/Nil>, if no more input is available. Fails if the socket is not connected.', 'sigs' => ['method get(IO::Socket:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'print', 'kind' => 'method', 'summary' => 'Writes the supplied string to the socket, thus sending it to other end of the connection. The binary version is L<method write|#method write>. Fails if the socket is not connected.', 'sigs' => ['method print(IO::Socket:D: Str(Cool) $string)'], 'returns' => [] },
        { 'name' => 'write', 'kind' => 'method', 'summary' => 'Writes the supplied buffer to the socket, thus sending it to other end of the connection. The string version is L<method print|#method print>. Fails if the socket is not connected.', 'sigs' => ['method write(IO::Socket:D: Blob:D $buf)'], 'returns' => [] },
        { 'name' => 'put', 'kind' => 'method', 'summary' => 'Writes the supplied string, with a C<\\n> appended to it, to the socket, thus sending it to other end of the connection. Fails if the socket is not connected.', 'sigs' => ['method put(IO::Socket:D: Str(Cool) $string)'], 'returns' => [] },
        { 'name' => 'close', 'kind' => 'method', 'summary' => 'Closes the socket. Fails if the socket is not connected.', 'sigs' => ['method close(IO::Socket:D)'], 'returns' => [] },
        { 'name' => 'native-descriptor', 'kind' => 'method', 'summary' => 'This returns a value that the operating system would understand as a "socket descriptor" and is suitable for passing to a native function that requires a socket descriptor as an argument such as C<setsockopt>.', 'sigs' => ['method native-descriptor()'], 'returns' => [] },
