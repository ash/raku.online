  :margin("  "),
  :type<foo>,
  :paragraphs("bar\\n",)
);', 'expect' => '', 'routine' => 'new', 'opts' => ':lang<raku> :preamble<use experimental :rakuast>', 'preamble' => 'use experimental :rakuast' },
        { 'code' => 'frobnicate => 42', 'expect' => '', 'routine' => 'new', 'opts' => '', 'preamble' => '' },
        { 'code' => 'frobnicate => RakuAST::IntLiteral.new(42)', 'expect' => '', 'routine' => 'new', 'opts' => ':preamble<use experimental :rakuast>', 'preamble' => 'use experimental :rakuast' },
        { 'code' => '  =begin foo
