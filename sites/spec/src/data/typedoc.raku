      'name' => 'Exception',
      'file' => 'Exception',
      'subkind' => 'class',
      'category' => 'exception',
      'subtitle' => 'Anomalous event capable of interrupting normal control-flow',
      'declkind' => 'class',
      'children' => ['X::AdHoc', 'X::Cannot::Empty', 'X::Cannot::Lazy', 'X::Method::NotFound', 'X::Method::InvalidQualifier', 'X::OutOfRange', 'X::Routine::Unwrap', 'X::Constructor::Positional', 'X::Hash::Store::OddNumber', 'X::Phaser::PrePost', 'X::Sequence::Deduction', 'X::Assignment::RO', 'X::NoDispatcher', 'X::Localizer::NoContainer', 'X::Inheritance::NotComposed', 'X::Inheritance::Unsupported', 'X::HyperOp::NonDWIM', 'X::Set::Coerce', 'X::StubCode', 'X::Eval::NoSuchLang', 'X::Seq::Consumed', 'X::Symbol::Kind', 'X::Proc::Unsuccessful', 'X::Numeric::CannotConvert', 'X::Str::Numeric', 'X::Str::Match::x', 'X::Str::Trans::IllegalKey', 'X::Str::Trans::InvalidArg', 'X::Buf::AsStr', 'X::Buf::Pack', 'X::Buf::Pack::NonASCII', 'X::Proc::Async', 'X::Promise::CauseOnlyValidOnBroken', 'X::Promise::Vowed', 'X::Channel::SendOnClosed', 'X::Channel::ReceiveOnClosed', 'X::Temporal', 'X::Scheduler::CueInNaNSeconds', 'X::Export::NameClash', 'X::Import::MissingSymbols', 'X::Composition::NotComposable', 'X::Mixin::NotComposable', 'X::TypeCheck', 'X::ControlFlow', 'X::OS', 'X::IO::Rename', 'X::IO::Move', 'X::IO::Copy', 'X::IO::Mkdir', 'X::IO::Chdir', 'X::IO::Dir', 'X::IO::Cwd', 'X::IO::Rmdir', 'X::IO::Link', 'X::IO::Unlink', 'X::IO::Symlink', 'X::IO::Chmod', 'X::IO::DoesNotExist', 'X::Comp', 'X::Comp::Group', 'X::Attribute::Required', 'X::Bind', 'X::Bind::Slice', 'X::Trait::NotOnNative', 'X::Trait::Scope', 'X::Trait::Unknown', 'X::Does::TypeObject', 'X::NYI', 'X::Role::Initialization', 'X::Dynamic::NotFound', 'X::Control'],
      'routines' => [
        { 'name' => 'message', 'kind' => 'method', 'summary' => 'This is a stub that must be overwritten by subclasses, and should return the exception message. Special care should be taken that this method does not produce an exception itself.', 'sigs' => ['method message(Exception:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'backtrace', 'kind' => 'method', 'summary' => 'Returns the backtrace associated with the exception in a L<C<Backtrace>|/type/Backtrace> object or an empty string if there is none. Only makes sense on exceptions that have been thrown at least once.', 'sigs' => ['method backtrace(Exception:D:)'], 'returns' => [] },
        { 'name' => 'throw', 'kind' => 'method', 'summary' => 'Throws the exception.', 'sigs' => ['method throw(Exception:D:)'], 'returns' => [] },
        { 'name' => 'resume', 'kind' => 'method', 'summary' => 'Resumes control flow where C<.throw> left it when handled in a C<CATCH> block.', 'sigs' => ['method resume(Exception:D:)'], 'returns' => [] },
        { 'name' => 'rethrow', 'kind' => 'method', 'summary' => 'Rethrows an exception that has already been thrown at least once. This is different from C<throw> in that it preserves the original backtrace.', 'sigs' => ['method rethrow(Exception:D:)'], 'returns' => [] },
        { 'name' => 'fail', 'kind' => 'routine', 'summary' => 'Exits the calling L<C<Routine>|/type/Routine> and returns a L<C<Failure>|/type/Failure> object wrapping the exception. The routine form works in the same way, with an alternative syntax: C<fail ForbiddenWord.new(:word($word))>.', 'sigs' => ['multi  fail(Exception $e)', 'method fail(Exception:D:)'], 'returns' => [] },
        { 'name' => 'gist', 'kind' => 'method', 'summary' => 'Returns whatever the exception printer should produce for this exception. The default implementation returns message and backtrace separated by a newline.', 'sigs' => ['multi method gist(Exception:D:)'], 'returns' => [] },
        { 'name' => 'Failure', 'kind' => 'method', 'summary' => 'Available as of the 2022.06 release of the Rakudo compiler. Coerces the C<Exception> into a L<C<Failure>|/type/Failure> object.', 'sigs' => ['method Failure(Exception:D: --> Failure:D)'], 'returns' => ['Failure:D'] },
        { 'name' => 'die', 'kind' => 'routine', 'summary' => 'Throws a fatal C<Exception>. The default exception handler prints each element of the list to L«C<$*ERR>|/language/variables#index-entry-%24%2AERR» (STDERR). If the subroutine form is called without arguments, the value of L«C<$!> variable|/syntax/$!» is checked. If it is set to a L«C<.DEFINITE>|/language/mop#DEFINITE» value, its value will be used as the C<Exception> to throw if it\'s of type C<Exception>, otherwise, it will be used as payload of', 'sigs' => ['multi  die()', 'multi  die(*@message)', 'multi  die(Exception:D $e)', 'method die(Exception:D:)'], 'returns' => [] },
        { 'name' => 'warn', 'kind' => 'sub', 'summary' => 'Throws a resumable warning exception, which is considered a control exception, and hence is invisible to most normal exception handlers.  The outermost control handler will print the warning to C<$*ERR>. After printing the warning, the exception is resumed where it was thrown.  To override this behavior, catch the exception in a C<CONTROL> block.  A C<quietly {...}> block is the opposite of a C<try {...}> block in that it will suppress any', 'sigs' => ['multi warn(*@message)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Exception {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'class X::YourApp::SomeError is Exception {
    method message() {
        "A YourApp-Specific error occurred: out of coffee!";
    }
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'try die "Something bad happened";
if ($!) {
    say $!.message; # OUTPUT: «Something bad happened.␤»
}', 'expect' => 'Something bad happened.
', 'routine' => 'message', 'opts' => '', 'preamble' => '' },
        { 'code' => 'try die "Something bad happened";
with $! { .backtrace.print ; }', 'expect' => '', 'routine' => 'backtrace', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $exception = X::AdHoc.new;    # Totally fine
try $exception.throw;            # Throws
if ($!) { #`( some handling ) }; # Suppress the exception', 'expect' => '', 'routine' => 'throw', 'opts' => '', 'preamble' => '' },
        { 'code' => '# For example, resume control flow for any exception
CATCH { default { .resume } }', 'expect' => '', 'routine' => 'resume', 'opts' => '', 'preamble' => '' },
