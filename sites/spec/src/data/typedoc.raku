    {
      'name' => 'IO::Spec::Win32',
      'file' => 'Win32',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'Platform specific operations on file and directory paths for Windows',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'basename', 'kind' => 'method', 'summary' => 'Takes a path as a string and returns a possibly-empty portion after the last slash or backslash:', 'sigs' => ['method basename(Str:D $path --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'canonpath', 'kind' => 'method', 'summary' => 'Returns a string that is a canonical representation of C<$path>. If C<:$parent> is set to true, will also clean up references to parent directories. B<NOTE:> the routine does not access the filesystem.', 'sigs' => ['method canonpath(Str() $path, :$parent --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'catdir', 'kind' => 'method', 'summary' => 'Concatenates multiple path fragments and returns the canonical representation of the resultant path as a string. The C<@parts> are L«C<Str>|/type/Str» objects and are allowed to contain path separators.', 'sigs' => ['method catdir (*@parts --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'catfile', 'kind' => 'method', 'summary' => 'Alias for L«C<catdir>|/routine/catdir».', 'sigs' => [], 'returns' => [] },
        { 'name' => 'catpath', 'kind' => 'method', 'summary' => 'Concatenates a path from given volume, a chain of directories, and file. An empty string can be given for any of the three arguments. No attempt to make the path canonical is made. Use L«C<canonpath>|/routine/canonpath» for that purpose.', 'sigs' => ['method catpath (Str:D $volume, Str:D $dir, Str:D $file --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'devnull', 'kind' => 'method', 'summary' => 'Returns the string C<"nul"> representing the L<"Null device"|https://en.wikipedia.org/wiki/Null_device>:', 'sigs' => ['method devnull(--> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'dir-sep', 'kind' => 'method', 'summary' => 'Returns the string C<｢\\｣> representing canonical directory separator character.', 'sigs' => ['method dir-sep(--> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'is-absolute', 'kind' => 'method', 'summary' => 'Returns C<True> if the C<$path> starts with a slash (C<"/">) or backslash (C<"\\">), even if they have combining character on them, optionally preceded by a volume:', 'sigs' => ['method is-absolute(Str:D $path --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'join', 'kind' => 'method', 'summary' => 'Similar to L«C<catpath>|/routine/catpath», takes two path fragments and concatenates them, adding or removing a path separator, if necessary, except it will return just C<$file> if both C<$dir> and C<$file> are string C<\'/\'> or if C<$dir> is the string C<\'.\'>. The first argument is ignored (it exists to maintain consistent interface with other L<C<IO::Spec>|/type/IO::Spec> types for systems that have volumes).', 'sigs' => ['method join (Str:D $volume, Str:D $dir, Str:D $file --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'path', 'kind' => 'method', 'summary' => 'Splits the value of C«%*ENV<PATH>» (or C«%*ENV<Path>» if the former is not set) on semicolons (C<";">) and returns a L<C<Seq>|/type/Seq> with each of the resultant parts, always adding element C<"."> to the head. Removes all double quotes (C<">) it finds.', 'sigs' => ['method path(--> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'rel2abs', 'kind' => 'method', 'summary' => 'Returns a string representing C<$path> converted to absolute path, based at C<$base>, which defaults to C<$*CWD>. If C<$base> is not an absolute path, it will be made absolute relative to C<$*CWD>, unless C<$*CWD> and C<$base> are the same.', 'sigs' => ['method rel2abs(Str() $path, $base = $*CWD --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'rootdir', 'kind' => 'method', 'summary' => 'Returns string C<｢\\｣>, representing root directory.', 'sigs' => ['method rootdir(--> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'split', 'kind' => 'method', 'summary' => 'Creates an L«C<IO::Path::Parts>|/type/IO::Path::Parts» for C<$path>. B<Note>: Before Rakudo release 2020.06 this method split the given C<$path> into "volume", "dirname", and "basename" and returned the result as a L<C<List>|/type/List> of three L<C<Pair>|/type/Pair>s, in that order.', 'sigs' => ['method split(IO::Spec::Win32: Cool:D $path)'], 'returns' => [] },
        { 'name' => 'splitdir', 'kind' => 'method', 'summary' => 'Splits the given C<$path> on slashes and backslashes.', 'sigs' => ['method splitdir(Cool:D $path --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'splitpath', 'kind' => 'method', 'summary' => 'Splits the given C<$path> into a list of 3 strings: volume, dirname, and file. The volume is always an empty string, returned for API compatibility with other L<C<IO::Spec>|/type/IO::Spec> types. If C<:$nofile> named argument is set to C<True>, the content of the file string is undefined and should be ignored; this is a means to get a performance boost, as implementations may use faster code path when file is not needed.', 'sigs' => ['method splitpath(Cool:D $path, :$nofile --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'tmpdir', 'kind' => 'method', 'summary' => 'Attempts to locate a system\'s temporary directory by checking several typical directories and environment variables. Uses current directory if no suitable directories are found.', 'sigs' => ['method tmpdir(--> IO::Path:D)'], 'returns' => ['IO::Path:D'] },
      ],
      'examples' => [
        { 'code' => 'class IO::Spec::Win32 is IO::Spec::Unix { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Win32.basename("foo/bar/") .raku.say; # OUTPUT: «""␤»
IO::Spec::Win32.basename("foo/bar\\\\").raku.say; # OUTPUT: «""␤»
IO::Spec::Win32.basename("foo/bar/.").raku.say; # OUTPUT: «"."␤»
IO::Spec::Win32.basename("foo/bar")  .raku.say; # OUTPUT: «"bar"␤»', 'expect' => '""
""
"."
"bar"
', 'routine' => 'basename', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Win32.canonpath("C:/foo//../bar/../ber").say;
# OUTPUT: «C:\\foo\\..\\bar\\..\\ber␤»', 'expect' => 'C:\\foo\\..\\bar\\..\\ber
', 'routine' => 'canonpath', 'opts' => '', 'preamble' => '' },
        { 'code' => 'IO::Spec::Win32.canonpath("C:/foo///./../bar/../ber").say;
# OUTPUT: «C:\\foo\\..\\bar\\..\\ber␤»', 'expect' => 'C:\\foo\\..\\bar\\..\\ber
', 'routine' => 'canonpath', 'opts' => '', 'preamble' => '' },
