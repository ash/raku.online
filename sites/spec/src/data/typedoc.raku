    {
      'name' => 'Channel',
      'file' => 'Channel',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'Thread-safe queue for sending values from producers to consumers',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'send', 'kind' => 'method', 'summary' => 'Enqueues an item into the C<Channel>. Throws an exception of type L<C<X::Channel::SendOnClosed>|/type/X::Channel::SendOnClosed> if the C<Channel> has been closed already. This call will B<not> block waiting for a consumer to take the object. There is no set limit on the number of items that may be queued, so care should be taken to prevent runaway queueing.', 'sigs' => ['method send(Channel:D: \\item)'], 'returns' => [] },
        { 'name' => 'receive', 'kind' => 'method', 'summary' => 'Receives and removes an item from the C<Channel>. It blocks if no item is present, waiting for a C<send> from another thread. Throws an exception of type L<C<X::Channel::ReceiveOnClosed>|/type/X::Channel::ReceiveOnClosed> if the C<Channel> has been closed, and the last item has been removed already, or if C<close> is called while C<receive> is waiting for an item to arrive. If the C<Channel> has been marked as erratic with method C<fail>, and the last', 'sigs' => ['method receive(Channel:D:)'], 'returns' => [] },
        { 'name' => 'poll', 'kind' => 'method', 'summary' => 'Receives and removes an item from the C<Channel>. If no item is present, returns L<C<Nil>|/type/Nil> instead of waiting. See method C<receive> for a blocking version that properly responds to C<Channel> closing and failure.', 'sigs' => ['method poll(Channel:D:)'], 'returns' => [] },
        { 'name' => 'close', 'kind' => 'method', 'summary' => 'Close the C<Channel>, normally.  This makes subsequent C<send> calls die with L<C<X::Channel::SendOnClosed>|/type/X::Channel::SendOnClosed>.  Subsequent calls of C<.receive> may still drain any remaining items that were previously sent, but if the queue is empty, will throw an L<C<X::Channel::ReceiveOnClosed>|/type/X::Channel::ReceiveOnClosed> exception.  Since you can produce a L<C<Seq>|/type/Seq> from a C<Channel> by contextualizing to array with C<@()>', 'sigs' => ['method close(Channel:D:)'], 'returns' => [] },
        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Returns a list based on the L<C<Seq>|/type/Seq> which will iterate items in the queue and remove each item from it as it iterates. This can only terminate once the C<close> method has been called.', 'sigs' => ['method list(Channel:D:)'], 'returns' => [] },
        { 'name' => 'closed', 'kind' => 'method', 'summary' => 'Returns a promise that will be kept once the C<Channel> is closed by a call to method C<close>.', 'sigs' => ['method closed(Channel:D: --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'fail', 'kind' => 'method', 'summary' => 'Closes the C<Channel> (that is, makes subsequent C<send> calls die), and enqueues the error to be thrown as the final element in the C<Channel>. Method C<receive> will throw that error as an exception.  Does nothing if the C<Channel> has already been closed or C<.fail> has already been called on it.', 'sigs' => ['method fail(Channel:D: $error)'], 'returns' => [] },
        { 'name' => 'Capture', 'kind' => 'method', 'summary' => 'Equivalent to calling L«C<.List.Capture>|/type/List#method_Capture» on the invocant.', 'sigs' => ['method Capture(Channel:D: --> Capture:D)'], 'returns' => ['Capture:D'] },
        { 'name' => 'Supply', 'kind' => 'method', 'summary' => 'This returns an C<on-demand> L<C<Supply>|/type/Supply> that emits a value for every value received on the C<Channel>. C<done> will be called on the L<C<Supply>|/type/Supply> when the C<Channel> is closed. Multiple calls to this method produce multiple instances of Supply, which compete over the values from the C<Channel>.', 'sigs' => ['method Supply(Channel:D:)'], 'returns' => [] },
        { 'name' => 'await', 'kind' => 'sub', 'summary' => 'Waits until all of one or more C<Channel>s has a value available, and returns those values (it calls C<.receive> on the C<Channel>). Also works with L<C<Promise>|/type/Promise>s. Since 6.d, it no longer blocks a thread while waiting.', 'sigs' => ['multi await(Channel:D)', 'multi await(*@)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Channel {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
await (^10).map: {
    start {
        my $r = rand;
        sleep $r;
        $c.send($r);
    }
}
$c.close;
say $c.list;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
$c.send(1);
$c.send([2, 3, 4, 5]);
$c.close;
say $c.list; # OUTPUT: «(1 [2 3 4 5])␤»', 'expect' => '(1 [2 3 4 5])
', 'routine' => 'send', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
$c.send(1);
say $c.receive; # OUTPUT: «1␤»', 'expect' => '1
', 'routine' => 'receive', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
Promise.in(2).then: { $c.close; }
^10 .map({ $c.send($_); });
loop {
    if $c.poll -> $item { $item.say };
    if $c.closed  { last };
    sleep 0.1;
}', 'expect' => '', 'routine' => 'poll', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
$c.close;
$c.send(1);
CATCH { default { put .^name, \': \', .Str } };
# OUTPUT: «X::Channel::SendOnClosed: Cannot send a message on a closed channel␤»', 'expect' => 'X::Channel::SendOnClosed: Cannot send a message on a closed channel
', 'routine' => 'close', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new; $c.send(1); $c.send(2);
$c.close;
say $c.list; # OUTPUT: «(1 2)␤»', 'expect' => '(1 2)
', 'routine' => 'list', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
$c.closed.then({ say "It\'s closed!" });
$c.close;
sleep 1;', 'expect' => '', 'routine' => 'closed', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
$c.fail("Bad error happens!");
$c.receive;
CATCH { default { put .^name, \': \', .Str } };
# OUTPUT: «X::AdHoc: Bad error happens!␤»', 'expect' => 'X::AdHoc: Bad error happens!
', 'routine' => 'fail', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
my Supply $s1 = $c.Supply;
my Supply $s2 = $c.Supply;
$s1.tap(-> $v { say "First $v" });
$s2.tap(-> $v { say "Second $v" });
^10 .map({ $c.send($_) });
sleep 1;', 'expect' => '', 'routine' => 'Supply', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c = Channel.new;
Promise.in(1).then({$c.send(1)});
say await $c;', 'expect' => '', 'routine' => 'await', 'opts' => '', 'preamble' => '' },
      ],
    },
    {
      'name' => 'Code',
      'file' => 'Code',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Code object',
      'declkind' => 'class',
      'children' => ['Block', 'WhateverCode'],
      'routines' => [
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'Usually calls the code object and passes C<$topic> as an argument. However, when called on a code object that takes no arguments, the code object is invoked with no arguments and C<$topic> is dropped. The result of the call is returned.', 'sigs' => ['multi method ACCEPTS(Code:D: Mu $topic)'], 'returns' => [] },
        { 'name' => 'arity', 'kind' => 'method', 'summary' => 'Returns the minimum number of positional arguments that must be passed in order to call the code object. Any optional or slurpy parameters in the code object\'s L<C<Signature>|/type/Signature> do not contribute, nor do named parameters.', 'sigs' => ['method arity(Code:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'assuming', 'kind' => 'method', 'summary' => 'Returns a new L<C<Callable>|/type/Callable> that has been L<primed|/language/glossary#priming> with the arguments passed to C<assuming>.  In other words, the new function implements the same behavior as the original, but has the values passed to C<.assuming> already bound to the corresponding parameters. For a sub with arity greater than one, you can use L«C<Whatever> C<*>|/type/Whatever» for all of', 'sigs' => ['method assuming(Callable:D $self: |primers)'], 'returns' => [] },
        { 'name' => 'count', 'kind' => 'method', 'summary' => 'Returns the maximum number of positional arguments that may be passed when calling the code object. For code objects that can accept any number of positional arguments (that is, they have a slurpy parameter), C<count> will return C<Inf>. Named parameters do not contribute.', 'sigs' => ['method count(Code:D: --> Real:D)'], 'returns' => ['Real:D'] },
        { 'name' => 'of', 'kind' => 'method', 'summary' => 'Returns the L<return type constraint|/language/signatures#Constraining_return_types> of the C<Code>:', 'sigs' => ['method of(Code:D: --> Mu)'], 'returns' => ['Mu'] },
        { 'name' => 'signature', 'kind' => 'method', 'summary' => 'Returns the L<C<Signature>|/type/Signature> object for this code object, which describes its parameters.', 'sigs' => ['multi method signature(Code:D: --> Signature:D)'], 'returns' => ['Signature:D'] },
        { 'name' => 'cando', 'kind' => 'method', 'summary' => 'Returns a list of candidates that can be called with the given L<C<Capture>|/type/Capture>.  Since C<Code> objects do not have any multiple dispatch, this either returns a list with the object, or an empty list.', 'sigs' => ['method cando(Capture $c)'], 'returns' => [] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Will output the method name, but also produce a warning. Use C<.raku> or C<.gist> instead.', 'sigs' => ['multi method Str(Code:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'file', 'kind' => 'method', 'summary' => 'Returns the name of the file in which the code object was declared.', 'sigs' => ['method file(Code:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'line', 'kind' => 'method', 'summary' => 'Returns the line number in the source code at which the code object\'s declaration begins. If the code object was generated automatically (and thus I<not> declared in the source code), then C<line> returns the line on which the enclosing scope\'s declaration begins.  For example, when called on an L<automatically generated accessor method| /language/objects#Attributes> produced by the C<has $.name> syntax, C<line> returns the line on which the method\'s class\'s', 'sigs' => ['method line(Code:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'bytecode-size', 'kind' => 'method', 'summary' => 'Note: this method has been available in Rakudo compiler on the MoarVM backend only, starting from 2022.06 release. Returns the number of bytes that the code object occupies in memory.  Note that if the code object is in fact a C<multi>, then the bytecode size will be reported for the C<proto>.  You can use the C<.candidates> method to obtain each candidate, and then call the C<bytecode-size> methods on them.', 'sigs' => ['method bytecode-size(--> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'is-implementation-detail', 'kind' => 'method', 'summary' => 'Note: this method has been available in Rakudo compiler starting from 2020.05 release. Returns C<True> if the code object was marked with L«C<is implementation-detail> trait|/language/traits#is_implementation-detail_trait», C<False> otherwise.', 'sigs' => ['method is-implementation-detail(--> False)'], 'returns' => ['False'] },
      ],
      'examples' => [
        { 'code' => 'class Code is Any does Callable {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'sub argless() { }
sub args($a, $b?) { }
sub slurpy($a, $b, *@c) { }
say &argless.arity;             # OUTPUT: «0␤»
say &args.arity;                # OUTPUT: «1␤»
say &slurpy.arity;              # OUTPUT: «2␤»', 'expect' => '0
1
2
', 'routine' => 'arity', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my sub slow($n){ my $i = 0; $i++ while $i < $n; $i }', 'expect' => '', 'routine' => 'assuming', 'opts' => '', 'preamble' => '' },
        { 'code' => '# takes only one parameter and as such wont forward $n
