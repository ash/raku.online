        { 'name' => '^parents', 'kind' => 'method', 'summary' => 'Returns the list of parent classes. By default it stops at L<C<Cool>|/type/Cool>, L<C<Any>|/type/Any> or L<C<Mu>|/type/Mu>, which you can suppress by supplying the C<:all> adverb. With C<:tree>, a nested list is returned.', 'sigs' => ['method ^parents($obj, :$all, :$tree)'], 'returns' => [] },
