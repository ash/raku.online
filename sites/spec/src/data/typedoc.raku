    {
      'name' => 'DateTime',
      'file' => 'DateTime',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Calendar date with time',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Creates a new C<DateTime> object. One option for creating a new C<DateTime> object is from the components (year, month, day, hour, ...) separately. Another is to pass a L<C<Date>|/type/Date> object for the date component, and specify the time component-wise. Yet another is to obtain the time from an L<C<Instant>|/type/Instant>, and only supply the timezone and formatter. Or instead of an L<C<Instant>|/type/Instant> you can supply a L<C<Numeric>|/type/Numeric> as a Unix timestamp', 'sigs' => ['multi method new(Int :$year!, Int :$month = 1, Int :$day = 1,', 'multi method new(Date :$date!,', 'multi method new(Int() $year, Int() $month, Int() $day,', 'multi method new(Instant:D $i,  :$timezone=0, :&formatter)', 'multi method new(Numeric:D $posix,  :$timezone=0, :&formatter)', 'multi method new(Str:D $format, :$timezone=0, :&formatter)'], 'returns' => [] },
        { 'name' => 'now', 'kind' => 'method', 'summary' => 'Creates a new C<DateTime> object from the current system time. A custom L<formatter|/routine/formatter> and L<timezone|/routine/timezone> can be provided. The C<:$timezone> is the offset B<in seconds> from L<GMT|https://en.wikipedia.org/wiki/Greenwich_Mean_Time> and defaults to the value of L«C<$*TZ> variable|/language/variables#index-entry-%24*TZ». Note that one may use the methods shown below chained to the C<.now> to easily express current', 'sigs' => ['method now(:$timezone = $*TZ, :&formatter --> DateTime:D)'], 'returns' => ['DateTime:D'] },
        { 'name' => 'clone', 'kind' => 'method', 'summary' => 'Creates a new C<DateTime> object based on the invocant, but with the given arguments overriding the values from the invocant. Note that this can lead to invalid dates in some circumstances:', 'sigs' => ['method clone(DateTime:D: :$year, :$month, :$day, :$hour, :$minute, :$second, :$timezone, :&formatter)'], 'returns' => [] },
        { 'name' => 'hh-mm-ss', 'kind' => 'method', 'summary' => 'Returns the time represented by the object as a string in 24-hour HH:MM:SS format:', 'sigs' => ['method hh-mm-ss(DateTime:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'hour', 'kind' => 'method', 'summary' => 'Returns the hour component.', 'sigs' => ['method hour(DateTime:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'minute', 'kind' => 'method', 'summary' => 'Returns the minute component.', 'sigs' => ['method minute(DateTime:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'second', 'kind' => 'method', 'summary' => 'Returns the second component, including potentially fractional seconds.', 'sigs' => ['method second(DateTime:D:)'], 'returns' => [] },
        { 'name' => 'whole-second', 'kind' => 'method', 'summary' => 'Returns the second component, rounded down to an L<C<Int>|/type/Int>.', 'sigs' => ['method whole-second(DateTime:D:)'], 'returns' => [] },
        { 'name' => 'timezone', 'kind' => 'method', 'summary' => 'Returns the timezone B<in seconds> as an offset from UTC.', 'sigs' => ['method timezone(DateTime:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'offset', 'kind' => 'method', 'summary' => 'Returns the timezone B<in seconds> as an offset from UTC. This is an alias for L<method timezone|#method timezone>.', 'sigs' => ['method offset(DateTime:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'offset-in-minutes', 'kind' => 'method', 'summary' => 'Returns the timezone in minutes as an offset from UTC.', 'sigs' => ['method offset-in-minutes(DateTime:D: --> Real:D)'], 'returns' => ['Real:D'] },
        { 'name' => 'offset-in-hours', 'kind' => 'method', 'summary' => 'Returns the timezone in hours as an offset from UTC.', 'sigs' => ['method offset-in-hours(DateTime:D: --> Real:D)'], 'returns' => ['Real:D'] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Returns a string representation of the invocant, as done by L<the formatter|/type/Dateish#method_formatter>. If no formatter was specified, an ISO 8601 timestamp will be returned.', 'sigs' => ['method Str(DateTime:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'Instant', 'kind' => 'method', 'summary' => 'Returns an L<C<Instant>|/type/Instant> object based on the invocant.', 'sigs' => ['method Instant(DateTime:D: --> Instant:D)'], 'returns' => ['Instant:D'] },
        { 'name' => 'Real', 'kind' => 'method', 'summary' => 'Converts the invocant to L«C<Instant>|/type/Instant».  The same value can be obtained with the L<C<Instant>|/type/Instant> method. Available as of release 2023.02 of the Rakudo compiler.', 'sigs' => ['multi method Real(DateTime:D: --> Instant:D)'], 'returns' => ['Instant:D'] },
        { 'name' => 'Numeric', 'kind' => 'method', 'summary' => 'Available as of the 2021.09 release of the Rakudo compiler. Converts the invocant to L«C<Instant>|/type/Instant».  The same value can be obtained with the L<C<Instant>|/type/Instant> method.  This allows C<DateTime> objects to be used directly in arithmetic operations.', 'sigs' => ['multi method Numeric(DateTime:D: --> Instant:D)'], 'returns' => ['Instant:D'] },
        { 'name' => 'day-fraction', 'kind' => 'method', 'summary' => 'Returns the instant\'s time as a fraction of a 24-hour day. Notice the C<day-fraction> value is the same as the fractional part of the C<modified-julian-date> for the same instant. Also note that leap seconds may cause some variations from expected values: Available as of the 2021.04 Rakudo compiler release.', 'sigs' => ['method day-fraction(DateTime:D: --> Real:D)'], 'returns' => ['Real:D'] },
        { 'name' => 'julian-date', 'kind' => 'method', 'summary' => 'Returns the L<Julian date|https://en.wikipedia.org/wiki/Julian_day> (JD) for the UTC date and time. The C<julian-date> starts at zero at the epoch of noon UTC on I<November 24, 4714 B.C.> on the L<proleptic|https://en.m.wiktionary.org/wiki/proleptic> Gregorian calendar (the calendar in use in much of the world and in international commerce and travel). The JD is used in astronomy to define times of celestial objects transiting the', 'sigs' => ['method julian-date(DateTime:D: --> Real:D)'], 'returns' => ['Real:D'] },
        { 'name' => 'modified-julian-date', 'kind' => 'method', 'summary' => 'Returns the L<Modified Julian Date|https://en.wikipedia.org/wiki/Julian_day> (MJD) for the UTC date and time. Notice the fractional part of the C<modified-julian-date> is same value as the L<C<day-fraction>|/type/DateTime#method_day-fraction> for the same instant, and is similarly affected by leap seconds. Likewise, the integral part of the I<MJD> is the same value as the C<daycount> for the same instant since they', 'sigs' => ['method modified-julian-date(DateTime:D: --> Real:D)'], 'returns' => ['Real:D'] },
        { 'name' => 'posix', 'kind' => 'method', 'summary' => 'Returns the date and time as a POSIX/Unix timestamp (non-leap seconds since the POSIX epoch, 1970-01-01T00:00:00Z). If C<$ignore-timezone> is C<True>, the C<DateTime> object will be treated as if the timezone offset is zero. Note that this will collapse both a leap second and the second immediately following it into the same timestamp, because POSIX time ignores leap seconds. If you need better than this, see L<C<Instant>|/type/Instant> for the relevant', 'sigs' => ['method posix(Bool:D: $ignore-timezone = False --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'truncated-to', 'kind' => 'method', 'summary' => 'Returns a copy of the invocant, with everything smaller than the specified unit truncated to the smallest possible value. DateTimes with fractional seconds can be truncated to whole seconds with C<.truncated-to(\'second\')>.', 'sigs' => ['method truncated-to(DateTime:D: Cool $unit)'], 'returns' => [] },
        { 'name' => 'Date', 'kind' => 'method', 'summary' => 'Converts the invocant to L«C<Date>|/type/Date».', 'sigs' => ['multi method Date(DateTime:U --> Date:U)', 'multi method Date(DateTime:D --> Date:D)'], 'returns' => ['Date:U', 'Date:D'] },
        { 'name' => 'DateTime', 'kind' => 'method', 'summary' => 'Returns the invocant.', 'sigs' => ['method DateTime(--> DateTime)'], 'returns' => ['DateTime'] },
        { 'name' => 'utc', 'kind' => 'method', 'summary' => 'Returns a DateTime object for the same time, but in timezone UTC.', 'sigs' => ['method utc(DateTime:D: --> DateTime:D)'], 'returns' => ['DateTime:D'] },
        { 'name' => 'in-timezone', 'kind' => 'method', 'summary' => 'Returns a DateTime object for the same time, but in the specified C<$timezone>, which is the offset B<in seconds> from L<GMT|https://en.wikipedia.org/wiki/Greenwich_Mean_Time>. Per L<RFC 7164|https://tools.ietf.org/html/rfc7164#section-3>, leap seconds do not respect local time and always occur at the end of the I<UTC> day:', 'sigs' => ['method in-timezone(DateTime:D: Int(Cool) $timezone = 0 --> DateTime:D)'], 'returns' => ['DateTime:D'] },
        { 'name' => 'local', 'kind' => 'method', 'summary' => 'Returns a DateTime object for the same time, but in the local timezone (L«C<$*TZ>|/language/variables#index-entry-%24*TZ»).', 'sigs' => ['method local(DateTime:D: --> DateTime:D)'], 'returns' => ['DateTime:D'] },
        { 'name' => 'infix:<->', 'kind' => 'sub', 'summary' => 'Takes a C<DateTime> to subtract from and either a L«C<Duration>|/type/Duration» or another C<DateTime> object. Returns a new C<DateTime> object or the L<C<Duration>|/type/Duration> between the two dates, respectively. When subtracting L<C<Duration>|/type/Duration>, timezone of the original C<DateTime> is preserved in the returned C<DateTime> object.', 'sigs' => ['multi infix:<-> (DateTime:D, Duration:D --> DateTime:D)', 'multi infix:<-> (DateTime:D, DateTime:D --> Duration:D)'], 'returns' => ['DateTime:D', 'Duration:D'] },
        { 'name' => 'infix:<+>', 'kind' => 'sub', 'summary' => 'Takes a C<DateTime> and increases it by the given L«C<Duration>|/type/Duration», preserving the timezone.', 'sigs' => ['multi infix:<+> (DateTime:D, Duration:D --> DateTime:D)', 'multi infix:<+> (Duration:D, DateTime:D --> DateTime:D)'], 'returns' => ['DateTime:D', 'DateTime:D'] },
        { 'name' => 'infix:<cmp>', 'kind' => 'sub', 'summary' => 'Compares the equivalent instant, returns the Order.', 'sigs' => ['multi infix:<cmp>(DateTime:D \\a, DateTime:D \\b --> Order:D)'], 'returns' => ['Order:D'] },
      ],
      'examples' => [
        { 'code' => 'class DateTime does Dateish {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $dt = DateTime.new(
year    => 2015,
month   => 11,
day     => 21,
hour    => 16,
minute  => 1,
);

say $dt;                            # OUTPUT: «2015-11-21T16:01:00Z␤»
say $dt.later(days => 20);          # OUTPUT: «2015-12-11T16:01:00Z␤»
say $dt.truncated-to(\'hour\');       # OUTPUT: «2015-11-21T16:00:00Z␤»
say $dt.in-timezone(-8 * 3600);     # OUTPUT: «2015-11-21T08:01:00-0800␤»

my $now = DateTime.now(formatter => { sprintf "%02d:%02d", .hour, .minute });
