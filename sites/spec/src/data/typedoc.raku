      'name' => 'Instant',
      'file' => 'Instant',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Specific moment in time',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'from-posix', 'kind' => 'method', 'summary' => 'Converts the POSIX timestamp C<$posix> to an Instant. If C<$prefer-leap-second> is C<True>, the return value will be the first of the two possible seconds in the case of a leap second.', 'sigs' => ['method from-posix($posix, Bool $prefer-leap-second = False)'], 'returns' => [] },
        { 'name' => 'to-posix', 'kind' => 'method', 'summary' => 'Converts the invocant to a POSIX timestamp and returns a two element list containing the POSIX timestamp and a L<C<Bool>|/type/Bool>. It is the inverse of L<method from-posix|#method from-posix>, except that the second return value is C<True> if *and only if* this Instant is in a leap second.', 'sigs' => ['method to-posix()'], 'returns' => [] },
        { 'name' => 'Date', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Date>|/type/Date>.', 'sigs' => ['method Date(Instant:D: --> Date:D)'], 'returns' => ['Date:D'] },
        { 'name' => 'DateTime', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<DateTime>|/type/DateTime>. POSIX time (commonly called "Unix time") does not address leap seconds; in other words, it assumes that the period of rotation of the Earth is a fixed constant. Since in fact the amount of time that passes between one noon and the next varies from day to day, we must occasionally have a 61st second in the 60th minute of some hour; this is called a leap second, and happens at the', 'sigs' => ['method DateTime(Instant:D: --> DateTime:D)'], 'returns' => ['DateTime:D'] },
      ],
      'examples' => [
        { 'code' => 'class Instant is Cool does Real { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say DateTime.new(Instant.from-posix(1483228800, True));  # OUTPUT: «2016-12-31T23:59:60Z␤»
say DateTime.new(Instant.from-posix(1483228800));        # OUTPUT: «2017-01-01T00:00:00Z␤»', 'expect' => '2016-12-31T23:59:60Z
2017-01-01T00:00:00Z
', 'routine' => 'from-posix', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say DateTime.new(\'2017-01-01T00:00:00Z\').Instant.to-posix; # OUTPUT: «(1483228800 False)␤»
say DateTime.new(\'2016-12-31T23:59:60Z\').Instant.to-posix; # OUTPUT: «(1483228800 True)␤»', 'expect' => '(1483228800 False)
(1483228800 True)
', 'routine' => 'to-posix', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $i = "/etc/passwd".IO.modified;
say $i;             # OUTPUT: «Instant:1771879757.95139447␤»
say $i.Date;        # OUTPUT: «2026-02-23␤»', 'expect' => 'Instant:1771879757.95139447
2026-02-23
', 'routine' => 'Date', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say now.DateTime;  # OUTPUT: «2026-03-07T13:56:42.930951Z␤»', 'expect' => '2026-03-07T13:56:42.930951Z
', 'routine' => 'DateTime', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Instant $i .= from-posix(1483228799);
my Duration $s = DateTime.new(1) - DateTime.new(0);
sub demo { say [$_, .posix] with DateTime.new($i + $^n * $s) }
demo(0); # OUTPUT: «[2016-12-31T23:59:59Z 1483228799]␤»
demo(1); # OUTPUT: «[2016-12-31T23:59:60Z 1483228800]␤»
demo(2); # OUTPUT: «[2017-01-01T00:00:00Z 1483228800]␤»
demo(3); # OUTPUT: «[2017-01-01T00:00:01Z 1483228801]␤»', 'expect' => '[2016-12-31T23:59:59Z 1483228799]
[2016-12-31T23:59:60Z 1483228800]
[2017-01-01T00:00:00Z 1483228800]
[2017-01-01T00:00:01Z 1483228801]
', 'routine' => 'DateTime', 'opts' => '', 'preamble' => '' },
        { 'code' => 'with now { say .Int - DateTime.new($_).posix } # OUTPUT: «37␤»', 'expect' => '37
', 'routine' => 'DateTime', 'opts' => '', 'preamble' => '' },
        { 'code' => '$ perl6-2016.06 -e \'say Instant.from-posix: 1485726595\'
