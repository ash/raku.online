# OUTPUT: «Buf[uint8]:0x<66 6f>␤Buf[uint8]:0x<6f 62>␤Buf[uint8]:0x<61 72>␤»', 'expect' => 'fo
ob
ar
Buf[uint8]:0x<66 6f>
Buf[uint8]:0x<6f 62>
Buf[uint8]:0x<61 72>
', 'routine' => 'Supply', 'opts' => '', 'preamble' => '' },
