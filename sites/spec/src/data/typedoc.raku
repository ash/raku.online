say (-4/3).UInt.^name;    # OUTPUT: «Failure␤»
say "foo".UInt.^name;     # OUTPUT: «Failure␤»', 'expect' => '1
20
1
Failure
Failure
', 'routine' => 'UInt', 'opts' => '', 'preamble' => '' },
