      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'These constructors build a new junction from the type that defines it and a set of values. The main difference between the two multis is how the type of the C<Junction> is passed as an argument; either positionally as the first argument, or as a named argument using C<type>.', 'sigs' => ['multi method new(Junction: \\values, Str :$type!)', 'multi method new(Junction: Str:D \\type, \\values)'], 'returns' => [] },
        { 'name' => 'defined', 'kind' => 'method', 'summary' => 'Checks for definedness instead of Boolean values. L<C<Failure>|/type/Failure>s are also considered non-defined: Since 6.d, this method will autothread.', 'sigs' => ['multi method defined(Junction:D:)'], 'returns' => [] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Collapses the C<Junction> and returns a single Boolean value according to the type and the values it holds. Every element is transformed to L<C<Bool>|/type/Bool>. All elements in this case are converted to C<True>, so it\'s false to assert that only one of them is. Just one of them is truish in this case, C<1>, so the coercion to L<C<Bool>|/type/Bool> returns C<True>.', 'sigs' => ['multi method Bool(Junction:D:)'], 'returns' => [] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Autothreads the C<.Str> method over its elements and returns results as a C<Junction>. Output methods that use C<.Str> method (L<print|/routine/print> and L<put|/routine/put>) are special-cased to autothread junctions, despite being able to accept a L<C<Mu>|/type/Mu> type.', 'sigs' => ['multi method Str(Junction:D:)'], 'returns' => [] },
        { 'name' => 'iterator', 'kind' => 'method', 'summary' => 'Returns an iterator over the C<Junction> converted to a L<C<List>|/type/List>.', 'sigs' => ['multi method iterator(Junction:D:)'], 'returns' => [] },
        { 'name' => 'gist', 'kind' => 'method', 'summary' => 'Collapses the C<Junction> and returns a L<C<Str>|/type/Str> composed of the type of the junction and the L<gists|/routine/gist> of its components:', 'sigs' => ['multi method gist(Junction:D:)'], 'returns' => [] },
        { 'name' => 'raku', 'kind' => 'method', 'summary' => 'Collapses the C<Junction> and returns a L<C<Str>|/type/Str> composed of L<raku|/routine/raku> of its components that L<evaluates|/routine/EVAL> to the equivalent C<Junction> with equivalent components:', 'sigs' => ['multi method raku(Junction:D:)'], 'returns' => [] },
        { 'name' => 'C<~>', 'kind' => 'infix', 'summary' => 'The infix C<~> concatenation can be used to merge junctions into a single one or merge Junctions with strings. The resulting junction will have all elements merged as if they were joined into a nested loop: On the other hand, the versions of C<~> that use a string as one argument will just concatenate the string to every member of the Junction, creating another Junction with the same number of elements.', 'sigs' => ['multi infix:<~>(Str:D $a, Junction:D $b)', 'multi infix:<~>(Junction:D $a, Str:D $b)', 'multi infix:<~>(Junction:D \\a, Junction:D \\b)'], 'returns' => [] },
