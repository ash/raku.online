    {
      'name' => 'Date',
      'file' => 'Date',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Calendar date',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Creates a new C<Date> object, either from a triple of (year, month, day) that can be coerced to integers, or from a string of the form C<YYYY-MM-DD> (L<ISO 8601|https://en.wikipedia.org/wiki/ISO_8601>), or from an Instant or DateTime object.  Optionally accepts a formatter as a named parameter. Since Rakudo 2022.03, the "day" argument can also be a callable, with C<*> representing the last day in a month, and the possibility of getting to the', 'sigs' => ['multi method new($year, $month, $day, :&formatter --> Date:D)', 'multi method new(:$year!, :$month = 1, :$day = 1  --> Date:D)', 'multi method new(Str $date                        --> Date:D)', 'multi method new(Instant:D $dt                    --> Date:D)', 'multi method new(DateTime:D $dt                   --> Date:D)'], 'returns' => ['Date:D', 'Date:D', 'Date:D', 'Date:D', 'Date:D'] },
        { 'name' => 'new-from-daycount', 'kind' => 'method', 'summary' => 'Creates a new C<Date> object given C<$daycount> which is the number of days from epoch Nov. 17, 1858, i.e. the L<Modified Julian Day|https://en.wikipedia.org/wiki/Julian_day>. Optionally accepts a formatter as a named parameter.', 'sigs' => ['method new-from-daycount($daycount,:&formatter --> Date:D)'], 'returns' => ['Date:D'] },
        { 'name' => 'daycount', 'kind' => 'method', 'summary' => 'Returns the number of days from epoch Nov. 17, 1858, i.e. the L<Modified Julian Day|https://en.wikipedia.org/wiki/Julian_day>.', 'sigs' => ['method daycount(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'last-date-in-month', 'kind' => 'method', 'summary' => 'Returns the last date in the month of the C«Date» object. Otherwise, returns the invocant if the day value is already the last day of the month. This should allow for much easier ranges like for all remaining dates in the month.', 'sigs' => ['method last-date-in-month(Date:D: --> Date:D)'], 'returns' => ['Date:D'] },
        { 'name' => 'first-date-in-month', 'kind' => 'method', 'summary' => 'Returns the first date in the month of the C«Date» object. Otherwise, returns the invocant if the day value is already the first day of the month.', 'sigs' => ['method first-date-in-month(Date:D: --> Date:D)'], 'returns' => ['Date:D'] },
        { 'name' => 'clone', 'kind' => 'method', 'summary' => 'Creates a new C<Date> object based on the invocant, but with the given arguments overriding the values from the invocant.', 'sigs' => ['method clone(Date:D: :$year, :$month, :$day, :&formatter)'], 'returns' => [] },
        { 'name' => 'today', 'kind' => 'method', 'summary' => 'Returns a C<Date> object for the current day.  Optionally accepts a formatter named parameter.', 'sigs' => ['method today(:&formatter --> Date:D)'], 'returns' => ['Date:D'] },
        { 'name' => 'truncated-to', 'kind' => 'method', 'summary' => 'Returns a C<Date> truncated to the first day of its year, month or week. For example', 'sigs' => ['method truncated-to(Date:D: Cool $unit)'], 'returns' => [] },
        { 'name' => 'succ', 'kind' => 'method', 'summary' => 'Returns a C<Date> of the following day. "succ" is short for "successor".', 'sigs' => ['method succ(Date:D: --> Date:D)'], 'returns' => ['Date:D'] },
        { 'name' => 'pred', 'kind' => 'method', 'summary' => 'Returns a C<Date> of the previous day. "pred" is short for "predecessor".', 'sigs' => ['method pred(Date:D: --> Date:D)'], 'returns' => ['Date:D'] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Returns a string representation of the invocant, as specified by L<the formatter|/type/Dateish#method_formatter>. If no formatter was specified, an (L<ISO 8601|https://en.wikipedia.org/wiki/ISO_8601>) date will be returned.', 'sigs' => ['multi method Str(Date:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'gist', 'kind' => 'method', 'summary' => 'Returns the date in C<YYYY-MM-DD> format (L<ISO 8601|https://en.wikipedia.org/wiki/ISO_8601>)', 'sigs' => ['multi method gist(Date:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'Date', 'kind' => 'method', 'summary' => 'Returns the invocant.', 'sigs' => ['method Date(--> Date)'], 'returns' => ['Date'] },
        { 'name' => 'DateTime', 'kind' => 'method', 'summary' => 'Converts the invocant to L«C<DateTime>|/type/DateTime»', 'sigs' => ['multi method DateTime(Date:U: --> DateTime:U)', 'multi method DateTime(Date:D: --> DateTime:D)'], 'returns' => ['DateTime:U', 'DateTime:D'] },
        { 'name' => 'Int', 'kind' => 'method', 'summary' => 'Converts the invocant to L«C<Int>|/type/Int».  The same value can be obtained with the C<daycount> method. Available as of release 2023.02 of the Rakudo compiler.', 'sigs' => ['multi method Int(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'Real', 'kind' => 'method', 'summary' => 'Converts the invocant to L«C<Int>|/type/Int».  The same value can be obtained with the C<daycount> method. Available as of release 2023.02 of the Rakudo compiler.', 'sigs' => ['multi method Real(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'Numeric', 'kind' => 'method', 'summary' => 'Converts the invocant to L«C<Int>|/type/Int».  The same value can be obtained with the C<daycount> method.  This allows C<Date> objects to be used directly in arithmetic operations. Available as of release 2023.02 of the Rakudo compiler.', 'sigs' => ['multi method Numeric(Date:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'infix:<->', 'kind' => 'sub', 'summary' => 'Takes a date to subtract from and either an L«C<Int>|/type/Int», representing the number of days to subtract, or another C<Date> object. Returns a new C<Date> object or the number of days between the two dates, respectively.', 'sigs' => ['multi infix:<-> (Date:D, Int:D --> Date:D)', 'multi infix:<-> (Date:D, Date:D --> Int:D)'], 'returns' => ['Date:D', 'Int:D'] },
        { 'name' => 'infix:<+>', 'kind' => 'sub', 'summary' => 'Takes an L«C<Int>|/type/Int» and adds that many days to the given C<Date> object.', 'sigs' => ['multi infix:<+> (Date:D, Int:D --> Date:D)', 'multi infix:<+> (Int:D, Date:D --> Date:D)'], 'returns' => ['Date:D', 'Date:D'] },
