    {
      'name' => 'Hash',
      'file' => 'Hash',
      'subkind' => 'class',
      'category' => 'composite',
      'subtitle' => 'Mapping from strings to itemized values',
      'declkind' => 'class',
      'children' => ['Stash'],
      'routines' => [
        { 'name' => 'classify-list', 'kind' => 'method', 'summary' => 'Populates a C<Hash> by classifying the possibly-empty C<@list> of values using the given C<mapper>, optionally altering the values using the C<:&as> L«C<Callable>|/type/Callable». The C<@list> cannot be lazy. The mapper can be a L«C<Callable>|/type/Callable» that takes a single argument, an L«C<Associative>|/type/Associative», or an L«C<Iterable>|/type/Iterable»; this L<C<Callable>|/type/Callable> is guaranteed to be called only once per item.', 'sigs' => ['multi method classify-list(&mapper, *@list, :&as --> Hash:D)', 'multi method classify-list(%mapper, *@list, :&as --> Hash:D)', 'multi method classify-list(@mapper, *@list, :&as --> Hash:D)'], 'returns' => ['Hash:D', 'Hash:D', 'Hash:D'] },
        { 'name' => 'categorize-list', 'kind' => 'method', 'summary' => 'Populates a C<Hash> by classifying the possibly-empty C<@list> of values using the given C<mapper>, optionally altering the values using the C<:&as> L«C<Callable>|/type/Callable». The C<@list> cannot be lazy. The mapper can be a L«C<Callable>|/type/Callable» that takes a single argument, an L«C<Associative>|/type/Associative», or an L«C<Iterable>|/type/Iterable». With L«C<Associative>|/type/Associative» and an L«C<Iterable>|/type/Iterable»', 'sigs' => ['multi method categorize-list(&mapper, *@list, :&as --> Hash:D)', 'multi method categorize-list(%mapper, *@list, :&as --> Hash:D)', 'multi method categorize-list(@mapper, *@list, :&as --> Hash:D)'], 'returns' => ['Hash:D', 'Hash:D', 'Hash:D'] },
        { 'name' => 'push', 'kind' => 'method', 'summary' => 'Adds the C<new> elements to the hash with the same semantics as hash assignment, but with three exceptions: L<C<Array>|/type/Array>, the new value is pushed onto the array (instead of replacing it). an L<C<Array>|/type/Array>, old and new value are both placed into an array in the place of the old value. Example: Please note that literal pairs in the argument list may be interpreted as L<named arguments|/type/Capture> and as such won\'t end up in the C<Hash>:', 'sigs' => ['method push(Hash:D: +new)'], 'returns' => [] },
        { 'name' => 'append', 'kind' => 'method', 'summary' => 'Append the provided Pairs or even sized list to the Hash. If a key already exists, turn the existing value into an L<C<Array>|/type/Array> and push new value onto that L<C<Array>|/type/Array>. Please note that you can\'t mix even sized lists and lists of Pairs. Also, bare L<C<Pair>|/type/Pair>s or colon pairs will be treated as L<named arguments|/language/signatures#Positional_vs._named_arguments> to C<.append>.', 'sigs' => ['method append(+@values)'], 'returns' => [] },
        { 'name' => 'default', 'kind' => 'method', 'summary' => 'Returns the default value of the invocant, i.e. the value which is returned when a non existing key is used to access an element in the C<Hash>. Unless the C<Hash> is declared as having a default value by using the L<is default|/type/Variable#trait_is_default> trait the method returns the type object C<(Any)>.', 'sigs' => ['method default(Hash:D:)'], 'returns' => [] },
        { 'name' => 'keyof', 'kind' => 'method', 'summary' => 'Returns the type constraint for the keys of the invocant. For normal hashes the method returns the coercion type C<(Str(Any))> while for L<non-string keys|/language/hashmap#Non-string_keys_(object_hash)> hashes the type used in the declaration of the C<Hash> is returned.', 'sigs' => ['method keyof()'], 'returns' => [] },
        { 'name' => 'of', 'kind' => 'method', 'summary' => 'Returns the type constraint for the values of the invocant. By default, i.e., if no type constraint is given during declaration, the method returns C<(Mu)>.', 'sigs' => ['method of(Hash:D:)'], 'returns' => [] },
        { 'name' => 'dynamic', 'kind' => 'routine', 'summary' => 'Returns C<True> if the invocant has been declared with the L<is dynamic|/routine/is dynamic> trait. If you declare a variable with the C<*> twigil C<is dynamic> is implied. Note that in the L<C<Scalar>|/type/Scalar> case you have to use the C<VAR> method in order to get correct information. Some methods are implemented as adverbs on subscripts (consult the L<operators|/language/operators#postcircumfix_{_}> documentation', 'sigs' => ['method dynamic(--> Bool:D)'], 'returns' => ['Bool:D'] },
      ],
      'examples' => [
        { 'code' => 'class Hash is Map { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# initialization with pairs:
my %capitals = Spain => \'Madrid\', \'United States\' => \'Washington DC\';', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# adding another pair:
%capitals{\'Zimbabwe\'} = \'Harare\';', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# accessing a value by key:
my $country = \'Spain\';
say "The capital of $country is %capitals{$country}";', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# getting all keys:
say "I know the capitals of these countries: ", %capitals.keys.sort.join(\', \');', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# check if a key is in a hash:
if %capitals{\'Europe\'}:exists {
    # not executed
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# iterating over keys and values (unordered):
for %capitals.kv -> $country, $capital {
    say "$capital is the capital of $country";
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %orig = :1a, :2b; my %new = :5b, :6c;
%orig{ %new.keys } = %new.values;
say %orig.raku; # OUTPUT: «{:a(1), :b(5), :c(6)}␤»', 'expect' => '{:a(1), :b(5), :c(6)}
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'given 3 { say WHAT {3 => 4, :b}  };     # OUTPUT: «(Hash)␤»
