say %hash.classify-list: @mapper, 1, 2, 3, 4, 4;
# OUTPUT: «{foo => bar, four => [4 4], one => [1], three => [3], two => [2]}␤»', 'expect' => '{even => [0 2 4 6 8], odd => [1 3 5 7 9]}
