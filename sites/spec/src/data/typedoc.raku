    {
      'name' => 'Failure',
      'file' => 'Failure',
      'subkind' => 'class',
      'category' => 'exception',
      'subtitle' => 'Delayed exception',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Returns a new C<Failure> instance with payload given as argument. If called without arguments on a C<Failure> object, it will throw; on a type value, it will create an empty C<Failure> with no payload. The latter can be either an L<C<Exception>|/type/Exception> or a payload for an L<C<Exception>|/type/Exception>. A typical payload would be a L<C<Str>|/type/Str> with an error message. A list of payloads is also accepted.', 'sigs' => ['multi method new(Failure:D:)', 'multi method new(Failure:U:)', 'multi method new(Failure:U: Exception:D \\exception)', 'multi method new(Failure:U: $payload)', 'multi method new(Failure:U: |cap (*@msg))'], 'returns' => [] },
        { 'name' => 'handled', 'kind' => 'method', 'summary' => 'Returns C<True> for handled failures, C<False> otherwise. The C<handled> method is an L<lvalue|/language/glossary#lvalue>, see L«routine trait C<is rw>|/type/Routine#trait_is_rw», which means you can also use it to set the handled state:', 'sigs' => ['method handled(Failure:D: --> Bool:D) is rw'], 'returns' => ['Bool:D'] },
        { 'name' => 'exception', 'kind' => 'method', 'summary' => 'Returns the L<C<Exception>|/type/Exception> object that the failure wraps.', 'sigs' => ['method exception(Failure:D: --> Exception)'], 'returns' => ['Exception'] },
        { 'name' => 'self', 'kind' => 'method', 'summary' => 'If the invocant is a L<handled|/routine/handled> C<Failure>, returns it as is. If not handled, throws its L<C<Exception>|/type/Exception>. Since L<C<Mu>|/type/Mu> type L«provides C<.self>|/type/Mu#method_self» for every class, calling this method is a handy way to explosively filter out Failures:', 'sigs' => ['method self(Failure:D: --> Failure:D)'], 'returns' => ['Failure:D'] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<False>, and marks the failure as handled.', 'sigs' => ['multi method Bool(Failure:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'Capture', 'kind' => 'method', 'summary' => 'Throws C<X::Cannot::Capture> if the invocant is a type object or a L<handled|/routine/handled> C<Failure>. Otherwise, throws the invocant\'s L<exception|/routine/exception>.', 'sigs' => ['method Capture()'], 'returns' => [] },
        { 'name' => 'defined', 'kind' => 'method', 'summary' => 'Returns C<False> (failures are officially undefined), and marks the failure as handled.', 'sigs' => ['multi method defined(Failure:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Marks the failure as handled and throws the invocant\'s L<exception|/type/Failure#method_exception>.', 'sigs' => ['multi method list(Failure:D:)'], 'returns' => [] },
        { 'name' => 'fail', 'kind' => 'sub', 'summary' => 'Exits the calling L<C<Routine>|/type/Routine> and returns a C<Failure> object wrapping the exception C<$e> - or, for the C<cap> or C<$payload> form, an L<C<X::AdHoc>|/type/X::AdHoc> exception constructed from the concatenation of C<@text>. If the caller activated fatal exceptions via the pragma C<use fatal;>, the exception is thrown instead of being returned as a C<Failure>. If it\'s called with a generic C<Failure>, an ad-hoc undefined failure is', 'sigs' => ['multi fail(--> Nil)', 'multi fail(*@text)', 'multi fail(Exception:U $e  --> Nil )', 'multi fail($payload --> Nil)', 'multi fail(|cap (*@msg) --> Nil)', 'multi fail(Failure:U $f --> Nil)', 'multi fail(Failure:D $fail --> Nil)'], 'returns' => ['Nil', 'Nil', 'Nil', 'Nil', 'Nil', 'Nil'] },
      ],
      'examples' => [
        { 'code' => 'class Failure is Nil { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'sub may_fail( --> Numeric:D ) {
  my $value = (^10).pick || fail "Zero is unacceptable";
  fail "Odd is also not okay" if $value % 2;
  return $value;
}

with may_fail() -> $value { # defined, so didn\'t fail
  say "I know $value isn\'t zero or odd."
} else { # undefined, so failed, and the Failure is the topic
  say "Uh-oh: {.exception.message}."
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
