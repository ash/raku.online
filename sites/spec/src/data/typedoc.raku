', 'routine' => 'isNaN', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say (10+7i).polar; # OUTPUT: «(12.2065556157337 0.610725964389209)␤»', 'expect' => '(12.2065556157337 0.610725964389209)
