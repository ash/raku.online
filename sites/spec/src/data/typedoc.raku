      'name' => 'Metamodel::DefiniteHOW',
      'file' => 'DefiniteHOW',
      'subkind' => 'class',
      'category' => 'metamodel',
      'subtitle' => 'Metaobject for type definiteness',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new_type', 'kind' => 'method', 'summary' => 'Creates a new definite type given a base type and definiteness. C<$definite> should either be C<1> for C<:D> types or C<0> for C<:U> types.', 'sigs' => ['method new_type(:$base_type!, :$definite!)'], 'returns' => [] },
        { 'name' => 'name', 'kind' => 'method', 'summary' => 'Returns the name of a definite type.', 'sigs' => ['method name($definite_type)'], 'returns' => [] },
        { 'name' => 'shortname', 'kind' => 'method', 'summary' => 'Returns the shortname of a definite type.', 'sigs' => ['method shortname($definite_type)'], 'returns' => [] },
        { 'name' => 'base_type', 'kind' => 'method', 'summary' => 'Returns the base type for a definite type:', 'sigs' => ['method base_type($definite_type)'], 'returns' => [] },
        { 'name' => 'definite', 'kind' => 'method', 'summary' => 'Returns C<1> if the definite type given is a C<:D> type or C<0> if it is a C<:U> type.', 'sigs' => ['method definite($definite_type)'], 'returns' => [] },
        { 'name' => 'nominalize', 'kind' => 'method', 'summary' => 'Produces a nominal type object for a definite type. This is its base type, which may also get nominalized if it has the C<nominalizable> archetype.', 'sigs' => ['method nominalize($obj)'], 'returns' => [] },
        { 'name' => 'find_method', 'kind' => 'method', 'summary' => 'Looks up a method on the base type of a definite type.', 'sigs' => ['method find_method($definite_type, $name)'], 'returns' => [] },
        { 'name' => 'type_check', 'kind' => 'method', 'summary' => 'Performs a type-check of a definite type against C<$checkee>. This will check if C<$checkee> is of its base type, returning C<True> if they match or C<False> otherwise. This metamethod can get called when a definite type is on the left-hand side of a smartmatch, for instance.', 'sigs' => ['method type_check($definite_type, $checkee)'], 'returns' => [] },
        { 'name' => 'accepts_type', 'kind' => 'method', 'summary' => 'Performs a type-check of C<$checkee> against a definite type. This will check if C<$checkee> is of its base type and matches its definiteness, returning C<True> if they match or C<False> otherwise.  This metamethod can get called when the definite type is on the right-hand side of a smartmatch, for instance.', 'sigs' => ['method accepts_type($definite_type, $checkee)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Metamodel::DefiniteHOW
    does Metamodel::Documenting
        { }', 'expect' => '', 'routine' => '', 'opts' => ':skip-test<breaks the metamodel>', 'preamble' => '' },
