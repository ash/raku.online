$hs.tap(&say);           # OUTPUT: «4␤10␤3␤»', 'expect' => '4
10
3
', 'routine' => 'head', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $s = Supply.from-list(4, 10, 3, 2);
my $ts = $s.tail(2);
$ts.tap(&say);           # OUTPUT: «3␤2␤»', 'expect' => '3
2
', 'routine' => 'tail', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $s = Supply.from-list(4, 10, 3, 2);
my $ts = $s.tail( * - 2 );
$ts.tap(&say);           # OUTPUT: «3␤2␤»', 'expect' => '3
2
', 'routine' => 'tail', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $rand = supply { emit (rand × 100).floor for ^∞ };
my $first-prime = $rand.first: &is-prime;
# output the first prime from the endless random number supply $rand,
