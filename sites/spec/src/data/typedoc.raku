say $list[2].VAR.^name; # OUTPUT: «Str␤», non-containerized

$list[0] = \'a\'; # OK!
$list[1] = \'c\'; # OK!
$list[2] = \'d\'; # Error: Cannot modify an immutable List', 'expect' => 'Scalar
Scalar
Str
', 'routine' => '', 'opts' => '', 'preamble' => '' },
