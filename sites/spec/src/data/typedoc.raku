say Any.new ~~ Any:D; # OUTPUT: «True␤»
say Any.new ~~ Any:U; # OUTPUT: «False␤»
say Any.new ~~ Any:_; # OUTPUT: «True␤»', 'expect' => 'False
True
True
True
False
True
', 'routine' => '', 'opts' => '', 'preamble' => '' },
