                # printed «a b␤», «2 1␤» otherwise', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %map is Map = \'a\', 1, \'b\', 2;
say %map{\'a\'};      # OUTPUT: «1␤»
say %map{ \'a\', \'b\' }; # OUTPUT: «(1 2)␤»', 'expect' => '1
(1 2)
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $map = Map.new(\'a\', 1, \'b\', 2);
my $key = \'a\';
if $map{$key}:exists {
    say "$map{} has key $key";
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '                  # Cannot modify an immutable Str', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %h = Map.new(\'a\', 1, \'b\', 2);', 'expect' => '', 'routine' => 'new', 'opts' => '', 'preamble' => '' },
        { 'code' => '# WRONG: :b(2) interpreted as named argument
say Map.new(\'a\', 1, :b(2)).keys; # OUTPUT: «(a)␤»', 'expect' => '(a)
', 'routine' => 'new', 'opts' => '', 'preamble' => '' },
        { 'code' => '# RIGHT: :b(2) interpreted as Pair because of extra parentheses
say Map.new( (\'a\', 1, :b(2)) ).keys.sort; # OUTPUT: «(a b)␤»', 'expect' => '(a b)
', 'routine' => 'new', 'opts' => '', 'preamble' => '' },
        { 'code' => '# RIGHT: \'b\' => 2 always creates a Pair
say Map.new(\'a\', 1, \'b\' => 2).keys.sort; # OUTPUT: «(a b)␤»', 'expect' => '(a b)
', 'routine' => 'new', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %h is Map = \'a\', 1, \'b\', 2;', 'expect' => '', 'routine' => 'new', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %map = Map.new(\'a\', 1, \'b\', 2);
say %map.elems; # OUTPUT: «2␤»', 'expect' => '2
', 'routine' => 'elems', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => (2, 3), \'b\' => 17);
say $m.keys; # OUTPUT: «(a b)␤»', 'expect' => '(a b)
', 'routine' => 'keys', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => (2, 3), \'b\' => 17);
say $m.values; # OUTPUT: «((2 3) 17)␤»', 'expect' => '((2 3) 17)
', 'routine' => 'values', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => (2, 3), \'b\' => 17);
say $m.pairs; # OUTPUT: «(a => (2 3) b => 17)␤»', 'expect' => '(a => (2 3) b => 17)
', 'routine' => 'pairs', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => (2, 3), \'b\' => 17);
say $m.antipairs;                        # OUTPUT: «((2 3) => a 17 => b)␤»', 'expect' => '((2 3) => a 17 => b)
', 'routine' => 'antipairs', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => (2, 3), \'b\' => 17);
say $m.invert;                          # OUTPUT: «(2 => a 3 => a 17 => b)␤»', 'expect' => '(2 => a 3 => a 17 => b)
', 'routine' => 'invert', 'opts' => '', 'preamble' => '' },
        { 'code' => 'Map.new(\'a\', 1, \'b\', 2).kv  # (a 1 b 2)', 'expect' => '', 'routine' => 'kv', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => (2, 3), \'b\' => 17);
say $m.list;                            # OUTPUT: «(b => 17 a => (2 3))␤»', 'expect' => '(b => 17 a => (2 3))
', 'routine' => 'list', 'opts' => '', 'preamble' => '' },
        { 'code' => '# These are equivalent:
say Map.new(<c 3 a 1 b 2>).sort;        # OUTPUT: «(a => 1 b => 2 c => 3)␤»
say Map.new(<c 3 a 1 b 2>).sort: *.key; # OUTPUT: «(a => 1 b => 2 c => 3)␤»', 'expect' => '(a => 1 b => 2 c => 3)
(a => 1 b => 2 c => 3)
', 'routine' => 'sort', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => 2, \'b\' => 17);
say $m.Int;                                       # OUTPUT: «2␤»', 'expect' => '2
', 'routine' => 'Int', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => 2, \'b\' => 17);
say $m.Numeric;                                   # OUTPUT: «2␤»', 'expect' => '2
', 'routine' => 'Numeric', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $m = Map.new(\'a\' => 2, \'b\' => 17);
say $m.Bool;                                      # OUTPUT: «True␤»', 'expect' => 'True
', 'routine' => 'Bool', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $map = Map.new(\'a\' => 2, \'b\' => 17);
my $capture = $map.Capture;
my-sub(|$capture);                                # OUTPUT: «2, 17␤»', 'expect' => '2, 17
', 'routine' => 'Capture', 'opts' => '', 'preamble' => '' },
        { 'code' => 'sub my-sub(:$a, :$b) {
    say "$a, $b"
}', 'expect' => '', 'routine' => 'Capture', 'opts' => '', 'preamble' => '' },
