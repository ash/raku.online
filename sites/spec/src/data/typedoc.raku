    {
      'name' => 'Label',
      'file' => 'Label',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Tagged location in the source code',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'name', 'kind' => 'method', 'summary' => 'Not terribly useful, returns the name of the defined label:', 'sigs' => [], 'returns' => [] },
        { 'name' => 'file', 'kind' => 'method', 'summary' => 'Returns the file the label is defined in.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'line', 'kind' => 'method', 'summary' => 'Returns the line where the label has been defined.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Converts to a string including the name, file and line it\'s been defined in.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'next', 'kind' => 'method', 'summary' => 'Begin the next iteration of the loop associated with the label.', 'sigs' => ['method next(Label:)'], 'returns' => [] },
        { 'name' => 'redo', 'kind' => 'method', 'summary' => 'Repeat the same iteration of the loop associated with the label.', 'sigs' => ['method redo(Label:)'], 'returns' => [] },
        { 'name' => 'last', 'kind' => 'method', 'summary' => 'Terminate the execution of the loop associated with the label.', 'sigs' => ['method last(Label:)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Label {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'USERS:          # the label
for @users -> $u {
for $u.pets -> $pet {
    # usage of a label
    next USERS if $pet.barks;
}
say "None of {$u}\'s pets barks";
}
say USERS.^name;        # OUTPUT: «Label␤»', 'expect' => 'Label
', 'routine' => '', 'opts' => ':skip-test<compile time error>', 'preamble' => '' },
        { 'code' => 'my $x = 0;
my $y = 0;
my $t = \'\';
A: while $x++ < 2 {
$t ~= "A$x";
B: while $y++ < 2 {
    $t ~= "B$y";
    redo A if $y++ == 1;
    last A
}
}
say $t; # OUTPUT: «A1B1A1A2␤»', 'expect' => 'A1B1A1A2
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '駱駝道: while True {
  say 駱駝道.name;
