    {
      'name' => 'Promise',
      'file' => 'Promise',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'Status/result of an asynchronous computation',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'start', 'kind' => 'method', 'summary' => 'Creates a new Promise that runs the given code object. The promise will be kept when the code terminates normally, or broken if it throws an exception. The return value or exception can be inspected with the C<result> method. The scheduler that handles this promise can be passed as a named argument. There is also a statement prefix C<start> that provides syntactic sugar for this method: As of the 6.d version of the language, C<start> statement prefix used in', 'sigs' => ['method start(Promise:U: &code, :$scheduler = $*SCHEDULER --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'in', 'kind' => 'method', 'summary' => 'Creates a new Promise that will be kept in C<$seconds> seconds, or later. C<$seconds> can be fractional or negative. Negative values are treated as C<0> (i.e. L<keeping|/routine/keep> the returned C<Promise> right away). Please note that situations like these are often more clearly handled with a L<react and whenever block|/language/concurrency#react>.', 'sigs' => ['method in(Promise:U: $seconds, :$scheduler = $*SCHEDULER --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'at', 'kind' => 'method', 'summary' => 'Creates a new C<Promise> that will be kept C<$at> the given time—which is given as an L<C<Instant>|/type/Instant> or equivalent L<C<Numeric>|/type/Numeric>—or as soon as possible after it. If the given time is in the past, it will be treated as L<now|/routine/now> (i.e. L<keeping|/routine/keep> the returned C<Promise> right away). Please note that situations like these are often more clearly handled with', 'sigs' => ['method at(Promise:U: $at, :$scheduler = $*SCHEDULER --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'kept', 'kind' => 'method', 'summary' => 'Returns a new promise that is already kept, either with the given value, or with the default value C<True>.', 'sigs' => ['multi method kept(Promise:U: \\result = True --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'broken', 'kind' => 'method', 'summary' => 'Returns a new promise that is already broken, either with the given value, or with the default value C«X::AdHoc.new(payload => "Died")»', 'sigs' => ['multi method broken(Promise:U: --> Promise:D)', 'multi method broken(Promise:U: \\exception --> Promise:D)'], 'returns' => ['Promise:D', 'Promise:D'] },
        { 'name' => 'allof', 'kind' => 'method', 'summary' => 'Returns a new promise that will be kept when all the promises passed as arguments are kept or broken. The result of the individual Promises is not reflected in the result of the returned promise: it simply indicates that all the promises have been completed in some way. If the results of the individual promises are important then they should be inspected after the C<allof> promise is kept. In the following requesting the C<result> of a broken promise will cause the', 'sigs' => ['method allof(Promise:U: *@promises --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'anyof', 'kind' => 'method', 'summary' => 'Returns a new promise that will be kept as soon as any of the promises passed as arguments is kept or broken. The result of the completed Promise is not reflected in the result of the returned promise which will always be Kept. You can use this to wait at most a number of seconds for a promise:', 'sigs' => ['method anyof(Promise:U: *@promises --> Promise:D)'], 'returns' => ['Promise:D'] },
        { 'name' => 'then', 'kind' => 'method', 'summary' => 'Schedules a piece of code to be run after the invocant has been kept or broken, and returns a new promise for this computation. In other words, creates a chained promise. The C<Promise> is passed as an argument to the C<&code>.', 'sigs' => ['method then(Promise:D: &code)'], 'returns' => [] },
        { 'name' => 'keep', 'kind' => 'method', 'summary' => 'Keeps a promise, optionally setting the result. If no result is passed, the result will be C<True>. Throws an exception of type L<C<X::Promise::Vowed>|/type/X::Promise::Vowed> if a vow has already been taken. See method C<vow> for more information.', 'sigs' => ['multi method keep(Promise:D: \\result = True)'], 'returns' => [] },
        { 'name' => 'break', 'kind' => 'method', 'summary' => 'Breaks a promise, optionally setting the cause. If no cause is passed, the cause will be C<False>. Throws an exception of type L<C<X::Promise::Vowed>|/type/X::Promise::Vowed> if a vow has already been taken. See method C<vow> for more information.', 'sigs' => ['multi method break(Promise:D: \\cause = False)'], 'returns' => [] },
        { 'name' => 'result', 'kind' => 'method', 'summary' => 'Waits for the promise to be kept or broken. If it is kept, returns the result; otherwise throws the result as an exception.', 'sigs' => ['method result(Promise:D:)'], 'returns' => [] },
        { 'name' => 'cause', 'kind' => 'method', 'summary' => 'If the promise was broken, returns the result (or exception). Otherwise, throws an exception of type L<C<X::Promise::CauseOnlyValidOnBroken>|/type/X::Promise::CauseOnlyValidOnBroken>.', 'sigs' => ['method cause(Promise:D:)'], 'returns' => [] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<True> for a kept or broken promise, and C<False> for one in state C<Planned>.', 'sigs' => ['multi method Bool(Promise:D:)'], 'returns' => [] },
        { 'name' => 'status', 'kind' => 'method', 'summary' => 'Returns the current state of the promise: C<Kept>, C<Broken> or C<Planned>: See L<C<PromiseStatus>|/type/PromiseStatus>.', 'sigs' => ['method status(Promise:D --> PromiseStatus)'], 'returns' => ['PromiseStatus'] },
        { 'name' => 'scheduler', 'kind' => 'method', 'summary' => 'Returns the scheduler that manages the promise.', 'sigs' => ['method scheduler(Promise:D:)'], 'returns' => [] },
        { 'name' => 'vow', 'kind' => 'method', 'summary' => 'Returns an object that holds the sole authority over keeping or breaking a promise. Calling C<keep> or C<break> on a promise that has vow taken throws an exception of type L<C<X::Promise::Vowed>|/type/X::Promise::Vowed>.', 'sigs' => ['method keep() { ... }', 'method break() { ... }', 'method vow(Promise:D: --> Vow:D)'], 'returns' => ['Vow:D'] },
        { 'name' => 'Supply', 'kind' => 'method', 'summary' => 'Returns a L<C<Supply>|/type/Supply> that will emit the C<result> of the C<Promise> being Kept or C<quit> with the C<cause> if the C<Promise> is Broken.', 'sigs' => ['method Supply(Promise:D:)'], 'returns' => [] },
        { 'name' => 'await', 'kind' => 'sub', 'summary' => 'Waits until one or more promises are I<all> fulfilled, and then returns their values. Also works on L<C<Channel>|/type/Channel>s. Any broken promises will rethrow their exceptions. If a list is passed it will return a list containing the results of awaiting each item in turn.', 'sigs' => ['multi await(Promise:D --> Promise)', 'multi await(*@ --> Array)'], 'returns' => ['Promise', 'Array'] },
      ],
      'examples' => [
        { 'code' => 'class Promise {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $p = Promise.start({ sleep 2; 42});
$p.then({ say .result });   # will print 42 once the block finished
say $p.status;              # OUTPUT: «Planned␤»
$p.result;                  # waits for the computation to finish
say $p.status;              # OUTPUT: «Kept␤»', 'expect' => 'Planned
Kept
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'sub async-get-with-promise($user-agent, $url) {
my $p = Promise.new;
my $v = $p.vow;

# do an asynchronous call on a fictive user agent,
# and return the promise:
$user-agent.async-get($url,
        on-error => -> $error {
            $v.break($error);
        },
        on-success => -> $response {
            $v.keep($response);
        }
);
return $p;
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
