    {
      'name' => 'Blob',
      'file' => 'Blob',
      'subkind' => 'role',
      'category' => 'composite',
      'subtitle' => 'Immutable buffer for binary data (\'Binary Large OBject\')',
      'decl' => 'enum as the B<second> parameter to these methods.  If no endianness is',
      'declkind' => 'role',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Creates an empty C<Blob>, or a new C<Blob> from another C<Blob>, or from a list of integers or values (which will have to be coerced into integers):', 'sigs' => ['multi method new(Blob:)', 'multi method new(Blob: Blob:D $blob)', 'multi method new(Blob: int @values)', 'multi method new(Blob: @values)', 'multi method new(Blob: *@values)'], 'returns' => [] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<False> if and only if the buffer is empty.', 'sigs' => ['multi method Bool(Blob:D:)'], 'returns' => [] },
        { 'name' => 'Capture', 'kind' => 'method', 'summary' => 'Converts the object to a L<C<List>|/type/List> which is, in turn, coerced to a L<C<Capture>|/type/Capture>.', 'sigs' => ['method Capture(Blob:D:)'], 'returns' => [] },
        { 'name' => 'elems', 'kind' => 'method', 'summary' => 'Returns the number of elements of the buffer.', 'sigs' => ['multi method elems(Blob:D:)'], 'returns' => [] },
        { 'name' => 'bytes', 'kind' => 'method', 'summary' => 'Returns the number of bytes used by the elements in the buffer.', 'sigs' => ['method bytes(Blob:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'chars', 'kind' => 'method', 'summary' => 'Throws L<C<X::Buf::AsStr>|/type/X::Buf::AsStr> with C<chars> as payload.', 'sigs' => ['method chars(Blob:D:)'], 'returns' => [] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Throws L<C<X::Buf::AsStr>|/type/X::Buf::AsStr> with L<C<Str>|/type/Str> as payload. In order to convert to a L<C<Str>|/type/Str> you need to use L<C<.decode>|/routine/decode>.', 'sigs' => ['multi method Str(Blob:D:)'], 'returns' => [] },
        { 'name' => 'Stringy', 'kind' => 'method', 'summary' => 'Throws L<C<X::Buf::AsStr>|/type/X::Buf::AsStr> with L<C<Stringy>|/type/Stringy> as payload.', 'sigs' => ['multi method Stringy(Blob:D:)'], 'returns' => [] },
        { 'name' => 'decode', 'kind' => 'method', 'summary' => 'Applies an encoding to turn the blob into a L<C<Str>|/type/Str>; the encoding will be UTF-8 by default. On malformed utf-8 C<.decode> will throw X::AdHoc. To handle sloppy utf-8 use L«C<utf8-c8>|/language/unicode#UTF8-C8».', 'sigs' => ['multi method decode(Blob:D: $encoding = self.encoding // "utf-8")'], 'returns' => [] },
        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Returns a L<C<List>|/type/List> of integers:', 'sigs' => ['multi method list(Blob:D:)'], 'returns' => [] },
        { 'name' => 'gist', 'kind' => 'method', 'summary' => 'Returns the string containing the "gist" of the C<Blob>, B<listing up to the first 100> elements, separated by space, appending an ellipsis if the C<Blob> has more than 100 elements.', 'sigs' => ['method gist(Blob:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'subbuf', 'kind' => 'method', 'summary' => 'Extracts a part of the invocant buffer, starting from the index with elements C<$from>, and taking C<$len> elements (or less if the buffer is shorter), and creates a new buffer as the result. For convenience, also allows a L<C<Range>|/type/Range> to be specified to indicate which part of the invocant buffer you would like:', 'sigs' => ['multi method subbuf(Int $from, Int $len = self.elems --> Blob:D)', 'multi method subbuf(Range $range --> Blob:D)', 'multi method subbuf(Blob:D: &From)', 'multi method subbuf(Blob:D: Int:D $From, &End)', 'multi method subbuf(Blob:D: &From, &End)', 'multi method subbuf(Blob:D: \\from, Whatever)', 'multi method subbuf(Blob:D: \\from, Numeric \\length)'], 'returns' => ['Blob:D', 'Blob:D'] },
        { 'name' => 'allocate', 'kind' => 'method', 'summary' => 'Returns a newly created C<Blob> object with the given number of elements. Optionally takes a second argument that indicates the pattern with which to fill the C<Blob>: this can be a single (possibly native) integer value, or any L<C<Iterable>|/type/Iterable> that generates integer values, including another C<Blob>. The pattern will be repeated if not enough values are given to fill the entire C<Blob>.', 'sigs' => ['multi method allocate(Blob:U: Int:D $elements)', 'multi method allocate(Blob:U: Int:D $elements, int $value)', 'multi method allocate(Blob:U: Int:D $elements, Int:D \\value)', 'multi method allocate(Blob:U: Int:D $elements, Mu:D $got)', 'multi method allocate(Blob:U: Int:D $elements, int @values)', 'multi method allocate(Blob:U: Int:D $elements, Blob:D $blob)', 'multi method allocate(Blob:U: Int:D $elements, @values)'], 'returns' => [] },
        { 'name' => 'unpack', 'kind' => 'routine', 'summary' => 'This method is considered B<experimental>, in order to use it you will need to do: Extracts features from the blob according to the template string, and returns them as a list. The template string consists of zero or more units that begin with an ASCII letter, and are optionally followed by a quantifier.  The quantifier can be C<*> (which typically stands for "use up the rest of the Blob here"), or a', 'sigs' => ['multi method unpack(Blob:D: Str:D $template)', 'multi method unpack(Blob:D: @template)', 'multi        unpack(Blob:D \\blob, Str:D $template)', 'multi        unpack(Blob:D \\blob, @template)'], 'returns' => [] },
        { 'name' => 'pack', 'kind' => 'sub', 'summary' => 'This subroutine is considered B<experimental>,  in order to use it you will need to do: Packs the given items according to the template and returns a buffer containing the packed bytes. The template string consists of zero or more units that begin with an ASCII letter, and are optionally followed by a quantifier.  For details, see L<unpack|/routine/unpack>.', 'sigs' => ['multi pack(Str $template, *@items)', 'multi pack(@template, *@items)'], 'returns' => [] },
        { 'name' => 'reverse', 'kind' => 'method', 'summary' => 'Returns a Blob with all elements in reversed order. These methods are available on the blob8 (and C<buf8>) types only.  They allow low level access to reading bytes from the underlying data and interpreting them in different ways with regards to type (integer or floating point (num)), size (8, 16, 32, 64 or 128 bits), signed or unsigned (for integer values) and endianness (native, little and big endianness).  The returned values are', 'sigs' => ['method reverse(Blob:D: --> Blob:D)'], 'returns' => ['Blob:D'] },
        { 'name' => 'read-uint8', 'kind' => 'method', 'summary' => 'Returns an unsigned native integer value for the byte at the given position. The C<$endian> parameter has no meaning, but is available for consistency.', 'sigs' => ['method read-uint8(blob8:D: uint $pos, $endian = NativeEndian --> uint)'], 'returns' => ['uint'] },
        { 'name' => 'read-int8', 'kind' => 'method', 'summary' => 'Returns a native C<int> value for the byte at the given position. The C<$endian> parameter has no meaning, but is available for consistency.', 'sigs' => ['method read-int8(blob8:D: uint $pos, $endian = NativeEndian --> int)'], 'returns' => ['int'] },
        { 'name' => 'read-uint16', 'kind' => 'method', 'summary' => 'Returns a native C<uint> value for the B<two> bytes starting at the given position.', 'sigs' => ['method read-uint16(blob8:D: uint $pos, $endian = NativeEndian --> uint)'], 'returns' => ['uint'] },
        { 'name' => 'read-int16', 'kind' => 'method', 'summary' => 'Returns a native C<int> value for the B<two> bytes starting at the given position.', 'sigs' => ['method read-int16(blob8:D: uint $pos, $endian = NativeEndian --> int)'], 'returns' => ['int'] },
        { 'name' => 'read-uint32', 'kind' => 'method', 'summary' => 'Returns a native C<uint> value for the B<four> bytes starting at the given position.', 'sigs' => ['method read-uint32(blob8:D: uint $pos, $endian = NativeEndian --> uint)'], 'returns' => ['uint'] },
        { 'name' => 'read-int32', 'kind' => 'method', 'summary' => 'Returns a native C<int> value for the B<four> bytes starting at the given position.', 'sigs' => ['method read-int32(blob8:D: uint $pos, $endian = NativeEndian --> int)'], 'returns' => ['int'] },
        { 'name' => 'read-uint64', 'kind' => 'method', 'summary' => 'Returns an unsigned integer value for the B<eight> bytes starting at the given position.', 'sigs' => ['method read-uint64(blob8:D: uint $pos, $endian = NativeEndian --> UInt:D)'], 'returns' => ['UInt:D'] },
        { 'name' => 'read-int64', 'kind' => 'method', 'summary' => 'Returns a native C<int> value for the B<eight> bytes starting at the given position.', 'sigs' => ['method read-int64(blob8:D: uint $pos, $endian = NativeEndian --> int)'], 'returns' => ['int'] },
        { 'name' => 'read-uint128', 'kind' => 'method', 'summary' => 'Returns an unsigned integer value for the B<sixteen> bytes starting at the given position.', 'sigs' => ['method read-uint128(blob8:D: uint $pos, $endian = NativeEndian --> UInt:D)'], 'returns' => ['UInt:D'] },
        { 'name' => 'read-int128', 'kind' => 'method', 'summary' => 'Returns an integer value for the B<sixteen> bytes starting at the given position.', 'sigs' => ['method read-int128(blob8:D: uint $pos, $endian = NativeEndian --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'read-num32', 'kind' => 'method', 'summary' => 'Returns a native C<num> value for the B<four> bytes starting at the given position.', 'sigs' => ['method read-num32(blob8:D: uint $pos, $endian = NativeEndian --> int)'], 'returns' => ['int'] },
        { 'name' => 'read-num64', 'kind' => 'method', 'summary' => 'Returns a native C<num> value for the B<eight> bytes starting at the given position.', 'sigs' => ['method read-num64(blob8:D: uint $pos, $endian = NativeEndian --> int)'], 'returns' => ['int'] },
        { 'name' => 'read-ubits', 'kind' => 'method', 'summary' => 'Returns an unsigned integer value for the B<bits> from the given B<bit> offset and given number of bits.  The endianness of the bits is assumed to be C<BigEndian>.', 'sigs' => ['method read-ubits(blob8:D: uint $pos, uint $bits --> UInt:D)'], 'returns' => ['UInt:D'] },
        { 'name' => 'read-bits', 'kind' => 'method', 'summary' => 'Returns a signed integer value for the B<bits> from the given B<bit> offset and given number of bits.  The endianness of the bits is assumed to be C<BigEndian>.', 'sigs' => ['method read-bits(blob8:D: uint $pos, uint $bits --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'Buf', 'kind' => 'method', 'summary' => 'Available as of the 2021.06 Rakudo compiler release. Coerces the invocant into a mutable L<C<Buf>|/type/Buf> object.', 'sigs' => ['method Buf(Blob:D: --> Buf:D)'], 'returns' => ['Buf:D'] },
      ],
      'examples' => [
        { 'code' => 'role Blob[::T = uint8] does Positional[T] does Stringy { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
