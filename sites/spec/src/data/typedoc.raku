', 'routine' => 'new', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say (3+5i).re;    # OUTPUT: «3␤»', 'expect' => '3
', 'routine' => 're', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say (3+5i).im;    # OUTPUT: «5␤»', 'expect' => '5
', 'routine' => 'im', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say (3+5i).reals;    # OUTPUT: «(3 5)␤»', 'expect' => '(3 5)
', 'routine' => 'reals', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say (NaN+5i).isNaN; # OUTPUT: «True␤»
say (7+5i).isNaN;   # OUTPUT: «False␤»', 'expect' => 'True
