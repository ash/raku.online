        { 'code' => 'my $n = ("a" => 5, "b" => 2, "a" => 1).BagHash;
say $n.values.sort;                              # OUTPUT: «(2 6)␤»', 'expect' => '(2 6)
', 'routine' => 'values', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = bag <eggs spam spam spam>;
