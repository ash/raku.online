        { 'code' => 'say 4.sqrt;             # OUTPUT: «2␤»
say sqrt(2);            # OUTPUT: «1.4142135623731␤»', 'expect' => '2
1.4142135623731
', 'routine' => 'sqrt', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say sqrt(-1);           # OUTPUT: «0+1i␤»', 'expect' => '0+1i
', 'routine' => 'sqrt', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say 6.sign;             # OUTPUT: «1␤»
