    {
      'name' => 'Bool',
      'file' => 'Bool',
      'subkind' => 'enum',
      'category' => 'basic',
      'subtitle' => 'Logical Boolean',
      'declkind' => 'enum',
      'routines' => [
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'method ACCEPTS(Bool:D: --> Bool:D) Used for smartmatch comparison. When the right side is C<True> returns always C<True>, when the right side of the match is C<False> returns always C<False>. In particular, C<ACCEPTS> returns always the instance on which it is invoked, that is the right side of a smartmatch. As an example:', 'sigs' => [], 'returns' => [] },
        { 'name' => 'succ', 'kind' => 'routine', 'summary' => 'Returns C<True>. C<succ> is short for "successor"; it returns the next enum value. Bool is a special enum with only two values, C<False> and C<True>. When sorted, C<False> comes first, so C<True> is its successor. And since C<True> is the "highest" Bool enum value, its own successor is also C<True>.', 'sigs' => ['method succ(--> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'pred', 'kind' => 'routine', 'summary' => 'Returns C<False>. C<pred> is short for "predecessor"; it returns the previous enum value. Bool is a special enum with only two values, C<False> and C<True>. When sorted, C<False> comes first, so C<False> is the predecessor to C<True>. And since C<False> is the "lowest" Bool enum value, its own predecessor is also C<False>.', 'sigs' => ['method pred(--> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'enums', 'kind' => 'routine', 'summary' => 'Returns a L<C<Hash>|/type/Hash> of enum-pairs. Works on both the C<Bool> type and any key.', 'sigs' => ['method enums(--> Hash:D)'], 'returns' => ['Hash:D'] },
        { 'name' => 'pick', 'kind' => 'routine', 'summary' => 'Returns a random pick of C<True> and/or C<False>. If it\'s called without an argument then it returns just one pick: If it\'s called with a C<$count> of one then it returns a L<C<Seq>|/type/Seq> with just one pick: If C<$count> is C<*> or greater than or equal to two then it returns a L<C<Seq>|/type/Seq> with I<two> elements -- either C<True> then C<False>, or C<False> then C<True>:', 'sigs' => ['multi method pick(Bool:U: --> Bool:D)', 'multi method pick(Bool:U: $count --> Seq:D)'], 'returns' => ['Bool:D', 'Seq:D'] },
        { 'name' => 'roll', 'kind' => 'routine', 'summary' => 'Returns C<True> or C<False> if called without any argument. Otherwise returns C<$count> elements chosen at random. Note that each random choice from the C<enum> is made independently, like a separate coin toss where each side of the coin represents one of the two values of the C<enum>. If C<*> is passed as C<$count> an infinite L<C<Seq>|/type/Seq> of C<Bool>s is returned.', 'sigs' => ['multi method roll(Bool:U --> Bool:D)', 'multi method roll(Bool:U $count --> Seq:D)'], 'returns' => ['Bool:D', 'Seq:D'] },
        { 'name' => 'Int', 'kind' => 'routine', 'summary' => 'Returns the value part of the C<enum> pair.', 'sigs' => ['multi method Int(Bool:D --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'Numeric', 'kind' => 'routine', 'summary' => 'Returns the value part of the C<enum> pair.', 'sigs' => ['multi method Numeric(Bool:D --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => '?', 'kind' => 'prefix', 'summary' => 'Coerces its argument to C<Bool>.', 'sigs' => ['multi prefix:<?>(Mu --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'so', 'kind' => 'prefix', 'summary' => 'Coerces its argument to C<Bool>, has looser precedence than C«prefix:<?>».', 'sigs' => ['multi prefix:<so>(Mu --> Bool:D)'], 'returns' => ['Bool:D'] },
      ],
      'examples' => [
        { 'code' => 'enum Bool <False True>', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '
my $b = Bool.new( True );
# when True on the right side returns
# always True
True  ~~ $b;     # True
False ~~ $b;     # True

$b = Bool.new( False );
# when False on the right side
# returns always False
False ~~ $b;     # False
True ~~ $b;      # False', 'expect' => '', 'routine' => 'ACCEPTS', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say True.succ;                                    # OUTPUT: «True␤»
say False.succ;                                   # OUTPUT: «True␤»', 'expect' => 'True
True
', 'routine' => 'succ', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say True.pred;                                    # OUTPUT: «False␤»
say False.pred;                                   # OUTPUT: «False␤»', 'expect' => 'False
False
', 'routine' => 'pred', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Bool.enums;                                   # OUTPUT: «{False => 0, True => 1}␤»
say False.enums;                                  # OUTPUT: «{False => 0, True => 1}␤»', 'expect' => '{False => 0, True => 1}
{False => 0, True => 1}
', 'routine' => 'enums', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Bool.pick;                                    # OUTPUT: «True␤»', 'expect' => 'True
', 'routine' => 'pick', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Bool.pick(1);                                 # OUTPUT: «(False)␤»', 'expect' => '(False)
', 'routine' => 'pick', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Bool.pick(*);                                 # OUTPUT: «(False True)␤»', 'expect' => '(False True)
', 'routine' => 'pick', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Bool.roll;                                    # OUTPUT: «True␤»
say Bool.roll(3);                                 # OUTPUT: «(True False False)␤»
say Bool.roll(*);                                 # OUTPUT: «(...)␤»', 'expect' => 'True
(True False False)
(...)
', 'routine' => 'roll', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say False.Int;                                # OUTPUT: «0␤»
say True.Int;                                 # OUTPUT: «1␤»', 'expect' => '0
1
', 'routine' => 'Int', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say False.Numeric;                                # OUTPUT: «0␤»
say True.Numeric;                                 # OUTPUT: «1␤»', 'expect' => '0
1
', 'routine' => 'Numeric', 'opts' => '', 'preamble' => '' },
      ],
    },
    {
      'name' => 'Buf',
      'file' => 'Buf',
      'subkind' => 'role',
      'category' => 'composite',
      'subtitle' => 'Mutable buffer for binary data',
      'decl' => 'enum as the B<third> parameter to these methods.  If no endianness is',
      'declkind' => 'role',
      'routines' => [
        { 'name' => 'subbuf-rw', 'kind' => 'method', 'summary' => 'A mutable version of C<subbuf> that returns a L<C<Proxy>|/type/Proxy> functioning as a writable reference to a part of a buffer. Its first argument, C<$from> specifies the index in the buffer from which a substitution should occur, and its last argument, C<$elems> specifies how many elements are to be replaced. For example, to replace one element at index 3 with two elements, C<100> and C<101>: In the case the C<$elems> argument is not specified, the substitution', 'sigs' => ['method subbuf-rw($from = 0, $elems = self.elems - $from) is rw'], 'returns' => [] },
        { 'name' => 'subbuf-rw', 'kind' => 'routine', 'summary' => 'Returns a writable reference to a part of a buffer. Invokes the C<subbuf-rw> method on the specified C<Buf>:', 'sigs' => ['multi subbuf-rw(Buf:D \\b) is rw', 'multi subbuf-rw(Buf:D \\b, Int() $from) is rw', 'multi subbuf-rw(Buf:D \\b, $from, $elems) is rw'], 'returns' => [] },
        { 'name' => 'reallocate', 'kind' => 'method', 'summary' => 'Change the number of elements of the C<Buf>, returning the changed C<Buf>. The size of C<Buf> will be adapted depending on the number of C<$elems> specified: if it is smaller than the actual size of the C<Buf> the resulting C<Buf> will be shrunk down, otherwise it will be enlarged to fit the number of C<$elems>. In the case the C<Buf> is enlarged, newly created items will be assigned a Virtual Machine specific null', 'sigs' => ['method reallocate(Buf:D: Int:D $elems)'], 'returns' => [] },
        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Returns a L<C<List>|/type/List> of integers.', 'sigs' => ['multi method list(Buf:D:)'], 'returns' => [] },
        { 'name' => 'push', 'kind' => 'method', 'summary' => 'Adds elements at the end of the buffer.', 'sigs' => ['method push( $elems )'], 'returns' => [] },
        { 'name' => 'pop', 'kind' => 'method', 'summary' => 'Returns and removes the last element of the buffer.', 'sigs' => ['method pop()'], 'returns' => [] },
        { 'name' => 'append', 'kind' => 'method', 'summary' => 'Appends to the end of the buffer.', 'sigs' => ['method append( $elems )'], 'returns' => [] },
        { 'name' => 'prepend', 'kind' => 'method', 'summary' => 'Inserts elements at the beginning of the buffer. Duplicated from Array.prepend The difference from method C<unshift> is that if you prepend a B<single> array or list argument, C<prepend> will flatten that array / list, whereas C<unshift> prepends the list / array as just a single element.', 'sigs' => ['method prepend( $elems )'], 'returns' => [] },
        { 'name' => 'shift', 'kind' => 'method', 'summary' => 'Removes and returns the first element of the buffer.', 'sigs' => ['method shift()'], 'returns' => [] },
        { 'name' => 'unshift', 'kind' => 'method', 'summary' => 'Inserts elements at the beginning of the buffer.', 'sigs' => ['method unshift()'], 'returns' => [] },
        { 'name' => 'splice', 'kind' => 'method', 'summary' => 'Substitutes elements of the buffer by other elements, returning a buffer with the removed elements. These methods are available on the C<buf8> type only.  They allow low level access to writing bytes to the underlying data and in different ways with regards to type (integer or floating point (num)), size (8, 16, 32, 64 or 128 bits), signed or unsigned (for integer values) and endianness (native, little', 'sigs' => ['method splice( Buf:D: $start = 0, $elems?, *@replacement --> Buf)'], 'returns' => ['Buf'] },
        { 'name' => 'write-uint8', 'kind' => 'method', 'summary' => 'Writes an unsigned 8-bit integer value at the given position.  The C<$endian> parameter has no meaning, but is available for consistency.', 'sigs' => ['method write-uint8(buf8:D: uint $pos, uint8 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-int8', 'kind' => 'method', 'summary' => 'Writes a signed 8-bit integer value at the given position.  The C<$endian> parameter has no meaning, but is available for consistency.', 'sigs' => ['method write-int8(buf8:D: uint $pos, int8 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-uint16', 'kind' => 'method', 'summary' => 'Writes an unsigned 16-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-uint16(buf8:D: uint $pos, uint16 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-int16', 'kind' => 'method', 'summary' => 'Writes a signed 16-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-int16(buf8:D: uint $pos, int16 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-uint32', 'kind' => 'method', 'summary' => 'Writes an unsigned 32-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-uint32(buf8:D: uint $pos, uint32 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-int32', 'kind' => 'method', 'summary' => 'Writes a signed 32-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-int32(buf8:D: uint $pos, int32 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-uint64', 'kind' => 'method', 'summary' => 'Writes an unsigned 64-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-uint64(buf8:D: uint $pos, uint64 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-int64', 'kind' => 'method', 'summary' => 'Writes a signed 64-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-int64(buf8:D: uint $pos, Int:D $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-uint128', 'kind' => 'method', 'summary' => 'Writes an unsigned 128-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-uint128(buf8:D: uint $pos, UInt:D $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-int128', 'kind' => 'method', 'summary' => 'Writes a signed 128-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-int128(buf8:D: uint $pos, Int:D $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-num32', 'kind' => 'method', 'summary' => 'Writes a native C<num32> IEEE floating point value at the given position with the given endianness.', 'sigs' => ['method write-num32(buf8:D: uint $pos, num32 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-num64', 'kind' => 'method', 'summary' => 'Writes a native C<num64> IEEE floating point value at the given position with the given endianness.', 'sigs' => ['method write-num64(buf8:D: uint $pos, num64 $value, $endian = NativeEndian --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-ubits', 'kind' => 'method', 'summary' => 'Writes an unsigned integer value to the B<bits> from the given B<bit> offset and given number of bits.  The endianness of the bits is assumed to be C<BigEndian>.  Always returns Nil.', 'sigs' => ['method write-ubits(buf8:D: uint $pos, uint $bits, UInt:D $value --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-bits', 'kind' => 'method', 'summary' => 'Writes a signed integer value for the B<bits> from the given B<bit> offset and given number of bits.  The endianness of the bits is assumed to be C<BigEndian>.  Always returns Nil. These methods are available on the C<buf8> type only.  They allow low level access to writing bytes to the underlying data and in different ways with regards to type (integer or floating point (num)), size (8, 16, 32, 64 or 128', 'sigs' => ['method write-bits(buf8:D: uint $pos, uint $bits, Int:D $value --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'write-uint8', 'kind' => 'method', 'summary' => 'Writes an unsigned 8-bit integer value at the given position.  The C<$endian> parameter has no meaning, but is available for consistency.', 'sigs' => ['method write-uint8(buf8: uint $pos, uint8 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-int8', 'kind' => 'method', 'summary' => 'Writes a signed 8-bit integer value at the given position.  The C<$endian> parameter has no meaning, but is available for consistency.', 'sigs' => ['method write-int8(buf8: uint $pos, int8 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-uint16', 'kind' => 'method', 'summary' => 'Writes an unsigned 16-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-uint16(buf8: uint $pos, uint16 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-int16', 'kind' => 'method', 'summary' => 'Writes a signed 16-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-int16(buf8: uint $pos, int16 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-uint32', 'kind' => 'method', 'summary' => 'Writes an unsigned 32-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-uint32(buf8: uint $pos, uint32 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-int32', 'kind' => 'method', 'summary' => 'Writes a signed 32-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-int32(buf8: uint $pos, int32 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-uint64', 'kind' => 'method', 'summary' => 'Writes an unsigned 64-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-uint64(buf8: uint $pos, uint64 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-int64', 'kind' => 'method', 'summary' => 'Writes a signed 64-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-int64(buf8: uint $pos, Int:D $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-uint128', 'kind' => 'method', 'summary' => 'Writes an unsigned 128-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-uint128(buf8: uint $pos, UInt:D $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-int128', 'kind' => 'method', 'summary' => 'Writes a signed 128-bit integer value at the given position with the given endianness.', 'sigs' => ['method write-int128(buf8: uint $pos, Int:D $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-num32', 'kind' => 'method', 'summary' => 'Writes a native C<num32> IEEE floating point value at the given position with the given endianness.', 'sigs' => ['method write-num32(buf8: uint $pos, num32 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-num64', 'kind' => 'method', 'summary' => 'Writes a native C<num64> IEEE floating point value at the given position with the given endianness.', 'sigs' => ['method write-num64(buf8: uint $pos, num64 $value, $endian = NativeEndian --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-ubits', 'kind' => 'method', 'summary' => 'Writes an unsigned integer value to the B<bits> from the given B<bit> offset and given number of bits.  The endianness of the bits is assumed to be C<BigEndian>.', 'sigs' => ['method write-ubits(buf8: uint $pos, uint $bits, UInt:D $value --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'write-bits', 'kind' => 'method', 'summary' => 'Writes a signed integer value for the B<bits> from the given B<bit> offset and given number of bits.  The endianness of the bits is assumed to be C<BigEndian>.', 'sigs' => ['method write-bits(buf8: uint $pos, uint $bits, Int:D $value --> buf8:D)'], 'returns' => ['buf8:D'] },
        { 'name' => 'Blob', 'kind' => 'method', 'summary' => 'Available as of the 2021.06 Rakudo compiler release. Coerces the invocant into an immutable L<C<Blob>|/type/Blob> object.', 'sigs' => ['method Buf(Buf:D: --> Blob:D)'], 'returns' => ['Blob:D'] },
      ],
      'examples' => [
        { 'code' => 'role Buf[::T = uint8] does Blob[T] is repr(\'VMArray\') is array_type(T){ ... }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $bú = Buf.new(1, 2, 3);
$bú[1] = 42;
say $bú.raku; # OUTPUT: «Buf.new(1,42,3)␤»', 'expect' => 'Buf.new(1,42,3)
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $bú = Buf[int32].new(3, -3, 0xff32, -44);
say $bú; # OUTPUT: «Buf[int32]:0x<03 -3 FF32 -2C>␤»', 'expect' => 'Buf[int32]:0x<03 -3 FF32 -2C>
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $bú = buf8.new(3, 6, 254);
say $bú; # OUTPUT: «Buf[uint8]:0x<03 06 fe>␤»', 'expect' => 'Buf[uint8]:0x<03 06 fe>
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Buf $bú .= new(0..5);
$bú.subbuf-rw(3,1) = Buf.new(100, 101);
say $bú.raku;   # OUTPUT: «Buf.new(0,1,2,100,101,4,5)␤»', 'expect' => 'Buf.new(0,1,2,100,101,4,5)
', 'routine' => 'subbuf-rw', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Buf $bú .= new(0..5);
$bú.subbuf-rw(3) = Buf.new(200);
say $bú.raku;   # OUTPUT: «Buf.new(0,1,2,200)␤»', 'expect' => 'Buf.new(0,1,2,200)
', 'routine' => 'subbuf-rw', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Buf $bú .= new(0..5);
$bú.subbuf-rw = Buf.new(123, 123);
say $bú.raku;   # OUTPUT: «Buf.new(123, 123)␤»', 'expect' => 'Buf.new(123, 123)
', 'routine' => 'subbuf-rw', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Buf $bú .= new(1,2,3);
subbuf-rw($bú,2,1) = Buf.new(42);
say $bú.raku;   # OUTPUT: «Buf.new(1,2,42)␤»', 'expect' => 'Buf.new(1,2,42)
', 'routine' => 'subbuf-rw', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Buf $bú .= new(^10);
$bú.reallocate(5);
say $bú.raku;  # OUTPUT: «Buf.new(0,1,2,3,4)␤»', 'expect' => 'Buf.new(0,1,2,3,4)
', 'routine' => 'reallocate', 'opts' => '', 'preamble' => '' },
        { 'code' => '$bú = Buf.new( 1..3 );
$bú.reallocate( 10 );
say $bú.raku; # OUTPUT: «Buf.new(1,2,3,0,0,0,0,0,0,0)␤»', 'expect' => 'Buf.new(1,2,3,0,0,0,0,0,0,0)
', 'routine' => 'reallocate', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Buf.new(122,105,112,205).list; # OUTPUT: «(122 105 112 205)␤»', 'expect' => '(122 105 112 205)
', 'routine' => 'list', 'opts' => '', 'preamble' => '' },
        { 'code' => ' my $bú = Buf.new( 1, 1, 2, 3, 5 );
 $bú.push( 8 );
 say $bú.raku; # OUTPUT: «Buf.new(1,1,2,3,5,8)␤»', 'expect' => 'Buf.new(1,1,2,3,5,8)
', 'routine' => 'push', 'opts' => '', 'preamble' => '' },
        { 'code' => ' my $bú = Buf.new( 1, 1, 2, 3, 5 );
 say $bú.pop(); # OUTPUT: «5␤»
 say $bú.raku;  # OUTPUT: «Buf.new(1,1,2,3)␤»', 'expect' => '5
Buf.new(1,1,2,3)
', 'routine' => 'pop', 'opts' => '', 'preamble' => '' },
        { 'code' => ' my $bú = Buf.new( 1, 1, 2, 3, 5 );
 $bú.append(9, 8, 7, 6);
 say $bú.raku; # OUTPUT: «Buf.new(1,1,2,3,5,9,8,7,6)␤»', 'expect' => 'Buf.new(1,1,2,3,5,9,8,7,6)
', 'routine' => 'append', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $bú = Buf.new( 1, 1, 2, 3, 5 );
$bú.prepend( 0 );
say $bú.raku; # OUTPUT: «Buf.new(0,1,1,2,3,5)␤»', 'expect' => 'Buf.new(0,1,1,2,3,5)
', 'routine' => 'prepend', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $bú = Buf.new( 1, 1, 2, 3, 5 );
say $bú.shift(); # OUTPUT: «1␤»
say $bú.raku;    # OUTPUT: «Buf.new(1,2,3,5)␤»', 'expect' => '1
Buf.new(1,2,3,5)
', 'routine' => 'shift', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $bú = Buf.new( 1, 1, 2, 3, 5 );
$bú.unshift( 0 );
say $bú.raku; # OUTPUT: «Buf.new(0,1,1,2,3,5)␤»', 'expect' => 'Buf.new(0,1,1,2,3,5)
', 'routine' => 'unshift', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $bú = Buf.new( 1, 1, 2, 3, 5 );
say $bú.splice:  0, 3, <3 2 1>;  # OUTPUT: «Buf:0x<01 01 02>␤»
say $bú.raku;                    # OUTPUT: «Buf.new(3,2,1,3,5)␤»', 'expect' => 'Buf:0x<01 01 02>
Buf.new(3,2,1,3,5)
', 'routine' => 'splice', 'opts' => '', 'preamble' => '' },
      ],
