      'name' => 'Complex',
      'file' => 'Complex',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Complex number',
      'declkind' => 'class',
      'children' => ['ComplexStr'],
      'routines' => [
        { 'name' => 'i', 'kind' => 'postfix', 'summary' => 'Adding a trailing C<i> to a number literal makes it a Complex, for example:', 'sigs' => [], 'returns' => [] },
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Creates a new C<Complex> object from real and imaginary parts. When created without arguments, both parts are considered to be zero.', 'sigs' => ['multi method new(Real $re, Real $im --> Complex:D)'], 'returns' => ['Complex:D'] },
        { 'name' => 're', 'kind' => 'method', 'summary' => 'Returns the real part of the complex number.', 'sigs' => ['method re(Complex:D: --> Real:D)'], 'returns' => ['Real:D'] },
        { 'name' => 'im', 'kind' => 'method', 'summary' => 'Returns the imaginary part of the complex number.', 'sigs' => ['method im(Complex:D: --> Real:D)'], 'returns' => ['Real:D'] },
        { 'name' => 'reals', 'kind' => 'method', 'summary' => 'Returns a two-element list containing the real and imaginary parts for this value.', 'sigs' => ['method reals(Complex:D: --> Positional:D)'], 'returns' => ['Positional:D'] },
        { 'name' => 'isNaN', 'kind' => 'method', 'summary' => 'Returns true if the real or imaginary part is L<C<NaN>|/type/Num#NaN> (not a number).', 'sigs' => ['method isNaN(Complex:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'polar', 'kind' => 'method', 'summary' => 'Returns a two-element list of the polar coordinates for this value, i.e. magnitude and angle in radians.', 'sigs' => ['method polar(Complex:D: --> Positional:D)'], 'returns' => ['Positional:D'] },
        { 'name' => 'floor', 'kind' => 'method', 'summary' => 'Returns C<self.re.floor + self.im.floor>. That is, each of the real and imaginary parts is rounded to the highest integer not greater than the value of that part.', 'sigs' => ['method floor(Complex:D: --> Complex:D)'], 'returns' => ['Complex:D'] },
        { 'name' => 'ceiling', 'kind' => 'method', 'summary' => 'Returns C<self.re.ceiling + self.im.ceiling>. That is, each of the real and imaginary parts is rounded to the lowest integer not less than the value of that part.', 'sigs' => ['method ceiling(Complex:D: --> Complex:D)'], 'returns' => ['Complex:D'] },
        { 'name' => 'sign', 'kind' => 'routine', 'summary' => 'Returns C<0i> if the absolute value of the complex number is 0.  Otherwise returns the complex number divided by its absolute value (the unit complex number in the same direction as $z). Available as of 6.e language version (early implementation exists in Rakudo compiler 2023.02+).', 'sigs' => ['method sign(Complex:D: --> Complex:D)', 'multi  sign(Complex:D $z --> Complex:D)'], 'returns' => ['Complex:D', 'Complex:D'] },
        { 'name' => 'round', 'kind' => 'method', 'summary' => 'With no arguments, rounds both the real and imaginary parts to the nearest integer and returns a new C<Complex> number. If C<$scale> is given, rounds both parts of the invocant to the nearest multiple of C<$scale>. Uses the same algorithm as L<Real.round|/type/Real#method_round> on each part of the number.', 'sigs' => ['multi method round(Complex:D: --> Complex:D)', 'multi method round(Complex:D: Real() $scale --> Complex:D)'], 'returns' => ['Complex:D', 'Complex:D'] },
        { 'name' => 'truncate', 'kind' => 'method', 'summary' => 'Removes the fractional part of both the real and imaginary parts of the number, using L<Real.truncate|/type/Real#method_truncate>, and returns the result as a new C<Complex>.', 'sigs' => ['method truncate(Complex:D: --> Complex:D)'], 'returns' => ['Complex:D'] },
        { 'name' => 'abs', 'kind' => 'routine', 'summary' => 'Returns the absolute value of the invocant (or the argument in sub form). For a given complex number C<$z> the absolute value C<|$z|> is defined as C<sqrt($z.re * $z.re + $z.im * $z.im)>.', 'sigs' => ['method abs(Complex:D: --> Num:D)', 'multi  abs(Complex:D $z --> Num:D)'], 'returns' => ['Num:D', 'Num:D'] },
        { 'name' => 'conj', 'kind' => 'method', 'summary' => 'Returns the complex conjugate of the invocant (that is, the number with the sign of the imaginary part negated).', 'sigs' => ['method conj(Complex:D: --> Complex:D)'], 'returns' => ['Complex:D'] },
        { 'name' => 'sqrt', 'kind' => 'method', 'summary' => 'Returns the complex square root of the invocant, i.e. the root where the real part is ≥ 0 and the imaginary part has the same sign as the imaginary part of the invocant.', 'sigs' => ['method sqrt(Complex:D: --> Complex:D)'], 'returns' => ['Complex:D'] },
        { 'name' => 'gist', 'kind' => 'method', 'summary' => 'Returns a string representation of the form "1+2i", without internal spaces. (Str coercion also returns this.)', 'sigs' => ['method gist(Complex:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'raku', 'kind' => 'method', 'summary' => 'Returns an implementation-specific string that produces an L<equivalent|/routine/eqv> object when given to L<EVAL|/routine/EVAL>.', 'sigs' => ['method raku(Complex:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'Real', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Num>|/type/Num>. If the imaginary part isn\'t L<approximately|/routine/=~=> zero, coercion L<fails|/routine/fail> with L<C<X::Numeric::Real>|/type/X::Numeric::Real>. The C<:D> variant returns the result of that coercion. The C<:U> variant issues a warning about using an uninitialized value in numeric context and then returns value C<0e0>.', 'sigs' => ['multi method Real(Complex:D: --> Num:D)', 'multi method Real(Complex:U: --> Num:D)'], 'returns' => ['Num:D', 'Num:D'] },
        { 'name' => 'infix:<**>', 'kind' => 'sub', 'summary' => 'The X<exponentiation operator|Infix operators,exponentiation operator> coerces the second argument to C<Complex> and calculates the left-hand-side raised to the power of the right-hand side. Since 6.d, either argument can be equal to zero.', 'sigs' => ['multi infix:<**>(Complex:D \\a, Complex:D \\b --> Complex:D)', 'multi infix:<**>(Num(Real) \\a, Complex:D \\b --> Complex:D)', 'multi infix:<**>(Complex:D \\a, Num(Real) \\b --> Complex:D)'], 'returns' => ['Complex:D', 'Complex:D', 'Complex:D'] },
      ],
      'examples' => [
        { 'code' => 'class Complex is Cool does Numeric {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
