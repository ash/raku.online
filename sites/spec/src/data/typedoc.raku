    {
      'name' => 'Pair',
      'file' => 'Pair',
      'subkind' => 'class',
      'category' => 'composite',
      'subtitle' => 'Key/value pair',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Constructs a new C<Pair> object.', 'sigs' => ['multi method new(Pair: Mu  $key, Mu  $value)', 'multi method new(Pair: Mu :$key, Mu :$value)'], 'returns' => [] },
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'If C<%topic> is an L<C<Associative>|/type/Associative>, looks up the value using invocant\'s key in it and checks invocant\'s value C<.ACCEPTS> that value: If C<$topic> is another C<Pair>, checks the invocant\'s key and value C<.ACCEPTS> the C<$topic>\'s key and value respectively: If C<$topic> is any other value, the invocant C<Pair>\'s key is treated as a method name. This method is called on C<$topic>, the L«C<Bool>|/type/Bool» result of which is compared', 'sigs' => ['multi method ACCEPTS(Pair:D $: %topic)', 'multi method ACCEPTS(Pair:D $: Pair:D $topic)', 'multi method ACCEPTS(Pair:D $: Mu $topic)'], 'returns' => [] },
        { 'name' => 'antipair', 'kind' => 'method', 'summary' => 'Returns a new C<Pair> object with key and value exchanged.', 'sigs' => ['method antipair(Pair:D: --> Pair:D)'], 'returns' => ['Pair:D'] },
        { 'name' => 'key', 'kind' => 'method', 'summary' => 'Returns the I<key> part of the C<Pair>.', 'sigs' => ['multi method key(Pair:D:)'], 'returns' => [] },
        { 'name' => 'value', 'kind' => 'method', 'summary' => 'Returns the I<value> part of the C<Pair>.', 'sigs' => ['multi method value(Pair:D:) is rw'], 'returns' => [] },
        { 'name' => 'cmp', 'kind' => 'infix', 'summary' => 'The type-agnostic comparator; compares two C<Pair>s. Compares first their I<key> parts, and then compares the I<value> parts if the keys are equal.', 'sigs' => ['multi infix:<cmp>(Pair:D, Pair:D)'], 'returns' => [] },
        { 'name' => 'fmt', 'kind' => 'method', 'summary' => 'Takes a I<format string>, and returns a string the I<key> and I<value> parts of the C<Pair> formatted. Here\'s an example: For more about format strings, see L<sprintf|/routine/sprintf>.', 'sigs' => ['multi method fmt(Pair:D: Str:D $format --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'kv', 'kind' => 'method', 'summary' => 'Returns a two-element L<C<Seq>|/type/Seq> with the I<key> and I<value> parts of C<Pair>, in that order. This method is a special case of the same-named method on L<C<Hash>|/type/Hash>, which returns all its entries as a list of keys and values.', 'sigs' => ['multi method kv(Pair:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'pairs', 'kind' => 'method', 'summary' => 'Returns a list of one C<Pair>, namely this one.', 'sigs' => ['multi method pairs(Pair:D:)'], 'returns' => [] },
        { 'name' => 'antipairs', 'kind' => 'method', 'summary' => 'Returns a L<C<List>|/type/List> containing the L<antipair|/type/Pair#method_antipair> of the invocant.', 'sigs' => ['multi method antipairs(Pair:D:)'], 'returns' => [] },
        { 'name' => 'invert', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq>. If the C<.value> of the invocant is I<NOT> an L<C<Iterable>|/type/Iterable>, the L<C<Seq>|/type/Seq> will contain a single C<Pair> whose C<.key> is the C<.value> of the invocant and whose C<.value> is the C<.key> of the invocant: If invocant\'s C<.value> I<is> an L<C<Iterable>|/type/Iterable>, the returned L<C<Seq>|/type/Seq> will contain the same number of C<Pair>s as items in the C<.value>, with each', 'sigs' => ['method invert(Pair:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'keys', 'kind' => 'method', 'summary' => 'Returns a L<C<List>|/type/List> containing the L<key|/type/Pair#method_key> of the invocant.', 'sigs' => ['multi method keys(Pair:D: --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'values', 'kind' => 'method', 'summary' => 'Returns a L<C<List>|/type/List> containing the L<value|/type/Pair#method_value> of the invocant.', 'sigs' => ['multi method values(Pair:D: --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'freeze', 'kind' => 'method', 'summary' => 'Makes the I<value> of the C<Pair> read-only, by removing it from its L<Scalar container|/language/containers#Scalar_containers>, and returns it. B<NOTE:> this method is deprecated as of B<6.d> language version. Instead, create a new C<Pair>, with a L<decontainerized|/language/glossary#decont> key/value.', 'sigs' => ['method freeze(Pair:D:)'], 'returns' => [] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Returns a string representation of the invocant formatted as I<key ~ \\t ~ value>.', 'sigs' => ['multi method Str(Pair:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'Pair', 'kind' => 'method', 'summary' => 'Returns the invocant C<Pair> object.', 'sigs' => ['method Pair()'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Pair does Associative {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'Pair.new(\'key\', \'value\'); # The canonical way
