', 'routine' => 'dir-sep', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say IO::Spec::Win32.is-absolute: "/foo";        # OUTPUT: «True␤»
say IO::Spec::Win32.is-absolute: "/\\x[308]foo"; # OUTPUT: «True␤»
say IO::Spec::Win32.is-absolute: ｢C:\\foo｣;      # OUTPUT: «True␤»
say IO::Spec::Win32.is-absolute: "bar";         # OUTPUT: «False␤»', 'expect' => 'True
True
True
False
', 'routine' => 'is-absolute', 'opts' => '', 'preamble' => '' },
