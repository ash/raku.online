:foo(127);                # short for  foo => 127
:127foo;                  # the same   foo => 127', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# use MATHEMATICAL DOUBLE-STRUCK DIGIT THREE
