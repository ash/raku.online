        { 'name' => 'roll', 'kind' => 'method', 'summary' => 'Similar to a L<C<Bag>|/type/Bag>.roll, but with L<C<Real>|/type/Real> weights rather than integral ones.', 'sigs' => ['method roll($count = 1)'], 'returns' => [] },
        { 'name' => 'pick', 'kind' => 'method', 'summary' => 'Throws an exception. The feature is not supported on the type, since there\'s no clear value to subtract from non-integral weights, to make it work.', 'sigs' => ['method pick($?)'], 'returns' => [] },
