        { 'name' => 'grep', 'kind' => 'method', 'summary' => 'Applies C<grep> to the C<HyperSeq> similarly to how it would do it on a L<C<Seq>|/type/Seq>. When you use C<hyper> on a L<C<Seq>|/type/Seq>, this is the method that is actually called.', 'sigs' => ['method grep(HyperSeq:D: $matcher, *%options)'], 'returns' => [] },
        { 'name' => 'map', 'kind' => 'method', 'summary' => 'Uses maps on the C<HyperSeq>, generally created by application of C<hyper> to a preexisting L<C<Seq>|/type/Seq>.', 'sigs' => ['method map(HyperSeq:D: $matcher, *%options)'], 'returns' => [] },
        { 'name' => 'invert', 'kind' => 'method', 'summary' => 'Inverts the C<HyperSeq> created from a L<C<Seq>|/type/Seq> by C<.hyper>.', 'sigs' => ['method invert(HyperSeq:D:)'], 'returns' => [] },
        { 'name' => 'hyper', 'kind' => 'method', 'summary' => 'Returns the object.', 'sigs' => ['method hyper(HyperSeq:D:)'], 'returns' => [] },
        { 'name' => 'race', 'kind' => 'method', 'summary' => 'Creates a L<C<RaceSeq>|/type/RaceSeq> object out of the current one.', 'sigs' => ['method race(HyperSeq:D:)'], 'returns' => [] },
        { 'name' => 'serial', 'kind' => 'method', 'summary' => 'Converts the object to a L<C<Seq>|/type/Seq> and returns it.', 'sigs' => ['multi method serial(HyperSeq:D:)'], 'returns' => [] },
        { 'name' => 'is-lazy', 'kind' => 'method', 'summary' => 'Returns C<False>.', 'sigs' => ['method is-lazy(--> False )'], 'returns' => ['False'] },
        { 'name' => 'sink', 'kind' => 'method', 'summary' => 'Sinks the underlying data structure, producing any side effects.', 'sigs' => ['method sink(--> Nil)'], 'returns' => ['Nil'] },
