', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'A: while True {
  say A.name; # OUTPUT: «A␤»
  last A;
}', 'expect' => 'A
', 'routine' => 'name', 'opts' => '', 'preamble' => '' },
        { 'code' => 'MY-LABEL:
for 1..10 {
    next MY-LABEL if $_ < 5;
