      'routines' => [
        { 'name' => 'find_method', 'kind' => 'method', 'summary' => 'Given a method name, it returns the method object of that name which is closest in the method resolution order (MRO). If no method can be found, it returns a VM-specific sentinel value (typically a low-level NULL value) that can be tested for with a test for L<definedness|/routine/defined>: If C<:no_fallback> is supplied, fallback methods are not considered.', 'sigs' => ['method find_method($obj, $name, :$no_fallback, *%adverbs)'], 'returns' => [] },
        { 'name' => 'find_method_qualified', 'kind' => 'method', 'summary' => 'Given a method name and a type, returns the method from that type. This is used in calls like', 'sigs' => ['method find_method_qualified($obj, $type, $name)'], 'returns' => [] },
        { 'name' => 'can', 'kind' => 'method', 'summary' => 'Returns the list of methods of that name the object can do.', 'sigs' => ['method can($obj, $name)'], 'returns' => [] },
        { 'name' => 'publish_method_cache', 'kind' => 'method', 'summary' => 'Walk MRO and add methods to cache, unless another method lower in the class hierarchy "shadowed" it.', 'sigs' => ['method publish_method_cache($obj)'], 'returns' => [] },
      ],
