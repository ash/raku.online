      'consumers' => ['Mixy', 'Bag', 'BagHash'],
      'routines' => [
        { 'name' => 'new-from-pairs', 'kind' => 'method', 'summary' => 'Constructs a Baggy objects from a list of L«C<Pair>|/type/Pair» objects given as positional arguments: B<Note:> be sure you aren\'t accidentally passing the Pairs as positional arguments; the quotes around the keys in the above example are significant.', 'sigs' => ['method new-from-pairs(Baggy: *@pairs --> Baggy:D)'], 'returns' => ['Baggy:D'] },
        { 'name' => 'grab', 'kind' => 'method', 'summary' => 'Like L<pick|#method pick>, a C<grab> returns a random selection of elements, weighted by the values corresponding to each key. Unlike C<pick>, it works only on mutable structures, e.g. L<C<BagHash>|/type/BagHash>. Use of C<grab> on an immutable structure results in an L<C<X::Immutable>|/type/X::Immutable> exception. If C<*> is passed as C<$count>, or C<$count> is greater than or equal to the L<total|#method total> of the invocant, then C<total> elements from the', 'sigs' => ['multi method grab(Baggy:D: --> Any)', 'multi method grab(Baggy:D: $count --> Seq:D)'], 'returns' => ['Any', 'Seq:D'] },
        { 'name' => 'grabpairs', 'kind' => 'method', 'summary' => 'Returns a L<C<Pair>|/type/Pair> or a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s depending on the version of the method being invoked. Each L<C<Pair>|/type/Pair> returned has an element of the invocant as its key and the element\'s weight as its value. Unlike L<pickpairs|/routine/pickpairs>, it works only on mutable structures, e.g. L<C<BagHash>|/type/BagHash>. Use of C<grabpairs> on an immutable structure results in', 'sigs' => ['multi method grabpairs(Baggy:D: --> Any)', 'multi method grabpairs(Baggy:D: $count --> Seq:D)'], 'returns' => ['Any', 'Seq:D'] },
        { 'name' => 'pick', 'kind' => 'method', 'summary' => 'Like an ordinary list L<pick|/type/List#routine_pick>, but returns keys of the invocant weighted by their values, as if the keys were replicated the number of times indicated by the corresponding value and then list pick used. The underlying metaphor for picking is that you\'re pulling colored marbles out a bag. (For "picking with replacement" see L<roll|#method roll> instead). If C<*> is passed as C<$count>, or C<$count> is', 'sigs' => ['multi method pick(Baggy:D: --> Any)', 'multi method pick(Baggy:D: $count --> Seq:D)'], 'returns' => ['Any', 'Seq:D'] },
        { 'name' => 'pickpairs', 'kind' => 'method', 'summary' => 'Returns a L<C<Pair>|/type/Pair> or a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s depending on the version of the method being invoked. Each L<C<Pair>|/type/Pair> returned has an element of the invocant as its key and the element\'s weight as its value. The elements are \'picked\' without replacement. If C<*> is passed as C<$count>, or C<$count> is greater than or equal to the number of L<elements|#method elems> of the invocant, then all element/weight L<C<Pair>|/type/Pair>s from', 'sigs' => ['multi method pickpairs(Baggy:D: --> Pair:D)', 'multi method pickpairs(Baggy:D: $count --> Seq:D)'], 'returns' => ['Pair:D', 'Seq:D'] },
        { 'name' => 'roll', 'kind' => 'method', 'summary' => 'Like an ordinary list L<roll|/type/List#routine_roll>, but returns keys of the invocant weighted by their values, as if the keys were replicated the number of times indicated by the corresponding value and then list roll used. The underlying metaphor for rolling is that you\'re throwing C<$count> dice that are independent of each other, which (in bag terms) is equivalent to picking a colored marble out your bag and then putting it back, and doing this', 'sigs' => ['multi method roll(Baggy:D: --> Any:D)', 'multi method roll(Baggy:D: $count --> Seq:D)'], 'returns' => ['Any:D', 'Seq:D'] },
        { 'name' => 'pairs', 'kind' => 'method', 'summary' => 'Returns all elements and their respective weights as a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s where the key is the element itself and the value is the weight of that element.', 'sigs' => ['method pairs(Baggy:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'antipairs', 'kind' => 'method', 'summary' => 'Returns all elements and their respective weights as a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s, where the element itself is the value and the weight of that element is the key, i.e. the opposite of method L<pairs|#method pairs>.', 'sigs' => ['method antipairs(Baggy:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'invert', 'kind' => 'method', 'summary' => 'Returns all elements and their respective weights as a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s, where the element itself is the value and the weight of that element is the key, i.e. the opposite of method L<pairs|#method pairs>. Except for some esoteric cases, C<invert> on a Baggy type returns the same result as L<antipairs|#method_antipairs>.', 'sigs' => ['method invert(Baggy:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'classify-list', 'kind' => 'method', 'summary' => 'Populates a I<mutable> C<Baggy> by classifying the possibly-empty C<@list> of values using the given C<mapper>. The C<@list> cannot be lazy. The mapper can be a L«C<Callable>|/type/Callable» that takes a single argument, an L«C<Associative>|/type/Associative», or an L«C<Iterable>|/type/Iterable». With L«C<Associative>|/type/Associative» and an L«C<Iterable>|/type/Iterable» mappers, the values in the C<@list> represent the key and index of the mapper\'s', 'sigs' => ['multi method classify-list(&mapper, *@list --> Baggy:D)', 'multi method classify-list(%mapper, *@list --> Baggy:D)', 'multi method classify-list(@mapper, *@list --> Baggy:D)'], 'returns' => ['Baggy:D', 'Baggy:D', 'Baggy:D'] },
        { 'name' => 'categorize-list', 'kind' => 'method', 'summary' => 'Populates a I<mutable> C<Baggy> by categorizing the possibly-empty C<@list> of values using the given C<mapper>. The C<@list> cannot be lazy. The mapper can be a L«C<Callable>|/type/Callable» that takes a single argument, an L«C<Associative>|/type/Associative», or an L«C<Iterable>|/type/Iterable». With L«C<Associative>|/type/Associative» and an L«C<Iterable>|/type/Iterable» mappers, the values in the C<@list> represent the key and index of the mapper\'s', 'sigs' => ['multi method categorize-list(&mapper, *@list --> Baggy:D)', 'multi method categorize-list(%mapper, *@list --> Baggy:D)', 'multi method categorize-list(@mapper, *@list --> Baggy:D)'], 'returns' => ['Baggy:D', 'Baggy:D', 'Baggy:D'] },
        { 'name' => 'keys', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of all keys in the C<Baggy> object without taking their individual weights into account as opposed to L<kxxv|#method kxxv>.', 'sigs' => ['method keys(Baggy:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'values', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of all values, i.e. weights, in the C<Baggy> object.', 'sigs' => ['method values(Baggy:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'kv', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of keys and values interleaved.', 'sigs' => ['method kv(Baggy:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'kxxv', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of the keys of the invocant, with each key multiplied by its weight. Note that C<kxxv> only works for C<Baggy> types which have integer weights, i.e. L<C<Bag>|/type/Bag> and L<C<BagHash>|/type/BagHash>.', 'sigs' => ['method kxxv(Baggy:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'elems', 'kind' => 'method', 'summary' => 'Returns the number of elements in the C<Baggy> object without taking the individual elements\' weight into account.', 'sigs' => ['method elems(Baggy:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'total', 'kind' => 'method', 'summary' => 'Returns the sum of weights for all elements in the C<Baggy> object.', 'sigs' => ['method total(Baggy:D:)'], 'returns' => [] },
        { 'name' => 'default', 'kind' => 'method', 'summary' => 'Returns zero.', 'sigs' => ['method default(Baggy:D: --> 0)'], 'returns' => ['0'] },
        { 'name' => 'hash', 'kind' => 'method', 'summary' => 'Returns a L<C<Hash>|/type/Hash> where the elements of the invocant are the keys and their respective weights the values.', 'sigs' => ['method hash(Baggy:D: --> Hash:D)'], 'returns' => ['Hash:D'] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<True> if the invocant contains at least one element.', 'sigs' => ['method Bool(Baggy:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'Set', 'kind' => 'method', 'summary' => 'Returns a L<C<Set>|/type/Set> whose elements are the L<keys|#method keys> of the invocant.', 'sigs' => ['method Set(--> Set:D)'], 'returns' => ['Set:D'] },
        { 'name' => 'SetHash', 'kind' => 'method', 'summary' => 'Returns a L<C<SetHash>|/type/SetHash> whose elements are the L<keys|#method keys> of the invocant.', 'sigs' => ['method SetHash(--> SetHash:D)'], 'returns' => ['SetHash:D'] },
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'Used in smartmatching if the right-hand side is a C<Baggy>. If the right-hand side is the type object, i.e. C<Baggy>, the method returns C<True> if C<$other> L<does|/type/Mu#routine_does> C<Baggy> otherwise C<False> is returned. If the right-hand side is a C<Baggy> object, C<True> is returned only if C<$other> has the same elements, with the same weights, as the invocant. L<Sets, Bags, and Mixes|/language/setbagmix>', 'sigs' => ['method ACCEPTS($other --> Bool:D)'], 'returns' => ['Bool:D'] },
      ],
      'examples' => [
        { 'code' => 'role Baggy does QuantHash { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Mix.new-from-pairs: \'butter\' => 0.22, \'sugar\' => 0.1, \'sugar\' => 0.02;
# OUTPUT: «Mix(butter(0.22) sugar(0.12))␤»', 'expect' => 'Mix(butter(0.22) sugar(0.12))
', 'routine' => 'new-from-pairs', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $cars = (\'Ford\' => 2, \'Rover\' => 3).BagHash;
say $cars.grab;                                   # OUTPUT: «Ford␤»
say $cars.grab(2);                                # OUTPUT: «(Rover Rover)␤»
say $cars.grab(*);                                # OUTPUT: «(Rover Ford)␤»', 'expect' => 'Ford
(Rover Rover)
(Rover Ford)
', 'routine' => 'grab', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = (\'eggs\' => 2, \'bacon\' => 3).Bag;
say $breakfast.grab;
CATCH { default { put .^name, \': \', .Str } };
# OUTPUT: «X::Immutable: Cannot call \'grab\' on an immutable \'Bag\'␤»', 'expect' => 'X::Immutable: Cannot call \'grab\' on an immutable \'Bag\'
', 'routine' => 'grab', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $breakfast = (eggs => 2, bacon => 3).BagHash;
say $breakfast.grabpairs;                         # OUTPUT: «bacon => 3␤»
