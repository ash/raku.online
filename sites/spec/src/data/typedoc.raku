    token mynumber  { <[0..9]> }
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Identifier.isa(Grammar);                # OUTPUT: «True␤»
my $match = Identifier.parse(\'W4anD0eR96\');
say ~$match;                                # OUTPUT: «W4anD0eR96␤»', 'expect' => 'True
W4anD0eR96
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'grammar RepeatChar {
