    {
      'name' => 'RakuAST::Doc::Declarator',
      'file' => 'Declarator',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Contains the declarator docs of a RakuAST object',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'The C<new> method can be called to create a new C<RakuAST::Doc::Declarator> object.  It only takes named arguments. Note that the leading and trailing documentation may contain any left margin whitespace. The L<C<RakuAST>|/type/RakuAST> object for which this declarator contains the documentation. A L<C<Positional>|/type/Positional> with the lines of leading documentation strings. A L<C<Positional>|/type/Positional> with the lines of trailing documentation strings.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-WHEREFORE', 'kind' => 'method', 'summary' => 'Set the object for which the C<RakuAST::Doc::Declarator> object contains the documentation.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-leading', 'kind' => 'method', 'summary' => 'Set the leading documentation.  If no arguments are specified, reset to not having any leading documentation.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'add-leading', 'kind' => 'method', 'summary' => 'Add a line to the leading documentation.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-trailing', 'kind' => 'method', 'summary' => 'Set the trailing documentation.  If no arguments are specified, reset to not having any trailing documentation.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'add-trailing', 'kind' => 'method', 'summary' => 'Add a line to the trailing documentation.', 'sigs' => [], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class RakuAST::Doc::Declarator { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'use experimental :rakuast;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "attached to a $declarator.WHEREFORE.^name() object";', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $declarator>', 'preamble' => 'my $declarator' },
        { 'code' => '.say for $declarator.leading;', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $declarator>', 'preamble' => 'my $declarator' },
        { 'code' => '.say for $declarator.trailing;', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $declarator>', 'preamble' => 'my $declarator' },
        { 'code' => '# method .gist falls back to .raku
say $declarator;  # RakuAST::Doc::Declarator.new(...', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $declarator;use experimental :rakuast>', 'preamble' => 'my $declarator;use experimental :rakuast' },
        { 'code' => 'method new(
