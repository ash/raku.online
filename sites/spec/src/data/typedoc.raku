        { 'code' => 'say (1.2-3.8i).floor;           # OUTPUT: «1-4i␤»', 'expect' => '1-4i
', 'routine' => 'floor', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say (1.2-3.8i).ceiling;         # OUTPUT: «2-3i␤»', 'expect' => '2-3i
