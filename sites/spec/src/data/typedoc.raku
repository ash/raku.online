        { 'code' => 'say a;', 'expect' => '', 'routine' => 'what', 'opts' => ':skip-test<compile time error>', 'preamble' => '' },
      ],
    },
    {
      'name' => 'atomicint',
      'file' => 'atomicint',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Integer (native storage at the platform\'s atomic operation size)',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'atomic-assign', 'kind' => 'sub', 'summary' => 'Performs an atomic assignment to a native integer, which may be in a lexical, attribute, or native array element. If C<$value> cannot unbox to a 64-bit native integer due to being too large, an exception will be thrown. If the size of C<atomicint> is only 32 bits, then an out of range C<$value> will be silently truncated. The C<atomic-assign> routine ensures that any required barriers are performed such that the changed value will be "published" to', 'sigs' => ['multi atomic-assign(atomicint $ is rw, int $value)', 'multi atomic-assign(atomicint $ is rw, Int() $value)'], 'returns' => [] },
        { 'name' => 'atomic-fetch', 'kind' => 'sub', 'summary' => 'Performs an atomic read of a native integer, which may live in a lexical, attribute, or native array element. Using this routine instead of simply using the variable ensures that the latest update to the variable from other threads will be seen, both by doing any required hardware barriers and also preventing the compiler from lifting reads. For example: Is certain to terminate, while in: It would be legal for a compiler to observe that C<$i> is not updated in the', 'sigs' => ['multi atomic-fetch(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => 'atomic-fetch-inc', 'kind' => 'sub', 'summary' => 'Performs an atomic increment on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value as seen before incrementing it. Overflow will wrap around silently.', 'sigs' => ['multi atomic-fetch-inc(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => 'atomic-fetch-dec', 'kind' => 'sub', 'summary' => 'Performs an atomic decrement on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value as seen before decrementing it. Overflow will wrap around silently.', 'sigs' => ['multi atomic-fetch-dec(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => 'atomic-fetch-add', 'kind' => 'sub', 'summary' => 'Performs an atomic addition on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value as seen before the addition was performed. Overflow will wrap around silently. If C<$value> is too big to unbox to a 64-bit integer, an exception will be thrown. If C<$value> otherwise overflows C<atomicint> then it will be silently truncated before the addition', 'sigs' => ['multi atomic-fetch-add(atomicint $ is rw, int $value)', 'multi atomic-fetch-add(atomicint $ is rw, Int() $value)'], 'returns' => [] },
        { 'name' => 'atomic-fetch-sub', 'kind' => 'sub', 'summary' => 'Performs an atomic subtraction on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value as seen before the subtraction was performed. Underflow will wrap around silently. If C<$value> is too big to unbox to a 64-bit integer, an exception will be thrown. If C<$value> otherwise overflows C<atomicint> then it will be silently truncated before the', 'sigs' => ['multi atomic-fetch-sub(atomicint $ is rw, int $value)', 'multi atomic-fetch-sub(atomicint $ is rw, Int() $value)'], 'returns' => [] },
        { 'name' => 'atomic-inc-fetch', 'kind' => 'sub', 'summary' => 'Performs an atomic increment on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value resulting from the increment. Overflow will wrap around silently.', 'sigs' => ['multi atomic-inc-fetch(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => 'atomic-dec-fetch', 'kind' => 'sub', 'summary' => 'Performs an atomic decrement on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value resulting from the decrement. Overflow will wrap around silently.', 'sigs' => ['multi atomic-dec-fetch(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => 'cas', 'kind' => 'sub', 'summary' => 'Performs an atomic compare and swap of the native integer value in location C<$target>. The first two forms have semantics like: Except it is performed as a single hardware-supported atomic instruction, as if all memory access to C<$target> were blocked while it took place. Therefore it is safe to attempt the operation from multiple threads without any other synchronization. For example: Will reliably only ever print C<Master!> one time, as only one of the threads', 'sigs' => ['multi cas(atomicint $target is rw, int $expected, int $value)', 'multi cas(atomicint $target is rw, Int() $expected, Int() $value)', 'multi cas(atomicint $target is rw, &operation)'], 'returns' => [] },
        { 'name' => '⚛=', 'kind' => 'infix', 'summary' => 'Performs an atomic assignment to a native integer, which may be in a lexical, attribute, or native array element. If C<$value> cannot unbox to a 64-bit native integer due to being too large, an exception will be thrown. If the size of C<atomicint> is only 32 bits, then an out of range C<$value> will be silently truncated. The C<⚛=> operator ensures that any required barriers are performed such that the changed value will be "published" to other threads.', 'sigs' => ['multi infix:<⚛=>(atomicint $ is rw, int $value)', 'multi infix:<⚛=>(atomicint $ is rw, Int() $value)'], 'returns' => [] },
        { 'name' => '⚛', 'kind' => 'prefix', 'summary' => 'Performs an atomic read of a native integer, which may live in a lexical, attribute, or native array element. Using this operator instead of simply using the variable ensures that the latest update to the variable from other threads will be seen, both by doing any required hardware barriers and also preventing the compiler from lifting reads. For example: Is certain to terminate, while in: It would be legal for a compiler to observe that C<$i> is not updated in the', 'sigs' => ['multi prefix:<⚛>(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => '++⚛', 'kind' => 'prefix', 'summary' => 'Performs an atomic increment on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value resulting from the increment. Overflow will wrap around silently.', 'sigs' => ['multi prefix:<++⚛>(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => '⚛++', 'kind' => 'postfix', 'summary' => 'Performs an atomic increment on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value as seen before incrementing it. Overflow will wrap around silently.', 'sigs' => ['multi postfix:<⚛++>(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => '--⚛', 'kind' => 'prefix', 'summary' => 'Performs an atomic decrement on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value resulting from the decrement. Overflow will wrap around silently.', 'sigs' => ['multi prefix:<--⚛>(atomicint $ is rw)'], 'returns' => [] },
        { 'name' => '⚛--', 'kind' => 'postfix', 'summary' => 'Performs an atomic decrement on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Returns the value as seen before decrementing it. Overflow will wrap around silently.', 'sigs' => ['multi postfix:<⚛-->(atomicint $ is rw)'], 'returns' => ['(atomicint $ is rw'] },
        { 'name' => '⚛+=', 'kind' => 'infix', 'summary' => 'Performs an atomic addition on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Evaluates to the result of the addition. Overflow will wrap around silently. If C<$value> is too big to unbox to a 64-bit integer, an exception will be thrown. If C<$value> otherwise overflows C<atomicint> then it will be silently truncated before the addition is', 'sigs' => ['multi infix:<⚛+=>(atomicint $ is rw, int $value)', 'multi infix:<⚛+=>(atomicint $ is rw, Int() $value)'], 'returns' => [] },
        { 'name' => '⚛-=', 'kind' => 'infix', 'summary' => 'Performs an atomic subtraction on a native integer. This will be performed using hardware-provided atomic operations. Since the operation is atomic, it is safe to use without acquiring a lock. Evaluates to the result of the subtraction.  Underflow will wrap around silently. If C<$value> is too big to unbox to a 64-bit integer, an exception will be thrown. If C<$value> otherwise overflows C<atomicint> then it will be silently truncated before the', 'sigs' => ['multi infix:<⚛-=>(atomicint $ is rw, int $value)', 'multi infix:<⚛-=>(atomicint $ is rw, Int() $value)'], 'returns' => [] },
        { 'name' => '⚛−=', 'kind' => 'infix', 'summary' => 'Synonym for ⚛-= using U+2212 minus.', 'sigs' => [], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class atomicint is Int is repr(\'P6int\') { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# Would typically only work on a 64-bit machine and VM build.
my int64 $active = 0;
$active⚛++;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# Would typically only work on a 32-bit machine and VM build.
my int32 $active = 0;
$active⚛++;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# Will work portably, though can only portably assume range of 32 bits.
my atomicint $active = 0;
$active⚛++;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# Correct (will always output 80000)
my atomicint $total = 0;
await start { for ^20000 { $total⚛++ } } xx 4;
say $total;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# *** WRONG *** due to lack of use of the atomicint type.
# Either works correctly or dies, depending on platform.
my int $total = 0;
await start { for ^20000 { $total⚛++ } } xx 4;
say $total;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '# *** WRONG *** due to lack of use of the atomic increment operator.
my atomicint $total = 0;
await start { for ^20000 { $total++ } } xx 4;
say $total;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my atomicint $i = 0;
start { atomic-assign($i, 1) }
while atomic-fetch($i) == 0 { }', 'expect' => '', 'routine' => 'atomic-fetch', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my atomicint $i = 0;
start { atomic-assign($i, 1) }
while $i == 0 { }', 'expect' => '', 'routine' => 'atomic-fetch', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my int $seen = $target;
if $seen == $expected {
$target = $value;
}
return $seen;', 'expect' => '', 'routine' => 'cas', 'opts' => ':preamble<no strict;>', 'preamble' => 'no strict;' },
        { 'code' => 'my atomicint $master = 0;
await start {
    if cas($master, 0, 1) == 0 {
        say "Master!"
    }
} xx 4', 'expect' => '', 'routine' => 'cas', 'opts' => '', 'preamble' => '' },
        { 'code' => 'cas $i, -> int $current { $current * 2 }', 'expect' => '', 'routine' => 'cas', 'opts' => ':preamble<no strict;>', 'preamble' => 'no strict;' },
        { 'code' => 'my atomicint $i = 0;
start { $i ⚛= 1 }
while ⚛$i == 0 { }', 'expect' => '', 'routine' => '⚛', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my atomicint $i = 0;
start { $i ⚛= 1 }
while $i == 0 { }', 'expect' => '', 'routine' => '⚛', 'opts' => '', 'preamble' => '' },
      ],
    },
    {
      'name' => 'routines',
      'file' => 'independent-routines',
      'subkind' => 'Language',
      'category' => 'fundamental',
      'subtitle' => 'Routines not defined within any class or role.',
      'declkind' => 'Independent',
      'routines' => [
        { 'name' => 'EVAL', 'kind' => 'routine', 'summary' => 'This routine executes at runtime a fragment of code, C<$code>, of a given language, C<$lang>, which defaults to C<Raku>. It coerces L<C<Cool>|/type/Cool> C<$code> to L<C<Str>|/type/Str>. If C<$code> is a L<C<Blob>|/type/Blob>, it\'ll be processed using the same encoding as the C<$lang> compiler would: for C<Raku> C<$lang>, uses C<utf-8>; for C<Perl5>, processes using the same rules as Perl. This works as-is with a literal string parameter. More complex input,', 'sigs' => ['sub infix:<mean>(*@a) is assoc<list> {'], 'returns' => [] },
        { 'name' => 'EVALFILE', 'kind' => 'sub', 'summary' => 'Slurps the specified file and evaluates it. Behaves the same way as C<EVAL> with regard to L<C<Blob>|/type/Blob> decoding, scoping, the C<$lang> parameter and the C<$check> parameter. Evaluates to the value produced by the final statement in the file when C<$check> is not C<True>.', 'sigs' => ['sub EVALFILE($filename where Blob|Cool, :$lang = \'Raku\', :$check)'], 'returns' => [] },
        { 'name' => 'repl', 'kind' => 'sub', 'summary' => 'I<Note>: C<repl> was introduced in release 2021.06 of the Rakudo compiler. Pauses execution and enters a L<REPL|/language/REPL> (read-eval-print loop) in the current context.  This REPL is exactly like the one created when you run C<raku> L<without any arguments|/programs/04-running-raku#DESCRIPTION> except that you can access/modify the program\'s current context (such as lexical variables). For example, if you run this code:', 'sigs' => ['sub repl()'], 'returns' => [] },
        { 'name' => 'get', 'kind' => 'sub', 'summary' => 'This routine is a wrapper for the L<method of the same name in C<IO::Handle>|/type/IO::Handle#routine_get>. If no C<Handle> is specified, defaults to L<C<$*ARGFILES>|/language/variables#$*ARGFILES>.', 'sigs' => ['multi get  (IO::Handle:D $fh = $*ARGFILES) { $fh.get  }'], 'returns' => [] },
        { 'name' => 'getc', 'kind' => 'sub', 'summary' => 'This routine is a wrapper for the L<method of the same name in C<IO::Handle>|/type/IO::Handle#routine_getc>>. If no C<Handle> is specified, defaults to L<C<$*ARGFILES>|/language/variables#$*ARGFILES>.', 'sigs' => ['multi getc  (IO::Handle:D $fh = $*ARGFILES) { $fh.getc  }'], 'returns' => [] },
        { 'name' => 'mkdir', 'kind' => 'sub', 'summary' => 'Creates a new directory; see L«C<mode>|/routine/mode» for explanation and valid values for C<$mode>. Returns the L<C<IO::Path>|/type/IO::Path> object pointing to the newly created directory on success; L<fails|/routine/fail> with L<C<X::IO::Mkdir>|/type/X::IO::Mkdir> if directory cannot be created. Also creates parent directories, as needed (similar to *nix utility C<mkdir> with C<-p> option); that is, C<mkdir "foo/bar/ber/meow"> will', 'sigs' => ['sub    mkdir(IO() $path, Int() $mode = 0o777 --> IO::Path:D)'], 'returns' => ['IO::Path:D'] },
        { 'name' => 'chdir', 'kind' => 'sub', 'summary' => 'Changes value of C<$*CWD> variable to the provided C<$path>, optionally ensuring the new path passes several file tests. B<NOTE:> that this routine does I<NOT> alter the process\'s current directory (see L«C<&*chdir>|/routine/&*chdir»). Returns L«C<IO::Path>|/type/IO::Path» representing new C<$*CWD> on success. On failure, returns L«C<Failure>|/type/Failure» and leaves C<$*CWD> untouched. The C<$path> can be any object with an IO method that returns an', 'sigs' => ['sub chdir(IO() $path, :$d = True, :$r, :$w, :$x --> IO::Path:D)'], 'returns' => ['IO::Path:D'] },
        { 'name' => '&*chdir', 'kind' => 'sub', 'summary' => 'Changes value of C<$*CWD> variable to the provided C<$path> and sets the process\'s current directory to the value of L«C<$path.absolute>|/routine/absolute». B<NOTE:> that in most cases, you want to use L«C<chdir>|/routine/chdir» routine instead. Returns an L«C<IO::Path>|/type/IO::Path» representing the new C<$*CWD> on success. On failure, returns L«C<Failure>|/type/Failure» and leaves C<$*CWD> untouched.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'chmod', 'kind' => 'sub', 'summary' => 'Coerces all C<@filenames> to L«C<IO::Path>|/type/IO::Path» and calls L«C<IO::Path.chmod>|/type/IO::Path#method_chmod» with C<$mode> on them. Returns a L«C<List>|/type/List» containing a subset of C<@filenames> for which C<chmod> was successfully executed.', 'sigs' => ['sub chmod(Int() $mode, *@filenames --> List)'], 'returns' => ['List'] },
        { 'name' => 'indir', 'kind' => 'sub', 'summary' => 'Takes L«C<Callable>|/type/Callable» C<&code> and executes it after locally (to C<&code>) changing C<$*CWD> variable to an L<C<IO::Path>|/type/IO::Path> object based on C<$path>, optionally ensuring the new path passes several file tests. If C<$path> is relative, it will be turned into an absolute path, even if an L<C<IO::Path>|/type/IO::Path> object was given. B<NOTE:> that this routine does I<NOT> alter the process\'s', 'sigs' => ['sub indir(IO() $path, &code, :$d = True, :$r, :$w, :$x)'], 'returns' => [] },
        { 'name' => 'print', 'kind' => 'sub', 'summary' => 'Prints the given text on standard output (the L«C<$*OUT>|/language/variables#index-entry-%24%2AOUT» filehandle), coercing non-L<C<Str>|/type/Str> objects to L<C<Str>|/type/Str> by calling L«C<.Str> method|/routine/Str». L<C<Junction>|/type/Junction> arguments L<autothread|/language/glossary#Autothreading> and the order of printed strings is not guaranteed. To print text and include the trailing newline, use', 'sigs' => ['multi print(**@args --> True)', 'multi print(Junction:D --> True)'], 'returns' => ['True', 'True'] },
        { 'name' => 'put', 'kind' => 'sub', 'summary' => 'Same as L«C<print>|/type/independent-routines#sub_print», except it uses L«C<print-nl>|/routine/print-nl» (which prints a L<newline|/language/newline>, by default) at the end. L<C<Junction>|/type/Junction> arguments L<autothread|/language/glossary#Autothreading> and the order of printed strings is not guaranteed. By itself, C<put()> will print a new line but please note that we have used parentheses after C<put>. Without these', 'sigs' => ['multi put()', 'multi put(**@args --> True)', 'multi put(Junction:D --> True)', 'multi put(Str:D \\x)', 'multi put(\\x)'], 'returns' => ['True', 'True'] },
        { 'name' => 'say', 'kind' => 'sub', 'summary' => 'Prints the "gist" of given objects; it will always invoke C<.gist> in the case the object is a subclass of L<C<Str>|/type/Str>. Same as L«C<put>|/type/independent-routines#sub_put», except it uses L«C<.gist>|/routine/gist» method to obtain string representation of the object; as in the case of C<put>, it will also autothread for L<C<Junction>|/type/Junction>s. B<NOTE:> the L«C<.gist>|/routine/gist» method of some objects, such as', 'sigs' => ['multi say(**@args --> True)'], 'returns' => ['True'] },
        { 'name' => 'note', 'kind' => 'routine', 'summary' => 'Like L«C<say>|/routine/say» (in the sense it will invoke the C<.gist> method of the printed object), except it prints output to L«C<$*ERR>|/language/variables#index-entry-%24%2AERR» handle (C<STDERR>). If no arguments are given to subroutine forms, will use string C<"Noted">. This command will also autothread on L<C<Junction>|/type/Junction>s, and is guaranteed to call C<gist> on the object if it\'s a subclass of L<C<Str>|/type/Str>.', 'sigs' => ['method note(Mu: -->Bool:D)', 'multi  note(            --> Bool:D)', 'multi  note(Str:D $note --> Bool:D)', 'multi  note(**@args     --> Bool:D)'], 'returns' => ['Bool:D', 'Bool:D', 'Bool:D', 'Bool:D'] },
        { 'name' => 'prompt', 'kind' => 'sub', 'summary' => 'L<Prints|/routine/print> C<$msg> to C<$*OUT> handle if C<$msg> was provided, then L<gets|/routine/get> a line of input from C<$*IN> handle. By default, this is equivalent to printing C<$msg> to L<STDOUT|https://en.wikipedia.org/wiki/Standard_streams#Standard_output_.28stdout.29>, reading a line from L<STDIN|https://en.wikipedia.org/wiki/Standard_streams#Standard_input_.28stdin.29>, removing the trailing new line, and returning the resultant string. As of Rakudo', 'sigs' => ['multi prompt()', 'multi prompt($msg)'], 'returns' => [] },
        { 'name' => 'open', 'kind' => 'sub', 'summary' => 'Creates L<a handle|/type/IO::Handle> with the given C<$path>, and calls L«C<IO::Handle.open>|/type/IO::Handle#method_open», passing any of the remaining arguments to it. Note that L<C<IO::Path>|/type/IO::Path> type provides numerous methods for reading and writing from files, so in many common cases you do not need to C<open> files or deal with L<C<IO::Handle>|/type/IO::Handle> type directly.', 'sigs' => ['multi open(IO() $path, |args --> IO::Handle:D)'], 'returns' => ['IO::Handle:D'] },
        { 'name' => 'slurp', 'kind' => 'sub', 'summary' => 'Slurps the contents of the entire file into a L<C<Str>|/type/Str> (or L<C<Buf>|/type/Buf> if C<:bin>). Accepts C<:bin> and C<:enc> optional named parameters, with the same meaning as L<open()|/routine/open>; possible encodings are the same as in all the other L<C<IO>|/type/IO> methods and are listed in L<C<encoding>|/type/IO::Handle#method_encoding> routine.  The routine will C<fail> if the file does not exist, or is a directory. Without any', 'sigs' => ['multi slurp(IO::Handle:D $fh = $*ARGFILES, |c)', 'multi slurp(IO() $path, |c)'], 'returns' => [] },
        { 'name' => 'spurt', 'kind' => 'sub', 'summary' => 'The C<$path> can be any object with an IO method that returns an L«C<IO::Path>|/type/IO::Path» object. Calls L«C<IO::Path.spurt>|/routine/spurt» on the C<$path>, forwarding any of the remaining arguments. The encoding with which the contents will be written. Boolean indicating whether to append to a (potentially) existing file.  If the file did not exist yet, it will be created.  Defaults to C<False>.', 'sigs' => ['multi spurt(IO() $path, |c)'], 'returns' => [] },
        { 'name' => 'run', 'kind' => 'sub', 'summary' => 'Runs an external command I<without involving a shell> and returns a L<C<Proc>|/type/Proc> object. By default, the external command will print to standard output and error, and read from standard input. If you want to pass some variables you can still use C«< >», but try to avoid using C<« »> as it will do word splitting if you forget to quote variables: Note that C<--> is required for many programs to disambiguate between', 'sigs' => ['sub run('], 'returns' => [] },
        { 'name' => 'shell', 'kind' => 'sub', 'summary' => 'Runs a command through the system shell, which defaults to C<%*ENV<ComSpec> /c> in Windows, C</bin/sh -c> otherwise. All shell metacharacters are interpreted by the shell, including pipes, redirects, environment variable substitutions and so on. Shell escapes are a severe security concern and can cause confusion with unusual file names. Use L<run|#sub_run> if you want to be safe. The return value is of L<type Proc|/type/Proc>.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'unpolar', 'kind' => 'routine', 'summary' => 'Returns a L<C<Complex>|/type/Complex> with the coordinates corresponding to the angle in radians and magnitude corresponding to the object value or C<$mag> in the case it\'s being used as a C<sub>', 'sigs' => ['method unpolar(Real $angle)', 'multi  unpolar(Real $mag, Real $angle)'], 'returns' => [] },
        { 'name' => 'printf', 'kind' => 'routine', 'summary' => 'Produces output according to a format.  The format used is the invocant (if called in method form) or the first argument (if called as a routine). The rest of the arguments will be substituted in the format following the format conventions.  See L<sprintf|/routine/sprintf> for details on acceptable format directives. On L<C<Junction>|/type/Junction>s, it will also autothread, without a guaranteed order.', 'sigs' => ['multi printf(Cool:D $format, *@args)'], 'returns' => [] },
        { 'name' => 'sprintf', 'kind' => 'routine', 'summary' => 'Returns a string according to a format as described below.  The format used is the invocant (if called in method form) or the first argument (if called as a routine). This function is mostly identical to the C library\'s C<sprintf> and C<printf> functions.  The only difference between the two functions is that C<sprintf> returns a string while the C<printf> function writes to a filehandle. C<sprintf>', 'sigs' => ['multi sprintf(Cool:D $format, *@args)'], 'returns' => [] },
        { 'name' => 'flat', 'kind' => 'sub', 'summary' => 'Constructs a list which contains any arguments provided, and returns the result of calling the C<.flat> method (L<inherited from C<Any>|/type/Any#method_flat>) on that list or L<C<Iterable>|/type/Iterable>:', 'sigs' => ['multi flat(**@list)', 'multi flat(Iterable \\a)'], 'returns' => [] },
        { 'name' => 'unique', 'kind' => 'routine', 'summary' => 'Returns a sequence of B<unique> values from the invocant/argument list, such that only the first occurrence of each duplicated value remains in the result list. C<unique> uses the semantics of the L<===|/routine/===> operator to decide whether two objects are the same, unless the optional C<:with> parameter is specified with another comparator. The order of the original list is preserved even as duplicates are removed.', 'sigs' => ['multi unique(+values, |c)'], 'returns' => [] },
        { 'name' => 'repeated', 'kind' => 'routine', 'summary' => 'This returns a sequence of B<repeated> values from the invocant/argument list. It takes the same parameters as L<unique|/routine/unique>, but instead of passing through any elements when they\'re first seen, they\'re only passed through as soon as they\'re seen for the second time (or more). Examples: As in the case of L<C<unique>|/type/Any#method_unique> the associative argument C<:as> takes a Callable that normalizes the element before comparison, and', 'sigs' => ['multi repeated(+values, |c)'], 'returns' => [] },
        { 'name' => 'squish', 'kind' => 'routine', 'summary' => 'Returns a sequence of values from the invocant/argument list where runs of one or more values are replaced with only the first instance. Like L<C<unique>|/routine/unique>, C<squish> uses the semantics of the L<===|/routine/===> operator to decide whether two objects are the same. Unlike L<C<unique>|/routine/unique>, this function only removes adjacent duplicates; identical values further apart are still kept. The order of the', 'sigs' => ['sub squish( +values, |c)'], 'returns' => [] },
        { 'name' => 'sleep', 'kind' => 'sub', 'summary' => 'Attempt to sleep for the given number of C<$seconds>.  Returns L<C<Nil>|/type/Nil> on completion.  Accepts L<C<Int>|/type/Int>, L<C<Num>|/type/Num>, L<C<Rat>|/type/Rat>, or L<C<Duration>|/type/Duration> types as an argument since all of these also do L<C<Real>|/type/Real>. It is thus possible to sleep for a non-integer amount of time.  For instance, the following code shows that C<sleep (5/2)> sleeps for 2.5', 'sigs' => ['sub sleep($seconds = Inf --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'sleep-timer', 'kind' => 'sub', 'summary' => 'This function is implemented like C<sleep>, but unlike the former it does return a L<C<Duration>|/type/Duration> instance with the number of seconds the system did not sleep. In particular, the returned L<C<Duration>|/type/Duration> will handle the number of seconds remaining when the process has been awakened by some external event (e.g., Virtual Machine or Operating System events). Under normal condition, when sleep is not interrupted, the returned L<C<Duration>|/type/Duration>', 'sigs' => ['sub sleep-timer(Real() $seconds = Inf --> Duration:D)'], 'returns' => ['Duration:D'] },
        { 'name' => 'sleep-until', 'kind' => 'sub', 'summary' => 'Works similar to C<sleep> but checks the current time and keeps sleeping until the required instant in the future has been reached. It uses internally the C<sleep-timer> method in a loop to ensure that, if accidentally woken up early, it will wait again for the specified amount of time remaining to reach the specified instant. goes back to sleep Returns C<True> if the L<C<Instant>|/type/Instant> in the future has been achieved (either', 'sigs' => ['sub sleep-until(Instant $until --> Bool)'], 'returns' => ['Bool'] },
        { 'name' => 'emit', 'kind' => 'sub', 'summary' => 'If used outside any supply or react block, throws an exception C<emit without supply or react>. Within a L<C<Supply>|/type/Supply> block, it will add a message to the stream. C<emit> is implemented as a L<control exception|/language/phasers#CONTROL> and can therefore be used by something called from the C<supply> block that it refers to. See also L<the page for C<emit> methods|/routine/emit>.', 'sigs' => ['sub emit(\\value --> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'undefine', 'kind' => 'sub', 'summary' => 'B<DEPRECATED> in 6.d language version and will be removed in 6.e. For L<C<Array>|/type/Array> and L<C<Hash>|/type/Hash>, it will become equivalent to assigning L<C<Empty>|/type/Slip#constant_Empty>; for everything else, equivalent to assigning L<C<Nil>|/type/Nil> or C<Empty> in the case of arrays or hashes, whose use is advised. Routines that manipulate arrays and other mutable collections.', 'sigs' => ['multi undefine(Mu    \\x)', 'multi undefine(Array \\x)', 'multi undefine(Hash  \\x)'], 'returns' => [] },
        { 'name' => 'pop', 'kind' => 'sub', 'summary' => 'Calls method C<pop> on the L<C<Positional>|/type/Positional> argument. That method is supposed to remove and return the last element, or return a L<C<Failure>|/type/Failure> wrapping an L<C<X::Cannot::Empty>|/type/X::Cannot::Empty> if the collection is empty. See the documentation of the L<C<Array> method|/routine/pop#(Array)_method_pop> for an example.', 'sigs' => ['multi pop(@a) is raw'], 'returns' => [] },
        { 'name' => 'shift', 'kind' => 'sub', 'summary' => 'Calls method C<shift> on the L<C<Positional>|/type/Positional> argument. That method, on a mutable collection that actually implements it (such as an L<C<Array>|/routine/shift#(Array)_method_shift> or a L<C<Buf>|/type/Buf#method_shift>), is supposed to remove and return the first element, or return a L<C<Failure>|/type/Failure> if the collection is empty. Example:', 'sigs' => ['multi shift(@a) is raw'], 'returns' => [] },
        { 'name' => 'push', 'kind' => 'sub', 'summary' => 'Calls method C<push> on the first argument, passing the remaining arguments. Method C<push> is supposed to add the provided values to the end of the collection or parts thereof. See the documentation of the L<C<Hash> method|/routine/push#(Hash)_method_push> for an example where indirection via this subroutine can be helpful. The C<push> method is supposed to flatten all arguments of type L<C<Slip>|/type/Slip>.', 'sigs' => ['multi push(\\a, **@b is raw)', 'multi push(\\a, \\b)'], 'returns' => [] },
        { 'name' => 'append', 'kind' => 'sub', 'summary' => 'Calls method C<append> on the first argument, passing the remaining arguments. Method C<append> is supposed to add the provided values to the end of the collection or parts thereof. Unlike method C<push>, method C<append> should follow the L<single argument rule|/language/functions#Slurpy_conventions>. So if you want to implement a conforming method C<append> for a new collection type, it should behave as if its signature was just:', 'sigs' => ['multi append(\\a, **@b is raw)', 'multi append(\\a, \\b)'], 'returns' => [] },
        { 'name' => 'exit', 'kind' => 'sub', 'summary' => 'Exits the current process with return code C<$status> or zero if no value has been specified. The exit value (C<$status>), when different from zero, has to be opportunely evaluated from the process that catches it (e.g., a shell); it is the only way to return an exit code different from zero from a L<Main|/routine/MAIN>. C<exit> prevents the L<LEAVE|/language/phasers#LEAVE> phaser to be executed, but it will run the code in the', 'sigs' => ['multi exit()', 'multi exit(Int(Any) $status)'], 'returns' => [] },
        { 'name' => 'done', 'kind' => 'sub', 'summary' => 'If used outside any supply or react block, throws an exception C<done without supply or react>. Within a L<C<Supply>|/type/Supply> block, it will signal that the supply will not emit further values, and leaves the supply block. See also L<documentation on method C<done>|/routine/done>. C<done> is implemented as a L<control exception|/language/phasers#CONTROL> and can therefore be used by something called from the C<supply> or C<react> block', 'sigs' => ['sub done(--> Nil)'], 'returns' => ['Nil'] },
        { 'name' => 'lastcall', 'kind' => 'sub', 'summary' => 'Truncates the current dispatch chain, which means any calls to C<nextsame>, C<callsame>, C<nextwith>, and C<callwith> will not find any of the next candidates. Note that since C<samewith> restarts the dispatch from the start, it\'s not affected by the truncation of current chain with C<lastcall>. Consider example below. C<foo(6)> uses C<nextsame> when C<lastcall> hasn\'t been called, and so it reaches the L<C<Any>|/type/Any>', 'sigs' => ['sub lastcall(--> True)'], 'returns' => ['True'] },
      ],
      'examples' => [
        { 'code' => 'proto EVAL($code where Blob|Cool|Callable, Str() :$lang = \'Raku\',
            PseudoStash :$context, Str() :$filename, Bool() :$check, *%_)', 'expect' => '', 'routine' => 'EVAL', 'opts' => ':method', 'preamble' => '' },
        { 'code' => 'multi EVAL($code, Str :$lang where { ($lang // \'\') eq \'Perl5\' },
            PseudoStash :$context, Str() :$filename, :$check)', 'expect' => '', 'routine' => 'EVAL', 'opts' => ':method', 'preamble' => '' },
        { 'code' => 'use MONKEY-SEE-NO-EVAL; # Or...
use MONKEY;             # shortcut that turns on all MONKEY pragmas, or...
use Test;               # a module that activates MONKEY-SEE-NO-EVAL.', 'expect' => '', 'routine' => 'EVAL', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $init = 0;
my $diff = 10;
my Str $changer = \'$init += \' ~ $diff; # contains a Str object with value \'$init += 10\'
# any of the above allows:
EVAL $changer;
EVAL $changer;
say $init;                         # OUTPUT: «20␤»', 'expect' => '20
', 'routine' => 'EVAL', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $answer = 42;
EVAL \'say $answer;\';    # OUTPUT: «42␤»', 'expect' => '42
', 'routine' => 'EVAL', 'opts' => '', 'preamble' => '' },
        { 'code' => 'EVAL \'my $lives = 9\'; say $lives;   # error, $lives not declared', 'expect' => '', 'routine' => 'EVAL', 'opts' => ':skip-test<compile time error>', 'preamble' => '' },
        { 'code' => 'module M {
    EVAL \'our $answer = 42\'
}
say $M::answer;         # OUTPUT: «42␤»', 'expect' => '42
', 'routine' => 'EVAL', 'opts' => '', 'preamble' => '' },
        { 'code' => '    @a.sum / @a.elems
}
EVAL \'say 2 mean 6 mean 4\';     # OUTPUT: «4␤»', 'expect' => '4
', 'routine' => 'EVAL', 'opts' => '', 'preamble' => '' },
        { 'code' => 'sub infix:<mean>(*@a) is assoc<list> {
@a.sum / @a.elems
}
say EVAL \'say 1; 2 mean 6 mean 4\';         # OUTPUT: «1␤4␤»', 'expect' => '1
4
', 'routine' => 'EVAL', 'opts' => '', 'preamble' => '' },
        { 'code' => 'EVAL "use v5.20; say \'Hello from perl!\'", :lang<Perl5>;', 'expect' => '', 'routine' => 'EVAL', 'opts' => '', 'preamble' => '' },
        { 'code' => 'use MONKEY-SEE-NO-EVAL;
EVAL \'say $?FILE\';                              # OUTPUT: «/tmp/EVAL_0␤»
EVAL \'say $?FILE\', filename => \'/my-eval-code\'; # OUTPUT: «/my-eval-code␤»', 'expect' => '/tmp/EVAL_0
/my-eval-code
', 'routine' => 'EVAL', 'opts' => '', 'preamble' => '' },
        { 'code' => 'EVALFILE "foo.raku";', 'expect' => '', 'routine' => 'EVALFILE', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $name = "Alice";

say "Hello, $name";

repl();

say "Goodbye, $name"', 'expect' => '', 'routine' => 'repl', 'opts' => '', 'preamble' => '' },
        { 'code' => '=begin code :lang<shell>
Type \'exit\' to leave
[0] > $name
Alice
[1] > $name = "Bob"
Bob
[2] > exit
=end code', 'expect' => '', 'routine' => 'repl', 'opts' => '', 'preamble' => '' },
        { 'code' => 'chdir         \'/tmp\'; # change $*CWD to \'/tmp\' and check its .d is True
chdir :r, :w, \'/tmp\'; # … check its .r and .w are True
chdir \'/not-there\';   # returns Failure', 'expect' => '', 'routine' => 'chdir', 'opts' => '', 'preamble' => '' },
        { 'code' => '# WRONG! DO NOT DO THIS!
my $*CWD = chdir \'/tmp/\';', 'expect' => '', 'routine' => 'chdir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'PROCESS::<&chdir> = sub (IO() $path --> IO::Path:D) { }', 'expect' => '', 'routine' => '&*chdir', 'opts' => '', 'preamble' => '' },
        { 'code' => '&*chdir(\'/tmp\');  # change $*CWD and process\'s current directory to \'/tmp\'
&*chdir(\'/not-there\'); # returns Failure', 'expect' => '', 'routine' => '&*chdir', 'opts' => '', 'preamble' => '' },
        { 'code' => '# WRONG! DO NOT DO THIS!
my $*CWD = &*chdir(\'/tmp\');', 'expect' => '', 'routine' => '&*chdir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'temp $*CWD;
&*chdir(\'/tmp\');', 'expect' => '', 'routine' => '&*chdir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'chmod 0o755, <myfile1  myfile2>; # make two files executable by the owner', 'expect' => '', 'routine' => 'chmod', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say indir("/tmp", {
    gather { take ".".IO }
})».CWD; # OUTPUT: «(/home/camelia)␤»', 'expect' => '(/home/camelia)
', 'routine' => 'indir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say indir("/tmp", {
    eager gather { take ".".IO }
})».CWD; # OUTPUT: «(/tmp)␤»', 'expect' => '(/tmp)
', 'routine' => 'indir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say indir("/tmp", {
    my $cwd = $*CWD;
    gather { temp $*CWD = $cwd; take ".".IO }
})».CWD; # OUTPUT: «(/tmp)␤»', 'expect' => '(/tmp)
', 'routine' => 'indir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say $*CWD;                   # OUTPUT: «"/home/camelia".IO␤»
indir \'/tmp\', { say $*CWD }; # OUTPUT: «"/tmp".IO␤»
say $*CWD;                   # OUTPUT: «"/home/camelia".IO␤»', 'expect' => '"/home/camelia".IO
"/tmp".IO
"/home/camelia".IO
', 'routine' => 'indir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'indir \'/not-there\', {;};     # returns Failure; path does not exist', 'expect' => '', 'routine' => 'indir', 'opts' => '', 'preamble' => '' },
        { 'code' => 'print "Hi there!\\n";       # OUTPUT: «Hi there!␤»
print "Hi there!";         # OUTPUT: «Hi there!»
print [1, 2, 3];           # OUTPUT: «1 2 3»
print "Hello" | "Goodbye"; # OUTPUT: «HelloGoodbye»', 'expect' => 'Hi there!
Hi there!1 2 3HelloGoodbye', 'routine' => 'print', 'opts' => '', 'preamble' => '' },
        { 'code' => 'put "Hi there!\\n";   # OUTPUT: «Hi there!␤␤»
put "Hi there!";     # OUTPUT: «Hi there!␤»
put [1, 2, 3];       # OUTPUT: «1 2 3␤»
put "Hello" | "Goodbye"; # OUTPUT: «Hello␤Goodbye␤»', 'expect' => 'Hi there!

Hi there!
1 2 3
Hello
Goodbye
', 'routine' => 'put', 'opts' => '', 'preamble' => '' },
        { 'code' => 'put "Hey"; put(); put("Hey"); # OUTPUT: «Hey␤␤Hey␤»', 'expect' => 'Hey

Hey
', 'routine' => 'put', 'opts' => '', 'preamble' => '' },
        { 'code' => '.put for <1 2 3>;             # OUTPUT: «1␤2␤3␤»', 'expect' => '1
2
3
', 'routine' => 'put', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say Range;        # OUTPUT: «(Range)␤»
say class Foo {}; # OUTPUT: «(Foo)␤»
say \'I ♥ Raku\';   # OUTPUT: «I ♥ Raku␤»
say 1..Inf;       # OUTPUT: «1..Inf␤»', 'expect' => '(Range)
(Foo)
I ♥ Raku
1..Inf
', 'routine' => 'say', 'opts' => '', 'preamble' => '' },
        { 'code' => 'note;       # STDERR OUTPUT: «Noted␤»
note \'foo\'; # STDERR OUTPUT: «foo␤»
note 1..*;  # STDERR OUTPUT: «1..Inf␤»', 'expect' => '', 'routine' => 'note', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $name = prompt "What\'s your name? ";
say "Hi, $name! Nice to meet you!";
my $age = prompt("Say your age (number)");
my Int $years = $age;
my Str $age-badge = $age;', 'expect' => '', 'routine' => 'prompt', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $fh = open :w, \'/tmp/some-file.txt\';
$fh.say: \'I ♥ writing Raku code\';
$fh.close;

$fh = open \'/tmp/some-file.txt\';
print $fh.readchars: 4;
$fh.seek: 7, SeekFromCurrent;
say $fh.readchars: 4;
$fh.close;

# OUTPUT: «I ♥ Raku␤»', 'expect' => 'I ♥ Raku
', 'routine' => 'open', 'opts' => '', 'preamble' => '' },
        { 'code' => '# read entire file as (Unicode) Str
my $text_contents   = slurp "path/to/file";

# read entire file as Latin1 Str
my $text_contents   = slurp "path/to/file", enc => "latin1";

# read entire file as Buf
my $binary_contents = slurp "path/to/file", :bin;', 'expect' => '', 'routine' => 'slurp', 'opts' => '', 'preamble' => '' },
        { 'code' => '# write directly to a file
spurt \'path/to/file\', \'default text, directly written\';

