say $b; # OUTPUT: «Blob[int32]:0x<03 -3 FF32 -2C>␤»', 'expect' => 'Blob[int32]:0x<03 -3 FF32 -2C>
', 'routine' => '', 'opts' => '', 'preamble' => '' },
