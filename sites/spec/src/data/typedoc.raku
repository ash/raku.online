        { 'name' => 'config', 'kind' => 'method', 'summary' => 'Instance returning a hash with object configuration information. Subject to change without notice, but can be helpful in environments where only one type of virtual machine is in use, or to find about the configuration of any other object that mixes in this role.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'desc', 'kind' => 'method', 'summary' => 'Instance method returning the "desc" (as in "description") of the VM object. Returns a L<C<Str>|/type/Str> type object if the "desc" could not be established.', 'sigs' => [], 'returns' => [] },
