    {
      'name' => 'Setty',
      'file' => 'Setty',
      'subkind' => 'role',
      'category' => 'composite',
      'subtitle' => 'Collection of distinct objects',
      'declkind' => 'role',
      'consumers' => ['Set', 'SetHash'],
      'routines' => [
        { 'name' => 'new-from-pairs', 'kind' => 'method', 'summary' => 'Constructs a Setty object from a list of L«C<Pair> objects|/type/Pair» given as positional arguments: B<Note:> be sure you aren\'t accidentally passing the Pairs as positional arguments; the quotes around the keys in the above example are significant.', 'sigs' => ['method new-from-pairs(*@pairs --> Setty:D)'], 'returns' => ['Setty:D'] },
        { 'name' => 'grab', 'kind' => 'method', 'summary' => 'Removes and returns C<$count> elements chosen at random (without repetition) from the set. If C<*> is passed as C<$count>, or C<$count> is greater than or equal to the size of the set, then all its elements are removed and returned in random order. Only works on mutable sets; When used on an immutable set, it results in an exception.', 'sigs' => ['method grab($count = 1)'], 'returns' => [] },
        { 'name' => 'grabpairs', 'kind' => 'method', 'summary' => 'Removes C<$count> elements chosen at random (without repetition) from the set, and returns a list of L<C<Pair>|/type/Pair> objects whose keys are the grabbed elements and whose values are C<True>. If C<*> is passed as C<$count>, or C<$count> is greater than or equal to the size of the set, then all its elements are removed and returned as L<C<Pair>|/type/Pair>s in the aforementioned way in random order.', 'sigs' => ['method grabpairs($count = 1)'], 'returns' => [] },
        { 'name' => 'pick', 'kind' => 'method', 'summary' => 'Returns C<$count> elements chosen at random (without repetition) from the set. If C<*> is passed as C<$count>, or C<$count> is greater than or equal to the size of the set, then all its elements are returned in random order (shuffled).', 'sigs' => ['multi method pick($count = 1)'], 'returns' => [] },
        { 'name' => 'pickpairs', 'kind' => 'method', 'summary' => 'Returns a L<C<Pair>|/type/Pair> or a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s depending on the candidate of the method being invoked. Each L<C<Pair>|/type/Pair> returned has an element of the invocant as its key and C<True> as its value. In contrast to L<grabpairs|#method grabpairs>, the elements are \'picked\' without replacement. If C<*> is passed as C<$count>, or C<$count> is greater than or equal to the number', 'sigs' => ['multi method pickpairs(Setty:D: --> Pair:D)', 'multi method pickpairs(Setty:D: $count --> Seq:D)'], 'returns' => ['Pair:D', 'Seq:D'] },
        { 'name' => 'roll', 'kind' => 'method', 'summary' => 'Returns a lazy list of C<$count> elements, each randomly selected from the set. Each random choice is made independently, like a separate die roll where each die face is a set element. If C<*> is passed as C<$count>, the list is infinite.', 'sigs' => ['multi method roll($count = 1)'], 'returns' => [] },
        { 'name' => 'antipairs', 'kind' => 'method', 'summary' => 'Returns all elements in the set and C<True> as a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s, where the element itself is the value, i.e. the opposite of method C<pairs>.', 'sigs' => ['multi method antipairs(Setty:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'keys', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of all elements of the set.', 'sigs' => ['multi method keys(Setty:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'values', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> containing as many C<True> values as the set has elements.', 'sigs' => ['multi method values(Setty:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'kv', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of the set\'s elements and C<True> values interleaved.', 'sigs' => ['multi method kv(Setty:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'elems', 'kind' => 'method', 'summary' => 'The number of elements of the set.', 'sigs' => ['method elems(Setty:D: --> Int)'], 'returns' => ['Int'] },
        { 'name' => 'total', 'kind' => 'method', 'summary' => 'The total of all the values of the L<C<QuantHash>|/type/QuantHash> object. For a C<Setty> object, this is just the number of elements.', 'sigs' => ['method total(Setty:D: --> Int)'], 'returns' => ['Int'] },
        { 'name' => 'minpairs', 'kind' => 'method', 'summary' => 'Returns the value of L«C<self.pairs>|/routine/pairs» (as all Pairs have minimum values). See also L«C<Any.minpairs>|/routine/minpairs»', 'sigs' => ['multi method minpairs(Setty:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'maxpairs', 'kind' => 'method', 'summary' => 'Returns the value of L«C<self.pairs>|/routine/pairs» (as all Pairs have maximum values). See also L«C<Any.maxpairs>|/routine/maxpairs»', 'sigs' => ['multi method maxpairs(Setty:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'default', 'kind' => 'method', 'summary' => 'Returns the default value of the invocant, i.e. the value which is returned when trying to access an element in the C<Setty> object which has not been previously initialized or when accessing an element which has explicitly been set to L<C<Nil>|/type/Nil> or C<False>.', 'sigs' => ['method default(--> False)'], 'returns' => ['False'] },
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'Returns C<True> if C<$other> and C<self> contain all the same elements, and no others.', 'sigs' => ['method ACCEPTS($other)'], 'returns' => [] },
        { 'name' => 'Bag', 'kind' => 'method', 'summary' => 'Returns a L<C<Bag>|/type/Bag> containing the elements of the invocant. The quantity of the elements in this created bag will be set to one:', 'sigs' => ['method Bag(Setty:D: --> Bag:D)'], 'returns' => ['Bag:D'] },
        { 'name' => 'BagHash', 'kind' => 'method', 'summary' => 'Returns a L<C<BagHash>|/type/BagHash> containing the elements of the invocant.', 'sigs' => ['method BagHash(Setty:D: --> BagHash:D)'], 'returns' => ['BagHash:D'] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<True> if the invocant contains at least one element.', 'sigs' => ['multi method Bool(Setty:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'Mix', 'kind' => 'method', 'summary' => 'Returns a L<C<Mix>|/type/Mix> containing the elements of the invocant. The elements of the returned L<C<Mix>|/type/Mix> will have weights equal to 1:', 'sigs' => ['method Mix(Setty:D: --> Mix:D)'], 'returns' => ['Mix:D'] },
        { 'name' => 'MixHash', 'kind' => 'method', 'summary' => 'Returns a L<C<MixHash>|/type/MixHash> containing the elements of the invocant. L<Sets, Bags, and Mixes|/language/setbagmix>', 'sigs' => ['method MixHash(Setty:D: --> MixHash:D)'], 'returns' => ['MixHash:D'] },
      ],
      'examples' => [
