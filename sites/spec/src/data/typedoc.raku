        { 'code' => 'class Hero {
has @.inventory;
has Str $.name;
submethod BUILD( :$!name, :@!inventory ) {
    @!inventory = self.clean-inventory( @!inventory );
}
submethod clean-inventory( @inventory ) {
    @!inventory.unique.sort
}
}

