    {
      'name' => 'Parameter',
      'file' => 'Parameter',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Element of a Signature',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'name', 'kind' => 'method', 'summary' => 'Returns the parameter name, which includes all L<sigils|/language/variables#Sigils> and L<twigils|/language/variables#Twigils>. This name is used internally when applied to code, or in a declaration to determine the declared the name.  This name is not necessarily usable by a caller – if it is, it will also appear as an L<alias|#method named_names>.  Often, the name will be chosen descriptively as a form of self-documentation.', 'sigs' => ['method name(Parameter:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'usage-name', 'kind' => 'method', 'summary' => 'Returns the parameter name without any L<sigils|/language/variables#Sigils> and L<twigils|/language/variables#Twigils>. If the parameter is anonymous, an empty string will be returned. B<Note:> Before Rakudo release 2020.08 the return value for an anonymous parameter was L<C<Nil>|/type/Nil>.', 'sigs' => ['method usage-name(Parameter:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'sigil', 'kind' => 'method', 'summary' => 'Returns a string containing the parameter\'s sigil, for a looser definition of "sigil" than what is considered part of the parameter\'s L«C<name>|#method name».  Still returns a sigil even if the parameter is anonymous. This "sigil" is actually an introspection used to help determine the normal binding style of a parameter, if it has not been altered through a L<trait|/language/signatures#Parameter_traits_and_modifiers>.', 'sigs' => ['method sigil(Parameter:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'type', 'kind' => 'method', 'summary' => 'Returns the L<nominal type constraint|/language/signatures#Type_constraints> of the parameter.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'coerce_type', 'kind' => 'method', 'summary' => 'Returns the L<coercion type|/syntax/Coercion%20type> of the parameter.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'constraints', 'kind' => 'method', 'summary' => 'Returns L<additional constraints|/language/signatures#Type_constraints> on the parameter (usually as an C<all>-Junction).', 'sigs' => [], 'returns' => [] },
        { 'name' => 'named', 'kind' => 'method', 'summary' => 'Returns C<True> if it\'s a L<named parameter|/language/signatures#Positional_vs._named_arguments>.', 'sigs' => ['method named(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'named_names', 'kind' => 'method', 'summary' => 'Returns the list of externally usable names/aliases for a L<named parameter|/language/signatures#Positional_vs._named_arguments>.', 'sigs' => ['method named_names(Parameter:D: --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'positional', 'kind' => 'method', 'summary' => 'Returns C<True> if the parameter is L<positional|/language/signatures#Positional_vs._named_arguments>.', 'sigs' => ['method positional(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'slurpy', 'kind' => 'method', 'summary' => 'Returns C<True> for L<slurpy parameters|/language/signatures#Slurpy_parameters>.', 'sigs' => ['method slurpy(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'twigil', 'kind' => 'method', 'summary' => 'Returns a string containing the twigil part of the parameter\'s name.', 'sigs' => ['method twigil(Parameter:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'optional', 'kind' => 'method', 'summary' => 'Returns C<True> for L<optional parameters|/language/signatures#Optional_and_mandatory_arguments>.', 'sigs' => ['method optional(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'raw', 'kind' => 'method', 'summary' => 'Returns C<True> for raw parameters. Raw parameters bind either a variable or a value passed to it, with no decontainerization taking place.  That means that if a variable was passed to it, you can assign to the parameter. This is different from L<rw|#method_rw>-parameter which can only bind to variables, never to values. This is the normal behavior for parameters declared with a L<sigil|#method sigil> of \'C<\\>\', which is not really a sigil insofar', 'sigs' => ['method raw(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'capture', 'kind' => 'method', 'summary' => 'Returns C<True> for parameters that capture the rest of the argument list into a single L<C<Capture>|/type/Capture> object. Like raw parameters, L<C<Capture>|/type/Capture> parameters do not force any context on the values bound to them, which is why their sigils are only used in declarations.', 'sigs' => ['method capture(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'rw', 'kind' => 'method', 'summary' => 'Returns C<True> for L<C<is rw>|/language/signatures#Parameter_traits_and_modifiers> parameters.', 'sigs' => ['method rw(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'copy', 'kind' => 'method', 'summary' => 'Returns C<True> for L<C<is copy>|/language/signatures#Parameter_traits_and_modifiers> parameters.', 'sigs' => ['method copy(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'readonly', 'kind' => 'method', 'summary' => 'Returns C<True> for read-only parameters (the default).', 'sigs' => ['method readonly(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'invocant', 'kind' => 'method', 'summary' => 'Returns C<True> if the parameter is the L<invocant parameter|/language/signatures#Parameter_separators>.', 'sigs' => ['method invocant(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'multi-invocant', 'kind' => 'method', 'summary' => 'Returns C<True> if the parameter affects L<multi dispatch|/language/functions#Multi-dispatch>.', 'sigs' => ['method multi-invocant(Parameter:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'default', 'kind' => 'method', 'summary' => 'Returns a closure that upon invocation returns the L<default value|/language/signatures#Optional_and_mandatory_arguments> for this parameter, or L<C<Code>|/type/Code> if no default was provided. B<Note:> Before Rakudo release 2020.08 the return value for a parameter with no default value was L<C<Any>|/type/Any>.', 'sigs' => ['method default(Parameter:D: --> Code:_)'], 'returns' => ['Code:_'] },
        { 'name' => 'type_captures', 'kind' => 'method', 'summary' => 'Returns a list of variable names of L<type captures|/language/signatures#Type_captures> associated with this parameter.  Type captures define a type name within the attached code, which is an alias to the type gleaned from the argument during a call. The type used may change from call to call.  Once they are defined, type captures can be used wherever you would use a type, even later in the same signature:', 'sigs' => ['method type_captures(Parameter:D: --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'sub_signature', 'kind' => 'method', 'summary' => 'If the parameter has a L<sub-signature|/language/signatures#Sub-signatures>, returns a L<C<Signature>|/type/Signature> object for it.  Otherwise returns L<C<Signature>|/type/Signature>. B<Note:> Before Rakudo release 2020.08 the return value for a parameter with no sub-signature was L<C<Any>|/type/Any>.', 'sigs' => ['method sub_signature(Parameter:D: --> Signature:_)'], 'returns' => ['Signature:_'] },
        { 'name' => 'prefix', 'kind' => 'method', 'summary' => 'If the parameter is L«slurpy|/language/signatures#Slurpy_parameters», returns the marker (e.g., C«*», C«**», or C«+») the parameter was declared with. Otherwise, returns an empty string.', 'sigs' => ['method prefix(Parameter:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'suffix', 'kind' => 'method', 'summary' => 'Returns the C«?» or C«!» marker a parameter was declared with, if any. Otherwise, returns the empty string.', 'sigs' => ['method suffix(Parameter:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'modifier', 'kind' => 'method', 'summary' => 'Returns the L<type smiley|/language/glossary#Type_smiley> (C<:U>, C<:D>, or C<:_>) a parameter was declared with. It returns the empty string for the C<:_> type smiley. Parameter.new( ... ) In some situations, specifically when working with the L<MetaObject Protocol|/language/mop>, it makes sense to create C<Parameter> objects programmatically.  For this purpose, you can call the C<new> method with the following named parameters:', 'sigs' => ['method modifier(Parameter:D: --> Str:D)'], 'returns' => ['Str:D'] },
      ],
      'examples' => [
        { 'code' => 'class Parameter { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
