    {
      'name' => 'Map',
      'file' => 'Map',
      'subkind' => 'class',
      'category' => 'composite',
      'subtitle' => 'Immutable mapping from strings to values',
      'declkind' => 'class',
      'children' => ['PseudoStash', 'Hash'],
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Creates a new Map from a list of alternating keys and values, with L<the same semantics|/language/hashmap#Hash_assignment> as described in the L<Hashes and maps|/language/hashmap> documentation, but also accepts L<C<Pair>|/type/Pair>s instead of separate keys and values. Use the L<grouping operator|/language/operators#term_(_)> or quote the key to ensure that a literal pair is not interpreted as a named argument.', 'sigs' => ['method new(*@args)'], 'returns' => [] },
        { 'name' => 'elems', 'kind' => 'method', 'summary' => 'Returns the number of pairs stored in the Map.', 'sigs' => ['method elems(Map:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'Used in smartmatching if the right-hand side is a C<Map>. If the topic is list-like (L<C<Positional>|/type/Positional>), returns True if any of the list elements exist as a key in the Map. If the topic is of type L<C<Cool>|/type/Cool> (strings, integers etc.), returns True if the topic exists as a key. If the topic is a regex, returns True if any of the keys match the regex. As a fallback, the topic is coerced to a list, and the L<C<Positional>|/type/Positional>', 'sigs' => ['multi method ACCEPTS(Map:D: Positional $topic)', 'multi method ACCEPTS(Map:D: Cool:D     $topic)', 'multi method ACCEPTS(Map:D: Regex      $topic)', 'multi method ACCEPTS(Map:D: Any        $topic)'], 'returns' => [] },
        { 'name' => 'gist', 'kind' => 'method', 'summary' => 'Returns the string containing the "gist" of the C<Map>, sorts the pairs and lists B<up to the first 100>, appending an ellipsis if the C<Map> has more than 100 pairs.', 'sigs' => ['method gist(Map:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'keys', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of all keys in the Map.', 'sigs' => ['method keys(Map:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'values', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of all values in the Map.', 'sigs' => ['method values(Map:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'pairs', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of all pairs in the Map.', 'sigs' => ['method pairs(Map:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'antipairs', 'kind' => 'method', 'summary' => 'Returns all keys and their respective values as a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s where the keys and values have been exchanged, i.e. the opposite of method L<pairs|/type/Map#method_pairs>. Unlike the L<C<invert>|/type/Map#method_invert> method, there is no attempt to expand list values into multiple pairs.', 'sigs' => ['method antipairs(Map:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'invert', 'kind' => 'method', 'summary' => 'Returns all keys and their respective values as a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair>s where the keys and values have been exchanged. The difference between C<invert> and L<C<antipairs>|/type/Map#method_antipairs> is that C<invert> expands list values into multiple pairs.', 'sigs' => ['method invert(Map:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'kv', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of keys and values interleaved.', 'sigs' => ['method kv(Map:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Returns a L<C<List>|/type/List> of L<C<Pair>|/type/Pair> objects of all keys and values in the Map.', 'sigs' => ['multi method list(Map:D: --> List:D)'], 'returns' => ['List:D'] },
        { 'name' => 'sort', 'kind' => 'method', 'summary' => 'Returns a L<C<Seq>|/type/Seq> of L<C<Pair>|/type/Pair> objects, which are the pairs of the hash, sorted by key. Equivalent to C<%hash.sort: *.key> See L<Any.sort|/type/Any#method_sort> for additional available candidates.', 'sigs' => ['multi method sort(Map:D: --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'Int', 'kind' => 'method', 'summary' => 'Returns the number of pairs stored in the C<Map> (same as C<.elems>).', 'sigs' => ['method Int(Map:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'Numeric', 'kind' => 'method', 'summary' => 'Returns the number of pairs stored in the C<Map> (same as C<.elems>).', 'sigs' => ['method Numeric(Map:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<True> if the invocant contains at least one key/value pair.', 'sigs' => ['method Bool(Map:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'Capture', 'kind' => 'method', 'summary' => 'Returns a L<C<Capture>|/type/Capture> where each key, if any, has been converted to a named argument with the same value as it had in the original C<Map>. The returned L<C<Capture>|/type/Capture> will not contain any positional arguments.', 'sigs' => ['method Capture(Map:D:)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Map does Associative does Iterable { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %e := Map.new(\'a\', 1, \'b\', 2);
say %e.keys;    # can print «a b␤» or «b a␤»
