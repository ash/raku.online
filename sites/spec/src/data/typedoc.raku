$p.start;', 'expect' => '', 'routine' => 'bind-stderr', 'opts' => '', 'preamble' => '' },
        { 'code' => 'try await $p.start;', 'expect' => '', 'routine' => 'start', 'opts' => ':preamble<my $p>', 'preamble' => 'my $p' },
