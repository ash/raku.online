    {
      'name' => 'Match',
      'file' => 'Match',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'Result of a successful regex match',
      'declkind' => 'class',
      'children' => ['Grammar'],
      'routines' => [
        { 'name' => 'pos', 'kind' => 'method', 'summary' => 'Returns the current position as a string index into C<Match.target> for a regex match I<in progress>: You should not use this method on a finished C<Match>, as the output can be implementation specific or is, in any case, unspecified.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'target', 'kind' => 'method', 'summary' => 'Returns a string representation of the object against which the regex matches. This is the value that the regex engine works with internally.', 'sigs' => ['method target()'], 'returns' => [] },
        { 'name' => 'chars', 'kind' => 'method', 'summary' => 'Returns the numbers of characters in the matched string or 0 if there\'s been no match. Returns the same as C<.Str.chars>.', 'sigs' => ['method chars()'], 'returns' => [] },
        { 'name' => 'clone', 'kind' => 'method', 'summary' => 'Clones the C<Match> object.', 'sigs' => ['method clone()'], 'returns' => [] },
        { 'name' => 'orig', 'kind' => 'method', 'summary' => 'Returns the original input to the regex engine, which is usually a string, but doesn\'t need to be (could be anything that can be coerced to a string): See L<method target|#method target> for a close equivalent that always returns a string.', 'sigs' => ['method orig()'], 'returns' => [] },
        { 'name' => 'from', 'kind' => 'method', 'summary' => 'Returns the index of the starting position of the match.', 'sigs' => ['method from()'], 'returns' => [] },
        { 'name' => 'to', 'kind' => 'method', 'summary' => 'Returns the index of the position next to the end of the match. It will return the match position if the end of the match is negative, and L<C<Nil>|/type/Nil> if there has been no match.', 'sigs' => ['method to()'], 'returns' => [] },
        { 'name' => 'made', 'kind' => 'method', 'summary' => 'Returns the payload that was set with L<C<make>|/routine/make>.', 'sigs' => ['method made()'], 'returns' => [] },
        { 'name' => 'make', 'kind' => 'routine', 'summary' => 'Sets the C<.ast> attribute, which will be retrieved using C<.made>. That is, it stores an arbitrary payload into the C<Match> object that can later be retrieved via L«C<.made>|/routine/made» method. Since the sub form operates, by default, on C<$/>, that example is equivalent to: This is typically used in a L<grammar|/language/grammars>\'s actions class methods, where a piece of data is stored by one method and then later retrieved', 'sigs' => ['method make(Match:D: Mu $payload)', 'sub make(Mu $payload)'], 'returns' => [] },
        { 'name' => 'actions', 'kind' => 'method', 'summary' => 'Returns the actions object (if any was set; else L<C<Mu>|/type/Mu>) that the grammar used from which this Match object was created.', 'sigs' => ['method actions(Match:D: --> Mu)'], 'returns' => ['Mu'] },
        { 'name' => 'ast', 'kind' => 'method', 'summary' => 'Alias for L<method made|#method made>.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Returns C<True> on successful and C<False> on unsuccessful matches. Please note that any zero-width match can also be successful.', 'sigs' => ['method Bool(Capture:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Returns the matched text.', 'sigs' => ['method Str(Match:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'Int', 'kind' => 'method', 'summary' => 'Tries to convert stringified result of the matched text into Int.', 'sigs' => ['method Int(Match:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'caps', 'kind' => 'method', 'summary' => 'Returns a list of pairs, with the index or submatch name as key and the submatches as values. The list is ordered by starting position of the submatches.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'chunks', 'kind' => 'method', 'summary' => 'Returns a list of pairs, with the index or submatch name as key and the submatches as values. The list is ordered by starting position of the submatches. Those parts of the string that were not matched by submatches are interleaved with the other pairs, with the string C<~> as key.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Returns a list of positional submatches.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'hash', 'kind' => 'method', 'summary' => 'Returns a hash of named submatches.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'prematch', 'kind' => 'method', 'summary' => 'Returns the part of the original string leading up to the match.', 'sigs' => ['method prematch(Match:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'postmatch', 'kind' => 'method', 'summary' => 'Returns the part of the original string following the match.', 'sigs' => ['method postmatch(Match:D: --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'replace-with', 'kind' => 'method', 'summary' => 'Returns the invocant string where the C«Match» object is replaced by C«$replacement».', 'sigs' => ['multi method replace-with(Match:D: Str() $replacement --> Str:D)'], 'returns' => ['Str:D'] },
        { 'name' => 'eqv', 'kind' => 'infix', 'summary' => 'Returns C<True> if the attributes C<pos>, C<from> and C<orig> for C<a> and C<b> are equal, and if C<made>, C<Capture::list> and C<Capture::hash> are either the same or both undefined.', 'sigs' => ['multi infix:<eqv>(Match:D \\a, Match:D \\b)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Match is Capture is Cool does NQPMatchRole {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c;
\'abc\' ~~ /.$${ $c = $¢ }/;
say $c; # OUTPUT: «｢c｣␤»', 'expect' => '｢c｣
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $c; \'camelia\' ~~ /<[ l m ]> {$c = $¢}/;
say $c; # OUTPUT: «｢m｣␤»
say $/; # OUTPUT: «｢m｣␤»', 'expect' => '｢m｣
｢m｣
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '\'123\' ~~ / (\\d) { say $0; say $/; } \\d+ /; # OUTPUT: «｢1｣␤｢1｣␤ 0 => ｢1｣␤»', 'expect' => '｢1｣
｢1｣
 0 => ｢1｣
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '\'123\' ~~ / (\\d) { say $/; say $¢; } \\d+ /; # OUTPUT: «｢1｣␤ 0 => ｢1｣␤｢1｣␤ 0 => ｢1｣␤»
say "¢ → ", $¢, "/ is $/"; ; # OUTPUT: «¢ → Nil/ is 123␤»', 'expect' => '｢1｣
 0 => ｢1｣
｢1｣
 0 => ｢1｣
¢ → Nil/ is 123
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => '    my constant Cursor = Match', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $a = \'abcdef\';
$a ~~ /b. {say $/.pos }../;     # OUTPUT: «3␤»', 'expect' => '3
', 'routine' => 'pos', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $a = "þor" ~~ /o/;
say $a.target # OUTPUT: «þor␤»', 'expect' => 'þor
', 'routine' => 'target', 'opts' => '', 'preamble' => '' },
        { 'code' => '42 ~~ /.+/;
say $/.orig;            # OUTPUT: «42␤»
say $/.orig.^name;      # OUTPUT: «Int␤»', 'expect' => '42
Int
', 'routine' => 'orig', 'opts' => '', 'preamble' => '' },
        { 'code' => '$/.make("your payload here");', 'expect' => '', 'routine' => 'make', 'opts' => '', 'preamble' => '' },
        { 'code' => 'make("your payload here");', 'expect' => '', 'routine' => 'make', 'opts' => '', 'preamble' => '' },
        { 'code' => 'method my-action ($/) {
    make "foo: $/";
}', 'expect' => '', 'routine' => 'make', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say \'abc\' ~~ /^/;                   # OUTPUT: «｢｣␤»
say $/.from, \' \',  $/.to, \' \', ?$/; # OUTPUT: «0 0 True␤»', 'expect' => '｢｣
0 0 True
', 'routine' => 'Bool', 'opts' => '', 'preamble' => '' },
        { 'code' => '"abc123def" ~~ /\\d+/;
say $/.Str;               # OUTPUT: «123␤»', 'expect' => '123
', 'routine' => 'Str', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say (\'12345\' ~~ /234/).Int;       # OUTPUT: «234␤»
say (\'12345\' ~~ /234/).Int.^name; # OUTPUT: «Int␤»
# the next line produces a warning about using Nil (result of a no match) in numeric context
say (\'one-two\' ~~ /234/).Int;     # OUTPUT: «0␤» # because Nil.Int returns 0', 'expect' => '234
Int
0
', 'routine' => 'Int', 'opts' => '', 'preamble' => '' },
        { 'code' => '\'abcdefg\' ~~ /cd/;
say $/.prematch;          # OUTPUT: «ab␤»', 'expect' => 'ab
', 'routine' => 'prematch', 'opts' => '', 'preamble' => '' },
        { 'code' => '# will return a list of three match objects
"abc123def" ~~ m:g/\\d/;
say $/.[1].prematch;      # OUTPUT: «abc1␤»', 'expect' => 'abc1
', 'routine' => 'prematch', 'opts' => '', 'preamble' => '' },
        { 'code' => '\'abcdefg\' ~~ /cd/;
say $/.postmatch;         # OUTPUT: «efg␤»', 'expect' => 'efg
', 'routine' => 'postmatch', 'opts' => '', 'preamble' => '' },
        { 'code' => '# will return a list of three match objects
"abc123def" ~~ m:g/\\d/;
say $/.[1].postmatch;     # OUTPUT: «3def␤»', 'expect' => '3def
', 'routine' => 'postmatch', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my Str $some-string = "Some foo";
my Match $match = $some-string.match(/foo/);
my $another-string = $match.replace-with("string"); # «Some string»', 'expect' => '', 'routine' => 'replace-with', 'opts' => '', 'preamble' => '' },
      ],
