    {
      'name' => 'Metamodel::EnumHOW',
      'file' => 'EnumHOW',
      'subkind' => 'class',
      'category' => 'metamodel',
      'subtitle' => 'Metaobject representing a Raku enum.',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new_type', 'kind' => 'method', 'summary' => 'Creates a new type object for an enum. C<$name> is the enum name, C<$base_type> is the type given when the enum is declared using a scoped declaration (if any), and C<$repr> is the type representation passed to the enum using the C<repr> trait. C<$is_mixin> is unused.', 'sigs' => ['method new_type(:$name!, :$base_type?, :$repr = \'P6opaque\', :$is_mixin)'], 'returns' => [] },
        { 'name' => 'add_parent', 'kind' => 'method', 'summary' => 'Sets the base type of an enum. This can only be used if no base type was passed to C<.new_type>.', 'sigs' => ['method add_parent($obj, $parent)'], 'returns' => [] },
        { 'name' => 'set_export_callback', 'kind' => 'method', 'summary' => 'Sets the enum\'s export callback, which is invoked when calling C<.compose_values>. This is called when applying the C<export> trait to an enum. C<$callback> should be a routine of some sort, taking no arguments, that handles exporting the enum\'s values.', 'sigs' => ['method set_export_callback($obj, $callback)'], 'returns' => [] },
        { 'name' => 'export_callback', 'kind' => 'method', 'summary' => 'Returns the export callback set by C<.set_export_callback>.', 'sigs' => ['method export_callback($obj)'], 'returns' => [] },
        { 'name' => 'compose', 'kind' => 'method', 'summary' => 'Completes a type object for an enum. This is when any roles done by the enum are mixed in. This needs to be called before any enum values can be added using C<.add_enum_value>.', 'sigs' => ['method compose($obj, :$compiler_services)'], 'returns' => [] },
        { 'name' => 'is_composed', 'kind' => 'method', 'summary' => 'Returns 1 if the enum is composed, otherwise returns 0.', 'sigs' => ['method is_composed($obj)'], 'returns' => [] },
        { 'name' => 'compose_values', 'kind' => 'method', 'summary' => 'Calls the export callback set by C<.set_export_callback> and removes it from state. This should be called after adding the enum\'s values using C<.add_enum_value>.', 'sigs' => ['method compose_values($obj)'], 'returns' => [] },
        { 'name' => 'set_composalizer', 'kind' => 'method', 'summary' => 'Sets the composalizer for an enum, which produces a type that can be mixed in with another. C<$c> should be a routine of some that has the following signature:', 'sigs' => ['method set_composalizer($c)'], 'returns' => [] },
        { 'name' => 'composalizer', 'kind' => 'method', 'summary' => 'Returns the composalizer set by C<.set_composalizer>.', 'sigs' => ['method composalizer($obj)'], 'returns' => [] },
        { 'name' => 'add_enum_value', 'kind' => 'method', 'summary' => 'Adds a value to this enum. C<$value> should be an instance of the enum itself, as type L<C<Enumeration>|/type/Enumeration>.', 'sigs' => ['method add_enum_value($obj, $value)'], 'returns' => [] },
        { 'name' => 'enum_values', 'kind' => 'method', 'summary' => 'Returns the values for the enum.', 'sigs' => ['method enum_values($obj)'], 'returns' => [] },
        { 'name' => 'elems', 'kind' => 'method', 'summary' => 'Returns the number of values.', 'sigs' => ['method elems($obj)'], 'returns' => [] },
        { 'name' => 'enum_from_value', 'kind' => 'method', 'summary' => 'Given a value of the enum\'s base type, return the corresponding enum.', 'sigs' => ['method enum_from_value($obj, $value)'], 'returns' => [] },
        { 'name' => 'enum_value_list', 'kind' => 'method', 'summary' => 'Returns a list of the enum values.', 'sigs' => ['method enum_value_list($obj)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Metamodel::EnumHOW
    does Metamodel::Naming
    does Metamodel::Documenting
    does Metamodel::Stashing
    does Metamodel::AttributeContainer
    does Metamodel::MethodContainer
    does Metamodel::MultiMethodContainer
    does Metamodel::RoleContainer
    does Metamodel::BaseType
    does Metamodel::MROBasedMethodDispatch
    does Metamodel::MROBasedTypeChecking
    does Metamodel::BUILDPLAN
    does Metamodel::BoolificationProtocol
    does Metamodel::REPRComposeProtocol
    does Metamodel::Mixins
        { }', 'expect' => '', 'routine' => '', 'opts' => ':skip-test<TWEAK>', 'preamble' => '' },
        { 'code' => 'enum Numbers <1 2>;
say Numbers.HOW ~~ Metamodel::EnumHOW; # OUTPUT: «True␤»', 'expect' => 'True
', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'our Int enum Error <Warning Failure Exception Sorrow Panic>;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'BEGIN {
    my constant Error = Metamodel::EnumHOW.new_type: :name<Error>, :base_type(Int);
    Error.^add_role: Enumeration;
    Error.^add_role: NumericEnumeration;
    Error.^compose;
    for <Warning Failure Exception Sorrow Panic>.kv -> Int $v, Str $k {
        # Note: Enumeration.pred and .succ will not work when adding enum
        # values as pairs. They should be instances of the enum itself, but
        # this isn\'t possible to do without nqp.
        Error.^add_enum_value: $k => $v;
        OUR::{$k} := Error.^enum_from_value: $v;
    }
    Error.^compose_values;
    OUR::<Error> := Error;
}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => ':($type, $name, @enum_values)', 'expect' => '', 'routine' => 'set_composalizer', 'opts' => '', 'preamble' => '' },
        { 'code' => 'enum Numbers <10 20>;
say Numbers.^enum_values;                   # OUTPUT: {10 => 0, 20 => 1}', 'expect' => '', 'routine' => 'enum_values', 'opts' => '', 'preamble' => '' },
        { 'code' => 'enum Numbers <10 20>;
say Numbers.^elems;                         # OUTPUT: 2', 'expect' => '', 'routine' => 'elems', 'opts' => '', 'preamble' => '' },
        { 'code' => 'enum Numbers <10 20>;
say Numbers.^enum_from_value(0);            # OUTPUT: 10', 'expect' => '', 'routine' => 'enum_from_value', 'opts' => '', 'preamble' => '' },
        { 'code' => 'enum Numbers <10 20>;
say Numbers.^enum_value_list;               # OUTPUT: (10 20)', 'expect' => '', 'routine' => 'enum_value_list', 'opts' => '', 'preamble' => '' },
      ],
    },
