', 'routine' => 'on-close', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $supplier = Supplier.new;
my $all      = $supplier.Supply;
my $ints     = $all.grep(Int);
$ints.tap(&say);
$supplier.emit($_) for 1, \'a string\', 3.14159;   # prints only 1', 'expect' => '', 'routine' => 'grep', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $supplier = Supplier.new;
