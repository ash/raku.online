    {
      'name' => 'RakuAST::Doc::Block',
      'file' => 'Block',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'Contains the information of a RakuDoc block',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'The C<new> method can be called to create a new C<RakuAST::Doc::Block> object.  It only takes named arguments, with the C<:type> argument being mandatory. Note that the paragraphs should B<not> contain the left margin whitespace. The type of block: this is a string with the name.  Required.  Any name is allowed, but the C<RakuDoc> standard assigns semantics to some names. When these are used, it is assumed that the behavior of the block will', 'sigs' => [], 'returns' => [] },
        { 'name' => 'from-paragraphs', 'kind' => 'method', 'summary' => 'Create a C<RakuAST::Doc::Block> from a number of strings to be considered paragraphs.  Strings are assumed to B<not> have removed the left margin yet. Takes the same arguments as C<new>.  Note that the paragraphs should only contain strings and should B<not> contain the left margin whitespace.  A C<worry>/C<warning> will be issued if the left margin of a string is less than the margin indicated with C<:margin>.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-margin', 'kind' => 'method', 'summary' => 'Set the margin to the given value, which is expected to be the empty string or 1 more spaces.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-type', 'kind' => 'method', 'summary' => 'Set the type to the given value, which is expected to be a string.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-level', 'kind' => 'method', 'summary' => 'Set the level to the given value, which is expected to be an integer.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-config', 'kind' => 'method', 'summary' => 'Set the configuration to the given value, which is expected to be an L<C<Associative>|/type/Associative> of which the values are L<C<RakuAST>|/type/RakuAST> objects.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'add-config', 'kind' => 'method', 'summary' => 'Takes a key and a value to add to the configuration.  Value is expected to be either a string or a L<C<RakuAST>|/type/RakuAST> object.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'set-paragraphs', 'kind' => 'method', 'summary' => 'Set the paragraphs to the given L<C<Positional>|/type/Positional>.  Values are expected to be either a string, or a L<C<RakuAST::Doc::Paragraph>|/type/RakuAST::Doc::Paragraph> object.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'add-paragraph', 'kind' => 'method', 'summary' => 'Add a paragraph: should be a string, or a L<C<RakuAST::Doc::Paragraph>|/type/RakuAST::Doc::Paragraph> object.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'literalize-config', 'kind' => 'method', 'summary' => 'Recursively literalizes the C<config> of the block (if any) and puts the result in C<resolved-config>. If the object was created from the Raku grammar, then there is no need to call this method ever, as it will have been called as part of the C<CHECK> phaser checks already.', 'sigs' => [], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class RakuAST::Doc::Block { }', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'use experimental :rakuast;', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say "type = $block.type()";', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'say "level = $block.level()";', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'say "allows: $_"
  with $block.config<allow> andthen .literalize;', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'say "allows: $_" with $block.resolved-config<allow>;', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'for $block.paragraphs {
say $_;
}', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'with $block {
say "=begin $_.type" if .block;
}', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'with $block {
say "=for $_.type" if .for;
}', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'with $block {
say "=$_.type" if .abbreviated;
}', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'with $block {
say "=$_.type" if .directive;
}', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'my %*OK := $block.allowed-markup;
say "B markup is allowed" if %*OK<B>;', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'put $block;  # bar␤', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => '# method .gist falls back to .raku
say $block;  # RakuAST::Doc::Block.new(...', 'expect' => '', 'routine' => '', 'opts' => ':preamble<my $block>', 'preamble' => 'my $block' },
        { 'code' => 'method new(
  Str:D  :$type!,        # type of block, e.g. "head"
  Int:D  :$level = 0,    # level of block, e.g. 1 for "=head1"
     :%config,       # any configuration to be applied
  Str:D  :$margin = "",  # left margin (0 or more spaces)
     :@paragraphs,   # paragraphs of this block
  Bool:D :$for,          # this is a =for block
  Bool:D :$abbreviated,  # this is an abbreviated block
  Bool:D :$directive     # this is a directive (also abbreviated)
)', 'expect' => '', 'routine' => 'new', 'opts' => ':method', 'preamble' => '' },
        { 'code' => '  =begin foo
  bar
  =end foo

