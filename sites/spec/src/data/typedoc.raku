      'name' => 'Kernel',
      'file' => 'Kernel',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'Kernel related information',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'arch', 'kind' => 'method', 'summary' => 'Instance method returning the "arch" (as in "architecture") information of the Kernel object.  Dies if the "arch" could not be established.', 'sigs' => ['method arch'], 'returns' => [] },
        { 'name' => 'archname', 'kind' => 'method', 'summary' => 'Instance method returning the concatenation of L<hardware|/routine/hardware> and L<name|/routine/name>.', 'sigs' => ['method archname'], 'returns' => [] },
        { 'name' => 'bits', 'kind' => 'method', 'summary' => 'Instance method returning the number of bits used in the architecture of the processor.  Usually B<32> or B<64>.', 'sigs' => ['method bits'], 'returns' => [] },
        { 'name' => 'cpu-cores', 'kind' => 'method', 'summary' => 'Instance / Class method returning the number of CPU cores that are available.', 'sigs' => ['method cpu-cores(--> Int)'], 'returns' => ['Int'] },
        { 'name' => 'cpu-usage', 'kind' => 'method', 'summary' => 'Instance / Class method returning the amount of CPU uses since the start of the program (in microseconds).', 'sigs' => ['method cpu-usage(--> Int)'], 'returns' => ['Int'] },
        { 'name' => 'free-memory', 'kind' => 'method', 'summary' => 'Instance / Class method returning the available memory on the system. When using the JVM, this returns the available memory to the JVM instead. This method is only available in release v2019.06 and later.', 'sigs' => ['method free-memory(--> Int)'], 'returns' => ['Int'] },
        { 'name' => 'total-memory', 'kind' => 'method', 'summary' => 'Instance / Class method returning the total memory available to the system. When using the JVM, this returns the total memory available to the JVM instead. This method is only available in release v2019.06 and later.', 'sigs' => ['method total-memory(--> Int)'], 'returns' => ['Int'] },
        { 'name' => 'endian', 'kind' => 'method', 'summary' => 'Class method that returns the L<C<Endian>|/type/Endian> object associated with the kernel architecture (either C<LittleEndian> or C<BigEndian>).', 'sigs' => ['method endian(--> Endian:D)'], 'returns' => ['Endian:D'] },
        { 'name' => 'hardware', 'kind' => 'method', 'summary' => 'Instance method returning the hardware information of the Kernel object.  Dies if the hardware information could not be established.', 'sigs' => ['method hardware'], 'returns' => [] },
        { 'name' => 'hostname', 'kind' => 'method', 'summary' => 'Instance method returning the hostname of the Kernel object.', 'sigs' => ['method hostname'], 'returns' => [] },
        { 'name' => 'release', 'kind' => 'method', 'summary' => 'Instance method returning the release information of the Kernel object.  Dies if the release information could not be established.', 'sigs' => ['method release'], 'returns' => [] },
        { 'name' => 'signal', 'kind' => 'method', 'summary' => 'Instance method returning the C<Signal> numeric code for a given name for the Kernel object.', 'sigs' => ['multi method signal(Kernel:D: Str:D $signal --> Int:D)', 'multi method signal(Kernel:D: Signal:D \\signal --> Int:D)', 'multi method signal(Kernel:D: Int:D \\signal --> Int:D)'], 'returns' => ['Int:D', 'Int:D', 'Int:D'] },
        { 'name' => 'signals', 'kind' => 'method', 'summary' => 'Instance method returning a list of C<Signal>s that are supported by the kernel represented by the Kernel object.', 'sigs' => [], 'returns' => [] },
      ],
      'examples' => [
