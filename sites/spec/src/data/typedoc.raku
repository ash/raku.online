    {
      'name' => 'Mu',
      'file' => 'Mu',
      'subkind' => 'class',
      'category' => 'basic',
      'subtitle' => 'The root of the Raku type hierarchy.',
      'declkind' => 'class',
      'children' => ['Junction', 'Any'],
      'routines' => [
        { 'name' => 'iterator', 'kind' => 'method', 'summary' => 'Coerces the invocant to a C<list> by applying its L«C<.list>|/routine/list» method and uses L«C<iterator>|/type/Iterable#method_iterator» on it.', 'sigs' => ['method iterator(--> Iterator)'], 'returns' => ['Iterator'] },
        { 'name' => 'defined', 'kind' => 'routine', 'summary' => 'Returns C<False> on a type object, and C<True> otherwise. (The sub evaluates its argument, and the method its invocant.) A few types (like L<C<Failure>|/type/Failure>) override C<defined> to return C<False> even for instances:', 'sigs' => ['multi method defined(   --> Bool:D)', 'multi        defined(Mu --> Bool:D)'], 'returns' => ['Bool:D', 'Bool:D'] },
        { 'name' => 'isa', 'kind' => 'method', 'summary' => 'Returns C<True> if the invocant is an instance of class C<$type>, a subset type or a derived class (through inheritance) of C<$type>. L<C<does>|/method/does#(Mu)_method_does> is similar, but includes roles.', 'sigs' => ['multi method isa(Mu $type     --> Bool:D)', 'multi method isa(Str:D $type  --> Bool:D)'], 'returns' => ['Bool:D', 'Bool:D'] },
        { 'name' => 'does', 'kind' => 'method', 'summary' => 'Returns C<True> if and only if the invocant conforms to type C<$type>. Unlike L<C<isa>|/method/isa#(Mu)_method_isa>, which returns C<True> only for superclasses, C<does> includes both superclasses and roles. Using the smartmatch operator L<~~|/routine/~~> is a more idiomatic alternative.', 'sigs' => ['method does(Mu $type --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'Bool', 'kind' => 'routine', 'summary' => 'Returns C<False> on the type object, and C<True> otherwise. Many built-in types override this to be C<False> for empty collections, the empty L<string|/type/Str> or numerical zeros', 'sigs' => ['multi method Bool(   --> Bool:D)', 'multi        Bool(Mu --> Bool:D)'], 'returns' => ['Bool:D', 'Bool:D'] },
        { 'name' => 'Capture', 'kind' => 'method', 'summary' => 'Returns a L<C<Capture>|/type/Capture> with named arguments corresponding to invocant\'s public attributes:', 'sigs' => ['method Capture(Mu:D: --> Capture:D)'], 'returns' => ['Capture:D'] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Returns a string representation of the invocant, intended to be machine readable. Method L<C<Str>|/type/Str> warns on type objects, and produces the empty string.', 'sigs' => ['multi method Str(--> Str)'], 'returns' => ['Str'] },
        { 'name' => 'gist', 'kind' => 'routine', 'summary' => 'Returns a string representation of the invocant, optimized for fast recognition by humans. As such lists will be truncated at 100 elements. Use C<.raku> to get all elements. The default C<gist> method in C<Mu> re-dispatches to the L<raku|/routine/raku> method for defined invocants, and returns the type name in parenthesis for type object invocants. Many built-in classes override the case of instances to', 'sigs' => ['multi method gist(   --> Str)', 'multi        gist(+args --> Str)'], 'returns' => ['Str', 'Str'] },
        { 'name' => 'perl', 'kind' => 'method', 'summary' => 'Calls L«C<.raku>|/routine/raku» on the invocant.  Since the change of the language name to Raku, this method is deprecated. Use C<.raku> instead.', 'sigs' => ['multi method perl(Mu:)'], 'returns' => [] },
        { 'name' => 'raku', 'kind' => 'method', 'summary' => 'For type objects, returns its name if C<.raku> has not been redefined from C<Mu>, or calls C<.raku> on the name of the type object otherwise. For plain objects, it will conventionally return a representation of the object that can be used via L«C<EVAL>|/routine/EVAL» to reconstruct the value of the object.', 'sigs' => ['multi method raku(Mu:U:)', 'multi method raku(Mu:D:)'], 'returns' => [] },
        { 'name' => 'item', 'kind' => 'routine', 'summary' => 'Forces the invocant to be evaluated in item context and returns the value of it. You can also use C<$> as item contextualizer.', 'sigs' => ['method item(Mu \\item:) is raw', 'multi  item(\\x)', 'multi  item(|c)', 'multi  item(Mu $a)'], 'returns' => [] },
        { 'name' => 'self', 'kind' => 'method', 'summary' => 'Returns the object it is called on.', 'sigs' => ['method self(--> Mu)'], 'returns' => ['Mu'] },
        { 'name' => 'clone', 'kind' => 'method', 'summary' => 'This method will clone type objects, or die if it\'s invoked with any argument. If invoked with value objects, it creates a shallow clone of the invocant, including shallow cloning of private attributes. Alternative values for I<public> attributes can be provided via named arguments with names matching the attributes\' names. Note that C<.clone> does not go the extra mile to shallow-copy C<@.> and C<%.>', 'sigs' => ['multi method clone(Mu:U: *%twiddles)', 'multi method clone(Mu:D: *%twiddles)'], 'returns' => [] },
        { 'name' => 'new', 'kind' => 'method', 'summary' => 'Default method for constructing (create + initialize) new objects of a class. This method expects only named arguments which are then used to initialize attributes with accessors of the same name. Classes may provide their own C<new> method to override this default. C<new> triggers an object construction mechanism that calls submethods named C<BUILD> in each class of an inheritance hierarchy, if they exist. See', 'sigs' => ['multi method new(*%attrinit)'], 'returns' => [] },
        { 'name' => 'bless', 'kind' => 'method', 'summary' => 'Low-level object construction method, usually called from within C<new>, implicitly from the default constructor, or explicitly if you create your own constructor. C<bless> creates a new object of the same type as the invocant, using the named arguments to initialize attributes and returns the created object. It is usually invoked within custom C<new> method implementations: In this example we are declaring this C<new> method to avoid the extra syntax', 'sigs' => ['method bless(*%attrinit --> Mu:D)'], 'returns' => ['Mu:D'] },
        { 'name' => 'CREATE', 'kind' => 'method', 'summary' => 'Allocates a new object of the same type as the invocant, without initializing any attributes.', 'sigs' => ['method CREATE(--> Mu:D)'], 'returns' => ['Mu:D'] },
        { 'name' => 'print', 'kind' => 'routine', 'summary' => 'Prints value to C<$*OUT> after stringification using C<.Str> method without adding a newline at end.', 'sigs' => ['multi method print(--> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'put', 'kind' => 'routine', 'summary' => 'Prints value to C<$*OUT>, adding a newline at end, and if necessary, stringifying non-L<C<Str>|/type/Str> object using the C<.Str> method.', 'sigs' => ['multi method put(--> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'say', 'kind' => 'routine', 'summary' => 'Will L<C<say>|/type/IO::Handle#method_say> to L<standard output|/language/variables#index-entry-$*OUT>. What C<say> actually does is, thus, deferred to the actual subclass. In L<most cases|/routine/say> it calls L<C<.gist>|/routine/gist> on the object, returning a compact string representation. In non-sink context, C<say> will always return C<True>. However, this behavior is just conventional and you shouldn\'t trust it for', 'sigs' => ['multi method say()'], 'returns' => [] },
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'C<ACCEPTS> is the method that smartmatching with the L<infix ~~|/routine/~~> operator and given/when invokes on the right-hand side (the matcher). The C<Mu:U> multi performs a type check. Returns C<True> if C<$other> conforms to the invocant (which is always a type object or failure). Note that there is no multi for defined invocants; this is to allow autothreading of L<junctions|/type/Junction>, which happens as a fallback', 'sigs' => ['multi method ACCEPTS(Mu:U: $other)'], 'returns' => [] },
        { 'name' => 'WHICH', 'kind' => 'method', 'summary' => 'Returns an object of type L<C<ObjAt>|/type/ObjAt> which uniquely identifies the object. Value types override this method which makes sure that two equivalent objects return the same return value from C<WHICH>.', 'sigs' => ['multi method WHICH(--> ObjAt:D)'], 'returns' => ['ObjAt:D'] },
        { 'name' => 'WHERE', 'kind' => 'method', 'summary' => 'Returns an L<C<Int>|/type/Int> representing the memory address of the object.  Please note that in the Rakudo implementation of Raku, and possibly other implementations, the memory location of an object is B<NOT> fixed for the lifetime of the object.  So it has limited use for applications, and is intended as a debugging tool only.', 'sigs' => ['method WHERE(Mu:)'], 'returns' => [] },
        { 'name' => 'WHY', 'kind' => 'method', 'summary' => 'Returns the attached Pod::Block::Declarator. For instance: See L<Pod declarator blocks|/language/pod#Declarator_blocks> for details about attaching Pod to variables, classes, functions, methods, etc.', 'sigs' => ['multi method WHY(Mu: --> Pod::Block::Declarator)'], 'returns' => ['Pod::Block::Declarator'] },
        { 'name' => 'is', 'kind' => 'trait', 'summary' => 'Marks a type as being exported, that is, available to external users. A user of a module or class automatically gets all the symbols imported that are marked as C<is export>. See L<Exporting and Selective Importing Modules|/language/using-modules/code#Exporting_and_selective_importing> for more details.', 'sigs' => ['multi trait_mod:<is>(Mu:U \\type, :$export!)'], 'returns' => [] },
        { 'name' => 'return', 'kind' => 'routine', 'summary' => 'The method C<return> will stop execution of a subroutine or method, run all relevant L<phasers|/language/phasers#Block_phasers> and provide invocant as a return value to the caller. If a return L<type constraint|/language/signatures#Constraining_return_types> is provided it will be checked unless the return value is L<C<Nil>|/type/Nil>. A control exception is raised and can be caught with L<CONTROL|/language/phasers#CONTROL>.', 'sigs' => ['method return()'], 'returns' => [] },
        { 'name' => 'return-rw', 'kind' => 'routine', 'summary' => 'Same as routine L<C<return>|/type/Mu#routine_return> except that C<return-rw> returns a writable container to the invocant (see more details here: L<C<return-rw>|/language/control#return-rw>).', 'sigs' => [], 'returns' => [] },
        { 'name' => 'emit', 'kind' => 'routine', 'summary' => 'Emits the invocant into the enclosing L<supply|/language/concurrency#index-entry-supply_(on-demand)> or L<react|/language/concurrency#react> block.', 'sigs' => ['method emit()'], 'returns' => [] },
        { 'name' => 'take', 'kind' => 'routine', 'summary' => 'The sub takes the given item and passes it to the enclosing C<gather> block. The method returns the invocant in the enclosing L<gather|/language/control#gather/take> block.', 'sigs' => ['method take()', 'sub    take(\\item)'], 'returns' => [] },
        { 'name' => 'take-rw', 'kind' => 'sub', 'summary' => 'Returns the given item to the enclosing C<gather> block, without introducing a new container.', 'sigs' => ['sub take-rw(\\item)'], 'returns' => [] },
        { 'name' => 'so', 'kind' => 'routine', 'summary' => 'Evaluates the item in Boolean context (and thus, for instance, collapses Junctions), and returns the result. It is the opposite of C<not>, and equivalent to the L«C<?> operator|/language/operators#prefix_?». One can use this method similarly to the English sentence: "If that is B<so>, then do this thing".  For instance, The C<$verbose-selected> variable in this case contains a L<C<Junction>|/type/Junction>, whose value is C<any(any(False, False),', 'sigs' => ['method so()'], 'returns' => [] },
        { 'name' => 'not', 'kind' => 'routine', 'summary' => 'Evaluates the item in Boolean context (leading to final evaluation of Junctions, for instance), and negates the result. It is the opposite of C<so> and its behavior is equivalent to the L«C<!> operator|/language/operators#prefix_!». Since there is also a L«prefix version of C<not>|/language/operators#prefix_not», this example reads better as:', 'sigs' => ['method not()'], 'returns' => [] },
      ],
      'examples' => [
