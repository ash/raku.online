        { 'name' => 'gist', 'kind' => 'method', 'summary' => 'Returns string C<"Backtrace(42 frames)"> where the number indicates the number of frames available via L<list|/routine/list> method.', 'sigs' => ['multi method gist(Backtrace:D:)'], 'returns' => [] },
        { 'name' => 'Str', 'kind' => 'method', 'summary' => 'Returns a concise string representation of the backtrace, omitting routines marked as C<is hidden-from-backtrace>, and at the discretion of the implementation, also some routines from the setting.', 'sigs' => ['multi method Str(Backtrace:D:)'], 'returns' => [] },
        { 'name' => 'next-interesting-index', 'kind' => 'method', 'summary' => 'Returns the index of the next C<interesting> frame, once hidden and other settings are taken into account. C<$named> will decide whether to printed only those with a name, C<$noproto> will hide C<proto>s, and C<$setting> will hide those are considered setting.', 'sigs' => ['method next-interesting-index(Backtrace:D: Int $idx = 0, :$named, :$noproto, :$setting)'], 'returns' => [] },
