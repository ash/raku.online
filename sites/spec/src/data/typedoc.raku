        { 'name' => 'nice', 'kind' => 'method', 'summary' => 'Returns the backtrace as a list of I<interesting> frames. If C<:$oneline> is set, will stop after the first frame.', 'sigs' => ['method nice(Backtrace:D: :$oneline)'], 'returns' => [] },
        { 'name' => 'full', 'kind' => 'method', 'summary' => 'Returns a full string representation of the backtrace, including hidden frames, compiler-specific frames, and those from the setting.', 'sigs' => ['multi method full(Backtrace:D:)'], 'returns' => [] },
