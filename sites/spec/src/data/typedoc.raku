    {
      'name' => 'Array',
      'file' => 'Array',
      'subkind' => 'class',
      'category' => 'composite',
      'subtitle' => 'Sequence of itemized values',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'gist', 'kind' => 'method', 'summary' => 'Exactly the same as L«C<List.gist>|/type/List#method_gist», except using square brackets for surrounding delimiters.', 'sigs' => [], 'returns' => [] },
        { 'name' => 'pop', 'kind' => 'method', 'summary' => 'Removes and returns the last item from the array.  Fails if the array is empty. Like many C<Array> methods, method C<pop> may be called via the corresponding L<subroutine|/type/independent-routines#sub_pop>. For example:', 'sigs' => ['method pop(Array:D:) is nodal'], 'returns' => [] },
        { 'name' => 'push', 'kind' => 'method', 'summary' => 'Adds the provided value or values to the end of the array, and returns the modified array. If any argument is a L<C<Slip>|/type/Slip>, method C<push> will add the values produced by the argument\'s L<iterator|/routine/iterator>. It throws if the invocant array or a L<C<Slip>|/type/Slip> L<is lazy|/routine/is-lazy>. Example: Note that C<push> does not attempt to flatten its argument list.  If you pass', 'sigs' => ['multi method push(Array:D: **@values is raw --> Array:D)', 'multi method push(Array:D: \\value --> Array:D)', 'multi method push(Array:D: Slip \\values --> Array:D)'], 'returns' => ['Array:D', 'Array:D', 'Array:D'] },
        { 'name' => 'append', 'kind' => 'method', 'summary' => 'Adds the provided values to the end of the array and returns the modified array, or throws if the invocant array or an argument that requires flattening L<is lazy|/routine/is-lazy>. In contrast with L<method push|/type/Array#method_push>, method C<append> adheres to the L<single argument rule|/language/functions#Slurpy_conventions> and is probably best thought of as: This means that if you pass a B<single> argument that is a', 'sigs' => ['multi method append(Array:D: **@values is raw --> Array:D)', 'multi method append(Array:D: \\arg --> Array:D)'], 'returns' => ['Array:D', 'Array:D'] },
        { 'name' => 'elems', 'kind' => 'method', 'summary' => 'Returns the number of elements in the invocant. Throws L<C<X::Cannot::Lazy>|/type/X::Cannot::Lazy> exception if the invocant L<is lazy|/routine/is-lazy>. For shaped arrays, returns the outer dimension; see L<shape|/routine/shape> if you need information for all dimensions.', 'sigs' => ['method elems(Array:D: --> Int:D)'], 'returns' => ['Int:D'] },
        { 'name' => 'clone', 'kind' => 'method', 'summary' => 'Clones the original C<Array>. Modifications of elements in the clone are not propagated to the original and vice-versa: However, note that the reifier I<is> shared between the two Arrays, so both Arrays will have the same elements even when each is randomly-generated on reification and each element will be reified just once, regardless of whether the reification was done by the clone or the original Array.', 'sigs' => ['method clone(Array:D: --> Array:D)'], 'returns' => ['Array:D'] },
        { 'name' => 'flat', 'kind' => 'method', 'summary' => 'This method will return the type object itself if it\'s applied to a type object; when applied to an object, it will return a L<C<Seq>|/type/Seq> created from the C<Array> underlying iterator.', 'sigs' => ['multi method flat(Array:U:)', 'multi method flat(Array:D:)'], 'returns' => [] },
        { 'name' => 'shift', 'kind' => 'method', 'summary' => 'Removes and returns the first item from the array.  Fails if the array is empty. Example:', 'sigs' => ['method shift(Array:D:) is nodal'], 'returns' => [] },
        { 'name' => 'unshift', 'kind' => 'routine', 'summary' => 'Adds the C<@values> to the start of the array, and returns the modified array. Fails if C<@values> is a lazy list. Example: The notes in L<the documentation for method push|/type/Array#method_push> apply, regarding how many elements are added to the array. The L<routine prepend|/type/Array#routine_prepend> is the equivalent for adding multiple elements from one list or array.', 'sigs' => ['multi        unshift(Array:D, **@values --> Array:D)', 'multi method unshift(Array:D: **@values --> Array:D)'], 'returns' => ['Array:D', 'Array:D'] },
        { 'name' => 'prepend', 'kind' => 'routine', 'summary' => 'Adds the elements from C<values> to the front of the array, modifying it in-place. Example: The difference from method C<unshift> is that if you prepend a B<single> array or list argument, C<prepend> will flatten that array / list, whereas C<unshift> prepends the list / array as just a single element.', 'sigs' => ['sub prepend(\\array, |values)', 'multi method prepend(Array:D: \\values)', 'multi method prepend(Array:D: **@values is raw)'], 'returns' => [] },
        { 'name' => 'splice', 'kind' => 'routine', 'summary' => 'Deletes C<$elems> elements starting from index C<$start> from the C<Array>, returns them and replaces them by C<@replacement>. If C<$elems> is omitted or is larger than the number of elements starting from C<$start>, all the elements starting from index C<$start> are deleted. If both C<$start> and C<$elems> are omitted, all elements are deleted from the C<Array> and returned. Each of C<$start> and C<$elems> can be specified as a', 'sigs' => ['multi        splice(@list,   $start = 0, $elems?, *@replacement --> Array)', 'multi method splice(Array:D: $start = 0, $elems?, *@replacement --> Array)'], 'returns' => ['Array', 'Array'] },
        { 'name' => 'shape', 'kind' => 'method', 'summary' => 'Returns the shape of the array as a list. Example:', 'sigs' => ['method shape() { (*,) }'], 'returns' => [] },
        { 'name' => 'default', 'kind' => 'method', 'summary' => 'Returns the default value of the invocant, i.e. the value which is returned when trying to access an element in the C<Array> which has not been previously initialized or when accessing an element which has explicitly been set to L<C<Nil>|/type/Nil>. Unless the C<Array> is declared as having a default value by using the L<is default|/type/Variable#trait_is_default> trait the method returns the type object for', 'sigs' => ['method default'], 'returns' => [] },
        { 'name' => 'of', 'kind' => 'method', 'summary' => 'Returns the type constraint for the values of the invocant. By default, i.e. if no type constraint is given during declaration, the method returns C<(Mu)>.', 'sigs' => ['method of()'], 'returns' => [] },
        { 'name' => 'dynamic', 'kind' => 'method', 'summary' => 'Returns C<True> if the invocant has been declared with the L<is dynamic|/routine/is dynamic> trait, that is, if it\'s a dynamic variable that can be accessed from the inner lexical scope without having been declared there. If you declare a variable with the C<*> twigil C<is dynamic> is implied. Please note that the C<dynamic> trait is a property of the variable, not the content. If a L<C<Scalar>|/type/Scalar> dynamic variable contains an array, rules for this', 'sigs' => ['method dynamic(Array:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
        { 'name' => 'List', 'kind' => 'method', 'summary' => 'Converts the array to a L<C<List>|/type/List>. The holes will show up as L<C<Nil>|/type/Nil>.', 'sigs' => ['multi method List(Array:D:)'], 'returns' => [] },
        { 'name' => 'Slip', 'kind' => 'method', 'summary' => 'Converts the array to a L<C<Slip>|/type/Slip>, filling the holes with the type value the C<Array> has been defined with.', 'sigs' => ['multi method Slip(Array:D: --> Slip:D)'], 'returns' => ['Slip:D'] },
      ],
