        { 'name' => 'map', 'kind' => 'method', 'summary' => 'It invokes C<&block> for each element and gathers the return values in a sequence and returns it. This program: results in:', 'sigs' => ['multi method map(Backtrace:D: &block --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'flat', 'kind' => 'method', 'summary' => 'Returns the backtrace same as L<list|#method_list>.', 'sigs' => ['multi method flat(Backtrace:D:)'], 'returns' => [] },
