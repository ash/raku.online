    {
      'name' => 'Test',
      'file' => 'Test',
      'subkind' => 'module',
      'category' => 'module',
      'subtitle' => 'Writing and running tests',
      'declkind' => 'module',
      'routines' => [
        { 'name' => 'plan', 'kind' => 'sub', 'summary' => 'Specify the count of tests -- usually written at the beginning of a test file. In C<subtest>s, C<plan> is used to specify the count of tests within the subtest. If a C<plan> is used, it\'s not necessary to specify the end of testing with C<done-testing>. You can also provide a C<:skip-all> named argument instead of a test count, to indicate that you want to skip all of the tests. Such a plan will call L«C<exit>|/routine/exit», unless used inside of a C<subtest>.', 'sigs' => ['multi plan(Cool:D :skip-all($reason)!)', 'multi plan($number_of_tests)'], 'returns' => [] },
        { 'name' => 'done-testing', 'kind' => 'sub', 'summary' => 'Specify that testing has finished.  Use this function when you don\'t have a C<plan> with the number of tests to run. A C<plan> is not required when using C<done-testing>. It\'s recommended that the C<done-testing> function be removed and replaced with a C<plan> function when all tests are finalized. Use of C<plan> can help detect test failures otherwise not reported because tests were accidentally skipped due', 'sigs' => ['sub done-testing()'], 'returns' => [] },
        { 'name' => 'ok', 'kind' => 'sub', 'summary' => 'The C<ok> function marks a test as passed if the given C<$cond> evaluates to C<True>. It also accepts an optional description of the test as second argument. In principle, you could use C<ok> for every kind of comparison test, by including the comparison in the expression passed to C<$cond>: However, where possible it\'s better to use one of the specialized comparison test functions below, because they can print more helpful diagnostics output in', 'sigs' => ['multi ok(Mu $cond, $desc = \'\')'], 'returns' => [] },
        { 'name' => 'nok', 'kind' => 'sub', 'summary' => 'The C<nok> function marks a test as passed if the given C<$cond> evaluates to C<False>. It also accepts an optional description of the test as second argument.', 'sigs' => ['multi nok(Mu $cond, $desc = \'\')'], 'returns' => [] },
        { 'name' => 'is', 'kind' => 'sub', 'summary' => 'Marks a test as passed if C<$got> and C<$expected> compare positively with the L«C<eq> operator|/routine/eq», unless C<$expected> is a type object, in which case L«C<===> operator|/routine/===» will be used instead; accepts an optional description of the test as the last argument. B<NOTE:> the C<eq> operator stringifies its operands, which means C<is()> is not a good function for testing more complex things, such as lists: C<is (1, (2,', 'sigs' => ['multi is(Mu $got, Mu:U $expected, $desc = \'\')', 'multi is(Mu $got, Mu:D $expected, $desc = \'\')'], 'returns' => [] },
        { 'name' => 'isnt', 'kind' => 'sub', 'summary' => 'Marks a test as passed if C<$got> and C<$expected> are B<not> equal using the same rules as C<is()>.  The function accepts an optional description of the test.', 'sigs' => ['multi isnt(Mu $got, Mu:U $expected, $desc = \'\')', 'multi isnt(Mu $got, Mu:D $expected, $desc = \'\')'], 'returns' => [] },
        { 'name' => 'is_approx', 'kind' => 'sub', 'summary' => 'B<NOTE>: Removed with Rakudo release 2023.09, deprecated in older versions. Use C<is-approx> instead.', 'sigs' => ['multi is_approx(Mu $got, Mu $expected, $desc = \'\')'], 'returns' => [] },
        { 'name' => 'is-approx', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the C<$got> and C<$expected> numerical values are approximately equal to each other. The subroutine can be called in numerous ways that let you test using relative tolerance (C<$rel-tol>) or absolute tolerance (C<$abs-tol>) of different values. If no tolerance is set, the function will base the tolerance on the I<absolute> value of C<$expected>: if it\'s smaller than C<1e-6>, use absolute tolerance of', 'sigs' => ['multi is-approx(Numeric $got, Numeric $expected, $desc = \'\')'], 'returns' => [] },
        { 'name' => 'is-approx-calculate', 'kind' => 'sub', 'summary' => 'This is the actual routine called by L<C<is-approx> when absolute and relative tolerance are specified|/type/Test#Both_absolute_and_relative_tolerance_specified>. They are tested independently, and the test succeeds only if both pass.', 'sigs' => ['sub is-approx-calculate($got, $expected, $abs-tol where { !.defined or $_ >= 0 },'], 'returns' => [] },
        { 'name' => 'is-deeply', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the first and second parameters are equivalent, using the same semantics as the L<eqv operator|/routine/eqv>. This is the best way to check for equality of (deep) data structures. The function accepts an optional description of the test as the last argument. B<Note:> for L<historical reasons|https://github.com/rakudo/rakudo/commit/096bc17cd5>, L<C<Seq>|/type/Seq>C<:D> arguments to C<is-deeply> get converted to', 'sigs' => ['multi is-deeply(Seq:D $got, Seq:D $expected, $reason = \'\')', 'multi is-deeply(Seq:D $got, Mu $expected, $reason = \'\')', 'multi is-deeply(Mu $got, Seq:D $expected, $reason = \'\')', 'multi is-deeply(Mu $got, Mu $expected, $reason = \'\')'], 'returns' => [] },
        { 'name' => 'cmp-ok', 'kind' => 'sub', 'summary' => 'Compares C<$got> and C<$expected> with the given C<$op> comparator and passes the test if the comparison yields a C<True> value. The description of the test is optional. The C<$op> comparator can be either a L<C<Callable>|/type/Callable> or a L<C<Str>|/type/Str> containing an infix operator, such as C<\'==\'>, a C<\'~~\'>, or a user-defined infix. Metaoperators cannot be given as a string; pass them as a', 'sigs' => ['multi cmp-ok(Mu $got is raw, $op, Mu $expected is raw, $desc = \'\')'], 'returns' => [] },
        { 'name' => 'isa-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given object C<$var> is, or inherits from, the given C<$type>.  For convenience, types may also be specified as a string.  The function accepts an optional description of the test, which defaults to a string that describes the object. Note that, unlike C<isa>, C<isa-ok> also matches C<Roles>:', 'sigs' => ['multi isa-ok(Mu $var, Mu $type, $desc = "The object is-a \'$type.raku()\'")'], 'returns' => [] },
        { 'name' => 'can-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$var> can run the method named C<$meth>.  The function accepts an optional description.  For instance:', 'sigs' => ['multi can-ok(Mu $var, Str $meth, $desc = "..." )'], 'returns' => [] },
        { 'name' => 'does-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$var> can do the given role C<$type>. The function accepts an optional description of the test.', 'sigs' => ['multi does-ok(Mu $var, Mu $type, $desc = "...")'], 'returns' => [] },
        { 'name' => 'like', 'kind' => 'sub', 'summary' => 'Use it this way: Marks a test as passed if the first parameter, when coerced to a string, matches the regular expression specified as the second parameter. The function accepts an optional description of the test with a default value printing the expected match.', 'sigs' => ['sub like(Str() $got, Regex:D $expected, $desc = "text matches $expected.raku()")'], 'returns' => [] },
        { 'name' => 'unlike', 'kind' => 'sub', 'summary' => 'Used this way: Marks a test as passed if the first parameter, when coerced to a string, does B<not> match the regular expression specified as the second parameter.  The function accepts an optional description of the test, which defaults to printing the text that did not match.', 'sigs' => ['multi unlike(Str() $got, Regex:D $expected, $desc = "text does not match $expected.raku()")'], 'returns' => [] },
        { 'name' => 'use-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$module> loads correctly. Since C<$code> is being turned into an C<EVAL>, you can also pass arguments:', 'sigs' => ['multi use-ok(Str $code, $desc = "$code module can be use-d ok")'], 'returns' => [] },
        { 'name' => 'dies-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$code> throws an L<C<Exception>|/type/Exception>. The function accepts an optional description of the test.', 'sigs' => ['multi dies-ok(Callable $code, $reason = \'\')'], 'returns' => [] },
        { 'name' => 'lives-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$code> B<does not> throw an exception. The function accepts an optional description of the test.', 'sigs' => ['multi lives-ok(Callable $code, $reason = \'\')'], 'returns' => [] },
        { 'name' => 'eval-dies-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$string> throws an L<C<Exception>|/type/Exception> when C<eval>ed as code. The function accepts an optional description of the test.', 'sigs' => ['multi eval-dies-ok(Str $code, $reason = \'\')'], 'returns' => [] },
        { 'name' => 'eval-lives-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$string> B<does not> throw an exception when C<eval>ed as code. The function accepts an optional description of the test.', 'sigs' => ['multi eval-lives-ok(Str $code, $reason = \'\')'], 'returns' => [] },
        { 'name' => 'exits-ok', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$code> exits with the given C<$exit> code. The routine accepts an optional description (C<$reason>) for the test.', 'sigs' => ['multi exits-ok($code, $exit, $reason)'], 'returns' => [] },
        { 'name' => 'throws-like', 'kind' => 'sub', 'summary' => 'Marks a test as passed if the given C<$code> throws the specific exception expected exception type C<$ex_type>. The code C<$code> may be specified as something L<C<Callable>|/type/Callable> or as a string to be C<EVAL>ed. The exception is specified as a type object. If an exception was thrown, it will also try to match the matcher hash, where the key is the name of the method to be called on the exception, and', 'sigs' => ['sub throws-like($code, $ex_type, $reason?, *%matcher)'], 'returns' => [] },
        { 'name' => 'fails-like', 'kind' => 'sub', 'summary' => 'Same interface as C<throws-like>, except checks that the code returns a L<C<Failure>|/type/Failure> instead of throwing. If the code does throw or if the returned L<C<Failure>|/type/Failure> has already been L<handled|/routine/handled>, that will be considered as a failed test.', 'sigs' => ['sub fails-like ( \\test where Callable:D|Str:D, $ex-type, $reason?, *%matcher)'], 'returns' => [] },
        { 'name' => 'subtest', 'kind' => 'sub', 'summary' => 'The C<subtest> function executes the given block, consisting of usually more than one test, possibly including a C<plan> or C<done-testing>, and counts as I<one> test in C<plan>, C<todo>, or C<skip> counts. It will pass the test only if B<all> tests in the block pass. The function accepts an optional description of the subtest. You can also place the description as the first positional argument, or use a', 'sigs' => ['multi subtest(Pair $what)', 'multi subtest($desc, &subtests)', 'multi subtest(&subtests, $desc = \'\')'], 'returns' => [] },
        { 'name' => 'todo', 'kind' => 'sub', 'summary' => 'Sometimes tests just aren\'t ready to be run, for instance a feature might not yet be implemented, in which case tests can be marked as C<todo>. Or it could be the case that a given feature only works on a particular platform - in which case one would C<skip> the test on other platforms. Mark C<$count> tests as TODO, giving a C<$reason> as to why.  By default only one test will be marked TODO. The result from the test code above will be something like:', 'sigs' => ['multi todo($reason, $count = 1)'], 'returns' => [] },
        { 'name' => 'skip', 'kind' => 'sub', 'summary' => 'Skip C<$count> tests, giving a C<$reason> as to why.  By default only one test will be skipped.  Use such functionality when a test (or tests) would die if run. Note that if you mark a test as skipped, you must also prevent that test from running.', 'sigs' => ['multi skip()', 'multi skip($reason, $count = 1)'], 'returns' => [] },
        { 'name' => 'skip-rest', 'kind' => 'sub', 'summary' => 'Skip the remaining tests.  If the remainder of the tests in the test file would all fail due to some condition, use this function to skip them, providing an optional C<$reason> as to why. Note that C<skip-rest> requires a C<plan> to be set, otherwise the C<skip-rest> call will throw an error. Note that C<skip-rest> does not exit the test run. Do it manually, or use conditionals to avoid running any further tests.', 'sigs' => ['sub skip-rest($reason = \'<unknown>\')'], 'returns' => [] },
        { 'name' => 'bail-out', 'kind' => 'sub', 'summary' => 'If you already know the tests will fail, you can bail out of the test run using C<bail-out()>: The function aborts the current test run, signaling failure to the harness. Takes an optional reason for bailing out. The subroutine will call C<exit()>, so if you need to do a clean-up, do it before calling C<bail-out()>. If you want to abort the test run, but without marking it as failed, see L«C<skip-rest>|#sub_skip-rest»', 'sigs' => ['sub bail-out ($desc?)'], 'returns' => [] },
        { 'name' => 'pass', 'kind' => 'sub', 'summary' => 'The C<pass> function marks a test as passed. C<flunk> marks a test as B<not> passed. Both functions accept an optional test description. Since these subroutines do not provide indication of what value was received and what was expected, they should be used sparingly, such as when evaluating a complex test condition.', 'sigs' => ['multi pass($desc = \'\')'], 'returns' => [] },
        { 'name' => 'flunk', 'kind' => 'sub', 'summary' => 'The opposite of C<pass>, makes a test fail with an optional message.', 'sigs' => ['multi flunk($reason = \'\')'], 'returns' => [] },
