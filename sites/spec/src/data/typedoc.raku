say $result.exception; # OUTPUT: «This directory is forbidden: \'foo\'␤»', 'expect' => 'This directory is forbidden: \'foo\'
', 'routine' => 'fail', 'opts' => '', 'preamble' => '' },
        { 'code' => 'sub re-fail {
my $x = +"a";
unless $x.defined {
    $x.handled = True;
    say "Something has failed in \\$x ", $x.^name;
    # OUTPUT: «Something has failed in $x Failure␤»
    fail($x);
    return $x;
}
}

my $x = re-fail;
say $x.handled; # OUTPUT: «False␤»', 'expect' => 'Something has failed in $x Failure
False
', 'routine' => 'fail', 'opts' => '', 'preamble' => '' },
