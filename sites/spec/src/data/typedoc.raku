      'name' => 'Regex',
      'file' => 'Regex',
      'subkind' => 'class',
      'category' => 'domain-specific',
      'subtitle' => 'String pattern',
      'declkind' => 'class',
      'routines' => [
        { 'name' => 'ACCEPTS', 'kind' => 'method', 'summary' => 'Matches the regex against the argument passed in. If the argument is L<C<Positional>|/type/Positional>, it returns the first successful match of any list item. If the argument is L<C<Associative>|/type/Associative>, it returns the first successful match of any key. Otherwise it interprets the argument as a L<C<Str>|/type/Str> and matches against it. In the case of Positional and Associative matches, L<C<Nil>|/type/Nil> is returned on', 'sigs' => ['multi method ACCEPTS(Regex:D: Mu --> Match:D)', 'multi method ACCEPTS(Regex:D: @)', 'multi method ACCEPTS(Regex:D: %)'], 'returns' => ['Match:D'] },
        { 'name' => 'Bool', 'kind' => 'method', 'summary' => 'Matches against the caller\'s L<$_|/syntax/$_> variable, and returns C<True> for a match or C<False> for no match.', 'sigs' => ['multi method Bool(Regex:D: --> Bool:D)'], 'returns' => ['Bool:D'] },
      ],
      'examples' => [
