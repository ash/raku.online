        { 'name' => 'list', 'kind' => 'method', 'summary' => 'Applies the infix L«C<,>|/routine/,» operator to the invocant and returns the resulting L<C<List>|/type/List>: Subclasses of C<Any> may choose to return any I<core> type that does the L<C<Positional>|/type/Positional> role from L«C<.list>|/routine/list». Use L«C<.List>|/routine/List» to coerce specifically to L<C<List>|/type/List>. X<|Syntax,@ list contextualizer> C<@> can also be used as a list or L<C<Positional>|/type/Positional> contextualizer:', 'sigs' => ['multi method list(Any:U:)', 'multi method list(Any:D \\SELF:)'], 'returns' => [] },
        { 'name' => 'push', 'kind' => 'method', 'summary' => 'The method push is defined for undefined invocants and allows for autovivifying undefined to an empty L<C<Array>|/type/Array>, unless the undefined value implements L<C<Positional>|/type/Positional> already. The argument provided will then be pushed into the newly created Array.', 'sigs' => ['multi method push(Any:U \\SELF: |values --> Positional:D)'], 'returns' => ['Positional:D'] },
        { 'name' => 'reverse', 'kind' => 'routine', 'summary' => 'Returns a L<C<Seq>|/type/Seq> with the same elements in reverse order. Note that C<reverse> always refers to reversing elements of a list; to reverse the characters in a string, use L<flip|/routine/flip>. Examples:', 'sigs' => ['multi        reverse(*@list  --> Seq:D)', 'multi method reverse(List:D: --> Seq:D)'], 'returns' => ['Seq:D', 'Seq:D'] },
        { 'name' => 'sort', 'kind' => 'method', 'summary' => 'Sorts iterables with L<cmp|/routine/cmp> or given code object and returns a new L<C<Seq>|/type/Seq>. Optionally, takes a L<C<Callable>|/type/Callable> as a positional parameter, specifying how to sort. Examples:', 'sigs' => ['multi method sort()', 'multi method sort(&custom-routine-to-use)'], 'returns' => [] },
        { 'name' => 'map', 'kind' => 'routine', 'summary' => 'C<map> will iterate over the invocant and apply the number of positional parameters of the code object from the invocant per call.  The returned values of the code object will become elements of the returned L<C<Seq>|/type/Seq>. The additional parameters C<:$label> and C<:$item>, available in the C<method> form, are useful only internally, since C<for> loops get converted to C<map>s. The C<:$label> takes an existing L<C<Label>|/type/Label> to', 'sigs' => ['multi method map(\\SELF: &code)', 'multi        map(&code, +values)'], 'returns' => [] },
        { 'name' => 'deepmap', 'kind' => 'routine', 'summary' => 'C<deepmap> will apply its argument (or first argument for the sub form) to each element and return a new L<C<Iterable>|/type/Iterable> with the return values of the argument, unless the element does the L<C<Iterable>|/type/Iterable> role. For those elements L<deepmap|/routine/deepmap> will descend recursively into the sublist. In the case of L<C<Associative>|/type/Associative>s, it will be applied to its values:', 'sigs' => ['method deepmap(&block --> Iterable) is nodal', 'sub    deepmap(&op, \\obj --> Iterable)'], 'returns' => ['Iterable', 'Iterable'] },
        { 'name' => 'duckmap', 'kind' => 'routine', 'summary' => 'C<duckmap> will apply its argument (or first argument for the sub form) to each element that behaves in such a way that the argument can be applied. If it fails, it will descend recursively if possible, or otherwise return the item without any transformation. It will act on values if the object is L<C<Associative>|/type/Associative>. In the first case, it is applied to C<c>, C<d> and C<e> which are the ones that', 'sigs' => ['method duckmap(&block --> Iterable) is rw is nodal', 'sub    duckmap(&op, \\obj --> Iterable)'], 'returns' => ['Iterable', 'Iterable'] },
        { 'name' => 'nodemap', 'kind' => 'routine', 'summary' => 'C<nodemap> will apply its argument (or first argument for the sub form) to each element and return a new L<C<Iterable>|/type/Iterable> with the return values of its L<C<Callable>|/type/Callable> argument. In contrast to L<deepmap|/routine/deepmap> it will B<not> descend recursively into sublists if it finds elements which L<do|/routine/does> the L<C<Iterable>|/type/Iterable> role. The examples above would have produced the exact same results if we had used', 'sigs' => ['method nodemap(&block --> Iterable) is nodal', 'sub    nodemap(&op, \\obj --> Iterable)'], 'returns' => ['Iterable', 'Iterable'] },
        { 'name' => 'flat', 'kind' => 'method', 'summary' => 'Interprets the invocant as a list, flattens L<non-containerized|/language/containers> L<C<Iterable>|/type/Iterable>s into a flat list, and returns that list. Keep in mind L<C<Map>|/type/Map> and L<C<Hash>|/type/Hash> types are L<C<Iterable>|/type/Iterable> and so will be flattened into lists of pairs. Note that L<C<Array>|/type/Array>s containerize their elements by default, and so C<flat> will not flatten them. You can use the', 'sigs' => ['method flat() is nodal'], 'returns' => [] },
        { 'name' => 'eager', 'kind' => 'method', 'summary' => 'Interprets the invocant as a L<C<List>|/type/List>, evaluates it eagerly, and returns that L<C<List>|/type/List>.', 'sigs' => ['method eager() is nodal'], 'returns' => [] },
        { 'name' => 'elems', 'kind' => 'routine', 'summary' => 'Interprets the invocant or argument as a list, and returns the number of elements in the list. It will also return 1 for classes.', 'sigs' => ['multi method elems(Any:U: --> 1)', 'multi method elems(Any:D:)', 'multi        elems($a)', 'multi        elems(array:D \\a)'], 'returns' => ['1'] },
        { 'name' => 'end', 'kind' => 'routine', 'summary' => 'Interprets the invocant or argument as a list, and returns the last index of that list.', 'sigs' => ['multi method end(Any:U: --> 0)', 'multi method end(Any:D:)', 'multi        end($a)', 'multi        end(array:D \\a)', 'multi        end($, *%)'], 'returns' => ['0'] },
        { 'name' => 'pairup', 'kind' => 'method', 'summary' => 'Returns an empty L<C<Seq>|/type/Seq> if the invocant is a type object Interprets the invocant as a list, and constructs a list of L<C<Pair>|/type/Pair>s from it, in the same way that assignment to a L<C<Hash>|/type/Hash> does.  That is, it takes two consecutive elements and constructs a pair from them, unless the item in the key position already is a pair (in which case the pair is passed through, and the next list item, if any,', 'sigs' => ['multi method pairup(Any:U:)', 'multi method pairup(Any:D:)'], 'returns' => [] },
        { 'name' => 'Array', 'kind' => 'method', 'summary' => 'Coerces the invocant to an L<C<Array>|/type/Array>.', 'sigs' => ['method Array(--> Array:D) is nodal'], 'returns' => ['Array:D'] },
        { 'name' => 'List', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<List>|/type/List>, using the L<list|/routine/list> method.', 'sigs' => ['method List(--> List:D) is nodal'], 'returns' => ['List:D'] },
        { 'name' => 'serial', 'kind' => 'method', 'summary' => 'This method is Rakudo specific, and is not included in the Raku spec. The method returns the self-reference to the instance itself: This is apparently a no-op, as exemplified by the third example above. However, in L<C<HyperSeq>|/type/HyperSeq>s and L<C<RaceSeq>|/type/RaceSeq>s it returns a serialized L<C<Seq>|/type/Seq>, so it can be considered the opposite of the C<hyper/race> methods. As such, it ensures that we are in serial list-processing mode, as', 'sigs' => ['multi method serial()'], 'returns' => [] },
        { 'name' => 'Hash', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Hash>|/type/Hash>.', 'sigs' => ['multi method Hash( --> Hash:D)'], 'returns' => ['Hash:D'] },
        { 'name' => 'hash', 'kind' => 'method', 'summary' => 'When called on a type object, returns an empty L<C<Hash>|/type/Hash>. On instances, it is equivalent to assigning the invocant to a C<%->sigiled variable and returning that. Subclasses of C<Any> may choose to return any I<core> type that does the L<C<Associative>|/type/Associative> role from L«C<.hash>|/routine/hash». Use L«C<.Hash>|/routine/Hash» to coerce specifically to L<C<Hash>|/type/Hash>.', 'sigs' => ['multi method hash(Any:U:)', 'multi method hash(Any:D:)'], 'returns' => [] },
        { 'name' => 'Slip', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Slip>|/type/Slip>.', 'sigs' => ['method Slip(--> Slip:D) is nodal'], 'returns' => ['Slip:D'] },
        { 'name' => 'Map', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Map>|/type/Map>.', 'sigs' => ['method Map(--> Map:D) is nodal'], 'returns' => ['Map:D'] },
        { 'name' => 'Seq', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Seq>|/type/Seq>.', 'sigs' => ['method Seq() is nodal'], 'returns' => [] },
        { 'name' => 'Bag', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Bag>|/type/Bag>, whereby L<C<Positional>|/type/Positional>s are treated as lists of values.', 'sigs' => ['method Bag(--> Bag:D) is nodal'], 'returns' => ['Bag:D'] },
        { 'name' => 'BagHash', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<BagHash>|/type/BagHash>, whereby L<C<Positional>|/type/Positional>s are treated as lists of values.', 'sigs' => ['method BagHash(--> BagHash:D) is nodal'], 'returns' => ['BagHash:D'] },
        { 'name' => 'Set', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Set>|/type/Set>, whereby L<C<Positional>|/type/Positional>s are treated as lists of values.', 'sigs' => ['method Set(--> Set:D) is nodal'], 'returns' => ['Set:D'] },
        { 'name' => 'SetHash', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<SetHash>|/type/SetHash>, whereby L<C<Positional>|/type/Positional>s are treated as lists of values.', 'sigs' => ['method SetHash(--> SetHash:D) is nodal'], 'returns' => ['SetHash:D'] },
        { 'name' => 'Mix', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<Mix>|/type/Mix>, whereby L<C<Positional>|/type/Positional>s are treated as lists of values.', 'sigs' => ['method Mix(--> Mix:D) is nodal'], 'returns' => ['Mix:D'] },
        { 'name' => 'MixHash', 'kind' => 'method', 'summary' => 'Coerces the invocant to L<C<MixHash>|/type/MixHash>, whereby L<C<Positional>|/type/Positional>s are treated as lists of values.', 'sigs' => ['method MixHash(--> MixHash:D) is nodal'], 'returns' => ['MixHash:D'] },
        { 'name' => 'Supply', 'kind' => 'method', 'summary' => 'First, it coerces the invocant to a C<list> by applying its L«C<.list>|/routine/list» method, and then to a L<C<Supply>|/type/Supply>.', 'sigs' => ['method Supply(--> Supply:D) is nodal'], 'returns' => ['Supply:D'] },
        { 'name' => 'min', 'kind' => 'routine', 'summary' => 'Coerces the invocant to L<C<Iterable>|/type/Iterable> and returns the smallest element using L<cmp|/routine/cmp> semantics; in the case of L<C<Map>|/type/Map>s and L<C<Hash>|/type/Hash>es, it returns the L<C<Pair>|/type/Pair> with the B<lowest> value. A L<C<Callable>|/type/Callable> positional argument can be given to the C<method> form.  If that L<C<Callable>|/type/Callable> accepts a single argument, then it', 'sigs' => ['multi method min(&by?, :$k, :$v, :$kv, :$p )', 'multi        min(+args, :&by, :$k, :$v, :$kv, :$p)'], 'returns' => [] },
        { 'name' => 'max', 'kind' => 'routine', 'summary' => 'The interface of the C<max> method / routine is the same as the one of L<min|#routine min>.  But instead of the lowest value, it will return the B<highest> value. As of the 2023.08 Rakudo compiler release:', 'sigs' => ['multi method max(&by?, :$k, :$v, :$kv, :$p )', 'multi        max(+args, :&by, :$k, :$v, :$kv, :$p)'], 'returns' => [] },
        { 'name' => 'minmax', 'kind' => 'routine', 'summary' => 'Returns a L<C<Range>|/type/Range> from the smallest to the largest element. If a L<C<Callable>|/type/Callable> positional argument is provided, each value is passed into the filter, and its return value is compared instead of the original value. The original values are still used in the returned L<C<Range>|/type/Range>. In C<sub> form, the invocant is passed as an argument and a comparison L<C<Callable>|/type/Callable>', 'sigs' => ['multi method minmax()', 'multi method minmax(&by)', 'multi        minmax(+args, :&by!)', 'multi        minmax(+args)'], 'returns' => [] },
        { 'name' => 'minpairs', 'kind' => 'method', 'summary' => 'Calls L«C<.pairs>|/routine/pairs» and returns a L<C<Seq>|/type/Seq> with all of the Pairs with minimum values, as judged by the L«C<cmp> operator|/routine/cmp»:', 'sigs' => ['multi method minpairs(Any:D:)'], 'returns' => [] },
        { 'name' => 'maxpairs', 'kind' => 'method', 'summary' => 'Calls L«C<.pairs>|/routine/pairs» and returns a L<C<Seq>|/type/Seq> with all of the Pairs with maximum values, as judged by the L«C<cmp> operator|/routine/cmp»:', 'sigs' => ['multi method maxpairs(Any:D:)'], 'returns' => [] },
        { 'name' => 'keys', 'kind' => 'method', 'summary' => 'For defined C<Any> returns its L<keys|/routine/keys> after calling C<list> on it, otherwise calls C<list> and returns it. See also L<C<List.keys>|/type/List#routine_keys>. Trying the same on a class will return an empty list, since most of them don\'t really have keys.', 'sigs' => ['multi method keys(Any:U: --> List)', 'multi method keys(Any:D: --> List)'], 'returns' => ['List', 'List'] },
        { 'name' => 'flatmap', 'kind' => 'method', 'summary' => 'Convenience method, analogous to L<C<.map(&block)>|#routine_map>L<C<.flat>|#method_flat>.', 'sigs' => ['method flatmap(&block, :$label)'], 'returns' => [] },
        { 'name' => 'roll', 'kind' => 'method', 'summary' => 'Coerces the invocant to a C<list> by applying its L«C<.list>|/routine/list» method and uses L«C<List.roll>|/type/List#routine_roll» on it. C<$m>, in this case, is converted into a list and then a (weighted in this case) dice is rolled on it. See also L<C<List.roll>|/type/List#routine_roll> for more information.', 'sigs' => ['multi method roll(--> Any)', 'multi method roll($n --> Seq)'], 'returns' => ['Any', 'Seq'] },
        { 'name' => 'iterator', 'kind' => 'method', 'summary' => 'Returns the object as an iterator after converting it to a list. This is the function called from the C<for> statement. An iterable subclass of C<Any> should provide its own implementation of this method, but other classes can inherit this as-is to provide a single-item-list iterator in contexts that require one.', 'sigs' => ['multi method iterator(Any:)'], 'returns' => [] },
        { 'name' => 'pick', 'kind' => 'method', 'summary' => 'Coerces the invocant to a L<C<List>|/type/List> by applying its L«C<.list>|/routine/list» method and uses L«C<List.pick>|/type/List#routine_pick» on it.', 'sigs' => ['multi method pick(--> Any)', 'multi method pick($n --> Seq)'], 'returns' => ['Any', 'Seq'] },
        { 'name' => 'skip', 'kind' => 'routine', 'summary' => 'Creates a L<C<Seq>|/type/Seq> from 1-item list\'s iterator and uses L«C<Seq.skip>|/type/Seq#method_skip» on it, please check that document for real use cases; calling C<skip> without argument is equivalent to C<skip(1)>. As of release 2022.07 of the Rakudo compiler, there is also a "sub" version of C<skip>.  It B<must> have the skip specifier as the first argument.  The rest of the arguments are turned into a L<C<Seq>|/type/Seq> and then have the C<skip>', 'sigs' => ['multi method skip()', 'multi method skip(Whatever)', 'multi method skip(Callable:D $w)', 'multi method skip(Int() $n)', 'multi method skip($skip, $produce)'], 'returns' => [] },
        { 'name' => 'are', 'kind' => 'method', 'summary' => 'The argumentless version available as of release 2022.02 of the Rakudo compiler.  The version with the type argument is in the 6.e language version (early implementation exists in Rakudo compiler 2024.05+). If called without arguments, returns the strictest type (or role) to which B<all> elements of the list will smartmatch.  Returns L<C<Nil>|/type/Nil> on an empty list. Scalar values are interpreted as a single element list.', 'sigs' => ['multi method are(Any:)', 'multi method are(Any: Any $type)'], 'returns' => [] },
        { 'name' => 'prepend', 'kind' => 'method', 'summary' => 'Called with no arguments on an empty variable, it initializes it as an empty L<C<Array>|/type/Array>; if called with arguments, it creates an array and then applies L«C<Array.prepend>|/type/Array#routine_prepend» on it.', 'sigs' => ['multi method prepend(Any:U: --> Array)', 'multi method prepend(Any:U: @values --> Array)'], 'returns' => ['Array', 'Array'] },
        { 'name' => 'unshift', 'kind' => 'method', 'summary' => 'Initializes C<Any> variable as empty L<C<Array>|/type/Array> and calls L«C<Array.unshift>|/type/Array#routine_unshift» on it.', 'sigs' => ['multi method unshift(Any:U: --> Array)', 'multi method unshift(Any:U: @values --> Array)'], 'returns' => ['Array', 'Array'] },
        { 'name' => 'first', 'kind' => 'routine', 'summary' => 'In general, coerces the invocant to a C<list> by applying its L«C<.list>|/routine/list» method and uses L«C<List.first>|/type/List#routine_first» on it. However, this is a multi with different signatures, which are implemented with (slightly) different behavior, although using it as a subroutine is equivalent to using it as a method with the second argument as the object. For starters, using a L<C<Bool>|/type/Bool> as the argument will always return a L<C<Failure>|/type/Failure>.', 'sigs' => ['multi method first(Bool:D $t)', 'multi method first(Regex:D $test, :$end, *%a)', 'multi method first(Callable:D $test, :$end, *%a is copy)', 'multi method first(Mu $test, :$end, *%a)', 'multi method first(:$end, *%a)', 'multi        first(Bool:D $t, |)', 'multi        first(Mu $test, +values, *%a)'], 'returns' => [] },
        { 'name' => 'unique', 'kind' => 'method', 'summary' => 'Creates a sequence of unique elements either of the object or of C<values> in the case it\'s called as a C<sub>. The C<:as> and C<:with> parameters receive functions that are used for transforming the item before checking equality, and for checking equality, since by default the L<C<===>|/routine/===> operator is used: Please see L<C<unique>|/type/independent-routines#routine_unique> for additional examples that use its sub form.', 'sigs' => ['multi method unique()', 'multi method unique( :&as!, :&with! )', 'multi method unique( :&as! )', 'multi method unique( :&with! )'], 'returns' => [] },
        { 'name' => 'repeated', 'kind' => 'method', 'summary' => 'Similarly to L<C<unique>|/type/Any#method_unique>, finds repeated elements in C<values> (as a routine) or in the object, using the C<:as> associative argument as a normalizing function and C<:with> as equality function. It returns the last repeated element before normalization, as shown in the example above. See L<C<repeated>|/type/independent-routines#routine_repeated> for more examples that use its sub form.', 'sigs' => ['multi method repeated()', 'multi method repeated( :&as!, :&with! )', 'multi method repeated( :&as! )', 'multi method repeated( :&with! )'], 'returns' => [] },
        { 'name' => 'squish', 'kind' => 'method', 'summary' => 'Similar to L<C<.repeated>|/type/Any#method_repeated>, returns the sequence of first elements of contiguous sequences of equal elements, after normalization by the function C<:as>, if present, and using as an equality operator the C<:with> argument or C<===> by default. As shown in the last example, a sequence can contain a single element. See L<C<squish>|/type/independent-routines#routine_squish> for additional C<sub>', 'sigs' => ['multi method squish( :&as!, :&with = &[===] )', 'multi method squish( :&with = &[===] )'], 'returns' => [] },
        { 'name' => 'permutations', 'kind' => 'method', 'summary' => 'Coerces the invocant to a C<list> by applying its L«C<.list>|/routine/list» method and uses L«C<List.permutations>|/type/List#routine_permutations» on it. Permutations of data structures with a single or no element will return a list containing an empty list or a list with a single element.', 'sigs' => ['method permutations(|c)'], 'returns' => [] },
        { 'name' => 'join', 'kind' => 'method', 'summary' => 'Converts the object to a list by calling L<C<self.list>|/type/Any#method_list>, and calls L<C<.join>|/type/List#routine_join> on the list. Can take a separator, which is an empty string by default.', 'sigs' => ['method join($separator = \'\') is nodal'], 'returns' => [] },
        { 'name' => 'categorize', 'kind' => 'routine', 'summary' => 'The first form will always fail. The second form classifies on the identity of the given object, which usually only makes sense in combination with the C<:&as> argument. In its simplest form, it uses a C<$test> whose result will be used as a key; the values of the key will be an array of the elements that produced that key as a result of the test. The C<:as> argument will normalize before categorizing', 'sigs' => ['multi method categorize()', 'multi method categorize(Whatever)', 'multi method categorize($test, :$into!, :&as)', 'multi method categorize($test, :&as)', 'multi        categorize($test, +items, :$into!, *%named )', 'multi        categorize($test, +items, *%named )'], 'returns' => [] },
        { 'name' => 'classify', 'kind' => 'routine', 'summary' => 'The first form will always fail. The second form classifies on the identity of the given object, which usually only makes sense in combination with the C<:&as> argument. The rest include a C<$test> argument, which is a function that will return a scalar for every input; these will be used as keys of a hash whose values will be arrays with the elements that output that key for the test function. Similarly to L<C<.categorize>|/type/Any#routine_categorize>, elements can be', 'sigs' => ['multi method classify()', 'multi method classify(Whatever)', 'multi method classify($test, :$into!, :&as)', 'multi method classify($test, :&as)', 'multi        classify($test, +items, :$into!, *%named )', 'multi        classify($test, +items, *%named )'], 'returns' => [] },
        { 'name' => 'reduce', 'kind' => 'routine', 'summary' => 'This routine combines the elements in a list-y object, and produces a single result, by applying a binary subroutine. It applies its argument (or first argument for the sub form) as an operator to all the elements in the object (or second argument for the sub form), producing a single result. The subroutine must be either an L<infix operator|/language/operators#index-entry-infix_operator> or take two positional arguments. When using an infix operator, we must provide', 'sigs' => ['multi method reduce(Any:U: & --> Nil)', 'multi method reduce(Any:D: &with)', 'multi        reduce (&with, +list)'], 'returns' => ['Nil'] },
        { 'name' => 'produce', 'kind' => 'routine', 'summary' => 'This is similar to L<C<reduce>|/routine/reduce#(List)_routine_reduce>, but returns a list with the accumulated values instead of a single result. The last element of the produced list would be the output produced by the C<.reduce> method. If it\'s a class, it will simply return Nil.', 'sigs' => ['multi method produce(Any:U: & --> Nil)', 'multi method produce(Any:D: &with)', 'multi        produce (&with, +list)'], 'returns' => ['Nil'] },
        { 'name' => 'pairs', 'kind' => 'method', 'summary' => 'Returns an empty L<C<List>|/type/List> if the invocant is a type object: For a value object, it converts the invocant to a L<C<List>|/type/List> via the C<list> method and returns the result of L<List.pairs|/type/List#routine_pairs> on it. In this case, every element (with weight) in a bag is converted to a pair.', 'sigs' => ['multi method pairs(Any:U:)', 'multi method pairs(Any:D:)'], 'returns' => [] },
        { 'name' => 'antipairs', 'kind' => 'method', 'summary' => 'Returns an empty L<C<List>|/type/List> if the invocant is a type object If it\'s a value object, it returns the inverted list of pairs after converting it to a list of pairs; the values will become keys and the other way round.', 'sigs' => ['multi method antipairs(Any:U:)', 'multi method antipairs(Any:D:)'], 'returns' => [] },
        { 'name' => 'invert', 'kind' => 'method', 'summary' => 'Applied to a type object will return an empty list; applied to an object will convert it to a list and apply L<C<List.invert>|/type/List#routine_invert> to it, that is, interchange key with value in every Pair. The resulting list needs to be a list of L<C<Pair>|/type/Pair>s. In this case, a L<C<Bag>|/type/Bag> can be converted to a list of L<C<Pair>|/type/Pair>s. If the result of converting the object to a list is not a list of pairs, the method will fail.', 'sigs' => ['multi method invert(Any:U:)', 'multi method invert(Any:D:)'], 'returns' => [] },
        { 'name' => 'kv', 'kind' => 'routine', 'summary' => 'Returns an empty L<C<List>|/type/List> if the invocant is a type object: It calls C<list> on the invocant for value objects and returns the result of L<List.kv|/type/List#routine_kv> on it as a list where keys and values will be ordered and contiguous In the case of L<C<Positional>|/type/Positional>s, the indices will be considered I<keys>.', 'sigs' => ['multi method kv(Any:U:)', 'multi method kv(Any:D:)', 'multi        kv($x)'], 'returns' => [] },
        { 'name' => 'toggle', 'kind' => 'method', 'summary' => 'L<Iterates|/routine/iterator> over the invocant, producing a L<C<Seq>|/type/Seq>, toggling whether the received values are propagated to the result on and off, depending on the results of calling L<C<Callables>|/type/Callable> in C<@conditions>: Imagine a switch that\'s either on or off (C<True> or C<False>), and values are produced if it\'s on. By default, the initial state of that switch is in "on"', 'sigs' => ['method toggle(Any:D: *@conditions where .all ~~ Callable:D, Bool :$off  --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'head', 'kind' => 'routine', 'summary' => 'Returns either the first element in the object, or the first C<$n> if that\'s used. In the first two cases, the results are different since there\'s no defined order in L<C<Mix>|/type/Mix>es. In the other cases, it returns a L<C<Seq>|/type/Seq>. A L<C<Callable>|/type/Callable> can be used to return all but the last elements: As of release 2022.07 of the Rakudo compiler, there is also a "sub" version of C<head>.', 'sigs' => ['multi method head(Any:D:) is raw', 'multi method head(Any:D: Callable:D $w)', 'multi method head(Any:D: $n)'], 'returns' => [] },
        { 'name' => 'tail', 'kind' => 'routine', 'summary' => 'Returns the last or the list of the C<$n> last elements of an object. C<$n> can be a L<C<Callable>|/type/Callable>, usually a L<C<WhateverCode>|/type/WhateverCode>, which will be used to get all but the first C<n> elements of the object. As of release 2022.07 of the Rakudo compiler, there is also a "sub" version of C<tail>. It B<must> have the tail specifier as the first argument.  The rest of the arguments are turned into a L<C<Seq>|/type/Seq> and then have the C<tail>', 'sigs' => ['multi method tail() is raw', 'multi method tail($n)'], 'returns' => [] },
        { 'name' => 'tree', 'kind' => 'method', 'summary' => 'Returns the class if it\'s undefined or if it\'s not L<C<Iterable>|/type/Iterable>, returns the result of applying the C<tree> method to its invocant otherwise. C<.tree> has different prototypes for L<C<Iterable>|/type/Iterable> elements. With a number, it iteratively applies C<tree> to every element in the lower level; the first instance will apply C<.tree(0)> to every element in the array, and likewise for the next example.', 'sigs' => ['multi method tree(Any:U:)', 'multi method tree(Any:D:)', 'multi method tree(Any:D: Whatever )', 'multi method tree(Any:D: Int(Cool) $count)', 'multi method tree(Any:D: @ [&first, *@rest])', 'multi method tree(Any:D: &first, *@rest)'], 'returns' => [] },
        { 'name' => 'nl-out', 'kind' => 'method', 'summary' => 'Returns L<C<Str>|/type/Str> with the value of "\\n". See L«C<IO::Handle.nl-out>|/type/IO::Handle#method_nl-out» for the details.', 'sigs' => ['method nl-out(--> Str)'], 'returns' => ['Str'] },
        { 'name' => 'combinations', 'kind' => 'method', 'summary' => 'Coerces the invocant to a C<list> by applying its L«C<.list>|/routine/list» method and uses L«C<List.combinations>|/type/List#routine_combinations» on it. Combinations on an empty data structure will return a list with a single element, an empty list; on a data structure with a single element it will return a list with two lists, one of them empty and the other with a single element.', 'sigs' => ['method combinations(|c)'], 'returns' => [] },
        { 'name' => 'grep', 'kind' => 'method', 'summary' => 'Coerces the invocant to a C<list> by applying its L«C<.list>|/routine/list» method and uses L«C<List.grep>|/type/List#routine_grep» on it. For undefined invocants, based on C<$matcher> the return value can be either C<((Any))> or the empty List.', 'sigs' => ['method grep(Mu $matcher, :$k, :$kv, :$p, :$v --> Seq)'], 'returns' => ['Seq'] },
        { 'name' => 'append', 'kind' => 'method', 'summary' => 'In the case the instance is not a positional-thing, it instantiates it as a new L<C<Array>|/type/Array>, otherwise clone the current instance. After that, it appends the values passed as arguments to the array obtained calling L«C<Array.append>|/type/Array#method_append» on it.', 'sigs' => ['multi method append(Any:U \\SELF: |values)'], 'returns' => [] },
        { 'name' => 'values', 'kind' => 'method', 'summary' => 'Will return an empty list for undefined or class arguments, and the object converted to a list otherwise.', 'sigs' => ['multi method values(Any:U:)', 'multi method values(Any:D:)'], 'returns' => [] },
        { 'name' => 'collate', 'kind' => 'method', 'summary' => 'The C<collate> method sorts taking into account Unicode grapheme characteristics; that is, sorting more or less as one would expect instead of using the order in which their codepoints appear. C<collate> will behave this way if the object it is applied to is L<C<Iterable>|/type/Iterable>. This method is affected by the L<C<$*COLLATION>|/language/variables#index-entry-$*COLLATION> variable, which configures the four X<collation levels|Language,collation levels>. While Primary, Secondary and', 'sigs' => ['method collate()'], 'returns' => [] },
        { 'name' => 'cache', 'kind' => 'method', 'summary' => 'Provides a L<C<List>|/type/List> representation of the object itself, calling the method C<list> on the instance.', 'sigs' => ['method cache()'], 'returns' => [] },
        { 'name' => 'batch', 'kind' => 'method', 'summary' => 'Coerces the invocant to a C<list> by applying its L«C<.list>|/routine/list» method and uses L«C<List.batch>|/type/List#method_batch» on it.', 'sigs' => ['multi method batch(Int:D $batch)', 'multi method batch(Int:D :$elems!)'], 'returns' => [] },
        { 'name' => 'rotor', 'kind' => 'method', 'summary' => 'Creates a L<C<Seq>|/type/Seq> that groups the elements of the object in lists of C<$batch> elements. With the C<:partial> named argument, it will also include lists that do not get to be the C<$batch> size: C<.rotor> can be called with an array of integers and pairs, which will be applied in turn. While integers will establish the batch size, as above, L<C<Pair>|/type/Pair>s will use the key as batch size and the value as number of elements to', 'sigs' => ['multi method rotor(Any:D: Int:D $batch, :$partial)', 'multi method rotor(Any:D: *@cycle, :$partial)'], 'returns' => [] },
        { 'name' => 'sum', 'kind' => 'method', 'summary' => 'If the content is iterable, it returns the sum of the values after pulling them one by one, or 0 if the list is empty. It will fail if any of the elements cannot be converted to a number.', 'sigs' => ['method sum() is nodal'], 'returns' => [] },
        { 'name' => 'method', 'kind' => 'multi', 'summary' => 'Available as of the 2021.02 release of the Rakudo compiler. Converts the invocant to a L<C<Seq>|/type/Seq> and then calls the L<slice method|/type/Seq#multi_method_slice> on it.', 'sigs' => ['method slice(Any:D: *@indices --> Seq:D)'], 'returns' => ['Seq:D'] },
        { 'name' => 'snip', 'kind' => 'routine', 'summary' => 'Available as of 6.e language version (early implementation exists in Rakudo compiler 2022.07+). The C<snip> method / subroutine provides a way to cut a given L<C<Iterable>|/type/Iterable> into two or more L<C<List>|/type/List>s.  A "snip" will be made as soon as the smartmatch of a value in the given L<C<Iterable>|/type/Iterable> returns False.  The matcher may also be a list of matchers: as soon as a "snip" was made, will it start checking', 'sigs' => ['multi        snip(\\matcher, +values)', 'multi method snip(\\values: \\matcher)'], 'returns' => [] },
        { 'name' => 'snitch', 'kind' => 'routine', 'summary' => 'Available as of 6.e language version (early implementation exists in Rakudo compiler 2022.12+). The C<snitch> method / subroutine is a debugging / logging tool that will always return any invocant / argument given unchanged. By default, it will L<note|/routine/note> the invocant / argument, but this can be overridden by specifying a L<C<Callable>|/type/Callable> that is expected to take the invocant / argument as its only argument.', 'sigs' => ['multi  snitch(\\snitchee)', 'multi  snitch(&snitcher, \\snitchee)', 'method snitch(\\snitchee: &snitcher = &note)'], 'returns' => [] },
      ],
      'examples' => [
        { 'code' => 'class Any is Mu {}', 'expect' => '', 'routine' => '', 'opts' => '', 'preamble' => '' },
        { 'code' => 'EXPR.ACCEPTS(EXPR);', 'expect' => '', 'routine' => 'ACCEPTS', 'opts' => ':lang<pseudo>', 'preamble' => '' },
        { 'code' => 'say so 2 == <1 2 3>.any;        # OUTPUT: «True␤»
say so 5 == any(<1 2 3>);       # OUTPUT: «False␤»', 'expect' => 'True
False
', 'routine' => 'any', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say so 3 < <2 3 4>.all;         # OUTPUT: «False␤»
say so 1 < all(<2 3 4>);        # OUTPUT: «True␤»', 'expect' => 'False
True
', 'routine' => 'all', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say so 1 == (1, 2, 3).one;      # OUTPUT: «True␤»
say so 1 == one(1, 2, 1);       # OUTPUT: «False␤»', 'expect' => 'True
False
', 'routine' => 'one', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say so 1 == (1, 2, 3).none;     # OUTPUT: «False␤»
say so 4 == none(1, 2, 3);      # OUTPUT: «True␤»', 'expect' => 'False
True
', 'routine' => 'none', 'opts' => '', 'preamble' => '' },
        { 'code' => 'say 42.list.^name;           # OUTPUT: «List␤»
say 42.list.elems;           # OUTPUT: «1␤»', 'expect' => 'List
1
', 'routine' => 'list', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my $not-a-list-yet = $[1,2,3];
say $not-a-list-yet.raku;             # OUTPUT: «$[1, 2, 3]␤»
my @maybe-a-list = @$not-a-list-yet;
say @maybe-a-list.^name;              # OUTPUT: «Array␤»', 'expect' => '$[1, 2, 3]
Array
', 'routine' => 'list', 'opts' => '', 'preamble' => '' },
        { 'code' => 'my %h;
say %h<a>;     # OUTPUT: «(Any)␤»      <-- Undefined
%h<a>.push(1); # .push on Any
