        { 'id' => "subset-ver", 'title' => "a subset records its language version", 'note' => "Even.^ver reports the revision it was declared under.", 'code' => "subset Even of Int where * \%\% 2; say Even.^ver;", 'd' => "6.d", 'e' => "6.e", 'ppd' => "6.d", 'pp' => "6.e", 'changed' => 1, 'gating' => "gated", 'status' => "full", 'why' => "", 'rakuast' => 0 },
        { 'id' => "divmod-zero", 'title' => "mod by zero soft-fails", 'note' => "core.e redoes the div/mod candidates: 1 mod 0 returns a Failure the way div always has, instead of throwing on the spot. Visible on the 6.d/6.e axis since Rakudo 2026.08.", 'code' => "my \$x = 1 mod 0; say \$x.^name; \$x.so;", 'd' => "Attempt to divide 1 by zero using div", 'e' => "Failure", 'ppd' => "Attempt to divide 1 by zero using infix:<mod>", 'pp' => "Failure", 'changed' => 1, 'gating' => "gated", 'status' => "full", 'why' => "", 'rakuast' => 0 },
        { 'id' => "eval-revision", 'title' => "use v6.e.PREVIEW inside EVAL", 'note' => "Since Rakudo 2026.08 the pragma inside an EVAL string is accepted but inert — the EVAL'd code stays at the caller's revision. Raku++ still raises it, which is why the row scores default-on there: the snippet works without the outer pragma.", 'code' => "say EVAL q[use v6.e.PREVIEW; rotor(2, 1..6)];", 'd' => "Undeclared routine:", 'e' => "((1 2) (3 4) (5 6))", 'ppd' => "((1 2) (3 4) (5 6))", 'pp' => "((1 2) (3 4) (5 6))", 'changed' => 1, 'gating' => "default-on", 'status' => "full", 'why' => "", 'rakuast' => 0 },
      ],
